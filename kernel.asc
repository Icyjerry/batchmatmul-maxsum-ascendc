AscendC::Nd2NzParams bp;bp.ndNum=1;bp.nValue=TX2?cols:count;bp.dValue=TX2?count:cols;
bp.srcDValue=TX2?s.k:s.n;bp.dstNzC0Stride=PAD_MN?(bp.nValue+15)/16*16:bp.nValue;bp.dstNzNStride=1;
if constexpr(PAD_MN)ManualZeroNZTail(b1,bp.nValue,bp.dValue);AscendC::DataCopy(b1,b[batch*s.n*s.k+(TX2?n0*s.k+k0:k0*s.n+n0)],bp);
