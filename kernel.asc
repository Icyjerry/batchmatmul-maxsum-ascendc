const int64_t batch=t/(int64_t(aKPanels)*s.mTiles);const int64_t k0=int64_t(kp)*128,m0=int64_t(mt)*s.baseM;
auto data=cq.AllocTensor<T>();AscendC::DataCopyExtParams cp{128,s.baseM*2,
static_cast<uint32_t>((s.m-s.baseM)*2),0,0};AscendC::DataCopyPadExtParams<T>pad{false,0,0,T(0)};
AscendC::DataCopyPad(data,a[batch*s.m*s.k+k0*s.m+m0],cp,pad);cq.EnQue(data);data=cq.DeQue<T>();
Fence<AscendC::HardEvent::V_MTE3>();AscendC::DataCopy(packedA[(batch*s.mTiles+mt)*s.k*s.baseM+k0*s.baseM],data,128*s.baseM);
