}template<typename T>
__schedmode__(1)__global__ __vector__ void bmmms_col_sumfirst(GM_ADDR x1,GM_ADDR x2,GM_ADDR partial,GM_ADDR output,Schedule s)
{AscendC::TPipe pipe;
constexpr uint32_t width=512,kTile=32;const uint32_t kTiles=(s.k+kTile-1)/kTile,worker=AscendC::GetBlockIdx();
const int64_t tasks=s.b*kTiles;AscendC::GlobalTensor<T>a,b;AscendC::GlobalTensor<float>scratch,out;
a.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x1));b.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x2));
scratch.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(partial));out.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(output));
AscendC::TQue<AscendC::TPosition::VECIN,2>aq;AscendC::TQue<AscendC::TPosition::VECIN,1>bq,fq;
AscendC::TQue<AscendC::TPosition::VECOUT,1>oq;AscendC::TBuf<AscendC::TPosition::VECCALC>af,bf,sf,pf,rf,tf,df,of;
pipe.InitBuffer(aq,2,kTile*width*2);pipe.InitBuffer(bq,1,kTile*2);pipe.InitBuffer(fq,1,kTiles*32);pipe.InitBuffer(oq,1,32);
pipe.InitBuffer(af,kTile*width*4);pipe.InitBuffer(bf,kTile*4);pipe.InitBuffer(sf,kTile*4);pipe.InitBuffer(pf,kTile*4);
pipe.InitBuffer(rf,8*kTile*4);pipe.InitBuffer(tf,1024);pipe.InitBuffer(df,1024);pipe.InitBuffer(of,8*32);
auto fa=af.Get<float>(),fb=bf.Get<float>(),acc=sf.Get<float>(),prod=pf.Get<float>();
auto rows=rf.Get<float>(),tmp=tf.Get<float>(),dots=df.Get<float>(),outputs=of.Get<float>();for(int64_t task=worker;task<tasks;task+=s.workers){
const uint32_t batch=task/kTiles,k0=(task%kTiles)*kTile,kr=s.k-k0<kTile?s.k-k0:kTile;auto lb=bq.AllocTensor<T>();
AscendC::DataCopyExtParams bp{1,kr*2,0,0,0};AscendC::DataCopyPadExtParams<T>bpad{true,0,static_cast<uint8_t>((kr+15)/16*16-kr),T(0)};
AscendC::DataCopyPad(lb,b[int64_t(batch)*s.k+k0],bp,bpad);bq.EnQue(lb);
SumFirstCopyM(aq,a,s,batch,k0,kr,0);if(s.m>width)SumFirstCopyM(aq,a,s,batch,k0,kr,width);
lb=bq.DeQue<T>();AscendC::Cast(fb,lb,AscendC::RoundMode::CAST_NONE,kr);bq.FreeTensor(lb);
AscendC::Duplicate(acc,0.0f,kTile);AscendC::PipeBarrier<PIPE_V>();for(uint32_t m0=0;m0<s.m;m0+=width){
const uint32_t count=s.m-m0<width?s.m-m0:width,groups=(count+63)/64;
auto la=aq.DeQue<T>();AscendC::Cast(fa,la,AscendC::RoundMode::CAST_NONE,kr*width);AscendC::PipeBarrier<PIPE_V>();aq.FreeTensor(la);
if(m0+2*width<s.m)SumFirstCopyM(aq,a,s,batch,k0,kr,m0+2*width);for(uint32_t g=0;g<groups;++g)
AscendC::WholeReduceSum(rows[g*kTile],fa[g*64],uint64_t(count-g*64<64?count-g*64:64),kr,1,1,width/8);AscendC::PipeBarrier<PIPE_V>();
for(uint32_t step=1;step<groups;step*=2){for(uint32_t g=0;g+step<groups;g+=2*step)AscendC::Add(rows[g*kTile],rows[g*kTile],rows[(g+step)*kTile],kr);
AscendC::PipeBarrier<PIPE_V>();}
AscendC::Add(acc,acc,rows,kr);AscendC::PipeBarrier<PIPE_V>();}
AscendC::Mul(prod,acc,fb,kr);AscendC::PipeBarrier<PIPE_V>();
auto y=oq.AllocTensor<float>();AscendC::Duplicate(y,0.0f,8);AscendC::PipeBarrier<PIPE_V>();
AscendC::ReduceSum<float,true>(y,prod,tmp,kr);oq.EnQue(y);y=oq.DeQue<float>();AscendC::DataCopy(scratch[task*8],y,8);oq.FreeTensor(y);
}AscendC::SyncAll<true>();
const int64_t b0=int64_t(worker)*8;if(b0<s.b){
const uint32_t batches=s.b-b0<8?s.b-b0:8;for(uint32_t bi=0;bi<batches;++bi){
auto x=fq.AllocTensor<float>();AscendC::DataCopy(x,scratch[(b0+bi)*kTiles*8],kTiles*8);fq.EnQue(x);x=fq.DeQue<float>();
for(uint32_t i=0;i<kTiles;i+=128)AscendC::WholeReduceSum(dots[i],x[i*8],uint64_t(1),kTiles-i<128?kTiles-i:128,1,1,1);AscendC::PipeBarrier<PIPE_V>();
AscendC::ReduceSum<float,true>(outputs[bi*8],dots,tmp,kTiles);AscendC::PipeBarrier<PIPE_V>();fq.FreeTensor(x);}
auto y=oq.AllocTensor<float>();AscendC::WholeReduceSum(y,outputs,uint64_t(1),batches,1,1,1);oq.EnQue(y);y=oq.DeQue<float>();
AscendC::DataCopyExtParams cp{1,batches*4,0,0,0};AscendC::DataCopyPad(out[b0],y,cp);oq.FreeTensor(y);}
}template<typename T,bool TRANSPOSED,bool TAKE_MAX>
__global__ __vector__ void bmmms_small(GM_ADDR matrix,GM_ADDR vector,GM_ADDR output,Schedule s){
AscendC::TPipe pipe;const uint32_t rows=TAKE_MAX?s.n:s.m;
const uint32_t stride=(s.k+15)/16*16;const uint32_t rowPad=(rows+7)/8*8;
AscendC::GlobalTensor<T>mat,vec;AscendC::GlobalTensor<float>out;
mat.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(matrix),s.b*rows*s.k);vec.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(vector),s.b*s.k);
out.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(output),s.b);AscendC::TQue<AscendC::TPosition::VECIN,1>mq,vq;
AscendC::TQue<AscendC::TPosition::VECOUT,1>oq;
AscendC::TBuf<AscendC::TPosition::VECCALC>fmBuf,fvBuf,workBuf,idxBuf,idxTmpBuf,sumsBuf,partBuf,tmpBuf,resultBuf;
pipe.InitBuffer(mq,1,rows*stride*sizeof(T));pipe.InitBuffer(vq,1,stride*sizeof(T));
pipe.InitBuffer(oq,1,32);pipe.InitBuffer(fmBuf,rows*stride*4);
pipe.InitBuffer(fvBuf,stride*4);pipe.InitBuffer(workBuf,rows*stride*4);
pipe.InitBuffer(idxBuf,stride*4);pipe.InitBuffer(idxTmpBuf,stride*4);
pipe.InitBuffer(sumsBuf,rowPad*4);pipe.InitBuffer(partBuf,rowPad*4);
pipe.InitBuffer(tmpBuf,rowPad*4);pipe.InitBuffer(resultBuf,32);
auto fm=fmBuf.Get<float>(),fv=fvBuf.Get<float>(),work=workBuf.Get<float>();
auto sums=sumsBuf.Get<float>(),part=partBuf.Get<float>(),tmp=tmpBuf.Get<float>(),result=resultBuf.Get<float>();
auto index=idxBuf.Get<int32_t>(),indexTmp=idxTmpBuf.Get<int32_t>();if(TRANSPOSED){
AscendC::CreateVecIndex(index,int32_t(0),s.k);AscendC::PipeBarrier<PIPE_V>();
AscendC::Muls(index,index,int32_t(rows*4),s.k);AscendC::PipeBarrier<PIPE_V>();
}const int64_t b0=static_cast<int64_t>(AscendC::GetBlockIdx())*8;
const uint32_t batches=s.b-b0<8?s.b-b0:8;auto y=oq.AllocTensor<float>();
for(uint32_t bi=0;bi<batches;++bi){auto ml=mq.AllocTensor<T>(),vl=vq.AllocTensor<T>();
AscendC::DataCopyExtParams mp{static_cast<uint16_t>(TRANSPOSED?1:rows),static_cast<uint32_t>((TRANSPOSED?rows:1)*s.k*sizeof(T)),0,0,0};
AscendC::DataCopyPadExtParams<T>pad{true,0,static_cast<uint8_t>(TRANSPOSED?((16-rows*s.k%16)%16):(stride-s.k)),T(0)};
AscendC::DataCopyPad(ml,mat[(b0+bi)*rows*s.k],mp,pad);AscendC::DataCopyExtParams vp{1,static_cast<uint32_t>(s.k*sizeof(T)),0,0,0};
AscendC::DataCopyPadExtParams<T>vpad{true,0,static_cast<uint8_t>(stride-s.k),T(0)};AscendC::DataCopyPad(vl,vec[(b0+bi)*s.k],vp,vpad);
mq.EnQue(ml);vq.EnQue(vl);ml=mq.DeQue<T>();vl=vq.DeQue<T>();AscendC::Cast(fv,vl,AscendC::RoundMode::CAST_NONE,stride);
if(TRANSPOSED){AscendC::Cast(work,ml,AscendC::RoundMode::CAST_NONE,((rows*s.k+15)/16)*16);
AscendC::PipeBarrier<PIPE_V>();for(uint32_t r=0;r<rows;++r){
AscendC::Adds(indexTmp,index,int32_t(r*4),s.k);AscendC::PipeBarrier<PIPE_V>();
AscendC::Gather(fm[r*stride],work,indexTmp.ReinterpretCast<uint32_t>(),0,s.k);AscendC::PipeBarrier<PIPE_V>();
}}else{
AscendC::Cast(fm,ml,AscendC::RoundMode::CAST_NONE,rows*stride);AscendC::PipeBarrier<PIPE_V>();
}mq.FreeTensor(ml);vq.FreeTensor(vl);
AscendC::Duplicate(sums,0.0f,rowPad);AscendC::PipeBarrier<PIPE_V>();
for(uint32_t k=0;k<s.k;k+=64){const uint32_t count=s.k-k<64?s.k-k:64;
AscendC::BinaryRepeatParams rp{1,1,1,static_cast<uint8_t>(stride/8),static_cast<uint8_t>(stride/8),0};
AscendC::Mul(work[k],fm[k],fv[k],static_cast<uint64_t>(count),rows,rp);AscendC::PipeBarrier<PIPE_V>();
AscendC::WholeReduceSum(part,work[k],count,rows,1,1,stride/8);AscendC::PipeBarrier<PIPE_V>();
AscendC::Add(sums,sums,part,uint64_t(rows),1,AscendC::BinaryRepeatParams{1,1,1,8,8,8});
AscendC::PipeBarrier<PIPE_V>();}
if(TAKE_MAX)AscendC::ReduceMax<float>(result,sums,tmp,rows,false);else AscendC::ReduceSum<float,true>(result,sums,tmp,rows);
Fence<AscendC::HardEvent::V_S>();y.SetValue(bi,result.GetValue(0));
Fence<AscendC::HardEvent::S_V>();}
Fence<AscendC::HardEvent::S_MTE3>();oq.EnQue(y);y=oq.DeQue<float>();
AscendC::DataCopyExtParams op{1,static_cast<uint32_t>(batches*4),0,0,0};AscendC::DataCopyPad(out[b0],y,op);oq.FreeTensor(y);
}template<bool TRANSPOSED>
__aicore__ inline void MicroIndices(AscendC::LocalTensor<int32_t>index,AscendC::LocalTensor<int32_t>row,AscendC::LocalTensor<int32_t>tmp,
uint32_t count,uint32_t logicalRows,uint32_t k,uint32_t shift){
AscendC::CreateVecIndex(index,int32_t(0),count);AscendC::PipeBarrier<PIPE_V>();
AscendC::ShiftRight(row,index,int32_t(shift),count);AscendC::PipeBarrier<PIPE_V>();
AscendC::ShiftLeft(tmp,row,int32_t(shift),count);AscendC::PipeBarrier<PIPE_V>();
AscendC::Sub(index,index,tmp,count);AscendC::Mins(row,row,int32_t(logicalRows-1),count);
AscendC::PipeBarrier<PIPE_V>();AscendC::Mins(index,index,int32_t(k-1),count);
AscendC::Muls(row,row,int32_t(TRANSPOSED?4:k*4),count);AscendC::PipeBarrier<PIPE_V>();
AscendC::Muls(index,index,int32_t(TRANSPOSED?logicalRows*4:4),count);AscendC::PipeBarrier<PIPE_V>();
AscendC::Add(index,index,row,count);AscendC::PipeBarrier<PIPE_V>();
}template<typename T,bool TX1,bool TX2>
__global__ __vector__ void bmmms_micro_batch(GM_ADDR x1,GM_ADDR x2,GM_ADDR output,Schedule s){
AscendC::TPipe pipe;const uint32_t stride=s.k,shift=s.k==32?5:6,np=(s.n+7)/8*8;
const uint32_t ae=s.m*stride,be=s.n*stride,largest=ae>be?ae:be;const uint32_t chunk=s.microRows==4?4:2;
const int64_t b0=int64_t(AscendC::GetBlockIdx())*8;const uint32_t batches=s.b-b0<8?s.b-b0:8;
AscendC::GlobalTensor<T>a,b;AscendC::GlobalTensor<float>out;a.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x1));
b.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x2));out.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(output));
AscendC::TQue<AscendC::TPosition::VECIN,1>aq,bq;AscendC::TQue<AscendC::TPosition::VECOUT,1>oq;
AscendC::TBuf<AscendC::TPosition::VECCALC>af,bf,rawBuf,iaBuf,ibBuf,irBuf,itBuf,pf,df,rf;
pipe.InitBuffer(aq,1,8*ae*2);pipe.InitBuffer(bq,1,8*be*2);pipe.InitBuffer(oq,1,32);pipe.InitBuffer(af,8*ae*4);pipe.InitBuffer(bf,8*be*4);
pipe.InitBuffer(rawBuf,(TX1||!TX2)?8*largest*4:32);pipe.InitBuffer(iaBuf,TX1?8*ae*4:32);pipe.InitBuffer(ibBuf,!TX2?8*be*4:32);
pipe.InitBuffer(irBuf,(TX1||!TX2)?largest*4:32);pipe.InitBuffer(itBuf,(TX1||!TX2)?largest*4:32);
pipe.InitBuffer(pf,chunk*8*np*stride*4);pipe.InitBuffer(df,chunk*8*np*4);pipe.InitBuffer(rf,chunk*32);
auto fa=af.Get<float>(),fb=bf.Get<float>(),raw=rawBuf.Get<float>();
auto ia=iaBuf.Get<int32_t>(),ib=ibBuf.Get<int32_t>(),ir=irBuf.Get<int32_t>(),it=itBuf.Get<int32_t>();
auto prod=pf.Get<float>(),dots=df.Get<float>(),rows=rf.Get<float>();auto la=aq.AllocTensor<T>(),lb=bq.AllocTensor<T>();
AscendC::DataCopy(la,a[b0*ae],batches*ae);AscendC::DataCopy(lb,b[b0*be],batches*be);aq.EnQue(la);bq.EnQue(lb);
for(uint32_t bi=0;bi<batches;++bi){if constexpr(TX1){
MicroIndices<true>(ia[bi*ae],ir,it,ae,s.m,s.k,shift);AscendC::Adds(ia[bi*ae],ia[bi*ae],int32_t(bi*ae*4),ae);AscendC::PipeBarrier<PIPE_V>();
}if constexpr(!TX2){
MicroIndices<true>(ib[bi*be],ir,it,be,s.n,s.k,shift);AscendC::Adds(ib[bi*be],ib[bi*be],int32_t(bi*be*4),be);AscendC::PipeBarrier<PIPE_V>();
}}
la=aq.DeQue<T>();lb=bq.DeQue<T>();if constexpr(TX1){
AscendC::Cast(raw,la,AscendC::RoundMode::CAST_NONE,batches*ae);AscendC::PipeBarrier<PIPE_V>();
AscendC::Gather(fa,raw,ia.ReinterpretCast<uint32_t>(),0,batches*ae);AscendC::PipeBarrier<PIPE_V>();
}else AscendC::Cast(fa,la,AscendC::RoundMode::CAST_NONE,batches*ae);if constexpr(!TX2){
AscendC::Cast(raw,lb,AscendC::RoundMode::CAST_NONE,batches*be);AscendC::PipeBarrier<PIPE_V>();
AscendC::Gather(fb,raw,ib.ReinterpretCast<uint32_t>(),0,batches*be);}else AscendC::Cast(fb,lb,AscendC::RoundMode::CAST_NONE,batches*be);
AscendC::PipeBarrier<PIPE_V>();aq.FreeTensor(la);bq.FreeTensor(lb);auto y=oq.AllocTensor<float>();AscendC::Duplicate(y,0.0f,8);
if(np!=s.n)AscendC::Duplicate(prod,0.0f,chunk*batches*np*stride);AscendC::PipeBarrier<PIPE_V>();
AscendC::BinaryRepeatParams rp{1,1,1,static_cast<uint8_t>(np*stride/8),static_cast<uint8_t>(ae/8),static_cast<uint8_t>(be/8)};
for(uint32_t m0=0;m0<s.m;m0+=chunk){const uint32_t count=s.m-m0<chunk?s.m-m0:chunk;
for(uint32_t rr=0;rr<count;++rr)for(uint32_t n=0;n<s.n;++n)
AscendC::Mul(prod[rr*batches*np*stride+n*stride],fa[(m0+rr)*stride],fb[n*stride],uint64_t(stride),batches,rp);
AscendC::PipeBarrier<PIPE_V>();const uint32_t total=count*batches*np;
for(uint32_t i=0;i<total;i+=128)AscendC::WholeReduceSum(dots[i],prod[i*stride],uint64_t(stride),total-i<128?total-i:128,1,1,stride/8);
AscendC::PipeBarrier<PIPE_V>();for(uint32_t rr=0;rr<count;++rr)
AscendC::WholeReduceMax(rows[rr*8],dots[rr*batches*np],uint64_t(s.n),batches,1,1,np/8,AscendC::ReduceOrder::ORDER_ONLY_VALUE);
AscendC::PipeBarrier<PIPE_V>();for(uint32_t rr=0;rr<count;++rr){
AscendC::Add(y,y,rows[rr*8],batches);AscendC::PipeBarrier<PIPE_V>();}
}oq.EnQue(y);y=oq.DeQue<float>();
AscendC::DataCopyExtParams cp{1,batches*4,0,0,0};AscendC::DataCopyPad(out[b0],y,cp);oq.FreeTensor(y);}
template<typename T>__schedmode__(1)__global__ __vector__ void bmmms_tiny_tt_vector(
GM_ADDR x1,GM_ADDR x2,GM_ADDR output,Schedule s){
AscendC::TPipe pipe;const uint32_t kp=(s.k+15)/16*16,groups=(s.k+63)/64;
const uint32_t stride=s.k<=128?128:256,shift=s.k<=128?7:8;const uint32_t np=(s.n+7)/8*8,ae=s.m*stride;
const uint32_t ac=(s.m*s.k+15)/16*16,be=s.n*kp;const uint32_t rawCount=ac>ae?ac:ae,products=groups*2*np*64;
AscendC::GlobalTensor<T>a,b;AscendC::GlobalTensor<float>out;
a.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x1),s.b*s.m*s.k);b.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x2),s.b*s.n*s.k);
out.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(output),s.b);AscendC::TQue<AscendC::TPosition::VECIN,1>aq,bq;
AscendC::TQue<AscendC::TPosition::VECOUT,1>oq;AscendC::TBuf<AscendC::TPosition::VECCALC>rawBuf,faBuf,fbBuf,indexBuf;
AscendC::TBuf<AscendC::TPosition::VECCALC>prodBuf,dotBuf,rowBuf;pipe.InitBuffer(aq,1,ac*2);pipe.InitBuffer(bq,1,be*2);
pipe.InitBuffer(oq,1,32);pipe.InitBuffer(rawBuf,rawCount*4);pipe.InitBuffer(faBuf,ae*4);pipe.InitBuffer(fbBuf,be*4);
pipe.InitBuffer(indexBuf,ae*4);pipe.InitBuffer(prodBuf,products*4);
pipe.InitBuffer(dotBuf,2*np*4);pipe.InitBuffer(rowBuf,(2*s.m+7)/8*8*4);auto raw=rawBuf.Get<float>(),fa=faBuf.Get<float>(),fb=fbBuf.Get<float>();
auto index=indexBuf.Get<int32_t>();auto prod=prodBuf.Get<float>(),dots=dotBuf.Get<float>(),rows=rowBuf.Get<float>();
MicroIndices<true>(index,fa.ReinterpretCast<int32_t>(),raw.ReinterpretCast<int32_t>(),ae,s.m,s.k,shift);
for(int64_t batch=AscendC::GetBlockIdx();batch<s.b;batch+=s.workers){auto la=aq.AllocTensor<T>(),lb=bq.AllocTensor<T>();
AscendC::DataCopyExtParams ap{1,static_cast<uint32_t>(s.m*s.k*2),0,0,0};
AscendC::DataCopyPadExtParams<T>pa{true,0,static_cast<uint8_t>(ac-s.m*s.k),T(0)};
AscendC::DataCopyExtParams bp{static_cast<uint16_t>(s.n),static_cast<uint32_t>(s.k*2),0,0,0};
AscendC::DataCopyPadExtParams<T>pb{true,0,static_cast<uint8_t>(kp-s.k),T(0)};AscendC::DataCopyPad(la,a[batch*s.m*s.k],ap,pa);
AscendC::DataCopyPad(lb,b[batch*s.n*s.k],bp,pb);aq.EnQue(la);bq.EnQue(lb);la=aq.DeQue<T>();lb=bq.DeQue<T>();
AscendC::Cast(raw,la,AscendC::RoundMode::CAST_NONE,ac);AscendC::Cast(fb,lb,AscendC::RoundMode::CAST_NONE,be);
AscendC::Duplicate(prod,0.0f,products);AscendC::Duplicate(rows,0.0f,(2*s.m+7)/8*8);
AscendC::PipeBarrier<PIPE_V>();aq.FreeTensor(la);bq.FreeTensor(lb);AscendC::Gather(fa,raw,index.ReinterpretCast<uint32_t>(),0,ae);
AscendC::PipeBarrier<PIPE_V>();const AscendC::BinaryRepeatParams rp{1,1,1,8,0,static_cast<uint8_t>(kp/8)};
for(uint32_t m=0;m<s.m;m+=2){const uint32_t countM=s.m-m<2?s.m-m:2;
for(uint32_t g=0;g<groups;++g){const uint32_t count=s.k-g*64<64?s.k-g*64:64;
for(uint32_t r=0;r<countM;++r)AscendC::Mul(prod[(g*2+r)*np*64],fa[(m+r)*stride+g*64],fb[g*64],
uint64_t(count),s.n,rp);}
AscendC::PipeBarrier<PIPE_V>();for(uint32_t g=1;g<groups;++g){
AscendC::Add(prod,prod,prod[g*2*np*64],countM*np*64);AscendC::PipeBarrier<PIPE_V>();
}AscendC::WholeReduceSum(dots,prod,uint64_t(64),countM*np,1,1,8);
AscendC::PipeBarrier<PIPE_V>();AscendC::WholeReduceMax(rows[2*m],dots,uint64_t(s.n),countM,2,1,np/8,
AscendC::ReduceOrder::ORDER_ONLY_VALUE);AscendC::PipeBarrier<PIPE_V>();
}auto y=oq.AllocTensor<float>();
AscendC::WholeReduceSum(y,rows,uint64_t(2*s.m),1,1,1,8);oq.EnQue(y);y=oq.DeQue<float>();
AscendC::DataCopyExtParams cp{1,sizeof(float),0,0,0};AscendC::DataCopyPad(out[batch],y,cp);oq.FreeTensor(y);
}}
template<typename T,bool TX1,bool TX2>__schedmode__(1)__global__ __vector__ void bmmms_small_gemm_contiguous(
GM_ADDR x1,GM_ADDR x2,GM_ADDR output,GM_ADDR partial,Schedule s){
AscendC::TPipe pipe;const uint32_t stride=s.k<=32?32:64;
const uint32_t shift=s.k<=32?5:6;const uint32_t np=(s.n+7)/8*8;
