out.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(output),s.b);AscendC::TQue<AscendC::TPosition::VECIN,1>inQueue;
AscendC::TQue<AscendC::TPosition::VECOUT,1>outQueue;AscendC::TBuf<AscendC::TPosition::VECCALC>maxBuf,tmpBuf,resultBuf;
