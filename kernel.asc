template<typename T,bool SINGLE_AIV>__aicore__ inline void WideNFrameCompute(
GM_ADDR x1,GM_ADDR x2,GM_ADDR partial,GM_ADDR output,WideNKernelShape s){
AscendC::SetAtomicNone();AscendC::SetMaskNorm();AscendC::ResetMask();
#ifdef __DAV_CUBE__
const uint32_t worker=AscendC::GetBlockIdx();
#else
const uint32_t worker=SINGLE_AIV?AscendC::GetBlockIdx():AscendC::GetBlockIdx()/2;const uint32_t sub=SINGLE_AIV?0:AscendC::GetBlockIdx()%2;
#endif
const uint32_t oneC=s.mp*s.np,width=2*s.np,slotSize=2*oneC;const uint32_t begin=worker*s.nTiles/s.nSplit,end=(worker+1)*s.nTiles/s.nSplit;
