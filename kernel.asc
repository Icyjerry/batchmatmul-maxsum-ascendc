}else if constexpr(TX1){
lp.srcStride=1;
if(residentA){
if((s.tree&2)&&rows>count){
lp.repeatTimes=rows/16;lp.srcStride=s.k/16;lp.dstGap=count/16-1;
for(uint32_t ki=0;ki<count/16;++ki)
AscendC::LoadData(a2[ki*256],a1[k0*16+ki*256],lp);
}else{
lp.repeatTimes=count/16;
for(uint32_t mi=0;mi<rows/16;++mi)
AscendC::LoadData(a2[mi*count*16],a1[mi*s.k*16+k0*16],lp);
}
}else{
lp.repeatTimes=rows*count/256;AscendC::LoadData(a2,a1,lp);
}
}else{
if((s.tree&2)&&rows>count){
lp.repeatTimes=rows/16;lp.srcStride=1;lp.dstGap=count/16-1;
for(uint32_t ki=0;ki<count/16;++ki)
AscendC::LoadData(a2[ki*256],a1[ki*rows*16+(residentA?k0*rows:0)],lp);
}else{
lp.repeatTimes=count/16;lp.srcStride=rows/16;
for(uint32_t mi=0;mi<rows/16;++mi)AscendC::LoadData(a2[mi*count*16],a1[mi*256+(residentA?k0*rows:0)],lp);
