auto x=aq.AllocTensor<T>();if(count<width){
AscendC::Duplicate(x.template ReinterpretCast<uint16_t>(),uint16_t(0),kr*width);Fence<AscendC::HardEvent::V_MTE2>();
}const int64_t offset=(int64_t(batch)*s.k+k0)*s.m+m0;
