#include <cmath>
#include "kernel_operator.h"
/*
 * BatchMatmulMaxSum Kernel — Ascend C Direct Invocation
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *   Usage: info_x.tensors[0].shape[0]  // first dim of first tensor in input x
 *
 * v0.2: single-dot fast path; general shapes still use the Vector fallback.
 * Public API references checked; compilation against the server CANN is pending.
 * Each batch has one writer. No workspace, atomics, or GM intermediates.
 */

namespace batch_matmul_max_sum_v0 {
constexpr int32_t K_TILE = 256;

// Fixed reduction order, with FP32 compensation across K tiles and M rows.
__aicore__ inline void Accumulate(float value, float& sum, float& correction)
{
    const float adjusted = value - correction;
    const float next = sum + adjusted;
    correction = (next - sum) - adjusted;
    sum = next;
}

template <typename T>
class Kernel {
public:
    __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
        int64_t batches, int64_t m, int64_t n, int64_t k, bool tx1, bool tx2)
    {
        batches_ = batches;
        m_ = m;
        n_ = n;
        k_ = k;
        aRowStride_ = tx1 ? 1 : k;
        aKStride_ = tx1 ? m : 1;
        bColStride_ = tx2 ? k : 1;
        bKStride_ = tx2 ? 1 : n;
        aGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x1), batches * m * k);
        bGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x2), batches * k * n);
        yGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y), batches);

        // 5184 bytes of UB for either input dtype, independent of B/M/N/K.
        pipe_.InitBuffer(aBuf_, K_TILE * sizeof(T));
        pipe_.InitBuffer(bBuf_, K_TILE * sizeof(T));
        pipe_.InitBuffer(aFloatBuf_, K_TILE * sizeof(float));
        pipe_.InitBuffer(bFloatBuf_, K_TILE * sizeof(float));
        pipe_.InitBuffer(productBuf_, K_TILE * sizeof(float));
        pipe_.InitBuffer(scratchBuf_, K_TILE * sizeof(float));
        pipe_.InitBuffer(reducedBuf_, 32);
        pipe_.InitBuffer(outputBuf_, 32);
    }

    __aicore__ inline void Process()
    {
        auto output = outputBuf_.Get<float>();
        for (int64_t b = AscendC::GetBlockIdx(); b < batches_; b += AscendC::GetBlockNum()) {
            float total = 0.0f;
            float correction = 0.0f;
            for (int64_t m = 0; m < m_; ++m) {
                const int64_t aOffset = b * m_ * k_ + m * aRowStride_;
                const int64_t bOffset = b * k_ * n_;
                // The first VALID dot product initializes MaxSim, including negative rows.
                float rowMax = Dot(aOffset, bOffset);
                for (int64_t n = 1; n < n_; ++n) {
                    const float dot = Dot(aOffset, bOffset + n * bColStride_);
                    rowMax = dot > rowMax ? dot : rowMax;
                }
                Accumulate(rowMax, total, correction);
            }
            output.SetValue(0, total);
            Sync<AscendC::HardEvent::S_MTE3>();
            // y has exactly B floats: never round this GM write up to 32 bytes.
            const AscendC::DataCopyExtParams copy{1, sizeof(float), 0, 0, 0};
            AscendC::DataCopyPad(yGm_[b], output, copy);
            Sync<AscendC::HardEvent::MTE3_S>();
        }
    }

private:
    template <AscendC::HardEvent event>
    __aicore__ inline void Sync()
    {
        const int32_t id = static_cast<int32_t>(pipe_.FetchEventID(event));
        AscendC::SetFlag<event>(id);
        AscendC::WaitFlag<event>(id);
    }

    __aicore__ inline void Load(const AscendC::LocalTensor<T>& dst,
        const AscendC::GlobalTensor<T>& src, int64_t offset, int64_t stride, int32_t count)
    {
        if (stride == 1) {
            const AscendC::DataCopyExtParams copy{
                1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
            const AscendC::DataCopyPadExtParams<T> pad{false, 0, 0, 0};
            AscendC::DataCopyPad(dst, src[offset], copy, pad);
            Sync<AscendC::HardEvent::MTE2_V>();
        } else {
            // Correctness fallback for strided storage; no GM transpose buffer.
            for (int32_t i = 0; i < count; ++i) {
                dst.SetValue(i, src.GetValue(offset + static_cast<int64_t>(i) * stride));
            }
        }
    }

    __aicore__ inline float Dot(int64_t aOffset, int64_t bOffset)
    {
        auto a = aBuf_.template Get<T>();
        auto b = bBuf_.template Get<T>();
        auto af = aFloatBuf_.Get<float>();
        auto bf = bFloatBuf_.Get<float>();
        auto product = productBuf_.Get<float>();
        auto scratch = scratchBuf_.Get<float>();
        auto reduced = reducedBuf_.Get<float>();
        float sum = 0.0f;
        float correction = 0.0f;
        for (int64_t k = 0; k < k_; k += K_TILE) {
            const int32_t count = static_cast<int32_t>(k_ - k < K_TILE ? k_ - k : K_TILE);
            Load(a, aGm_, aOffset + k * aKStride_, aKStride_, count);
            Load(b, bGm_, bOffset + k * bKStride_, bKStride_, count);
            Sync<AscendC::HardEvent::S_V>();
            AscendC::Cast(af, a, AscendC::RoundMode::CAST_NONE, count);
            AscendC::Cast(bf, b, AscendC::RoundMode::CAST_NONE, count);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Mul(product, af, bf, count);
            AscendC::PipeBarrier<PIPE_V>();
            // Reduce only valid K elements; DMA padding is never consumed.
            AscendC::ReduceSum(reduced, product, scratch, count);
            Sync<AscendC::HardEvent::V_S>();
            Accumulate(reduced.GetValue(0), sum, correction);
            // V_S also completes all reads before the next tile reuses UB.
        }
        return sum;
    }

    AscendC::TPipe pipe_;
    AscendC::TBuf<AscendC::TPosition::VECIN> aBuf_, bBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> aFloatBuf_, bFloatBuf_, productBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> scratchBuf_, reducedBuf_;
    AscendC::TBuf<AscendC::TPosition::VECOUT> outputBuf_;
    AscendC::GlobalTensor<T> aGm_, bGm_;
    AscendC::GlobalTensor<float> yGm_;
    int64_t batches_, m_, n_, k_;
    int64_t aRowStride_, aKStride_, bColStride_, bKStride_;
};
} // namespace batch_matmul_max_sum_v0

// M=N=1: both storage layouts are contiguous vectors. Keep the entire dot
// product in UB and use a tree reduction, with no per-256-element scalar waits.
template <typename T>
__global__ __vector__ void batch_matmul_max_sum_dot(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
    int64_t batches, int32_t k)
{
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> aQueue, bQueue;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueue;
    AscendC::TBuf<AscendC::TPosition::VECCALC> afBuf, bfBuf, productBuf, partialBuf, workBuf;
    const int32_t paddedK = (k + 63) / 64 * 64;
    pipe.InitBuffer(aQueue, 1, paddedK * sizeof(T));
    pipe.InitBuffer(bQueue, 1, paddedK * sizeof(T));
    pipe.InitBuffer(outQueue, 1, 32);
    pipe.InitBuffer(afBuf, paddedK * sizeof(float));
    pipe.InitBuffer(bfBuf, paddedK * sizeof(float));
    pipe.InitBuffer(productBuf, paddedK * sizeof(float));
    pipe.InitBuffer(partialBuf, 512);
    pipe.InitBuffer(workBuf, 512);
    AscendC::GlobalTensor<T> aGm, bGm;
    AscendC::GlobalTensor<float> yGm;
    aGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x1), batches * k);
    bGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x2), batches * k);
    yGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y), batches);
    auto af = afBuf.Get<float>();
    auto bf = bfBuf.Get<float>();
    auto product = productBuf.Get<float>();
    auto partial = partialBuf.Get<float>();
    auto work = workBuf.Get<float>();
    const AscendC::DataCopyExtParams inputCopy{1, static_cast<uint32_t>(k * sizeof(T)), 0, 0, 0};
    const AscendC::DataCopyPadExtParams<T> pad{false, 0, 0, 0};
    const AscendC::DataCopyExtParams outputCopy{1, sizeof(float), 0, 0, 0};
    for (int64_t b = AscendC::GetBlockIdx(); b < batches; b += AscendC::GetBlockNum()) {
        auto a = aQueue.AllocTensor<T>();
        auto bb = bQueue.AllocTensor<T>();
        AscendC::DataCopyPad(a, aGm[b * k], inputCopy, pad);
        AscendC::DataCopyPad(bb, bGm[b * k], inputCopy, pad);
        aQueue.EnQue(a);
        bQueue.EnQue(bb);
        a = aQueue.DeQue<T>();
        bb = bQueue.DeQue<T>();
        AscendC::Cast(af, a, AscendC::RoundMode::CAST_NONE, k);
        AscendC::Cast(bf, bb, AscendC::RoundMode::CAST_NONE, k);
        if (paddedK != k) {
            AscendC::Duplicate(product, 0.0f, paddedK);
        }
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Mul(product, af, bf, k);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::WholeReduceSum(partial, product, 64, paddedK / 64, 1, 1, 8);
        AscendC::PipeBarrier<PIPE_V>();
        auto result = outQueue.AllocTensor<float>();
        AscendC::ReduceSum(result, partial, work, paddedK / 64);
        aQueue.FreeTensor(a);
        bQueue.FreeTensor(bb);
        outQueue.EnQue(result);
        result = outQueue.DeQue<float>();
        AscendC::DataCopyPad(yGm[b], result, outputCopy);
        outQueue.FreeTensor(result);
        // The next batch reuses af/bf/product/partial, which are not queues.
        AscendC::PipeBarrier<PIPE_V>();
    }
}

template <typename T>
__global__ __vector__ void batch_matmul_max_sum_custom(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
    int64_t batches, int64_t m, int64_t n, int64_t k, bool tx1, bool tx2)
{
    batch_matmul_max_sum_v0::Kernel<T> op;
    op.Init(x1, x2, y, batches, m, n, k, tx1, tx2);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1, GM_ADDR x2, const TensorGroupInfo& info_x2, GM_ADDR y, const TensorGroupInfo& info_y, int64_t availableCoreNum, aclrtStream stream,
    bool transposeX1,
    bool transposeX2)
{
    const auto& a = info_x1.tensors[0];
    const auto& b = info_x2.tensors[0];
    const int64_t batches = a.shape[0];
    const int64_t m = a.shape[transposeX1 ? 2 : 1];
    const int64_t k = a.shape[transposeX1 ? 1 : 2];
    const int64_t n = b.shape[transposeX2 ? 1 : 2];
    const int64_t cores = availableCoreNum > 0 ? availableCoreNum : 1;
    const uint32_t blockNum = static_cast<uint32_t>(batches < cores ? batches : cores);
    (void)info_y;

    if (m == 1 && n == 1) {
        if (a.dtype == 1) {
            batch_matmul_max_sum_dot<half><<<blockNum, nullptr, stream>>>(x1, x2, y, batches, k);
        } else if (a.dtype == 2) {
            batch_matmul_max_sum_dot<bfloat16_t><<<blockNum, nullptr, stream>>>(x1, x2, y, batches, k);
        }
        return;
    }

    if (a.dtype == 1) {
        batch_matmul_max_sum_custom<half><<<blockNum, nullptr, stream>>>(
            x1, x2, y, batches, m, n, k, transposeX1, transposeX2);
    } else if (a.dtype == 2) {
        batch_matmul_max_sum_custom<bfloat16_t><<<blockNum, nullptr, stream>>>(
            x1, x2, y, batches, m, n, k, transposeX1, transposeX2);
    }
}
