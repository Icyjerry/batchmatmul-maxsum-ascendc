for(uint32_t i=0;i<2;++i)AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(i);SingleTileDirectFence<true,AscendC::HardEvent::V_MTE3>();
AscendC::DataCopy(parts[worker*s.mp+rowStart],maxima,halfM);AscendC::SyncAll<true>();
if(worker==0&&sub==0){auto all=AscendC::LocalTensor<float>(AscendC::TPosition::VECCALC,0,s.nSplit*s.mp);
