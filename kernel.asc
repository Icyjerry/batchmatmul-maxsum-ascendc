std::min<int64_t>(platform->GetCoreNumAic(),platform->GetCoreNumAiv()/2));
if(cores>0&&2ULL*bm*kp+b1+4096<=l1&&4ULL*bm*bk<=l0a&&
4ULL*bn*bk<=l0b&&8ULL*bm*bn<=l0c&&vectorBytes<ub){
d.dual=33;d.baseM=bm;d.mTiles=Ceil(s.m,bm);d.nSplit=d.nTiles;d.window=1;
const uint64_t available=(std::min<uint64_t>(l1,512ULL*1024)-2ULL*bm*kp)/(4ULL*bn);
d.kChunk=std::min<uint64_t>(Ceil(s.k,bk)*bk,available/bk*bk);
d.workers=std::min<int64_t>(cores,int64_t(d.mTiles)*d.nTiles);
p.cubeBlocks=d.workers;p.cube.usedCoreNum=d.workers;
const uint64_t partialBytes=4ULL*d.mTiles*d.baseM*d.nSplit;
p.totalBytes=p.systemBytes+Ceil(partialBytes,512)*512+
8ULL*d.workers*d.baseM*d.baseN;
}
}
if(!fullMPinned&&s.b==1&&(s.dtype==1||s.dtype==2)&&
s.m>=1024&&s.m<8192&&s.n>=512&&s.n<4096&&
s.k>=512&&s.k<4096&&s.m%16==0&&s.n%16==0&&s.k%16==0&&
p.schedule.kSplit==1&&!p.schedule.earlySum&&
(p.schedule.dual==1||p.schedule.dual==2||p.schedule.dual==20||
p.schedule.dual==29||p.schedule.dual==35)){
auto*plat=platform_ascendc::PlatformAscendCManager::GetInstance();
uint64_t l1=0,l0a=0,l0b=0,l0c=0,ub=0;
plat->GetCoreMemSize(platform_ascendc::CoreMemType::L1,l1);
plat->GetCoreMemSize(platform_ascendc::CoreMemType::L0_A,l0a);
plat->GetCoreMemSize(platform_ascendc::CoreMemType::L0_B,l0b);
plat->GetCoreMemSize(platform_ascendc::CoreMemType::L0_C,l0c);
plat->GetCoreMemSize(platform_ascendc::CoreMemType::UB,ub);
l1=std::min<uint64_t>(l1,512ULL*1024);
constexpr uint32_t bn=128,bk=128;
uint32_t bm=128;const uint64_t kp=Ceil(s.k,16)*16,b1=4ULL*bn*bk;
while(bm>64&&(2ULL*bm*kp+b1+4096>l1||4ULL*bm*bk>l0a||8ULL*bm*bn>l0c))bm-=16;
const uint64_t chunks=Ceil(s.m,bm/2);
const uint64_t mergeBytes=8ULL*bm+64+chunks*32+Ceil(chunks,8)*32;
const uint64_t vectorBytes=4ULL*bm*bn+20ULL*bm+mergeBytes+4096;
const int64_t cores=std::min<int64_t>(availableCoreNum,
std::min<int64_t>(plat->GetCoreNumAic(),plat->GetCoreNumAiv()/2));
if(cores>0&&bm==128&&2ULL*bm*kp+2*b1+4096<=l1&&
4ULL*bm*bk<=l0a&&4ULL*bn*bk<=l0b&&8ULL*bm*bn<=l0c&&vectorBytes<ub){
const int64_t mt=Ceil(s.m,bm),nt=Ceil(s.n,bn);
uint32_t split=1;uint64_t peakBest=uint64_t(-1),copyBest=uint64_t(-1);
for(uint32_t ns=1;ns<=nt;++ns){
const int64_t tasks=mt*ns,w=std::min<int64_t>(cores,tasks);
uint64_t peak=0,copies=0;
for(int64_t wi=0;wi<w;++wi){
const int64_t first=tasks*wi/w,last=tasks*(wi+1)/w;
const int64_t t0=(first/ns)*nt+(first%ns)*nt/ns;
const int64_t t1=(last/ns)*nt+(last%ns)*nt/ns;
peak=std::max<uint64_t>(peak,t1-t0);
copies+=(last-1)/ns-first/ns+1;
}
if(peak<peakBest||(peak==peakBest&&copies<copyBest)){
peakBest=peak;copyBest=copies;split=ns;
}
}
auto&d=p.schedule;
d.dual=36;d.baseM=bm;d.baseN=bn;d.mTiles=mt;d.nTiles=nt;d.nSplit=split;
d.window=std::min<uint32_t>(4,Ceil(nt,split));
const uint64_t maxK=(l1-2ULL*bm*kp-4096)/(4ULL*bn);
d.kChunk=std::min<uint64_t>(Ceil(s.k,bk)*bk,maxK/bk*bk);
d.workers=std::min<int64_t>(cores,mt*split);
p.cubeBlocks=d.workers;p.cube.usedCoreNum=d.workers;
p.cube.baseM=bm;p.cube.baseN=bn;p.cube.baseK=bk;
const uint64_t parts=4ULL*mt*bm*split;
p.totalBytes=p.systemBytes+Ceil(parts,512)*512+8ULL*d.workers*bm*bn*d.window;
}
}
bool oneShardPinned=fullMPinned;
#ifdef BMMMS_TUNING
oneShardPinned=oneShardPinned||Tune().group>=0||Tune().rows>0;
#endif
if(!oneShardPinned&&s.b==1&&(s.dtype==1||s.dtype==2)&&
!(s.tx1&&!s.tx2)&&
s.m>=1024&&s.m<2048&&s.n>=1024&&s.n<2048&&
s.k>=1024&&s.k<2048&&s.k%8==0&&
p.schedule.kSplit==1&&!p.schedule.earlySum&&!p.schedule.tree&&
(p.schedule.dual==1||p.schedule.dual==2||p.schedule.dual==29||
p.schedule.dual==33||p.schedule.dual==35)&&p.systemBytes&&
p.schedule.b==s.b&&p.schedule.m==s.m&&
p.schedule.n==s.n&&p.schedule.k==s.k){
auto*plat=platform_ascendc::PlatformAscendCManager::GetInstance();
uint64_t l1=0,l0a=0,l0b=0,l0c=0,ub=0;
plat->GetCoreMemSize(platform_ascendc::CoreMemType::L1,l1);
plat->GetCoreMemSize(platform_ascendc::CoreMemType::L0_A,l0a);
plat->GetCoreMemSize(platform_ascendc::CoreMemType::L0_B,l0b);
plat->GetCoreMemSize(platform_ascendc::CoreMemType::L0_C,l0c);
plat->GetCoreMemSize(platform_ascendc::CoreMemType::UB,ub);
l1=std::min<uint64_t>(l1,512ULL*1024);
constexpr uint32_t bm=128,bn=128,bk=128;
const int64_t mt=Ceil(s.m,bm),nt=Ceil(s.n,bn);
const int64_t cores=std::min<int64_t>(availableCoreNum,
std::min<int64_t>(plat->GetCoreNumAic(),plat->GetCoreNumAiv()/2));
const uint64_t aBytes=2ULL*bm*Ceil(s.k,16)*16,bBytes=4ULL*bn*bk;
const uint64_t chunks=Ceil(s.m,bm/2);
const uint64_t vectorBytes=4ULL*bm*bn+28ULL*bm+64+
chunks*32+Ceil(chunks,8)*32+4096;
if(cores>=mt&&aBytes+bBytes+4096<=l1&&
4ULL*bm*bk<=std::min<uint64_t>(l0a,65536)&&
bBytes<=std::min<uint64_t>(l0b,65536)&&
8ULL*bm*bn<=std::min<uint64_t>(l0c,131072)&&vectorBytes<=ub){
const uint32_t ns=std::min<int64_t>(nt,cores/mt);
const uint32_t packetK=std::min<uint64_t>(3*bk,(l1-aBytes-4096)/(4ULL*bn)/bk*bk);
if(ns&&packetK>=bk&&packetK%bk==0){
auto&d=p.schedule;
d.dual=36;d.baseM=bm;d.baseN=bn;d.mTiles=mt;d.nTiles=nt;
d.nSplit=ns;d.workers=mt*ns;d.window=std::min<uint32_t>(4,Ceil(nt,ns));
d.kChunk=packetK;p.cubeBlocks=d.workers;p.cube.usedCoreNum=d.workers;
p.cube.baseM=bm;p.cube.baseN=bn;p.cube.baseK=bk;p.cube.stepM=1;p.cube.stepN=1;
const uint64_t parts=4ULL*mt*bm*ns;
p.totalBytes=p.systemBytes+Ceil(parts,512)*512+8ULL*d.workers*bm*bn*d.window;
}
}
}
bool ttMdlPinned=oneShardPinned;
#ifdef BMMMS_TUNING
const auto&ttTune=Tune();
ttMdlPinned=ttMdlPinned||ttTune.bm||ttTune.bn||ttTune.window||
ttTune.ns||ttTune.ks||ttTune.workers;
#endif
if(!ttMdlPinned&&s.b==1&&(s.dtype==1||s.dtype==2)&&s.tx1&&s.tx2&&
s.k==2048&&s.m>=1024&&s.m<8192&&s.n>=512&&s.n<4096){
auto&d=p.schedule;auto&t=p.cube;
if(d.dual==2&&d.kSplit==1&&!d.earlySum&&!d.tree&&
d.baseM==128&&d.baseN==256&&t.baseK==64&&
t.baseM==128&&t.baseN==256&&t.stepM==1&&t.stepN==1&&
t.stepKa==2&&t.depthA1==4&&t.stepKb==4&&t.depthB1==8&&
t.dbL0A==2&&t.dbL0B==2&&t.dbL0C==1&&
t.M==s.m&&t.N==s.n&&t.Ka==s.k&&t.Kb==s.k&&
!t.isBias&&!t.transLength&&!t.shareMode&&!t.shareUbSize){
uint64_t l1=0;
platform_ascendc::PlatformAscendCManager::GetInstance()->GetCoreMemSize(
platform_ascendc::CoreMemType::L1,l1);
l1=std::min<uint64_t>(l1,512ULL*1024);
constexpr uint32_t group=4;
const uint64_t aFrame=2ULL*d.baseM*t.baseK*group;
const uint64_t bFrame=2ULL*d.baseN*t.baseK*group;
if(aFrame+bFrame+4096<=l1/2){
t.stepKa=group;t.stepKb=group;
t.depthA1=2*group;t.depthB1=2*group;
t.shareL1Size=2*(aFrame+bFrame);
}
}
}
if(!ttMdlPinned&&s.b==1&&(s.dtype==1||s.dtype==2)&&s.tx1&&s.tx2&&
s.k==2048&&s.m>=1024&&s.m<8192&&s.n>=512&&s.n<4096&&
s.m%256==0&&s.n%256==0){
auto&d=p.schedule;auto&t=p.cube;
const uint64_t oldParts=Ceil(uint64_t(s.b)*d.nSplit*d.mTiles*d.baseM*4,512)*512;
const uint64_t oldRing=8ULL*d.workers*d.baseM*d.baseN*d.window;
if(d.dual==2&&d.kSplit==1&&d.kChunk==s.k&&!d.earlySum&&!d.tree&&
d.balance==1&&d.window==1&&d.nSplit==d.nTiles&&
d.b==s.b&&d.m==s.m&&d.n==s.n&&d.k==s.k&&
d.baseM==128&&d.baseN==256&&d.mTiles==s.m/128&&d.nTiles==s.n/256&&
d.workers>0&&d.workers==p.cubeBlocks&&t.usedCoreNum==d.workers&&
t.baseM==128&&t.baseN==256&&t.baseK==64&&
t.singleCoreM==128&&t.singleCoreK==s.k&&t.singleCoreN>=256&&
t.singleCoreN<=std::min<int64_t>(s.n,8*256)&&t.singleCoreN%256==0&&
t.stepM==1&&t.stepN==1&&t.stepKa==4&&t.stepKb==4&&
t.depthA1==8&&t.depthB1==8&&t.dbL0A==2&&t.dbL0B==2&&t.dbL0C==1&&
t.M==s.m&&t.N==s.n&&t.Ka==s.k&&t.Kb==s.k&&
!t.isBias&&!t.transLength&&!t.shareMode&&!t.shareUbSize&&
t.shareL1Size==393216&&p.totalBytes==p.systemBytes+oldParts+oldRing){
auto*plat=platform_ascendc::PlatformAscendCManager::GetInstance();
uint64_t l1=0,l0a=0,l0b=0,l0c=0,ub=0;
plat->GetCoreMemSize(platform_ascendc::CoreMemType::L1,l1);
plat->GetCoreMemSize(platform_ascendc::CoreMemType::L0_A,l0a);
plat->GetCoreMemSize(platform_ascendc::CoreMemType::L0_B,l0b);
plat->GetCoreMemSize(platform_ascendc::CoreMemType::L0_C,l0c);
plat->GetCoreMemSize(platform_ascendc::CoreMemType::UB,ub);
constexpr uint32_t bm=256,bn=128,bk=64,group=4;
constexpr uint64_t aFrame=2ULL*bm*bk*group,bFrame=2ULL*bn*bk*group;
constexpr uint64_t aL0=4ULL*bm*bk,bL0=4ULL*bn*bk,cL0=4ULL*bm*bn;
const uint64_t vectorBytes=4ULL*bm*bn+12ULL*bm+32+
3ULL*d.vectorTile*4+64;
const uint32_t mt=s.m/bm,nt=s.n/bn;
const uint64_t tasks=uint64_t(s.b)*mt*nt;
const int64_t cores=std::min<int64_t>(availableCoreNum,
std::min<int64_t>(plat->GetCoreNumAic(),plat->GetCoreNumAiv()/2));
if(d.workers==std::min<uint64_t>(cores>0?cores:0,tasks)&&
aFrame+bFrame+4096<=std::min<uint64_t>(l1,512ULL*1024)/2&&
aL0<=std::min<uint64_t>(l0a,65536)&&bL0<=std::min<uint64_t>(l0b,65536)&&
cL0<=std::min<uint64_t>(l0c,131072)&&vectorBytes+4096<=ub){
d.baseM=bm;d.baseN=bn;d.mTiles=mt;d.nTiles=nt;d.nSplit=nt;
t.baseM=bm;t.baseN=bn;t.baseK=bk;
t.singleCoreM=bm;t.singleCoreN=bn;t.singleCoreK=s.k;
t.stepM=1;t.stepN=1;t.stepKa=group;t.stepKb=group;
t.depthA1=2*group;t.depthB1=2*group;
t.dbL0A=2;t.dbL0B=2;t.dbL0C=1;
t.shareL1Size=2*(aFrame+bFrame);t.shareL0CSize=cL0;
const uint64_t parts=Ceil(uint64_t(s.b)*nt*mt*bm*4,512)*512;
p.totalBytes=p.systemBytes+parts+8ULL*d.workers*bm*bn;
}
}
}
return p;
}
struct Case9PackagePlan{bool safe=false,resident=false;uint32_t aK=0,bK=0;};
inline Case9PackagePlan MakeCase9PackagePlan(const Shape&s,const Plan&p)
{
Case9PackagePlan q;
auto*plat=platform_ascendc::PlatformAscendCManager::GetInstance();
uint64_t l1=0,l0a=0,l0b=0,l0c=0,ub=0;
plat->GetCoreMemSize(platform_ascendc::CoreMemType::L1,l1);
plat->GetCoreMemSize(platform_ascendc::CoreMemType::L0_A,l0a);
plat->GetCoreMemSize(platform_ascendc::CoreMemType::L0_B,l0b);
plat->GetCoreMemSize(platform_ascendc::CoreMemType::L0_C,l0c);
plat->GetCoreMemSize(platform_ascendc::CoreMemType::UB,ub);
const auto&d=p.schedule;const auto&t=p.cube;
if(!d.baseM||!d.baseN||d.baseM>128||d.baseN>256||d.window<1||d.workers!=p.cubeBlocks||
!d.nSplit||d.nSplit>d.nTiles||d.kSplit!=1||
d.mTiles!=Ceil(s.m,d.baseM)||d.nTiles!=Ceil(s.n,d.baseN))return q;
const uint32_t bk=d.kChunk;
if(!bk||bk%16)return q;
const uint64_t aL0=uint64_t(d.baseM)*bk*4,bL0=uint64_t(d.baseN)*bk*4;
const uint64_t oneC=uint64_t(d.baseM)*d.baseN*4;
const uint64_t cBytes=oneC*(2*oneC<=131072?2:1);
const uint64_t vectorBytes=oneC+20ULL*d.baseM+3ULL*d.vectorTile*4+64;
const uint64_t partBytes=Ceil(s.b*d.nSplit*d.mTiles*d.baseM*4,512)*512;
const uint64_t ringBytes=uint64_t(d.workers)*2*d.baseM*d.baseN*d.window*4;
if(aL0>l0a||bL0>l0b||cBytes>l0c||vectorBytes+1024>ub||
p.totalBytes<p.systemBytes+partBytes+ringBytes)return q;
const uint32_t maxPackage=Ceil(s.k,bk)*bk;
const int64_t nativeA=int64_t(t.baseK)*std::max<int64_t>(1,t.stepKa);
const int64_t nativeB=int64_t(t.baseK)*std::max<int64_t>(1,t.stepKb);
const uint32_t desiredA=std::min<uint32_t>(maxPackage,std::max<int64_t>(2*bk,Ceil(nativeA,bk)*bk));
const uint32_t desiredB=std::min<uint32_t>(maxPackage,std::max<int64_t>(2*bk,Ceil(nativeB,bk)*bk));
const uint64_t limit=std::min<uint64_t>(l1,512ULL*1024);
const uint64_t fullA=uint64_t(d.baseM)*Ceil(s.k,16)*16*2;
uint32_t bp=desiredB;
while(bp>bk&&fullA+uint64_t(d.baseN)*bp*4>limit)bp-=bk;
if(fullA+uint64_t(d.baseN)*bp*4<=limit){
q.safe=true;q.resident=true;q.aK=desiredA;q.bK=bp;return q;
}
return q;
}
inline bool UseCase10IssuePlan(const Shape&s,const Plan&p)
{
const auto&d=p.schedule;
if(s.b!=1||s.dtype!=2||s.tx1||s.tx2||
s.m<4096||s.m>=8192||s.n<1024||s.n>=2048||
s.k<1024||s.k>=2048||s.k%16||d.dual!=20||
d.kSplit!=1||d.window!=1||!d.nSplit||d.nSplit>d.nTiles||
d.baseM<32||d.baseM>128||d.baseM%32||
d.baseN<16||d.baseN>256||d.baseN%16||
(d.kChunk!=64&&d.kChunk!=128)||
d.b!=s.b||d.m!=s.m||d.n!=s.n||d.k!=s.k||
d.mTiles!=Ceil(s.m,d.baseM)||d.nTiles!=Ceil(s.n,d.baseN)||
!d.workers||d.workers!=p.cubeBlocks||
d.workers>uint64_t(s.b)*d.mTiles*d.nSplit)return false;
auto*plat=platform_ascendc::PlatformAscendCManager::GetInstance();
uint64_t l1=0,l0a=0,l0b=0,l0c=0,ub=0;
plat->GetCoreMemSize(platform_ascendc::CoreMemType::L1,l1);
plat->GetCoreMemSize(platform_ascendc::CoreMemType::L0_A,l0a);
plat->GetCoreMemSize(platform_ascendc::CoreMemType::L0_B,l0b);
plat->GetCoreMemSize(platform_ascendc::CoreMemType::L0_C,l0c);
plat->GetCoreMemSize(platform_ascendc::CoreMemType::UB,ub);
if(d.workers>plat->GetCoreNumAic()||2*d.workers>plat->GetCoreNumAiv())return false;
const uint64_t aBytes=uint64_t(d.baseM)*s.k*2;
const uint64_t aL0=uint64_t(d.baseM)*d.kChunk*4;
const uint64_t bL0=uint64_t(d.baseN)*d.kChunk*4;
const uint64_t oneC=uint64_t(d.baseM)*d.baseN*4;
const uint64_t cBytes=oneC*((d.tree&8)?1:2);
const uint64_t vectorBytes=oneC+20ULL*d.baseM+3ULL*d.vectorTile*4+64;
const uint64_t partBytes=Ceil(s.b*d.nSplit*d.mTiles*d.baseM*4,512)*512;
const uint64_t ringBytes=uint64_t(d.workers)*2*oneC;
return aBytes+bL0+4096<=std::min<uint64_t>(l1,512ULL*1024)&&
aL0<=std::min<uint64_t>(l0a,65536)&&bL0<=std::min<uint64_t>(l0b,65536)&&
cBytes<=std::min<uint64_t>(l0c,131072)&&vectorBytes+1024<=ub&&
p.totalBytes>=p.systemBytes+partBytes+ringBytes;
}
inline bool UseTallSingleFrame(const Shape&s,const Plan&p)
{
#ifdef BMMMS_TUNING
const auto&t=Tune();
if(t.group>=0||t.rows>0||t.dual>=0||t.early>=0||t.tree>=0||
t.bm||t.bn||t.window||t.ns||t.ks||t.workers)return false;
#endif
const auto&d=p.schedule;
if(s.b!=1||s.dtype!=1||s.tx1||s.tx2||s.n!=64||s.k!=128||
s.m<2048||s.m>8192||s.m%512||
d.b!=s.b||d.m!=s.m||d.n!=s.n||d.k!=s.k||
d.dual!=34||d.baseM!=512||d.baseN!=64||d.kChunk!=64||
d.kSplit!=1||d.nSplit!=1||d.nTiles!=1||d.window!=1||!d.earlySum||
!d.workers||d.workers!=d.mTiles||d.mTiles!=s.m/512||
d.workers!=p.cubeBlocks)return false;
auto*plat=platform_ascendc::PlatformAscendCManager::GetInstance();
if(d.workers>std::min<int64_t>(plat->GetCoreNumAic(),plat->GetCoreNumAiv()))return false;
uint64_t l1=0,l0a=0,l0b=0,l0c=0,ub=0;
plat->GetCoreMemSize(platform_ascendc::CoreMemType::L1,l1);
plat->GetCoreMemSize(platform_ascendc::CoreMemType::L0_A,l0a);
plat->GetCoreMemSize(platform_ascendc::CoreMemType::L0_B,l0b);
plat->GetCoreMemSize(platform_ascendc::CoreMemType::L0_C,l0c);
plat->GetCoreMemSize(platform_ascendc::CoreMemType::UB,ub);
constexpr uint64_t aBytes=64ULL*128*2,bBytes=512ULL*128*2;
constexpr uint64_t bL0Bytes=512ULL*64*2,cBytes=512ULL*64*4;
const uint64_t parts=uint64_t(d.workers)*512*4;
return aBytes+bBytes+4096<=l1&&aBytes<=l0a&&bL0Bytes<=l0b&&
cBytes<=l0c&&cBytes+4096<=ub&&
p.totalBytes>=p.systemBytes+parts+2ULL*d.workers*cBytes;
}
inline bool UseTallHalfPipeline(const Shape&s,const Plan&p)
{
if(!UseTallSingleFrame(s,p))return false;
const auto&d=p.schedule;
if(p.small||p.micro||p.case12PackedA||d.earlySum!=1||d.tree||
d.balance!=1||d.microRows!=s.m||d.batchGroup!=8||d.vectorTile!=1024||
p.finalBlocks!=1||!p.systemBytes||p.cube.usedCoreNum!=d.workers||
p.cube.baseM!=64||p.cube.baseN!=512||p.cube.baseK!=64)return false;
constexpr uint64_t oneC=512ULL*64*4;
const uint64_t parts=uint64_t(d.workers)*512*4;
return p.totalBytes==p.systemBytes+parts+2ULL*d.workers*oneC;
}
inline WideNKernelShape MakeWideNManualFrame(const Shape&s,const Plan&p)
{
WideNKernelShape q{};
#ifdef BMMMS_TUNING
const auto&t=Tune();
if(t.group>=0||t.rows>0||t.dual>=0||t.early>=0||t.tree>=0||
t.bm||t.bn||t.window||t.ns||t.ks||t.workers)return q;
#endif
const auto&d=p.schedule;
if(s.b!=1||s.dtype!=2||s.tx1||!s.tx2||s.m<16||s.m>128||
s.n<4096||s.k<32||s.k>256||s.m%16||s.n%16||s.k%16||
d.dual!=21||d.kSplit!=1||d.mTiles!=1||d.window!=1||
d.baseM!=Ceil(s.m,32)*32||d.baseN!=128||d.nTiles!=Ceil(s.n,128)||
!d.nSplit||d.nSplit>64||d.nSplit>d.nTiles||d.workers!=d.nSplit||
d.workers!=p.cubeBlocks)return q;
auto*plat=platform_ascendc::PlatformAscendCManager::GetInstance();
if(d.workers>uint32_t(std::min<int64_t>(plat->GetCoreNumAic(),plat->GetCoreNumAiv()/2)))return q;
uint64_t l1=0,l0a=0,l0b=0,l0c=0,ub=0;
plat->GetCoreMemSize(platform_ascendc::CoreMemType::L1,l1);
plat->GetCoreMemSize(platform_ascendc::CoreMemType::L0_A,l0a);
plat->GetCoreMemSize(platform_ascendc::CoreMemType::L0_B,l0b);
plat->GetCoreMemSize(platform_ascendc::CoreMemType::L0_C,l0c);
plat->GetCoreMemSize(platform_ascendc::CoreMemType::UB,ub);
const uint64_t a=uint64_t(d.baseM)*s.k*2,b=uint64_t(d.baseN)*s.k*2,c=uint64_t(d.baseM)*d.baseN;
const uint64_t parts=Ceil(d.nSplit*d.baseM*4,512)*512;
if(a+2*b+4096>l1||a>l0a||b>l0b||8*c>l0c||
8*c+10ULL*d.baseM+64+4096>ub||d.nSplit*d.baseM>2*c||
p.totalBytes<p.systemBytes+parts+8ULL*d.workers*c)return q;
return{uint32_t(s.m),uint32_t(s.n),uint32_t(s.k),d.baseM,d.baseN,d.nTiles,d.nSplit,d.workers};
}
inline bool MakeSmallFullKBatch(const Shape&s,const Plan&p,Schedule&q)
{
#ifdef BMMMS_TUNING
const auto&t=Tune();
if(t.group>=0||t.rows>0||t.dual>=0||t.early>=0||t.tree>=0||
t.bm||t.bn||t.window||t.ns||t.ks||t.workers)return false;
#endif
const auto&d=p.schedule;
if(s.b<8||s.b>32||s.m<16||s.m>32||s.n<64||s.n>128||
s.k<128||s.k>256||(s.dtype!=1&&s.dtype!=2)||d.kSplit!=1||
d.workers!=s.b||p.cubeBlocks!=s.b||
d.b!=s.b||d.m!=s.m||d.n!=s.n||d.k!=s.k)return false;
auto*plat=platform_ascendc::PlatformAscendCManager::GetInstance();
if(s.b>std::min<int64_t>(plat->GetCoreNumAic(),plat->GetCoreNumAiv()))return false;
const uint32_t mp=Ceil(s.m,16)*16,np=Ceil(s.n,16)*16,kp=Ceil(s.k,16)*16;
uint64_t l1=0,l0a=0,l0b=0,l0c=0,ub=0;
plat->GetCoreMemSize(platform_ascendc::CoreMemType::L1,l1);
plat->GetCoreMemSize(platform_ascendc::CoreMemType::L0_A,l0a);
plat->GetCoreMemSize(platform_ascendc::CoreMemType::L0_B,l0b);
plat->GetCoreMemSize(platform_ascendc::CoreMemType::L0_C,l0c);
plat->GetCoreMemSize(platform_ascendc::CoreMemType::UB,ub);
const uint64_t a=2ULL*mp*kp,b=2ULL*np*kp,c=4ULL*mp*np;
const uint64_t bytes=p.systemBytes+Ceil(s.b*mp*4,512)*512+8ULL*s.b*mp*np;
if(a>l0a||b>l0b||c>l0c||a+b+4096>l1||
c+8ULL*mp+64+1024>ub||p.totalBytes<bytes||
uint64_t(mp)*kp/256>255||uint64_t(np)*kp/256>255)return false;
q=d;q.baseM=mp;q.baseN=np;return true;
}
inline bool UseSmallC5Direct(const Shape&s,const Plan&p)
{
#ifdef BMMMS_TUNING
const auto&t=Tune();
if(t.group>=0||t.rows>0||t.dual>=0||t.early>=0||t.tree>=0||
t.bm||t.bn||t.window||t.ns||t.ks||t.workers)return false;
#endif
const auto&d=p.schedule;
if(s.b!=8||s.m!=16||s.n!=32||s.k!=128||
(s.dtype!=1&&s.dtype!=2)||p.small||p.micro||
d.b!=s.b||d.m!=s.m||d.n!=s.n||d.k!=s.k||
d.baseM!=16||d.baseN!=32||d.mTiles!=1||d.nTiles!=1||
d.nSplit!=1||d.kSplit!=1||d.kChunk!=128||
d.workers!=s.b||p.cubeBlocks!=s.b||d.earlySum||d.tree||!p.systemBytes)return false;
auto*plat=platform_ascendc::PlatformAscendCManager::GetInstance();
if(s.b>plat->GetCoreNumAic()||s.b>plat->GetCoreNumAiv())return false;
uint64_t l1=0,l0a=0,l0b=0,l0c=0,ub=0;
plat->GetCoreMemSize(platform_ascendc::CoreMemType::L1,l1);
plat->GetCoreMemSize(platform_ascendc::CoreMemType::L0_A,l0a);
plat->GetCoreMemSize(platform_ascendc::CoreMemType::L0_B,l0b);
plat->GetCoreMemSize(platform_ascendc::CoreMemType::L0_C,l0c);
plat->GetCoreMemSize(platform_ascendc::CoreMemType::UB,ub);
constexpr uint64_t aBytes=16*128*2,bBytes=32*128*2,cBytes=16*32*4;
return aBytes+bBytes+4096<=l1&&aBytes<=l0a&&bBytes<=l0b&&cBytes<=l0c&&
cBytes+16*8+64+1024<=ub&&
p.totalBytes>=p.systemBytes+512+uint64_t(s.b)*2*cBytes;
}
inline bool UseSplitTTCubeCollective(const Shape&s,const Plan&p,GM_ADDR x1,GM_ADDR x2)
{
#ifdef BMMMS_TUNING
const auto&t=Tune();
if(t.group>=0||t.rows>0||t.dual>=0||t.early>=0||t.tree>=0||
t.bm||t.bn||t.window||t.ns||t.ks||t.workers)return false;
#endif
const auto&d=p.schedule;
if(s.b!=1||s.m!=64||s.n!=64||s.k!=8192||s.dtype!=1||!s.tx1||!s.tx2||
p.small||p.micro||p.case12PackedA||p.cubeBlocks!=8||p.finalBlocks!=1||
d.b!=1||d.m!=64||d.n!=64||d.k!=8192||d.baseM!=64||d.baseN!=64||
d.mTiles!=1||d.nTiles!=1||d.nSplit!=1||d.workers!=8||d.vectorTile!=1024||
d.window!=1||d.kSplit!=8||d.kChunk!=1024||d.microRows!=64||d.batchGroup!=8||
d.dual!=25||d.earlySum||d.tree||d.balance!=1||p.cube.usedCoreNum!=8||
((reinterpret_cast<uintptr_t>(x1)|reinterpret_cast<uintptr_t>(x2))&31))return false;
auto*hw=platform_ascendc::PlatformAscendCManager::GetInstance();
if(hw->GetCoreNumAic()<8||hw->GetCoreNumAiv()<8)return false;
uint64_t l1=0,l0a=0,l0b=0,l0c=0,ub=0;
hw->GetCoreMemSize(platform_ascendc::CoreMemType::L1,l1);
hw->GetCoreMemSize(platform_ascendc::CoreMemType::L0_A,l0a);
hw->GetCoreMemSize(platform_ascendc::CoreMemType::L0_B,l0b);
hw->GetCoreMemSize(platform_ascendc::CoreMemType::L0_C,l0c);
hw->GetCoreMemSize(platform_ascendc::CoreMemType::UB,ub);
return l1>=65536+4096&&l0a>=32768&&l0b>=32768&&l0c>=16384&&ub>=16928+1024&&
p.systemBytes&&p.systemBytes==Ceil(hw->GetLibApiWorkSpaceSize(),512)*512&&
p.totalBytes==p.systemBytes+131072;
}
using CacheKey=std::pair<uintptr_t,uintptr_t>;
using ShapeKey=std::tuple<int64_t,int64_t,int64_t,int64_t,int32_t,int32_t,int32_t,int64_t>;
struct CacheEntry{
void*memory=nullptr;
uint64_t capacity=0;
bool hasPlan=false;
ShapeKey shape;
Plan plan;
};
inline std::map<CacheKey,CacheEntry>&Cache(){static std::map<CacheKey,CacheEntry>c;return c;}
inline std::mutex&CacheMutex(){static std::mutex m;return m;}
inline CacheKey CurrentKey(aclrtStream stream)
{
aclrtContext context=nullptr;
CheckAcl(aclrtGetCurrentContext(&context),"aclrtGetCurrentContext");
if(!context)throw std::runtime_error("no active ACL context");
return{reinterpret_cast<uintptr_t>(context),reinterpret_cast<uintptr_t>(stream)};
}
inline uint32_t SmallVectorK256Rows(const Shape&s)
{
#ifdef BMMMS_TUNING
const auto&t=Tune();
if(t.group>=0||t.rows>0||t.dual>=0||t.early>=0||t.tree>=0||
t.bm||t.bn||t.window||t.ns||t.ks||t.workers)return 0;
#endif
if(s.b<1||s.m<2||s.m>16||s.n<2||s.n>32||s.k<65||s.k>256)return 0;
if(s.m>=16&&s.n>=16)return 0;
auto*plat=platform_ascendc::PlatformAscendCManager::GetInstance();
if(s.b>plat->GetCoreNumAiv())return 0;
uint64_t ub=0;plat->GetCoreMemSize(platform_ascendc::CoreMemType::UB,ub);
const uint64_t kp=Ceil(s.k,16)*16,np=Ceil(s.n,8)*8;
const uint64_t ac=Ceil(s.m*s.k,16)*16,bc=Ceil(s.n*s.k,16)*16;
const uint64_t fixed=6*(s.m+s.n)*kp+(s.tx1?ac*4:32)+(!s.tx2?bc*4:32)+3*256*4+64;
const uint64_t perRow=np*kp*4+np*8;
uint32_t rows=s.m;
while(rows&&fixed+rows*perRow+Ceil(rows,8)*32+1024>ub)--rows;
return rows;
}
template<typename T,bool TX1,bool TX2,uint32_t KCONST,bool GROUPED>
inline void LaunchTinyK(GM_ADDR x1,GM_ADDR x2,GM_ADDR y,TinyKernelShape s,
uint32_t group,uint32_t blocks,aclrtStream stream)
{
if constexpr(GROUPED)bmmms_tiny_grouped<T,TX1,TX2,KCONST><<<blocks,nullptr,stream>>>(x1,x2,y,s,group);
else bmmms_tiny_direct<T,TX1,TX2,KCONST><<<blocks,nullptr,stream>>>(x1,x2,y,s);
}
template<typename T,bool TX1,bool TX2,bool GROUPED>
inline void LaunchTinyGeometry(GM_ADDR x1,GM_ADDR x2,GM_ADDR y,TinyKernelShape s,
uint32_t group,uint32_t blocks,aclrtStream stream)
{
switch(s.k){
case 32:LaunchTinyK<T,TX1,TX2,32,GROUPED>(x1,x2,y,s,group,blocks,stream);return;
case 40:LaunchTinyK<T,TX1,TX2,40,GROUPED>(x1,x2,y,s,group,blocks,stream);return;
case 48:LaunchTinyK<T,TX1,TX2,48,GROUPED>(x1,x2,y,s,group,blocks,stream);return;
case 56:LaunchTinyK<T,TX1,TX2,56,GROUPED>(x1,x2,y,s,group,blocks,stream);return;
case 64:LaunchTinyK<T,TX1,TX2,64,GROUPED>(x1,x2,y,s,group,blocks,stream);return;
default:LaunchTinyK<T,TX1,TX2,0,GROUPED>(x1,x2,y,s,group,blocks,stream);return;
}
}
template<typename T>
inline void Launch(GM_ADDR x1,GM_ADDR x2,GM_ADDR y,const Shape&s,const Plan&p,
void*memory,aclrtStream stream)
{
if constexpr(sizeof(T)==2)if(p.schedule.dual==39){
GM_ADDR partial=(GM_ADDR)memory+p.systemBytes;
bmmms_manual<T,true,true,true,false,false,false,false,true,true,true,false,true,true><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule);
return;
}
const uint32_t vectorRows=SmallVectorK256Rows(s);
if(vectorRows){
SmallVectorManualShape v{static_cast<uint32_t>(s.m),static_cast<uint32_t>(s.n),static_cast<uint32_t>(s.k),vectorRows};
const uint32_t blocks=s.b;
if(s.tx1&&s.tx2)bmmms_small_vector_k256<T,true,true><<<blocks,nullptr,stream>>>(x1,x2,y,v);
else if(s.tx1)bmmms_small_vector_k256<T,true,false><<<blocks,nullptr,stream>>>(x1,x2,y,v);
else if(s.tx2)bmmms_small_vector_k256<T,false,true><<<blocks,nullptr,stream>>>(x1,x2,y,v);
else bmmms_small_vector_k256<T,false,false><<<blocks,nullptr,stream>>>(x1,x2,y,v);
return;
}
if(p.schedule.dual==28){
bmmms_tiny_tt_vector<T><<<p.finalBlocks,nullptr,stream>>>(x1,x2,y,p.schedule);
return;
}
if(p.schedule.dual==16){
if(s.tx1&&s.tx2)LaunchTinyGeometry<T,true,true,false>(x1,x2,y,TinyKernelShape{static_cast<uint32_t>(s.b),static_cast<uint32_t>(s.m),static_cast<uint32_t>(s.n),static_cast<uint32_t>(s.k)},0,1,stream);
else if(s.tx1)LaunchTinyGeometry<T,true,false,false>(x1,x2,y,TinyKernelShape{static_cast<uint32_t>(s.b),static_cast<uint32_t>(s.m),static_cast<uint32_t>(s.n),static_cast<uint32_t>(s.k)},0,1,stream);
else if(s.tx2)LaunchTinyGeometry<T,false,true,false>(x1,x2,y,TinyKernelShape{static_cast<uint32_t>(s.b),static_cast<uint32_t>(s.m),static_cast<uint32_t>(s.n),static_cast<uint32_t>(s.k)},0,1,stream);
else LaunchTinyGeometry<T,false,false,false>(x1,x2,y,TinyKernelShape{static_cast<uint32_t>(s.b),static_cast<uint32_t>(s.m),static_cast<uint32_t>(s.n),static_cast<uint32_t>(s.k)},0,1,stream);
return;
}
if(p.schedule.dual==24){
if(s.tx1&&s.tx2)LaunchTinyGeometry<T,true,true,true>(x1,x2,y,TinyKernelShape{static_cast<uint32_t>(s.b),static_cast<uint32_t>(s.m),static_cast<uint32_t>(s.n),static_cast<uint32_t>(s.k)},p.schedule.batchGroup,p.finalBlocks,stream);
else if(s.tx1)LaunchTinyGeometry<T,true,false,true>(x1,x2,y,TinyKernelShape{static_cast<uint32_t>(s.b),static_cast<uint32_t>(s.m),static_cast<uint32_t>(s.n),static_cast<uint32_t>(s.k)},p.schedule.batchGroup,p.finalBlocks,stream);
else if(s.tx2)LaunchTinyGeometry<T,false,true,true>(x1,x2,y,TinyKernelShape{static_cast<uint32_t>(s.b),static_cast<uint32_t>(s.m),static_cast<uint32_t>(s.n),static_cast<uint32_t>(s.k)},p.schedule.batchGroup,p.finalBlocks,stream);
else LaunchTinyGeometry<T,false,false,true>(x1,x2,y,TinyKernelShape{static_cast<uint32_t>(s.b),static_cast<uint32_t>(s.m),static_cast<uint32_t>(s.n),static_cast<uint32_t>(s.k)},p.schedule.batchGroup,p.finalBlocks,stream);
return;
}
if(s.m==1&&s.n==1){
if(p.schedule.dual==15){
const bool aligned=s.k%16==0&&
((reinterpret_cast<uintptr_t>(x1)|reinterpret_cast<uintptr_t>(x2))&31)==0;
if(p.schedule.batchGroup==2){
if(aligned)bmmms_dot_short<T,true,2><<<p.finalBlocks,nullptr,stream>>>(x1,x2,y,static_cast<uint32_t>(s.b),static_cast<uint32_t>(s.k));
else bmmms_dot_short<T,false,2><<<p.finalBlocks,nullptr,stream>>>(x1,x2,y,static_cast<uint32_t>(s.b),static_cast<uint32_t>(s.k));
}else{
if(aligned)bmmms_dot_short<T,true><<<p.finalBlocks,nullptr,stream>>>(x1,x2,y,static_cast<uint32_t>(s.b),static_cast<uint32_t>(s.k));
else bmmms_dot_short<T><<<p.finalBlocks,nullptr,stream>>>(x1,x2,y,static_cast<uint32_t>(s.b),static_cast<uint32_t>(s.k));
}
return;
}
if(p.schedule.dual==10){
bmmms_dot_split<T><<<p.finalBlocks,nullptr,stream>>>(x1,x2,y,(GM_ADDR)memory,p.schedule);return;
}
if(p.schedule.dual==5){
bmmms_dot_grouped<T><<<p.finalBlocks,nullptr,stream>>>(x1,x2,y,p.schedule);return;
}
bmmms_dot<T><<<p.finalBlocks,nullptr,stream>>>(x1,x2,y,p.schedule);
return;
}
if(p.schedule.dual==12){
bmmms_col_sumfirst<T><<<p.finalBlocks,nullptr,stream>>>(x1,x2,(GM_ADDR)memory,y,p.schedule);return;
}
if(p.schedule.dual==9||p.schedule.dual==11){
if(s.m==1){
if(s.tx2)bmmms_gemv_vector<T,true><<<p.finalBlocks,nullptr,stream>>>(x2,x1,(GM_ADDR)memory,y,p.schedule);
else bmmms_gemv_vector<T,true,true><<<p.finalBlocks,nullptr,stream>>>(x2,x1,(GM_ADDR)memory,y,p.schedule);
}else{
if(s.tx1)bmmms_gemv_vector<T,false,true><<<p.finalBlocks,nullptr,stream>>>(x1,x2,(GM_ADDR)memory,y,p.schedule);
else bmmms_gemv_vector<T,false><<<p.finalBlocks,nullptr,stream>>>(x1,x2,(GM_ADDR)memory,y,p.schedule);
}
return;
}
if(p.small){
if(s.m==1){
if(s.tx2)bmmms_small<T,false,true><<<p.finalBlocks,nullptr,stream>>>(x2,x1,y,p.schedule);
else bmmms_small<T,true,true><<<p.finalBlocks,nullptr,stream>>>(x2,x1,y,p.schedule);
}else{
if(s.tx1)bmmms_small<T,true,false><<<p.finalBlocks,nullptr,stream>>>(x1,x2,y,p.schedule);
else bmmms_small<T,false,false><<<p.finalBlocks,nullptr,stream>>>(x1,x2,y,p.schedule);
}
return;
}
GM_ADDR workspace=(GM_ADDR)memory;
if(p.micro&&p.schedule.batchGroup==0&&p.schedule.microRows==s.m){
if(s.tx1&&s.tx2)bmmms_small_gemm<T,true,true><<<p.finalBlocks,nullptr,stream>>>(x1,x2,y,workspace,p.schedule);
else if(s.tx1)bmmms_small_gemm<T,true,false><<<p.finalBlocks,nullptr,stream>>>(x1,x2,y,workspace,p.schedule);
else if(s.tx2&&(s.k==32||s.k==64))
bmmms_small_gemm_contiguous<T,false,true><<<p.finalBlocks,nullptr,stream>>>(x1,x2,y,workspace,p.schedule);
else if(s.tx2)bmmms_small_gemm<T,false,true><<<p.finalBlocks,nullptr,stream>>>(x1,x2,y,workspace,p.schedule);
else if(s.k==32||s.k==64)
bmmms_small_gemm_contiguous<T,false,false><<<p.finalBlocks,nullptr,stream>>>(x1,x2,y,workspace,p.schedule);
else bmmms_small_gemm<T,false,false><<<p.finalBlocks,nullptr,stream>>>(x1,x2,y,workspace,p.schedule);
return;
}
if(p.micro){
if(p.schedule.dual==8){
if(s.tx1&&s.tx2)bmmms_micro_batch<T,true,true><<<p.finalBlocks,nullptr,stream>>>(x1,x2,y,p.schedule);
else if(s.tx1)bmmms_micro_batch<T,true,false><<<p.finalBlocks,nullptr,stream>>>(x1,x2,y,p.schedule);
else if(s.tx2)bmmms_micro_batch<T,false,true><<<p.finalBlocks,nullptr,stream>>>(x1,x2,y,p.schedule);
else bmmms_micro_batch<T,false,false><<<p.finalBlocks,nullptr,stream>>>(x1,x2,y,p.schedule);
return;
}
if(s.tx1&&s.tx2)
bmmms_small_gemm_grouped<T,true,true><<<p.finalBlocks,nullptr,stream>>>(x1,x2,y,workspace,p.schedule);
else if(s.tx1)
bmmms_small_gemm_grouped<T,true,false><<<p.finalBlocks,nullptr,stream>>>(x1,x2,y,workspace,p.schedule);
else if(s.tx2)
bmmms_small_gemm_grouped<T,false,true><<<p.finalBlocks,nullptr,stream>>>(x1,x2,y,workspace,p.schedule);
else
bmmms_small_gemm_grouped<T,false,false><<<p.finalBlocks,nullptr,stream>>>(x1,x2,y,workspace,p.schedule);
return;
}
GM_ADDR partial=workspace+p.systemBytes;
if(UseSmallC5Direct(s,p)){
if(s.tx1&&s.tx2)bmmms_single_tile_direct_batch_mix11<T,true,true,16,32,128,true><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule);
else if(s.tx1)bmmms_single_tile_direct_batch_mix11<T,true,false,16,32,128,true><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule);
else if(s.tx2)bmmms_single_tile_direct_batch_mix11<T,false,true,16,32,128,true><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule);
else bmmms_single_tile_direct_batch_mix11<T,false,false,16,32,128,true><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule);
return;
}
if(UseTallSingleFrame(s,p)){
if(UseTallHalfPipeline(s,p))
bmmms_tall_single_frame<T,true><<<p.cubeBlocks,nullptr,stream>>>(
x1,x2,partial,y,p.schedule.workers);
else{
bmmms_tall_single_frame<T><<<p.cubeBlocks,nullptr,stream>>>(
x1,x2,partial,y,p.schedule.workers);
}
return;
}
const auto wide=MakeWideNManualFrame(s,p);
if(wide.workers){
uint64_t wideUb=0;
platform_ascendc::PlatformAscendCManager::GetInstance()->GetCoreMemSize(
platform_ascendc::CoreMemType::UB,wideUb);
const uint64_t wholeFrameUb=16ULL*wide.mp*wide.np+12ULL*wide.mp+64+4096;
if(wholeFrameUb<=wideUb){
bmmms_wide_n_single_aiv<T><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,wide);
return;
}
bmmms_wide_n_manual_frame<T><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,wide);
return;
}
if(p.schedule.dual==36){
const auto&nn=p.schedule;
bool splitNN=s.b==1&&(s.dtype==1||s.dtype==2)&&!s.tx1&&!s.tx2&&
s.m>=2048&&s.m<8192&&s.n>=512&&s.n<4096&&s.k>=512&&s.k<2048&&
s.m%16==0&&s.n%16==0&&s.k%16==0&&!p.small&&!p.micro&&!p.case12PackedA&&
nn.baseM==128&&nn.baseN==128&&p.cube.baseK==128&&nn.kSplit==1&&
!nn.earlySum&&(nn.tree==0||nn.tree==8)&&nn.kChunk>=256&&nn.kChunk%128==0&&
nn.b==s.b&&nn.m==s.m&&nn.n==s.n&&nn.k==s.k&&
nn.mTiles==Ceil(s.m,128)&&nn.nTiles==Ceil(s.n,128)&&
nn.nSplit>0&&nn.nSplit<=nn.nTiles&&nn.window>0&&nn.window<=4&&
nn.workers>0&&nn.workers==p.cubeBlocks&&p.cube.usedCoreNum==nn.workers&&
p.systemBytes&&p.totalBytes==p.systemBytes+Ceil(4ULL*s.b*nn.nSplit*nn.mTiles*128,512)*512+
8ULL*nn.workers*128*128*nn.window;
#ifdef BMMMS_TUNING
const auto&nnTune=Tune();
splitNN=splitNN&&nnTune.group<0&&nnTune.rows<=0&&nnTune.dual<0&&
nnTune.early<0&&nnTune.tree<0&&!nnTune.bm&&!nnTune.bn&&
!nnTune.window&&!nnTune.ns&&!nnTune.ks&&!nnTune.workers;
#endif
if(splitNN){
bmmms_manual<T,false,false,true,false,false,false,false,true,true,true,false,false,false,true><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule);
return;
}
