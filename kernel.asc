template<typename T,bool TX1,bool TX2,bool PAD_MN=false,bool SKIP_B=false>__aicore__ inline void ManualCopyK(
AscendC::TQue<AscendC::TPosition::A1,2>&aq,AscendC::TQue<AscendC::TPosition::B1,2>&bq,
const AscendC::GlobalTensor<T>&a,const AscendC::GlobalTensor<T>&b,const Schedule&s,uint32_t bk,uint32_t rows,uint32_t cols,
int64_t batch,int64_t m0,int64_t n0,uint32_t k0,bool residentA){
