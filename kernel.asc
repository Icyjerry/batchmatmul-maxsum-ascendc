#ifdef __DAV_CUBE__
AscendC::SetLoadDataBoundary(uint64_t(0));AscendC::SetLoadDataPaddingValue(uint64_t(0));AscendC::GlobalTensor<T>a,b;
a.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x1));b.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x2));const uint32_t aElems=s.mp*s.k,bElems=s.np*s.k;
