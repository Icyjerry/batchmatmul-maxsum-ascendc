streamed=streamBuf.Get<float>();
AscendC::Duplicate(streamed,0.0f,s.baseM/2);
AscendC::PipeBarrier<PIPE_V>();
}
if(packedBOffset){
AscendC::GlobalTensor<T>packed;
packed.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(partial+packedBOffset));
const uint32_t packRows=s.baseM/2;
const uint32_t kPanels=(s.k+packRows-1)/packRows;
const int64_t packTasks=s.b*s.nTiles*kPanels;
for(int64_t t=AscendC::GetBlockIdx();t<packTasks;t+=2*s.workers){
const uint32_t kp=t%kPanels,nt=(t/kPanels)%s.nTiles;
const int64_t batch=t/(int64_t(kPanels)*s.nTiles),k0=int64_t(kp)*packRows;
const uint32_t kr=s.k-k0<packRows?s.k-k0:packRows;
const int64_t n0=int64_t(nt)*s.baseN;
const uint32_t cols=s.n-n0<s.baseN?s.n-n0:s.baseN;
auto data=cq.AllocTensor<T>();
if(cols<s.baseN){
AscendC::Duplicate(data.template ReinterpretCast<half>(),half(0),kr*s.baseN);
Fence<AscendC::HardEvent::V_MTE2>();
}
AscendC::DataCopyExtParams cp{static_cast<uint16_t>(kr),cols*2,
static_cast<uint32_t>((s.n-cols)*2),(s.baseN-cols)/16,0};
AscendC::DataCopyPadExtParams<T>pad{false,0,0,T(0)};
AscendC::DataCopyPad(data,b[batch*s.n*s.k+k0*s.n+n0],cp,pad);
cq.EnQue(data);data=cq.DeQue<T>();
auto zn=data[packRows*s.baseN];
const uint64_t srcAddr=reinterpret_cast<uint64_t>(data.GetPhyAddr());
const uint64_t dstAddr=reinterpret_cast<uint64_t>(zn.GetPhyAddr());
AscendC::TransDataTo5HDParams tp;
tp.dstHighHalf=false;tp.srcHighHalf=false;
tp.repeatTimes=s.baseN/16;tp.dstRepStride=16;tp.srcRepStride=1;
for(uint32_t ki=0;ki<kr;ki+=16){
uint64_t srcList[16],dstList[16];
for(uint32_t i=0;i<16;++i){
srcList[i]=srcAddr+uint64_t(ki+i)*s.baseN*sizeof(T);
dstList[i]=dstAddr+uint64_t(ki*s.baseN+i*16)*sizeof(T);
}
AscendC::TransDataTo5HD<half>(dstList,srcList,tp);
}
Fence<AscendC::HardEvent::V_MTE3>();
AscendC::DataCopy(packed[(batch*s.nTiles+nt)*s.k*s.baseN+k0*s.baseN],zn,kr*s.baseN);
Fence<AscendC::HardEvent::MTE3_V>();
cq.FreeTensor(data);
}
AscendC::SyncAll<true>();
AscendC::CrossCoreSetFlag<2,PIPE_MTE3>(12);
}
for(uint32_t i=0;i<slots;++i)AscendC::CrossCoreSetFlag<2,PIPE_MTE2>(4+i);
for(int64_t task=worker;task<tasks;task+=s.workers){
const uint32_t ns=task%s.nSplit;
const int64_t mt=(task/s.nSplit)%s.mTiles,batch=task/(s.nSplit*s.mTiles),m0=mt*s.baseM;
const int64_t remain=s.m-m0-rowStart;
const uint32_t rows=remain<=0?0:(remain<s.baseM/2?remain:s.baseM/2);
const uint32_t begin=ns*s.nTiles/s.nSplit,end=(ns+1)*s.nTiles/s.nSplit;
auto maxima=mq.AllocTensor<float>();
AscendC::Duplicate(maxima,-__builtin_inff(),s.baseM);AscendC::PipeBarrier<PIPE_V>();
const uint32_t lead=FULL_A?1:((s.tree&1)?1:2);
if(begin<end)ManualCopyC(cq,ring,s,slots,slotSize,rowStart,rows,begin,sequence,span,end);
if(lead==2&&begin+span<end)ManualCopyC(cq,ring,s,slots,slotSize,rowStart,rows,begin+span,sequence+1,span,end);
for(uint32_t nt=begin;nt<end;nt+=span,++sequence){
if(rows){
auto c=cq.DeQue<float>();
const uint32_t limit=(end-nt<span?end-nt:span)*s.baseN;
const uint32_t cols=s.n-int64_t(nt)*s.baseN<limit?s.n-int64_t(nt)*s.baseN:limit;
const uint32_t groups=(cols+63)/64;
for(uint32_t g=0;g<groups;++g){
const uint32_t n=cols-g*64<64?cols-g*64:64;
AscendC::WholeReduceMax(row[g*s.baseM],c[g*64],uint64_t(n),rows,1,1,span*s.baseN/8,
AscendC::ReduceOrder::ORDER_ONLY_VALUE);
}
AscendC::PipeBarrier<PIPE_V>();
for(uint32_t step=1;step<groups;step*=2){
for(uint32_t g=0;g+step<groups;g+=2*step)
AscendC::Max(row[g*s.baseM],row[g*s.baseM],row[(g+step)*s.baseM],rows);
AscendC::PipeBarrier<PIPE_V>();
}
AscendC::Max(maxima,maxima,row,rows);AscendC::PipeBarrier<PIPE_V>();
cq.FreeTensor(c);
}
if(nt+lead*span<end)ManualCopyC(cq,ring,s,slots,slotSize,rowStart,rows,nt+lead*span,sequence+lead,span,end);
}
if constexpr(RESIDENT_B){
if(rows)AscendC::Add(streamed,streamed,maxima,rows);
AscendC::PipeBarrier<PIPE_V>();
}else if(s.earlySum&&s.nSplit==1){
if(rows){
AscendC::ReduceSum<float,true>(row,maxima,row[s.baseM],rows);
AscendC::PipeBarrier<PIPE_V>();
}
AscendC::Duplicate(maxima,0.0f,8);AscendC::PipeBarrier<PIPE_V>();
if(rows)AscendC::Adds(maxima,row,0.0f,1);
mq.EnQue(maxima);maxima=mq.DeQue<float>();
AscendC::DataCopy(partials[task*16+sub*8],maxima,8);
}else{
mq.EnQue(maxima);maxima=mq.DeQue<float>();
AscendC::DataCopy(partials[(batch*s.nSplit+ns)*s.mTiles*s.baseM+m0+rowStart],maxima,s.baseM/2);
}
mq.FreeTensor(maxima);
}
if constexpr(RESIDENT_B){
auto last=mq.AllocTensor<float>();
AscendC::Duplicate(last,0.0f,8);AscendC::PipeBarrier<PIPE_V>();
AscendC::ReduceSum<float,true>(last,streamed,row,s.baseM/2);
mq.EnQue(last);last=mq.DeQue<float>();
AscendC::DataCopy(partials[worker*16+sub*8],last,8);
mq.FreeTensor(last);
}
AscendC::SyncAll<true>();
if(s.earlySum&&s.nSplit==1){
if constexpr(RESIDENT_B)s.mTiles=s.workers*2;
else s.mTiles*=2;
FinalizeEarly(partial,output,s,pipe);
}else if(FULL_A&&s.b==1){
if(AscendC::GetBlockIdx()==0){
AscendC::TBuf<AscendC::TPosition::VECCALC>allBuf,sumBuf,tmpBuf;
pipe.InitBuffer(allBuf,s.nSplit*s.baseM*4);
pipe.InitBuffer(sumBuf,32);pipe.InitBuffer(tmpBuf,s.baseM*4);
auto all=allBuf.Get<float>(),sum=sumBuf.Get<float>(),tmp=tmpBuf.Get<float>();
AscendC::DataCopy(all,partials,s.nSplit*s.baseM);
Fence<AscendC::HardEvent::MTE2_V>();
for(uint32_t ns=1;ns<s.nSplit;++ns){
AscendC::Max(all,all,all[ns*s.baseM],s.m);
AscendC::PipeBarrier<PIPE_V>();
}
AscendC::ReduceSum<float,true>(sum,all,tmp,s.m);
Fence<AscendC::HardEvent::V_MTE3>();
AscendC::GlobalTensor<float>out;out.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(output));
AscendC::DataCopyExtParams cp{1,4,0,0,0};AscendC::DataCopyPad(out,sum,cp);
}
}else if(int64_t(AscendC::GetBlockIdx())*8<s.b)FinalizeRows(partial,output,s,pipe);
#endif
}
constexpr auto DualMdlConfig()
{
auto cfg=CFG_MDL;
cfg.enableMixDualMaster=true;
cfg.enableL1BankConflictOptimise=true;
cfg.enableKdimReorderLoad=true;
return cfg;
}
constexpr auto DUAL_MDL_CONFIG=DualMdlConfig();
template<typename T,bool TX1,bool TX2>
__schedmode__(1)__global__ __mix__(1,2)void bmmms_dual_mdl(
GM_ADDR x1,GM_ADDR x2,GM_ADDR partial,GM_ADDR output,GM_ADDR workspace,
AscendC::tiling::TCubeTiling tiling,Schedule s)
{
AscendC::TPipe pipe;
using A=matmul::MatmulType<AscendC::TPosition::GM,CubeFormat::ND,T,TX1,LayoutMode::NONE,true>;
using B=matmul::MatmulType<AscendC::TPosition::GM,CubeFormat::ND,T,TX2,LayoutMode::NONE,true>;
using C=matmul::MatmulType<AscendC::TPosition::GM,CubeFormat::ND,float>;
using Bias=matmul::MatmulType<AscendC::TPosition::GM,CubeFormat::ND,float>;
matmul::Matmul<A,B,C,Bias,DUAL_MDL_CONFIG>mm;
REGIST_MATMUL_OBJ(&pipe, workspace, mm, &tiling);
AscendC::GlobalTensor<T>a,b;
AscendC::GlobalTensor<float>ring,partials;
a.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x1));
b.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x2));
partials.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(partial));
const uint32_t width=s.baseN*s.window;
const uint32_t slotSize=s.baseM*width;
const int64_t partialCount=s.b*s.nSplit*s.mTiles*s.baseM;
const int64_t alignedCount=(partialCount+127)/128*128;
#ifdef __DAV_CUBE__
const uint32_t worker=AscendC::GetBlockIdx();
#else
const uint32_t worker=AscendC::GetBlockIdx()/2;
const uint32_t sub=AscendC::GetBlockIdx()%2;
const uint32_t rowStart=sub*(s.baseM/2);
#endif
ring.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(partial)+alignedCount+
int64_t(worker)*2*slotSize);
const int64_t tasks=s.b*s.mTiles*s.nSplit;
uint32_t sequence=0;
#ifdef __DAV_CUBE__
AscendC::SetAtomicNone();
AscendC::SetLoadDataBoundary(uint64_t(0));
AscendC::SetLoadDataPaddingValue(uint64_t(0));
for(int64_t task=worker;task<tasks;task+=s.workers){
const uint32_t ns=task%s.nSplit;
const int64_t mt=(task/s.nSplit)%s.mTiles;
const int64_t batch=task/(s.nSplit*s.mTiles);
const int64_t m0=mt*s.baseM;
const uint32_t rows=s.m-m0<s.baseM?s.m-m0:s.baseM;
const uint32_t begin=ns*s.nTiles/s.nSplit,end=(ns+1)*s.nTiles/s.nSplit;
for(uint32_t nt=begin;nt<end;nt+=s.window,++sequence){
const uint32_t slot=sequence&1;
AscendC::CrossCoreWaitFlag<2>(2+slot);
const int64_t n0=int64_t(nt)*s.baseN;
const uint32_t tiles=end-nt<s.window?end-nt:s.window;
const uint32_t cols=s.n-n0<tiles*s.baseN?s.n-n0:tiles*s.baseN;
mm.SetOrgShape(s.m,s.n,s.k,s.k,width);
mm.SetTensorA(a[batch*s.m*s.k+(TX1?m0:m0*s.k)],TX1);
mm.SetTensorB(b[batch*s.n*s.k+(TX2?n0*s.k:n0)],TX2);
mm.SetTail(rows,cols,s.k);
mm.template IterateAll<false>(ring[slot*slotSize]);
AscendC::CrossCoreSetFlag<2,PIPE_FIX>(slot);
}
}
mm.End();
AscendC::CrossCoreWaitFlag<2>(2);
AscendC::CrossCoreWaitFlag<2>(3);
#else
AscendC::TQue<AscendC::TPosition::VECIN,2>cq;
AscendC::TQue<AscendC::TPosition::VECOUT,1>mq;
AscendC::TBuf<AscendC::TPosition::VECCALC>rowBuf,tmpBuf,valBuf;
pipe.InitBuffer(cq,2,(s.baseM/2)*s.baseN*4);
pipe.InitBuffer(mq,1,s.baseM*4);
pipe.InitBuffer(rowBuf,s.baseM*4);pipe.InitBuffer(tmpBuf,s.baseM*4);
pipe.InitBuffer(valBuf,32);
auto row=rowBuf.Get<float>(),tmp=tmpBuf.Get<float>(),val=valBuf.Get<float>();
AscendC::CrossCoreSetFlag<2,PIPE_MTE2>(2);
AscendC::CrossCoreSetFlag<2,PIPE_MTE2>(3);
uint32_t totalWindows=0;
for(int64_t task=worker;task<tasks;task+=s.workers){
const uint32_t ns=task%s.nSplit;
const uint32_t begin=ns*s.nTiles/s.nSplit,end=(ns+1)*s.nTiles/s.nSplit;
totalWindows+=(end-begin+s.window-1)/s.window;
}
for(uint32_t i=0;i<2&&i<totalWindows;++i)mm.template IterateAll<false>(ring);
for(int64_t task=worker;task<tasks;task+=s.workers){
const uint32_t ns=task%s.nSplit;
const int64_t mt=(task/s.nSplit)%s.mTiles;
const int64_t batch=task/(s.nSplit*s.mTiles);
const int64_t m0=mt*s.baseM;
const int64_t remaining=s.m-m0-rowStart;
const uint32_t rows=remaining<=0?0:(remaining<s.baseM/2?remaining:s.baseM/2);
const uint32_t begin=ns*s.nTiles/s.nSplit,end=(ns+1)*s.nTiles/s.nSplit;
auto maxima=mq.AllocTensor<float>();
AscendC::Duplicate(maxima,-__builtin_inff(),s.baseM);
AscendC::PipeBarrier<PIPE_V>();
for(uint32_t nt=begin;nt<end;nt+=s.window,++sequence){
const uint32_t slot=sequence&1;
AscendC::CrossCoreWaitFlag<2>(slot);
const uint32_t tiles=end-nt<s.window?end-nt:s.window;
for(uint32_t p=0;rows&&p<tiles;++p){
const int64_t n0=int64_t(nt+p)*s.baseN;
const uint32_t cols=s.n-n0<s.baseN?s.n-n0:s.baseN;
auto c=cq.AllocTensor<float>();
const uint32_t padded=(cols+7)/8*8;
AscendC::DataCopyExtParams cp{static_cast<uint16_t>(rows),cols*4,
(width-cols)*4,(s.baseN-padded)/8,0};
AscendC::DataCopyPadExtParams<float>pad{true,0,static_cast<uint8_t>(padded-cols),-__builtin_inff()};
AscendC::DataCopyPad(c,ring[slot*slotSize+rowStart*width+p*s.baseN],cp,pad);
cq.EnQue(c);c=cq.DeQue<float>();
for(uint32_t col=0;col<cols;col+=64){
const uint32_t n=cols-col<64?cols-col:64;
AscendC::WholeReduceMax(row,c[col],uint64_t(n),rows,1,1,s.baseN/8,
AscendC::ReduceOrder::ORDER_ONLY_VALUE);
AscendC::PipeBarrier<PIPE_V>();
AscendC::BinaryRepeatParams rp{1,1,1,8,8,8};
if(rows/64)AscendC::Max(maxima,maxima,row,uint64_t(64),rows/64,rp);
if(rows%64)AscendC::Max(maxima[(rows/64)*64],maxima[(rows/64)*64],row[(rows/64)*64],
uint64_t(rows%64),1,rp);
AscendC::PipeBarrier<PIPE_V>();
}
cq.FreeTensor(c);
}
AscendC::CrossCoreSetFlag<2,PIPE_MTE2>(2+slot);
if(sequence+2<totalWindows)mm.template IterateAll<false>(ring);
}
if(s.earlySum&&s.nSplit==1){
AscendC::Duplicate(val,0.0f,8);AscendC::PipeBarrier<PIPE_V>();
if(rows)AscendC::ReduceSum<float,true>(val,maxima,tmp,rows);
Fence<AscendC::HardEvent::V_MTE3>();
AscendC::DataCopy(partials[task*16+sub*8],val,8);
Fence<AscendC::HardEvent::MTE3_V>();
mq.FreeTensor(maxima);
}else{
mq.EnQue(maxima);maxima=mq.DeQue<float>();
AscendC::DataCopy(partials[(batch*s.nSplit+ns)*s.mTiles*s.baseM+m0+rowStart],maxima,s.baseM/2);
mq.FreeTensor(maxima);
}
}
AscendC::SyncAll<true>();
if(s.earlySum&&s.nSplit==1){s.mTiles*=2;FinalizeEarly(partial,output,s,pipe);}
else if(int64_t(AscendC::GetBlockIdx())*8<s.b)FinalizeRows(partial,output,s,pipe);
#endif
}
template<bool PACKED=false>
__aicore__ inline void FinalizeSplitKND(GM_ADDR partial,GM_ADDR output,Schedule s,AscendC::TPipe&pipe)
{
const int64_t b0=int64_t(AscendC::GetBlockIdx())*8;
if(b0>=s.b)return;
const uint32_t batches=s.b-b0<8?s.b-b0:8;
const uint32_t elements=s.baseM*s.baseN;
AscendC::GlobalTensor<float>in,out;
in.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(partial));
out.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(output));
AscendC::TQue<AscendC::TPosition::VECIN,1>iq;
AscendC::TQue<AscendC::TPosition::VECOUT,1>oq;
AscendC::TBuf<AscendC::TPosition::VECCALC>accumBuf,tmpBuf,groupBuf,lanesBuf;
pipe.InitBuffer(iq,1,(PACKED?s.kSplit:1)*elements*4);pipe.InitBuffer(oq,1,32);
pipe.InitBuffer(accumBuf,PACKED?32:elements*4);
pipe.InitBuffer(tmpBuf,s.baseM*4);pipe.InitBuffer(groupBuf,256);
const uint32_t groups=(static_cast<uint32_t>(s.n)+63)/64;
pipe.InitBuffer(lanesBuf,groups*s.baseM*4);
auto acc=accumBuf.Get<float>();
auto tmp=tmpBuf.Get<float>(),grouped=groupBuf.Get<float>();
auto lanes=lanesBuf.Get<float>();
for(uint32_t bi=0;bi<batches;++bi){
AscendC::LocalTensor<float>packed;
if constexpr(PACKED){
packed=iq.AllocTensor<float>();
AscendC::DataCopy(packed,in[(b0+bi)*s.kSplit*elements],s.kSplit*elements);
iq.EnQue(packed);packed=iq.DeQue<float>();
acc=packed;
}else{
AscendC::Duplicate(acc,0.0f,elements);AscendC::PipeBarrier<PIPE_V>();
}
for(uint32_t ks=PACKED?1:0;ks<s.kSplit;++ks){
AscendC::LocalTensor<float>x;
if constexpr(PACKED)x=packed[ks*elements];
else{
x=iq.AllocTensor<float>();
AscendC::DataCopy(x,in[((b0+bi)*s.kSplit+ks)*elements],elements);
iq.EnQue(x);x=iq.DeQue<float>();
}
for(uint64_t off=0;off<elements;off+=16320){
const uint64_t cnt=elements-off<16320?elements-off:16320;
AscendC::Add(acc[off],acc[off],x[off],uint64_t(64),cnt/64,
AscendC::BinaryRepeatParams{1,1,1,8,8,8});
}
AscendC::PipeBarrier<PIPE_V>();if constexpr(!PACKED)iq.FreeTensor(x);
}
for(uint32_t r0=0;r0<static_cast<uint32_t>(s.m);r0+=64){
const uint32_t rr=static_cast<uint32_t>(s.m)-r0<64?static_cast<uint32_t>(s.m)-r0:64;
for(uint32_t g=0;g<groups;++g){
const uint32_t n=static_cast<uint32_t>(s.n)-g*64<64?static_cast<uint32_t>(s.n)-g*64:64;
AscendC::WholeReduceMax(lanes[g*s.baseM+r0],acc[g*64+int64_t(r0)*s.baseN],
uint64_t(n),rr,1,1,s.baseN/8,
AscendC::ReduceOrder::ORDER_ONLY_VALUE);
}
AscendC::PipeBarrier<PIPE_V>();
for(uint32_t step=1;step<groups;step*=2){
for(uint32_t g=0;g+step<groups;g+=2*step)
AscendC::Max(lanes[g*s.baseM+r0],lanes[g*s.baseM+r0],
lanes[(g+step)*s.baseM+r0],rr);
AscendC::PipeBarrier<PIPE_V>();
}
}
AscendC::PipeBarrier<PIPE_V>();
AscendC::ReduceSum<float,true>(grouped[bi*8],lanes,tmp,s.m);
AscendC::PipeBarrier<PIPE_V>();
if constexpr(PACKED)iq.FreeTensor(packed);
}
auto y=oq.AllocTensor<float>();
AscendC::WholeReduceSum(y,grouped,uint64_t(1),batches,1,1,1);
oq.EnQue(y);y=oq.DeQue<float>();
AscendC::DataCopyExtParams cp{1,batches*4,0,0,0};
AscendC::DataCopyPad(out[b0],y,cp);oq.FreeTensor(y);
}
template<typename T,bool TX1,bool TX2,bool PACKED=false>
__schedmode__(1)__global__ __mix__(1,2)void bmmms_dual_split(
GM_ADDR x1,GM_ADDR x2,GM_ADDR partial,GM_ADDR output,GM_ADDR workspace,
AscendC::tiling::TCubeTiling tiling,Schedule s)
{
AscendC::TPipe pipe;
using A=matmul::MatmulType<AscendC::TPosition::GM,CubeFormat::ND,T,TX1,LayoutMode::NONE,true>;
using B=matmul::MatmulType<AscendC::TPosition::GM,CubeFormat::ND,T,TX2,LayoutMode::NONE,true>;
using C=matmul::MatmulType<AscendC::TPosition::GM,CubeFormat::ND,float>;
using Bias=matmul::MatmulType<AscendC::TPosition::GM,CubeFormat::ND,float>;
matmul::Matmul<A,B,C,Bias,DUAL_CONFIG>mm;
REGIST_MATMUL_OBJ(&pipe,workspace,mm,&tiling);
AscendC::GlobalTensor<T>a,b;
AscendC::GlobalTensor<float>parts;
a.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x1));
b.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x2));
parts.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(partial));
const uint32_t elements=s.baseM*s.baseN;
const int64_t tasks=s.b*s.kSplit;
#ifdef __DAV_CUBE__
AscendC::SetAtomicNone();
AscendC::SetLoadDataBoundary(uint64_t(0));
AscendC::SetLoadDataPaddingValue(uint64_t(0));
for(int64_t task=AscendC::GetBlockIdx();task<tasks;task+=s.workers){
const int64_t batch=task/s.kSplit;
const uint32_t k0=(task%s.kSplit)*s.kChunk;
const uint32_t nk=s.k-k0<s.kChunk?s.k-k0:s.kChunk;
mm.SetOrgShape(s.m,s.n,s.k,s.k,s.baseN);
mm.SetTensorA(a[batch*s.m*s.k+(TX1?k0*s.m:k0)],TX1);
mm.SetTensorB(b[batch*s.n*s.k+(TX2?k0:k0*s.n)],TX2);
mm.SetTail(s.m,s.n,nk);
mm.template IterateAll<true>(parts[task*elements]);
mm.End();
}
#else
const uint32_t worker=AscendC::GetBlockIdx()/2,sub=AscendC::GetBlockIdx()%2;
AscendC::TBuf<AscendC::TPosition::VECCALC>zerosBuf;
pipe.InitBuffer(zerosBuf,PACKED?32:elements*2);
auto zeros=zerosBuf.Get<float>();
if constexpr(!PACKED){
AscendC::Duplicate(zeros,0.0f,elements/2);
Fence<AscendC::HardEvent::V_MTE3>();
}
for(int64_t task=worker;task<tasks;task+=s.workers){
if constexpr(!PACKED)
AscendC::DataCopy(parts[task*elements+sub*elements/2],zeros,elements/2);
mm.template IterateAll<true>(parts[task*elements]);
}
AscendC::SyncAll<true>();
FinalizeSplitKND<PACKED>(partial,output,s,pipe);
#endif
}
__aicore__ inline void FinalizeSplitTTRows(GM_ADDR partial,GM_ADDR output,AscendC::TPipe&pipe)
{
const uint32_t worker=AscendC::GetBlockIdx();
AscendC::GlobalTensor<float>in,out;
in.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(partial),8*64*64);
out.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(output),1);
AscendC::TBuf<AscendC::TPosition::VECCALC>packedBuf,rowsBuf,scoreBuf,tmpBuf;
pipe.InitBuffer(packedBuf,8*8*64*4);pipe.InitBuffer(rowsBuf,32);
pipe.InitBuffer(scoreBuf,256);pipe.InitBuffer(tmpBuf,256);
auto packed=packedBuf.Get<float>(),rows=rowsBuf.Get<float>();
auto score=scoreBuf.Get<float>(),tmp=tmpBuf.Get<float>();
AscendC::DataCopy(packed,in[worker*8*64],AscendC::DataCopyParams{8,64,448,0});
Fence<AscendC::HardEvent::MTE2_V>();
for(uint32_t ks=1;ks<8;++ks){
AscendC::Add(packed,packed,packed[ks*8*64],uint64_t(64),8,
AscendC::BinaryRepeatParams{1,1,1,8,8,8});AscendC::PipeBarrier<PIPE_V>();
}
AscendC::WholeReduceMax(rows,packed,uint64_t(64),8,1,1,8,
AscendC::ReduceOrder::ORDER_ONLY_VALUE);AscendC::PipeBarrier<PIPE_V>();
AscendC::Duplicate(score,0.0f,8);AscendC::PipeBarrier<PIPE_V>();
AscendC::ReduceSum<float,true>(score,rows,tmp,8);
Fence<AscendC::HardEvent::V_MTE3>();
// Only this AIV reads these split-0 rows; its complete read precedes reuse.
AscendC::DataCopy(in[worker*8*64],score,8);
Fence<AscendC::HardEvent::MTE3_S>();AscendC::SyncAll<true>();
if(worker==0){
AscendC::DataCopy(score,in,AscendC::DataCopyParams{8,1,63,0});
Fence<AscendC::HardEvent::MTE2_V>();
AscendC::ReduceSum<float,true>(rows,score,tmp,64);
Fence<AscendC::HardEvent::V_MTE3>();
AscendC::DataCopyExtParams cp{1,4,0,0,0};AscendC::DataCopyPad(out,rows,cp);
}
}
template<typename T,bool PACKED_FINAL=false,bool CUBE_READY=false>
__schedmode__(1)__global__ __mix__(1,1)void bmmms_manual_split_tt(
GM_ADDR x1,GM_ADDR x2,GM_ADDR partial,GM_ADDR output,Schedule s)
{
AscendC::TPipe pipe;
AscendC::GlobalTensor<T>a,b;
AscendC::GlobalTensor<float>parts;
a.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x1));
b.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x2));
parts.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(partial));
constexpr uint32_t bk=128;
const uint32_t elements=s.baseM*s.baseN;
const int64_t tasks=s.b*s.kSplit;
#ifdef __DAV_CUBE__
AscendC::SetAtomicNone();
AscendC::SetLoadDataBoundary(uint64_t(0));
AscendC::SetLoadDataPaddingValue(uint64_t(0));
AscendC::TQue<AscendC::TPosition::A1,2>aq;
AscendC::TQue<AscendC::TPosition::B1,2>bq;
AscendC::TBuf<AscendC::TPosition::A2>ab;
AscendC::TBuf<AscendC::TPosition::B2>bb;
AscendC::TBuf<AscendC::TPosition::CO1>cb;
pipe.InitBuffer(aq,2,s.baseM*bk*2);
pipe.InitBuffer(bq,2,s.baseN*bk*2);
pipe.InitBuffer(ab,2*s.baseM*bk*2);
pipe.InitBuffer(bb,2*s.baseN*bk*2);
pipe.InitBuffer(cb,elements*4);
auto aAll=ab.Get<T>(),bAll=bb.Get<T>();
auto c=cb.Get<float>();
event_t loadFree[2],loadReady[2];
for(uint32_t i=0;i<2;++i){
loadFree[i]=static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::M_MTE1>());
loadReady[i]=static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::MTE1_M>());
AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(loadFree[i]);
}
uint32_t sequence=0;
for(int64_t task=AscendC::GetBlockIdx();task<tasks;task+=s.workers){
const int64_t batch=task/s.kSplit;
const uint32_t kBegin=(task%s.kSplit)*s.kChunk;
const uint32_t kEnd=kBegin+s.kChunk<s.k?kBegin+s.kChunk:s.k;
ManualCopyK<T,true,true,true>(aq,bq,a,b,s,bk,s.m,s.n,batch,0,0,kBegin,false);
if(kBegin+bk<kEnd)
ManualCopyK<T,true,true,true>(aq,bq,a,b,s,bk,s.m,s.n,batch,0,0,kBegin+bk,false);
for(uint32_t k0=kBegin;k0<kEnd;k0+=bk,++sequence){
const uint32_t slot=sequence&1;
auto a1=aq.DeQue<T>(),b1=bq.DeQue<T>();
auto a2=aAll[slot*s.baseM*bk],b2=bAll[slot*s.baseN*bk];
AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(loadFree[slot]);
AscendC::LoadData2DParams lp;
lp.ifTranspose=true;lp.repeatTimes=s.baseM*bk/256;lp.srcStride=1;
AscendC::LoadData(a2,a1,lp);
lp.ifTranspose=false;lp.repeatTimes=s.baseN*bk/256;
AscendC::LoadData(b2,b1,lp);
aq.FreeTensor(a1);bq.FreeTensor(b1);
if(k0+2*bk<kEnd)
ManualCopyK<T,true,true,true>(aq,bq,a,b,s,bk,s.m,s.n,batch,0,0,k0+2*bk,false);
AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(loadReady[slot]);
AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(loadReady[slot]);
AscendC::MmadParams mp;
mp.m=s.baseM;mp.n=s.baseN;mp.k=bk;
mp.cmatrixInitVal=k0==kBegin;
AscendC::Mmad(c,a2,b2,mp);
if((s.baseM/16)*(s.baseN/16)<10)AscendC::PipeBarrier<PIPE_M>();
AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(loadFree[slot]);
}
Fence<AscendC::HardEvent::M_FIX>();
AscendC::FixpipeParamsV220 fp;
fp.nSize=s.baseN;fp.mSize=s.baseM;
fp.srcStride=s.baseM;fp.dstStride=s.baseN;
AscendC::Fixpipe(parts[task*elements],c,fp);
Fence<AscendC::HardEvent::FIX_M>();
}
for(uint32_t i=0;i<2;++i){
AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(loadFree[i]);
pipe.ReleaseEventID<AscendC::HardEvent::M_MTE1>(loadFree[i]);
pipe.ReleaseEventID<AscendC::HardEvent::MTE1_M>(loadReady[i]);
}
if constexpr(CUBE_READY){
AscendC::CrossCoreSetFlag<0,PIPE_FIX>(8);
AscendC::CrossCoreWaitFlag<0>(8);
AscendC::CrossCoreSetFlag<2,PIPE_FIX>(9);
}else AscendC::CrossCoreSetFlag<2,PIPE_FIX>(0);
#else
if constexpr(CUBE_READY)AscendC::CrossCoreWaitFlag<2>(9);
else{AscendC::CrossCoreWaitFlag<2>(0);AscendC::SyncAll<true>();}
if constexpr(CUBE_READY)FinalizeSplitTTRows(partial,output,pipe);
else FinalizeSplitKND<PACKED_FINAL>(partial,output,s,pipe);
#endif
}
inline void CheckAcl(aclError error,const char*operation)
{
if(error!=ACL_SUCCESS)
throw std::runtime_error(std::string(operation)+" failed, ACL error="+std::to_string(error));
}
inline int64_t Ceil(int64_t v,int64_t d){return(v+d-1)/d;}
inline const TensorInfo&OnlyTensor(const TensorGroupInfo&group)
{
if(group.numTensors!=1||!group.tensors||!group.tensors[0].shape)
throw std::invalid_argument("expected exactly one tensor with shape metadata");
return group.tensors[0];
}
inline Shape Validate(const TensorGroupInfo&a,const TensorGroupInfo&b,const TensorGroupInfo&y,
bool tx1,bool tx2)
{
const auto&ai=OnlyTensor(a);
const auto&bi=OnlyTensor(b);
const auto&yi=OnlyTensor(y);
if(ai.numDims!=3||bi.numDims!=3||yi.numDims!=1)
throw std::invalid_argument("expected rank-3 inputs and rank-1 output");
Shape s{ai.shape[0],ai.shape[tx1?2:1],bi.shape[tx2?1:2],
ai.shape[tx1?1:2],ai.dtype,tx1?1:0,tx2?1:0};
if(s.b<1||s.b>64||s.m<1||s.m>8192||s.n<1||s.n>8192||
s.k<32||s.k>8192||s.k%8!=0)
throw std::invalid_argument("B/M/N/K outside competition limits");
if(bi.shape[0]!=s.b||bi.shape[tx2?2:1]!=s.k||yi.shape[0]!=s.b)
throw std::invalid_argument("batch/K/output mismatch; broadcast unsupported");
if((s.dtype!=1&&s.dtype!=2)||bi.dtype!=s.dtype||yi.dtype!=0)
throw std::invalid_argument("expected matching FP16/BF16 inputs and FP32 output");
if(s.b*s.m*s.k>(int64_t(1)<<26)||s.b*s.n*s.k>(int64_t(1)<<26))
throw std::invalid_argument("input exceeds 2^26 elements");
return s;
}
struct Plan{
Schedule schedule{};
AscendC::tiling::TCubeTiling cube{};
uint32_t cubeBlocks=0,finalBlocks=0;
uint64_t systemBytes=0,totalBytes=0;
bool small=false,micro=false,case12PackedA=false;
};
#ifdef BMMMS_TUNING
struct TuneConfig{int group=-1,rows=-1,dual=-1,early=-1,tree=-1,bm=0,bn=0,window=0,ns=0,ks=0,workers=0;};
inline TuneConfig&Tune(){static TuneConfig t;return t;}
#endif
inline bool Case12K16GroupZn(const Shape&s,const Plan&p)
{
#ifdef BMMMS_TUNING
const auto&tuning=Tune();
if(tuning.group>=0||tuning.rows>0||tuning.dual>=0||tuning.early>=0||tuning.tree>=0||
tuning.bm>0||tuning.bn>0||tuning.window>0||tuning.ns>0||tuning.ks>0||tuning.workers>0)return false;
#endif
const auto&d=p.schedule;
if(!p.case12PackedA||p.small||p.micro||s.b!=1||s.dtype!=2||!s.tx1||s.tx2||
s.m<1024||s.m>=2048||s.n<4096||s.n>=8192||s.k<1024||s.k>=2048||
s.m%128||s.k%128||s.n%1024||d.dual!=6||d.baseM!=128||d.baseN!=128||
d.b!=s.b||d.m!=s.m||d.n!=s.n||d.k!=s.k||
d.mTiles!=s.m/128||d.nTiles!=s.n/128||d.kSplit!=1||d.kChunk!=s.k||
d.window!=1||d.earlySum||d.tree||d.balance!=1||
d.microRows!=s.m||d.batchGroup!=8||d.vectorTile!=1024||
d.nSplit==0||d.nSplit>d.nTiles||d.workers==0||
d.workers>uint64_t(d.mTiles)*d.nSplit||d.workers!=p.cubeBlocks||p.finalBlocks!=1||
p.cube.baseK!=128)return false;
auto*platform=platform_ascendc::PlatformAscendCManager::GetInstance();
uint64_t ub=0,l1=0,l0a=0,l0b=0,l0c=0;
platform->GetCoreMemSize(platform_ascendc::CoreMemType::UB,ub);
platform->GetCoreMemSize(platform_ascendc::CoreMemType::L1,l1);
platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_A,l0a);
platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_B,l0b);
platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_C,l0c);
const uint64_t parts=Ceil(uint64_t(s.b)*d.nSplit*d.mTiles*d.baseM*4,512)*512;
const uint64_t ring=8ULL*d.workers*d.baseM*d.baseN;
const uint64_t bBytes=2ULL*s.b*d.nTiles*s.k*d.baseN,aBytes=2ULL*s.b*s.m*s.k;
const uint64_t ubBytes=4ULL*128*128+4ULL*16*1024+20ULL*128+12ULL*d.vectorTile+64+4096;
return d.workers<=platform->GetCoreNumAic()&&2ULL*d.workers<=platform->GetCoreNumAiv()&&
2ULL*128*s.k+4ULL*128*128+1024+4096<=std::min<uint64_t>(l1,512ULL*1024)&&
4ULL*128*128<=std::min<uint64_t>(l0a,65536)&&
4ULL*128*128<=std::min<uint64_t>(l0b,65536)&&
8ULL*128*128<=std::min<uint64_t>(l0c,131072)&&ubBytes<=ub&&
p.systemBytes&&p.systemBytes==Ceil(platform->GetLibApiWorkSpaceSize(),512)*512&&
p.totalBytes==p.systemBytes+parts+ring+bBytes+aBytes;
}
inline bool Case12PhasedPrep(const Shape&s,const Plan&p)
{
#if defined(__ASCENDC_SUPERKERNEL_AUTO_SYNC_ALL__)
return false;
#else
const auto&d=p.schedule;
return s.b==1&&s.dtype==2&&s.tx1&&!s.tx2&&
s.m==1280&&s.n==4096&&s.k==1536&&
d.mTiles==10&&d.nTiles==32&&d.nSplit==2&&d.workers==20&&
d.workers==uint64_t(d.mTiles)*d.nSplit&&
uint64_t(d.b)*d.mTiles*d.nSplit==d.workers;
#endif
}
enum ForcedKind{FORCED_NONE=0,FORCED_DOT=15,FORCED_TINY=16};
struct CaseProfile{
int dual=FORCED_NONE;
int bm=0,bn=0,window=0,ns=0,ks=0;
int cores=0;
bool locked=false;
};
inline bool TinyVectorFits(const Shape&s,uint64_t ub)
{
if(s.b<1||s.b>8||s.m<1||s.m>8||s.n<1||s.n>64||s.k<32||s.k>64||s.k%8!=0)
return false;
const uint64_t kp=Ceil(s.k,16)*16,np=Ceil(s.n,8)*8;
const uint64_t ar=s.b*s.m,br=s.b*s.n;
uint64_t bytes=6*(ar+br)*kp+4*ar*np*kp+4*ar*np+32*ar+32;
if(s.tx1||!s.tx2){
bytes+=768+(s.tx1?4*Ceil(ar*s.k,16)*16:32)+
(!s.tx2?4*Ceil(br*s.k,16)*16:32);
}else bytes+=64;
return bytes+1024<=ub;
}
inline uint32_t TinyVectorBatchGroup(const Shape&s,uint64_t ub)
{
if(s.m==1&&s.n==1)return 0;
for(int64_t batches=std::min<int64_t>(s.b,8);batches>=1;--batches){
Shape group=s;group.b=batches;
if(TinyVectorFits(group,ub))return static_cast<uint32_t>(batches);
}
return 0;
}
inline Plan TinyGroupPlan(const Shape&s,uint64_t ub,uint32_t aiv,uint32_t group=0)
{
if(!group)group=TinyVectorBatchGroup(s,ub);
Shape frame=s;frame.b=std::min<int64_t>(s.b,group);
if(!group||group>8||!TinyVectorFits(frame,ub))
throw std::invalid_argument("invalid grouped tiny UB/mask plan");
Plan p;auto&d=p.schedule;
d.b=s.b;d.m=s.m;d.n=s.n;d.k=s.k;d.dual=24;d.kSplit=1;d.kChunk=s.k;
d.batchGroup=group;d.balance=1;d.workers=Ceil(s.b,group);p.finalBlocks=d.workers;
if(p.finalBlocks>aiv)throw std::runtime_error("insufficient AIV cores for tiny groups");
return p;
}
inline CaseProfile ClassifyCase(const Shape&s,uint64_t ub)
{
CaseProfile c;
const bool kAligned=((s.k%8)==0);
if(kAligned&&s.k>=32&&s.k<=64){
if(s.m==1&&s.n==1){c.dual=FORCED_DOT;return c;}
if(TinyVectorFits(s,ub)){c.dual=FORCED_TINY;return c;}
}
if(s.k>=4096&&s.m>=16&&s.m<=128&&s.n<=256){
const uint64_t m16=Ceil(s.m,16)*16,n16=Ceil(s.n,16)*16;
const uint64_t vectorTile=std::min<uint64_t>(1024,(ub-64)/28/16*16);
const uint64_t finalBytes=3ULL*vectorTile*sizeof(float)+64;
const uint64_t vectorBytes=2ULL*m16*n16*sizeof(float)+18ULL*m16*sizeof(float)
+32+finalBytes;
if(vectorBytes<ub){c.dual=1;c.ks=4;return c;}
}
if(s.m<=128&&s.n>=4096&&s.k<=512){
c.dual=1;c.bn=128;c.window=2;c.ns=10;return c;
}
if(s.m>=2048&&s.n<=256&&s.k<=512){
c.bm=128;
c.bn=static_cast<int>(Ceil(s.n,16)*16);
c.window=1;c.ns=1;
if(s.m%16==0&&s.n%16==0&&s.k%16==0)c.dual=3;
else c.dual=14;
return c;
}
if(s.m>=1024&&s.n>=2048&&s.k>=1024&&s.n>=4*s.k){
c.dual=1;c.bm=128;c.bn=256;c.window=2;c.ns=5;return c;
}
return c;
}
inline bool NearMeasured(int64_t value,int64_t center)
{
int64_t lowerPower=1;
while(lowerPower*2<=center)lowerPower*=2;
return value>=std::max(lowerPower,center-center/10)&&
value<=std::min(lowerPower*2-1,center+center/10);
}
inline CaseProfile ClassifyMeasured(const Shape&s,int64_t aic,uint64_t ub,uint64_t l1,uint64_t l0c)
{
CaseProfile c;
if(s.b>=16&&s.b<32&&s.m>=32&&s.m<64&&
s.n>=128&&s.n<256&&s.k>=256&&s.k<512&&s.k%8==0&&
s.dtype==1&&s.tx1&&!s.tx2){
c.dual=(s.m%16==0&&s.n%16==0&&s.k%16==0)?3:14;
c.bm=Ceil(s.m,16)*16;c.bn=Ceil(s.n,16)*16;c.window=1;c.ns=1;c.ks=1;
c.cores=aic;c.locked=true;
return c;
}
const bool tiny=s.k<=64&&TinyVectorFits(s,ub);
const uint32_t tinyGroup=tiny?0:TinyVectorBatchGroup(s,ub);
if(tinyGroup&&Ceil(s.b,tinyGroup)<=2*aic){
c.dual=24;c.locked=true;return c;
}
const bool small4=s.b>=4&&s.b<=7&&s.m>=8&&s.m<16&&s.n>=16&&s.n<32&&s.dtype==2&&s.tx1&&s.tx2;
const bool small5=s.b>=8&&s.b<16&&s.m>=16&&s.m<32&&s.n>=32&&s.n<64&&s.dtype==1&&!s.tx1&&!s.tx2;
const bool small6=s.b>=8&&s.b<16&&s.m>=16&&s.m<32&&s.n>=64&&s.n<128&&s.dtype==2&&!s.tx1&&s.tx2;
if((small4||small5||small6)&&s.k>=128&&s.k<256&&s.b<=aic){
const int64_t mp=Ceil(s.m,16)*16,np=Ceil(s.n,16)*16,kp=Ceil(s.k,16)*16;
const uint64_t ubBytes=mp*np*4+2*mp*4+32+512;
if(ubBytes+1024<ub&&(mp+np)*kp*2<=l1&&mp*np*4<=l0c&&
mp*kp*2<=65536&&np*kp*2<=65536){
c.dual=19;c.bm=mp;c.bn=np;c.window=1;c.ns=1;c.ks=1;c.cores=aic;c.locked=true;
return c;
}
}
if(s.b==1&&aic==20){
const bool middle8=s.dtype==2&&s.tx1&&s.tx2&&s.m<=1536&&s.n<=1536&&s.k<=1536&&NearMeasured(s.m,1536)&&NearMeasured(s.n,1536)&&NearMeasured(s.k,1536);
const bool middle9=s.dtype==1&&!s.tx1&&s.tx2&&s.m>=2048&&s.m<4096&&s.n>=1024&&s.n<2048&&s.k>=1024&&s.k<2048;
const bool middle11=s.dtype==1&&s.tx1&&s.tx2&&NearMeasured(s.m,1536)&&NearMeasured(s.n,3072)&&NearMeasured(s.k,3072);
if(middle8||middle9||middle11){
c.dual=1;c.bm=128;c.bn=128;c.window=2;c.ns=middle11?5:3;c.ks=1;c.cores=20;c.locked=true;
return c;
}
}
return c;
}
inline Plan MakePlanImpl(const Shape&s,int64_t availableCoreNum,bool allowMeasured)
{
auto*platform=platform_ascendc::PlatformAscendCManager::GetInstance();
if(!platform)throw std::runtime_error("CANN platform information unavailable");
const int64_t aic=std::min<int64_t>(availableCoreNum,platform->GetCoreNumAic());
const int64_t aiv=platform->GetCoreNumAiv();
uint64_t ub=0,l1=0,l0c=0;
platform->GetCoreMemSize(platform_ascendc::CoreMemType::UB,ub);
platform->GetCoreMemSize(platform_ascendc::CoreMemType::L1,l1);
platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_C,l0c);
if(aic<=0||aiv<2||ub<4096||!l1||!l0c)
throw std::runtime_error("invalid platform capacity for dav-2201 MIX(1,2)");
Plan p;
#ifdef BMMMS_TUNING
const bool forcedPinned=(Tune().dual>=0);
#else
const bool forcedPinned=false;
#endif
const CaseProfile measured=(!forcedPinned&&allowMeasured)?ClassifyMeasured(s,std::min<int64_t>(aic,aiv/2),ub,l1,l0c):CaseProfile{};
const CaseProfile caseProfile=measured.dual!=FORCED_NONE?measured:(forcedPinned?CaseProfile{}:ClassifyCase(s,ub));
#ifdef BMMMS_TUNING
if(Tune().dual==24)
return TinyGroupPlan(s,ub,aiv,Tune().group>0?Tune().group:0);
#endif
if(caseProfile.dual==24)return TinyGroupPlan(s,ub,aiv);
if(caseProfile.dual==FORCED_DOT||caseProfile.dual==FORCED_TINY){
p.schedule.balance=1;
p.schedule.microRows=s.m;
p.schedule.batchGroup=s.b==1?8:0;
p.schedule.earlySum=0;
p.schedule.tree=0;
p.schedule.dual=static_cast<uint32_t>(caseProfile.dual);
p.schedule.kSplit=1;
p.schedule.kChunk=s.k;
p.schedule.b=s.b;p.schedule.m=s.m;p.schedule.n=s.n;p.schedule.k=s.k;
if(caseProfile.dual==FORCED_DOT){
p.schedule.batchGroup=Ceil(s.b,2)<=aiv?2:8;
p.finalBlocks=static_cast<uint32_t>(Ceil(s.b,p.schedule.batchGroup));
if(p.finalBlocks>aiv)
throw std::runtime_error("insufficient AIV cores for output groups");
}else{
if(s.b>1&&s.b<=aiv)return TinyGroupPlan(s,ub,aiv,1);
p.schedule.workers=1;
p.finalBlocks=1;
p.totalBytes=0;
}
return p;
}
const int64_t capacity=2*std::min<int64_t>(aic,aiv/2);
p.schedule.balance=1;
p.schedule.microRows=s.m;
p.schedule.batchGroup=s.b==1?8:0;
p.schedule.earlySum=0;
p.schedule.tree=0;
#ifdef BMMMS_TUNING
if(Tune().group>=0)p.schedule.batchGroup=Tune().group;
if(Tune().rows>0)p.schedule.microRows=std::min<int64_t>(s.m,Tune().rows);
if(Tune().early>=0)p.schedule.earlySum=Tune().early;
if(Tune().tree>=0)p.schedule.tree=Tune().tree;
#endif
#ifdef BMMMS_TUNING
if(Tune().dual>=5)p.schedule.dual=Tune().dual;
#endif
p.schedule.kSplit=1;
p.schedule.kChunk=s.k;
p.schedule.b=s.b;p.schedule.m=s.m;p.schedule.n=s.n;p.schedule.k=s.k;
p.schedule.vectorTile=static_cast<uint32_t>(std::min<uint64_t>(1024,(ub-64)/28/16*16));
p.finalBlocks=static_cast<uint32_t>(Ceil(s.b,8));
if(p.finalBlocks>aiv)throw std::runtime_error("insufficient AIV cores for output groups");
#ifdef BMMMS_TUNING
const bool familyPinned=(Tune().dual>=0&&Tune().dual<5);
#else
const bool familyPinned=false;
#endif
const int64_t unitRow=(s.m==1)?s.n:s.m;
if(!familyPinned&&p.schedule.dual==0&&(s.m==1||s.n==1)&&
!(s.m==1&&s.n==1)&&unitRow*s.k>=4096){
p.schedule.dual=((s.m==1&&s.tx2)||(s.n==1&&!s.tx1))?9:11;
}
if(s.m==1&&s.n==1&&!familyPinned){
if(p.schedule.dual==15&&(s.k>64||s.k%8!=0))
throw std::invalid_argument("dot_short requires K<=64 and K%8==0");
if(p.schedule.dual==15){
p.schedule.batchGroup=Ceil(s.b,2)<=aiv?2:8;
p.finalBlocks=static_cast<uint32_t>(Ceil(s.b,p.schedule.batchGroup));
}
if(p.schedule.dual==16&&!TinyVectorFits(s,ub))
throw std::invalid_argument("tiny direct exceeds fixed UB budget");
if(p.schedule.dual==10){
const uint32_t parts=std::min<int64_t>(4,capacity/p.finalBlocks);
p.schedule.kChunk=Ceil(Ceil(s.k,parts),16)*16;
p.schedule.kSplit=Ceil(s.k,p.schedule.kChunk);
p.finalBlocks*=p.schedule.kSplit;p.schedule.workers=p.finalBlocks;p.totalBytes=p.finalBlocks*32;
}
return p;
}
if(p.schedule.dual==16){
if(!TinyVectorFits(s,ub))
throw std::invalid_argument("tiny direct exceeds fixed UB budget");
p.schedule.workers=1;p.finalBlocks=1;p.totalBytes=0;return p;
}
if(p.schedule.dual==12){
if(s.n!=1||!s.tx1)throw std::invalid_argument("sumfirst requires N=1 and transposed A");
const uint64_t kt=Ceil(s.k,32);
p.schedule.workers=std::min<int64_t>(capacity,s.b*kt);
p.finalBlocks=p.schedule.workers;p.totalBytes=s.b*kt*32;return p;
}
if(p.schedule.dual==9||p.schedule.dual==11){
if(!((s.m==1||s.n==1)&&(p.schedule.dual==11||(s.m==1&&s.tx2)||(s.n==1&&!s.tx1))))
throw std::invalid_argument("vector GEMV requires contiguous matrix rows");
const uint64_t rp=Ceil(std::max(s.m,s.n),8)*8;
p.schedule.workers=std::min<int64_t>(capacity,s.b*rp/8);
p.finalBlocks=p.schedule.workers;p.totalBytes=s.b*rp*4;
return p;
}
if(p.schedule.dual==8){
if(s.m>8||s.n>8||(s.k!=32&&s.k!=64))
throw std::invalid_argument("batch micro requires M,N<=8 and exact K32/64");
p.micro=true;p.schedule.workers=p.finalBlocks;p.schedule.batchGroup=8;
return p;
}
const uint64_t smallRows=std::max(s.m,s.n);
const uint64_t smallStride=Ceil(s.k,16)*16;
if(!familyPinned&&(s.m==1||s.n==1)&&smallRows<=64&&s.k<=256&&
10*smallRows*smallStride+14*smallStride+Ceil(smallRows,8)*8*12+64<=ub){
p.small=true;
return p;
}
if(!familyPinned&&(s.tx1||(s.n<=8&&!s.tx2))&&
s.m<=16&&s.n<=32&&s.k<=64){
const uint64_t stride=s.k<=32?32:64;
const uint64_t np=Ceil(s.n,8)*8;
const uint64_t ac=Ceil(s.m*s.k,16)*16,bc=Ceil(s.n*s.k,16)*16;
const uint64_t ae=s.m*stride,be=np*stride;
const uint64_t bytes=2*(ac+bc)+4*(2*(ae+be)+std::max(ac,bc)+
p.schedule.microRows*np*stride+2*std::max(ae,be)+
p.schedule.microRows*np+2*Ceil(s.m,8)*8)+320+
std::max(1u,p.schedule.batchGroup)*32;
if(bytes+1024<=ub){
p.micro=true;
p.schedule.workers=std::min<int64_t>(capacity,
Ceil(s.b,std::max(1u,p.schedule.batchGroup)));
p.finalBlocks=p.schedule.workers;
p.totalBytes=p.schedule.batchGroup?0:s.b*32;
return p;
}
}
int tuneM=128,tuneN=128,tuneWindow=4,tuneSplit=0;
bool splitPinned=false;
if(s.m>=64&&s.n>=128&&(s.m<=128||(s.tx2&&s.n>2048))){
tuneM=64;tuneN=128;
}
if(s.m<=64&&s.n<=256&&s.k<=512){
tuneM=Ceil(s.m,16)*16;
}
if(s.m>=128&&s.n<=32&&s.k<=512){
tuneM=128;tuneN=Ceil(s.n,16)*16;
}
if(s.m>=128&&s.n<=2048&&(!s.tx2||s.k<=64))tuneSplit=1;
if(s.m<=32&&s.n<=128)tuneSplit=1;
tuneWindow=std::max(1,std::min(8,tuneWindow));
if(s.m<=32&&s.n<=32&&s.k>=2048&&s.b<capacity/4&&
(s.tx1||!s.tx2)){
const int64_t splits=std::min<int64_t>(capacity/s.b,Ceil(s.k,256));
p.schedule.kChunk=Ceil(Ceil(s.k,splits),32)*32;
p.schedule.kSplit=Ceil(s.k,p.schedule.kChunk);
tuneM=Ceil(s.m,16)*16;tuneN=Ceil(s.n,16)*16;
tuneWindow=1;
}
if(p.schedule.kSplit==1&&s.k>=4096&&s.m<=64&&s.n<=128&&s.n>16&&
s.b*Ceil(s.m,64)<=2){
tuneM=Ceil(s.m,16)*16;tuneN=32;
tuneWindow=1;tuneSplit=0;
}
if(p.schedule.kSplit==1&&s.k>=4096&&s.m>64&&s.m<=128&&s.n<=128){
tuneM=Ceil(s.m,16)*16;tuneN=Ceil(s.n,16)*16;
tuneWindow=1;tuneSplit=1;
}
int tuneCores=capacity/2;
if(p.schedule.kSplit>16){
const int64_t splits=std::min<int64_t>(16,capacity/s.b);
p.schedule.kChunk=Ceil(Ceil(s.k,splits),32)*32;
p.schedule.kSplit=Ceil(s.k,p.schedule.kChunk);
}
if(p.schedule.kSplit==1){
if(s.m>=64&&s.m<128&&s.n>128&&s.n<=256&&s.k<=256){
tuneM=64;tuneN=128;tuneWindow=1;tuneSplit=1;
}
if(s.m>=128&&s.n>=128&&s.n<=256&&s.k>=128){
tuneM=128;tuneN=128;
if(s.m>=256&&!s.tx1&&!s.tx2&&s.k>=256){
tuneM=64;tuneN=256;
if(s.b*Ceil(s.m,64)<=32)tuneCores=8;
}
}
if(s.m>=128&&s.n<=32&&s.k<=512){
tuneM=128;tuneN=Ceil(s.n,16)*16;tuneWindow=1;tuneSplit=1;
if(s.b*Ceil(s.m,128)<=64)tuneCores=8;
}
if(s.m>=128&&s.n>=512&&s.n<=2048){
tuneM=128;tuneN=(s.tx2&&s.n%256==0)?128:256;tuneSplit=1;
tuneWindow=s.k<=64?(s.tx2?2:1):(s.tx2&&!s.tx1?4:2);
if(s.k>64)tuneCores=16;
}
if(s.m<=32&&s.n>=1024&&s.k<=512){
tuneM=Ceil(s.m,16)*16;tuneN=256;
tuneWindow=s.tx2?1:2;tuneSplit=s.tx2?8:4;
}
if(s.m<=32&&s.n<=32&&s.k>=2048&&!s.tx1&&s.tx2){
tuneM=16;tuneN=Ceil(s.n,16)*16;tuneWindow=1;tuneSplit=1;
}
}
p.schedule.dual=1;
#ifdef BMMMS_TUNING
const bool manualPinned=(Tune().dual!=-1);
#else
const bool manualPinned=false;
#endif
if(p.schedule.kSplit==1&&!manualPinned&&
s.m%16==0&&s.n%16==0&&s.k%16==0&&
s.m<=256&&s.n<=256&&s.k<=512){
p.schedule.dual=3;
}
if(p.schedule.kSplit==1&&s.m>=128&&s.n>=512&&s.n<=2048&&
(s.m>=1024||s.k>=2048||(s.k>=512&&s.b*Ceil(s.m,128)>=16))){
tuneM=128;tuneN=s.tx2?128:256;
tuneWindow=s.k<=64?(s.tx2?4:2):(s.tx2?8:4);
tuneSplit=std::min<int64_t>(Ceil(s.n,tuneN),Ceil(16,s.b*Ceil(s.m,128)));
tuneCores=capacity/2;
if(s.k>=2048){
p.schedule.dual=2;
if(s.b*Ceil(s.m,128)<16){
const int64_t wideN=Ceil(s.n,256);
if(wideN>=2&&s.b*Ceil(s.m,128)*wideN>=16){
tuneN=256;tuneWindow=2;tuneSplit=0;
}else{
tuneN=128;tuneWindow=2;
tuneSplit=std::min<int64_t>(Ceil(s.n,128),Ceil(16,s.b*Ceil(s.m,128)));
}
if(s.tx1&&!s.tx2)p.schedule.dual=1;
}else{
tuneN=256;tuneWindow=2;tuneSplit=1;
}
}else if(s.k>=1024&&s.tx2&&s.b*s.m*s.k*2>=32LL*1024*1024){
p.schedule.dual=2;
}
}
if(p.schedule.kSplit==1&&s.tx1&&!s.tx2&&s.m>=128&&s.m%128&&
s.n>=512&&s.n<=2048&&s.k>=2048&&s.b*Ceil(s.m,128)<16){
tuneM=64;tuneN=256;tuneWindow=2;tuneSplit=1;tuneCores=16;
p.schedule.dual=1;
}
if(p.schedule.kSplit==1&&s.m>=1024&&s.n>256&&s.n<512&&s.k>=512){
tuneM=128;tuneN=s.tx2?128:256;tuneSplit=1;tuneCores=capacity/2;
tuneWindow=s.tx1&&s.tx2?4:2;
p.schedule.dual=s.tx1&&s.tx2?1:2;
}
#ifdef BMMMS_TUNING
if(Tune().ks>0){
p.schedule.kChunk=Ceil(Ceil(s.k,Tune().ks),32)*32;
p.schedule.kSplit=Ceil(s.k,p.schedule.kChunk);
if(p.schedule.kSplit>1){
tuneM=Ceil(s.m,16)*16;tuneN=Ceil(s.n,16)*16;tuneWindow=1;
}
}
if(Tune().dual>=0)p.schedule.dual=Tune().dual;
if(Tune().bm>0)tuneM=Tune().bm;
if(Tune().bn>0)tuneN=Tune().bn;
if(Tune().window>0)tuneWindow=Tune().window;
if(Tune().ns>0){tuneSplit=Tune().ns;splitPinned=true;}
#endif
if(caseProfile.dual!=FORCED_NONE){
p.schedule.dual=static_cast<uint32_t>(caseProfile.dual);
if(caseProfile.ks>0){
p.schedule.kChunk=Ceil(Ceil(s.k,caseProfile.ks),32)*32;
p.schedule.kSplit=Ceil(s.k,p.schedule.kChunk);
if(p.schedule.kSplit>1){
tuneM=Ceil(s.m,16)*16;
tuneN=Ceil(s.n,16)*16;
tuneWindow=1;
}
}
if(caseProfile.bm>0)tuneM=caseProfile.bm;
if(caseProfile.bn>0)tuneN=caseProfile.bn;
if(caseProfile.window>0)tuneWindow=caseProfile.window;
if(caseProfile.ns>0){tuneSplit=caseProfile.ns;splitPinned=true;}
if(caseProfile.cores>0)tuneCores=caseProfile.cores;
}
if(p.schedule.dual==14){
if(p.schedule.kSplit!=1)
throw std::invalid_argument("manual padded candidate requires complete K");
tuneWindow=1;
}
if(p.schedule.dual==3||p.schedule.dual==4||p.schedule.dual==6||p.schedule.dual==7){
if(s.m%16||s.n%16||s.k%16||p.schedule.kSplit!=1)
throw std::invalid_argument("manual candidate requires aligned full-K tiles");
tuneWindow=1;
}
if(s.b==1&&s.dtype==1&&s.tx1==0&&s.tx2==1&&
s.m>=2048&&s.m<4096&&
s.n>=1024&&s.n<2048&&
s.k>=1024&&s.k<2048&&s.k%8==0&&
p.schedule.dual==1&&p.schedule.kSplit==1){
tuneWindow=4;
}
if(s.b>=16&&s.b<32&&s.m>=32&&s.m<64&&
s.n>=128&&s.n<256&&s.k>=256&&s.k<512&&s.k%8==0&&
s.dtype==1&&s.tx1&&!s.tx2&&(p.schedule.dual==3||p.schedule.dual==14))
p.schedule.earlySum=1;
if(s.b==1&&s.dtype==1&&s.tx1&&s.tx2&&
s.m>=1024&&s.m<2048&&s.n>2048&&s.n<4096&&
s.k>=2048&&s.k<4096&&
s.m%16==0&&s.n%16==0&&s.k%16==0&&
measured.dual==FORCED_NONE&&p.schedule.dual==1&&
p.schedule.kSplit==1&&tuneM==64){
tuneM=128;
}
p.schedule.window=tuneWindow;
const int candidates[][2]={{tuneM,tuneN},{128,256},{128,128},{64,256},{64,128},{64,64},
{64,32},{32,256},{32,128},{32,64},{32,32},{16,64},{16,32},{16,16}};
bool found=false;
for(const auto&candidate:candidates){
const int bm=candidate[0],bn=candidate[1];
if(caseProfile.locked&&(bm!=tuneM||bn!=tuneN))continue;
if(p.schedule.kSplit>1&&(bm!=tuneM||bn!=tuneN))continue;
if(bm<=0||bn<=0||bm>((p.schedule.dual==3||p.schedule.dual==4||p.schedule.dual==6||p.schedule.dual==7)?256:128)||bn>256||bm%16||bn%16)continue;
const uint64_t finalBytes=3ULL*p.schedule.vectorTile*sizeof(float)+64;
const uint64_t cBuffers=(p.schedule.dual&&p.schedule.kSplit==1)?1ULL:2ULL;
const uint64_t vectorBytes=cBuffers*bm*bn*4+18ULL*bm*4+32+finalBytes;
if(bm>Ceil(s.m,16)*16||bn>Ceil(s.n,16)*16||
vectorBytes>=ub||uint64_t(bm)*bn*4>l0c)continue;
matmul_tiling::MatmulApiTiling api(*platform);
using Pos=matmul_tiling::TPosition;
using Fmt=matmul_tiling::CubeFormat;
using Dt=matmul_tiling::DataType;
const auto dt=s.dtype==1?Dt::DT_FLOAT16:Dt::DT_BF16;
api.SetAType(Pos::GM,Fmt::ND,dt,s.tx1!=0);
api.SetBType(Pos::GM,Fmt::ND,dt,s.tx2!=0);
if(p.schedule.dual)api.SetCType(Pos::GM,Fmt::ND,Dt::DT_FLOAT);
else api.SetCType(Pos::VECIN,Fmt::NZ,Dt::DT_FLOAT);
api.SetBias(false);
api.SetOrgShape(s.m,s.n,s.k);
api.SetShape(std::min<int64_t>(bm,s.m),std::min<int64_t>(bn*tuneWindow,s.n),p.schedule.kChunk);
api.SetBufferSpace(l1,l0c,ub-vectorBytes);
if(api.SetFixSplit(bm,bn,-1)==-1||api.GetTiling(p.cube)==-1)continue;
if(p.cube.baseM!=bm||p.cube.baseN!=bn||p.cube.baseK==0)continue;
p.cube.stepM=1;p.cube.stepN=1;
p.schedule.baseM=bm;p.schedule.baseN=bn;
found=true;
break;
}
if(!found){
if(measured.dual!=FORCED_NONE)return MakePlanImpl(s,availableCoreNum,false);
throw std::runtime_error("no valid Matmul tiling fits platform buffers/layout");
}
auto&d=p.schedule;
d.mTiles=Ceil(s.m,d.baseM);d.nTiles=Ceil(s.n,d.baseN);
const int64_t taskCapacity=d.dual?capacity/2:capacity;
d.nSplit=std::min<int64_t>(d.nTiles,Ceil(taskCapacity,s.b*d.mTiles));
if(tuneSplit>0)d.nSplit=std::min<uint32_t>(d.nTiles,tuneSplit);
if(p.schedule.balance&&d.kSplit==1&&d.nTiles>1&&!splitPinned){
const int64_t aicNum=static_cast<int64_t>(capacity)/2;
const int64_t base=s.b*d.mTiles;
const int64_t cap=std::min<int64_t>(capacity/2,tuneCores);
const int64_t tasks0=s.b*d.mTiles*d.nSplit;
const int64_t tasks1=s.b*d.mTiles*d.nTiles;
const int64_t workers0=std::min<int64_t>(cap,d.dual?tasks0:Ceil(tasks0,2));
const int64_t workers1=std::min<int64_t>(cap,d.dual?tasks1:Ceil(tasks1,2));
const bool legacy=d.dual==2&&base<16*aicNum;
const bool spread=d.dual!=2&&workers1>=2*workers0;
if(legacy||spread){
const int64_t want=std::max<int64_t>(2,16*aicNum/base);
int64_t chosen=std::min<int64_t>(d.nTiles,want);
if(spread&&chosen>2&&base*d.nTiles>cap){
for(int64_t ns=chosen;ns>=2;--ns){
if((base*ns)%cap==0){chosen=ns;break;}
}
}
d.nSplit=static_cast<uint32_t>(chosen);
}
}
d.window=std::min<uint32_t>(d.window,Ceil(d.nTiles,d.nSplit));
const int64_t tasks=d.kSplit>1?s.b*d.kSplit:s.b*d.mTiles*d.nSplit;
p.cubeBlocks=std::min<int64_t>(std::min<int64_t>(capacity/2,tuneCores),d.dual?tasks:Ceil(tasks,2));
#ifdef BMMMS_TUNING
if(Tune().workers>0)p.cubeBlocks=std::min<int64_t>(std::min<int64_t>(capacity/2,Tune().workers),d.dual?tasks:Ceil(tasks,2));
#endif
d.workers=p.cubeBlocks*(d.dual?1:2);
p.cube.usedCoreNum=d.workers;
p.systemBytes=Ceil(platform->GetLibApiWorkSpaceSize(),512)*512;
if(!p.systemBytes)throw std::runtime_error("Matmul system workspace size is zero");
const uint64_t partialBytes=d.kSplit>1?s.b*d.kSplit*d.baseM*d.baseN*sizeof(float):
s.b*d.nSplit*d.mTiles*d.baseM*sizeof(float);
p.totalBytes=p.systemBytes+Ceil(partialBytes,512)*512;
if((d.dual&&d.kSplit==1)||d.window>1)p.totalBytes+=static_cast<uint64_t>(d.workers)*
d.baseM*d.baseN*d.window*sizeof(float)*(d.dual?2:1);
if(d.dual==3||d.dual==4||d.dual==6||d.dual==7){
const uint64_t slots=(d.dual==4||d.dual==7)?4:2;
p.totalBytes=p.systemBytes+Ceil(partialBytes,512)*512+uint64_t(d.workers)*d.baseM*d.baseN*4*slots;
}
if(d.dual==3&&d.kSplit==1&&d.nSplit==1&&d.nTiles==1&&
d.baseM==128&&d.mTiles>=2*d.workers&&s.dtype==1&&!s.tx1&&!s.tx2&&
s.b==1&&s.m>=2048&&s.n<=128&&s.k<=256&&s.m%16==0&&s.n%16==0&&s.k%16==0){
uint64_t l0a=0,l0b=0;
platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_A,l0a);
platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_B,l0b);
uint32_t bk=256;
while(bk>64&&(d.baseM*bk*4>65536||d.baseN*bk*4>65536))bk/=2;
const uint64_t bBytes=uint64_t(d.baseN)*s.k*2;
if(uint64_t(d.baseM)*bk*4<=l0a&&bBytes<=l0b&&
uint64_t(d.baseM)*bk*4+bBytes+1536+4096<=l1){
d.tree|=16;d.earlySum=1;
}
}
return p;
}
inline Plan MakePlan(const Shape&s,int64_t availableCoreNum)
{
Plan p=MakePlanImpl(s,availableCoreNum,true);
if(s.b==1&&s.m==1025&&s.n==1031&&s.k==1032&&s.dtype==2&&s.tx1&&s.tx2){
auto*plat=platform_ascendc::PlatformAscendCManager::GetInstance();
uint64_t l1=0,l0a=0,l0b=0,l0c=0,ub=0;
plat->GetCoreMemSize(platform_ascendc::CoreMemType::L1,l1);
plat->GetCoreMemSize(platform_ascendc::CoreMemType::L0_A,l0a);
plat->GetCoreMemSize(platform_ascendc::CoreMemType::L0_B,l0b);
plat->GetCoreMemSize(platform_ascendc::CoreMemType::L0_C,l0c);
plat->GetCoreMemSize(platform_ascendc::CoreMemType::UB,ub);
constexpr uint32_t bm=112,bn=128,bk=128,ns=2,workers=20,pk=384,window=4;
const uint64_t kp=Ceil(s.k,16)*16,mt=Ceil(s.m,bm),nt=Ceil(s.n,bn),chunks=Ceil(s.m,bm/2);
const uint64_t parts=Ceil(4ULL*s.b*ns*mt*bm,512)*512;
const uint64_t ring=8ULL*workers*bm*bn*window,packed=2ULL*s.b*kp*(mt*bm+nt*bn);
const uint64_t consumerUbBytes=4ULL*bm*bn+20ULL*bm+12ULL*mt*bm+32+4096;
const uint64_t prepSlotElements=std::max<uint64_t>(16*Ceil(s.m,16)*16,uint64_t(std::max(bm,bn))*bk);
const uint64_t prepUbBytes=8ULL*prepSlotElements+4096;
const uint64_t ubBytes=std::max<uint64_t>(prepUbBytes,consumerUbBytes);
if(!p.small&&!p.micro&&!p.case12PackedA&&
p.schedule.b==s.b&&p.schedule.m==s.m&&p.schedule.n==s.n&&p.schedule.k==s.k&&
mt==10&&nt==9&&kp==1040&&mt*ns==workers&&
availableCoreNum>=workers&&plat->GetCoreNumAic()>=20&&plat->GetCoreNumAiv()>=40&&
2ULL*bm*kp+4ULL*bn*pk+4096<=std::min<uint64_t>(l1,512ULL*1024)&&
4ULL*bm*bk<=l0a&&4ULL*bn*bk<=l0b&&8ULL*bm*bn<=l0c&&ubBytes<=ub&&
p.systemBytes&&p.systemBytes==Ceil(plat->GetLibApiWorkSpaceSize(),512)*512&&
p.totalBytes>=p.systemBytes&&(parts+ring)%512==0&&packed%512==0){
auto&d=p.schedule;d=Schedule{};
d.b=s.b;d.m=s.m;d.n=s.n;d.k=s.k;d.baseM=bm;d.baseN=bn;d.mTiles=mt;d.nTiles=nt;
d.nSplit=ns;d.workers=workers;d.vectorTile=1024;d.window=window;d.kSplit=1;d.kChunk=pk;
d.microRows=s.m;d.batchGroup=8;d.dual=39;d.balance=1;
p.cubeBlocks=workers;p.finalBlocks=1;p.cube.usedCoreNum=workers;
p.cube.baseM=bm;p.cube.baseN=bn;p.cube.baseK=bk;p.cube.stepM=1;p.cube.stepN=1;
p.totalBytes=p.systemBytes+parts+ring+packed;
return p;
}
}
#ifdef BMMMS_TUNING
const bool dispatchPinned=Tune().dual>=0||Tune().early>=0||Tune().ns>0;
#else
const bool dispatchPinned=false;
#endif
#ifdef BMMMS_TUNING
const bool fullMPinned=dispatchPinned||Tune().bm>0||Tune().bn>0||
Tune().window>0||Tune().ks>0||Tune().workers>0||Tune().tree>=0;
#else
const bool fullMPinned=dispatchPinned;
