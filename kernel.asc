if constexpr(!PHASED_B)for(uint32_t i=0;i<slots;++i)AscendC::CrossCoreSetFlag<2,PIPE_MTE2>(4+i);for(int64_t task=worker;task<tasks;task+=s.workers){
const uint32_t ns=task%s.nSplit;const int64_t mt=(task/s.nSplit)%s.mTiles,batch=task/(s.nSplit*s.mTiles),m0=mt*s.baseM;
const int64_t remain=s.m-m0-rowStart;const uint32_t rows=remain<=0?0:(remain<s.baseM/2?remain:s.baseM/2);
const uint32_t begin=ns*s.nTiles/s.nSplit,end=(ns+1)*s.nTiles/s.nSplit;auto maxima=mq.AllocTensor<float>();
AscendC::Duplicate(maxima,-__builtin_inff(),s.baseM);AscendC::PipeBarrier<PIPE_V>();const uint32_t lead=FULL_A?1:((s.tree&1)?1:2);
if(begin<end)ManualCopyC(cq,ring,s,slots,slotSize,rowStart,rows,begin,sequence,span,end);
if(lead==2&&begin+span<end)ManualCopyC(cq,ring,s,slots,slotSize,rowStart,rows,begin+span,sequence+1,span,end);
for(uint32_t nt=begin;nt<end;nt+=span,++sequence){
if(rows){
auto c=cq.DeQue<float>();
const uint32_t limit=(end-nt<span?end-nt:span)*s.baseN;
const uint32_t cols=s.n-int64_t(nt)*s.baseN<limit?s.n-int64_t(nt)*s.baseN:limit;
