const uint32_t kr=s.k-k0<packRows?s.k-k0:packRows;const int64_t n0=int64_t(nt)*s.baseN;
const uint32_t cols=s.n-n0<s.baseN?s.n-n0:s.baseN;auto data=cq.AllocTensor<T>();
if(cols<s.baseN){AscendC::Duplicate(data.template ReinterpretCast<half>(),half(0),kr*s.baseN);
Fence<AscendC::HardEvent::V_MTE2>();}
