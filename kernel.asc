            }
        }
        if(residentA)Fence<AscendC::HardEvent::MTE1_MTE2>();
        if constexpr(RESIDENT_B)cachedBatch=batch;
    }
    for(uint32_t i=0;i<2;++i) {
        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(loadFree[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::M_MTE1>(loadFree[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::MTE1_M>(loadReady[i]);
    }
    for(uint32_t i=0;i<cBuffers;++i) {
        AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::FIX_M>(cFree[i]);
    }
    for(uint32_t i=0;i<slots;++i)AscendC::CrossCoreWaitFlag<2>(4+i);
#else
    AscendC::TQue<AscendC::TPosition::VECIN,2> cq;
    AscendC::TQue<AscendC::TPosition::VECOUT,1> mq;
    AscendC::TBuf<AscendC::TPosition::VECCALC> rb;
    pipe.InitBuffer(cq,2,(s.baseM/2)*s.baseN*span*4);
    pipe.InitBuffer(mq,1,s.baseM*4);pipe.InitBuffer(rb,4*s.baseM*4);
    auto row=rb.Get<float>();
    AscendC::TBuf<AscendC::TPosition::VECCALC> streamBuf;
    AscendC::LocalTensor<float> streamed;
    if constexpr(RESIDENT_B) {
        pipe.InitBuffer(streamBuf,s.baseM*2);
        streamed=streamBuf.Get<float>();
        AscendC::Duplicate(streamed,0.0f,s.baseM/2);
        AscendC::PipeBarrier<PIPE_V>();
    }
    if(packedBOffset) {
        // Reuse the C input queue before Cube produces any C. Each tile is a
        // disjoint [K-panel, N-tile] rectangle; padded N columns are zero only.
        AscendC::GlobalTensor<T> packed;
        packed.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(partial+packedBOffset));
        // The existing FP32 C slot holds baseM rows of 16-bit packed B.
        const uint32_t packRows=s.baseM;
        const uint32_t kPanels=(s.k+packRows-1)/packRows;
        const int64_t packTasks=s.b*s.nTiles*kPanels;
        for(int64_t t=AscendC::GetBlockIdx();t<packTasks;t+=2*s.workers) {
            const uint32_t kp=t%kPanels,nt=(t/kPanels)%s.nTiles;
            const int64_t batch=t/(int64_t(kPanels)*s.nTiles),k0=int64_t(kp)*packRows;
            const uint32_t kr=s.k-k0<packRows?s.k-k0:packRows;
            const int64_t n0=int64_t(nt)*s.baseN;
            const uint32_t cols=s.n-n0<s.baseN?s.n-n0:s.baseN;
            auto data=cq.AllocTensor<T>();
            if(cols<s.baseN) {
                AscendC::Duplicate(data.template ReinterpretCast<half>(),half(0),kr*s.baseN);
                Fence<AscendC::HardEvent::V_MTE2>();
            }
            AscendC::DataCopyExtParams cp{static_cast<uint16_t>(kr),cols*2,
                static_cast<uint32_t>((s.n-cols)*2),(s.baseN-cols)/16,0};
            AscendC::DataCopyPadExtParams<T> pad{false,0,0,T(0)};
            AscendC::DataCopyPad(data,b[batch*s.n*s.k+k0*s.n+n0],cp,pad);
            cq.EnQue(data);data=cq.DeQue<T>();
            Fence<AscendC::HardEvent::V_MTE3>();
            AscendC::DataCopy(packed[(batch*s.nTiles+nt)*s.k*s.baseN+k0*s.baseN],data,kr*s.baseN);
            Fence<AscendC::HardEvent::MTE3_V>();
            cq.FreeTensor(data);
        }
        // The signal is issued only after every packed panel is globally visible.
        AscendC::SyncAll<true>();
        AscendC::CrossCoreSetFlag<2,PIPE_MTE3>(12);
    }
    for(uint32_t i=0;i<slots;++i)AscendC::CrossCoreSetFlag<2,PIPE_MTE2>(4+i);
    for(int64_t task=worker;task<tasks;task+=s.workers) {
        const uint32_t ns=task%s.nSplit;
        const int64_t mt=(task/s.nSplit)%s.mTiles,batch=task/(s.nSplit*s.mTiles),m0=mt*s.baseM;
        const int64_t remain=s.m-m0-rowStart;
        const uint32_t rows=remain<=0?0:(remain<s.baseM/2?remain:s.baseM/2);
        const uint32_t begin=ns*s.nTiles/s.nSplit,end=(ns+1)*s.nTiles/s.nSplit;
        auto maxima=mq.AllocTensor<float>();
        AscendC::Duplicate(maxima,-__builtin_inff(),s.baseM);AscendC::PipeBarrier<PIPE_V>();

        const uint32_t lead=FULL_A?1:((s.tree&1)?1:2);
        if(begin<end)ManualCopyC(cq,ring,s,slots,slotSize,rowStart,rows,begin,sequence,span,end);
        if(lead==2 && begin+span<end)ManualCopyC(cq,ring,s,slots,slotSize,rowStart,rows,begin+span,sequence+1,span,end);
        for(uint32_t nt=begin;nt<end;nt+=span,++sequence) {
            if(rows) {
                auto c=cq.DeQue<float>();
                const uint32_t limit=(end-nt<span?end-nt:span)*s.baseN;
                const uint32_t cols=s.n-int64_t(nt)*s.baseN<limit?s.n-int64_t(nt)*s.baseN:limit;
                const uint32_t groups=(cols+63)/64;
                for(uint32_t g=0;g<groups;++g) {
                    const uint32_t n=cols-g*64<64?cols-g*64:64;
                    AscendC::WholeReduceMax(row[g*s.baseM],c[g*64],uint64_t(n),rows,1,1,span*s.baseN/8,
                        AscendC::ReduceOrder::ORDER_ONLY_VALUE);
                }
                AscendC::PipeBarrier<PIPE_V>();
                for(uint32_t step=1;step<groups;step*=2) {
                    for(uint32_t g=0;g+step<groups;g+=2*step)
                        AscendC::Max(row[g*s.baseM],row[g*s.baseM],row[(g+step)*s.baseM],rows);
                    AscendC::PipeBarrier<PIPE_V>();
                }
                AscendC::Max(maxima,maxima,row,rows);AscendC::PipeBarrier<PIPE_V>();
                cq.FreeTensor(c);
            }
            if(nt+lead*span<end)ManualCopyC(cq,ring,s,slots,slotSize,rowStart,rows,nt+lead*span,sequence+lead,span,end);
        }
        if constexpr(RESIDENT_B) {
            if(rows)AscendC::Add(streamed,streamed,maxima,rows);
            AscendC::PipeBarrier<PIPE_V>();
        } else if(s.earlySum && s.nSplit==1) {
            // Each AIV owns one aligned slot. Sum only after the complete N maximum.
            if(rows) {
                AscendC::ReduceSum<float,true>(row,maxima,row[s.baseM],rows);
                AscendC::PipeBarrier<PIPE_V>();
            }
            AscendC::Duplicate(maxima,0.0f,8);AscendC::PipeBarrier<PIPE_V>();
            if(rows)AscendC::Adds(maxima,row,0.0f,1);
            mq.EnQue(maxima);maxima=mq.DeQue<float>();
            AscendC::DataCopy(partials[task*16+sub*8],maxima,8);
        } else {
            mq.EnQue(maxima);maxima=mq.DeQue<float>();
            AscendC::DataCopy(partials[(batch*s.nSplit+ns)*s.mTiles*s.baseM+m0+rowStart],maxima,s.baseM/2);
        }
        mq.FreeTensor(maxima);
    }
    if constexpr(RESIDENT_B) {
        auto last=mq.AllocTensor<float>();
        AscendC::Duplicate(last,0.0f,8);AscendC::PipeBarrier<PIPE_V>();
        AscendC::ReduceSum<float,true>(last,streamed,row,s.baseM/2);
        mq.EnQue(last);last=mq.DeQue<float>();
        AscendC::DataCopy(partials[worker*16+sub*8],last,8);
        mq.FreeTensor(last);
    }
    AscendC::SyncAll<true>();
    if(s.earlySum && s.nSplit==1) {
        if constexpr(RESIDENT_B)s.mTiles=s.workers*2;
        else s.mTiles*=2;
        FinalizeEarly(partial,output,s,pipe);
    } else if(FULL_A && s.b==1) {
        if(AscendC::GetBlockIdx()==0) {
            // All producers have completed. One contiguous DMA replaces nSplit serial DMAs.
            AscendC::TBuf<AscendC::TPosition::VECCALC> allBuf,sumBuf,tmpBuf;
            pipe.InitBuffer(allBuf,s.nSplit*s.baseM*4);
            pipe.InitBuffer(sumBuf,32);pipe.InitBuffer(tmpBuf,s.baseM*4);
            auto all=allBuf.Get<float>(),sum=sumBuf.Get<float>(),tmp=tmpBuf.Get<float>();
            AscendC::DataCopy(all,partials,s.nSplit*s.baseM);
            Fence<AscendC::HardEvent::MTE2_V>();
            for(uint32_t ns=1;ns<s.nSplit;++ns) {
                AscendC::Max(all,all,all[ns*s.baseM],s.m);
                AscendC::PipeBarrier<PIPE_V>();
            }
            AscendC::ReduceSum<float,true>(sum,all,tmp,s.m);
            Fence<AscendC::HardEvent::V_MTE3>();
            AscendC::GlobalTensor<float> out;out.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(output));
            AscendC::DataCopyExtParams cp{1,4,0,0,0};AscendC::DataCopyPad(out,sum,cp);
        }
    } else if(int64_t(AscendC::GetBlockIdx())*8<s.b)FinalizeRows(partial,output,s,pipe);
#endif
}
// Optional MDL package-copy candidate; same ring-buffer ownership as Norm.
// A/B retain their physical strides; Kc is the bounded C-window row stride.
constexpr auto DualMdlConfig()
{
    auto cfg = CFG_MDL;
    cfg.enableMixDualMaster = true;
    cfg.enableL1BankConflictOptimise = true;
    cfg.enableKdimReorderLoad = true;
    return cfg;
}
constexpr auto DUAL_MDL_CONFIG = DualMdlConfig();
template <typename T, bool TX1, bool TX2>
__schedmode__(1) __global__ __mix__(1, 2) void bmmms_dual_mdl(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR partial, GM_ADDR output, GM_ADDR workspace,
    AscendC::tiling::TCubeTiling tiling, Schedule s)
{
    AscendC::TPipe pipe;
    using A=matmul::MatmulType<AscendC::TPosition::GM,CubeFormat::ND,T,TX1,LayoutMode::NONE,true>;
    using B=matmul::MatmulType<AscendC::TPosition::GM,CubeFormat::ND,T,TX2,LayoutMode::NONE,true>;
    using C=matmul::MatmulType<AscendC::TPosition::GM,CubeFormat::ND,float>;
    using Bias=matmul::MatmulType<AscendC::TPosition::GM,CubeFormat::ND,float>;
    matmul::Matmul<A,B,C,Bias,DUAL_MDL_CONFIG> mm;
    REGIST_MATMUL_OBJ(&pipe, workspace, mm, &tiling);
    AscendC::GlobalTensor<T> a,b;
    AscendC::GlobalTensor<float> ring,partials;
    a.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x1));
    b.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x2));
    partials.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(partial));
    const uint32_t width=s.baseN*s.window;
    const uint32_t slotSize=s.baseM*width;
    const int64_t partialCount=s.b*s.nSplit*s.mTiles*s.baseM;
    const int64_t alignedCount=(partialCount+127)/128*128;
#ifdef __DAV_CUBE__
    const uint32_t worker=AscendC::GetBlockIdx();
#else
    const uint32_t worker=AscendC::GetBlockIdx()/2;
    const uint32_t sub=AscendC::GetBlockIdx()%2;
    const uint32_t rowStart=sub*(s.baseM/2);
#endif
    ring.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(partial)+alignedCount+
                         int64_t(worker)*2*slotSize);
    const int64_t tasks=s.b*s.mTiles*s.nSplit;
    uint32_t sequence=0;
#ifdef __DAV_CUBE__
    AscendC::SetAtomicNone();
    AscendC::SetLoadDataBoundary(uint64_t(0));
    AscendC::SetLoadDataPaddingValue(uint64_t(0));
    for(int64_t task=worker;task<tasks;task+=s.workers) {
        const uint32_t ns=task%s.nSplit;
        const int64_t mt=(task/s.nSplit)%s.mTiles;
        const int64_t batch=task/(s.nSplit*s.mTiles);
        const int64_t m0=mt*s.baseM;
        const uint32_t rows=s.m-m0<s.baseM?s.m-m0:s.baseM;
        const uint32_t begin=ns*s.nTiles/s.nSplit,end=(ns+1)*s.nTiles/s.nSplit;
        for(uint32_t nt=begin;nt<end;nt+=s.window,++sequence) {
            const uint32_t slot=sequence&1;
            AscendC::CrossCoreWaitFlag<2>(2+slot);
            const int64_t n0=int64_t(nt)*s.baseN;
            const uint32_t tiles=end-nt<s.window?end-nt:s.window;
            const uint32_t cols=s.n-n0<tiles*s.baseN?s.n-n0:tiles*s.baseN;
            mm.SetOrgShape(s.m,s.n,s.k,s.k,width);
            mm.SetTensorA(a[batch*s.m*s.k+(TX1?m0:m0*s.k)],TX1);
            mm.SetTensorB(b[batch*s.n*s.k+(TX2?n0*s.k:n0)],TX2);
            mm.SetTail(rows,cols,s.k);
            mm.template IterateAll<false>(ring[slot*slotSize]);
            AscendC::CrossCoreSetFlag<2,PIPE_FIX>(slot);
        }
    }
    mm.End();
    // Consume each slot's last release, including an unused initial credit.
    AscendC::CrossCoreWaitFlag<2>(2);
    AscendC::CrossCoreWaitFlag<2>(3);
#else
    AscendC::TQue<AscendC::TPosition::VECIN,2> cq;
    AscendC::TQue<AscendC::TPosition::VECOUT,1> mq;
    AscendC::TBuf<AscendC::TPosition::VECCALC> rowBuf,tmpBuf,valBuf;
    pipe.InitBuffer(cq,2,(s.baseM/2)*s.baseN*4);
    pipe.InitBuffer(mq,1,s.baseM*4);
    pipe.InitBuffer(rowBuf,s.baseM*4);pipe.InitBuffer(tmpBuf,s.baseM*4);
    pipe.InitBuffer(valBuf,32);
    auto row=rowBuf.Get<float>(),tmp=tmpBuf.Get<float>(),val=valBuf.Get<float>();
    AscendC::CrossCoreSetFlag<2,PIPE_MTE2>(2);
    AscendC::CrossCoreSetFlag<2,PIPE_MTE2>(3);
    // The CANN 9 dual-master wrapper still has a lightweight iteration-start
    // handshake (flag 9). Post two iterations ahead; completion uses our slots.
    uint32_t totalWindows=0;
    for(int64_t task=worker;task<tasks;task+=s.workers) {
        const uint32_t ns=task%s.nSplit;
        const uint32_t begin=ns*s.nTiles/s.nSplit,end=(ns+1)*s.nTiles/s.nSplit;
        totalWindows+=(end-begin+s.window-1)/s.window;
    }
    for(uint32_t i=0;i<2 && i<totalWindows;++i) mm.template IterateAll<false>(ring);
    for(int64_t task=worker;task<tasks;task+=s.workers) {
        const uint32_t ns=task%s.nSplit;
        const int64_t mt=(task/s.nSplit)%s.mTiles;
        const int64_t batch=task/(s.nSplit*s.mTiles);
        const int64_t m0=mt*s.baseM;
        const int64_t remaining=s.m-m0-rowStart;
        const uint32_t rows=remaining<=0?0:(remaining<s.baseM/2?remaining:s.baseM/2);
        const uint32_t begin=ns*s.nTiles/s.nSplit,end=(ns+1)*s.nTiles/s.nSplit;
        auto maxima=mq.AllocTensor<float>();
        AscendC::Duplicate(maxima,-__builtin_inff(),s.baseM);
        AscendC::PipeBarrier<PIPE_V>();
        for(uint32_t nt=begin;nt<end;nt+=s.window,++sequence) {
            const uint32_t slot=sequence&1;
            AscendC::CrossCoreWaitFlag<2>(slot);
            const uint32_t tiles=end-nt<s.window?end-nt:s.window;
            for(uint32_t p=0;rows && p<tiles;++p) {
                const int64_t n0=int64_t(nt+p)*s.baseN;
                const uint32_t cols=s.n-n0<s.baseN?s.n-n0:s.baseN;
                auto c=cq.AllocTensor<float>();
                const uint32_t padded=(cols+7)/8*8;
                AscendC::DataCopyExtParams cp{static_cast<uint16_t>(rows),cols*4,
                    (width-cols)*4,(s.baseN-padded)/8,0};
                AscendC::DataCopyPadExtParams<float> pad{true,0,static_cast<uint8_t>(padded-cols),-__builtin_inff()};
                AscendC::DataCopyPad(c,ring[slot*slotSize+rowStart*width+p*s.baseN],cp,pad);
                cq.EnQue(c);c=cq.DeQue<float>();
                for(uint32_t col=0;col<cols;col+=64) {
                    const uint32_t n=cols-col<64?cols-col:64;
                    AscendC::WholeReduceMax(row,c[col],uint64_t(n),rows,1,1,s.baseN/8,
                                            AscendC::ReduceOrder::ORDER_ONLY_VALUE);
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::BinaryRepeatParams rp{1,1,1,8,8,8};
                    if(rows/64) AscendC::Max(maxima,maxima,row,uint64_t(64),rows/64,rp);
                    if(rows%64) AscendC::Max(maxima[(rows/64)*64],maxima[(rows/64)*64],row[(rows/64)*64],
                                              uint64_t(rows%64),1,rp);
                    AscendC::PipeBarrier<PIPE_V>();
                }
                cq.FreeTensor(c);
            }
            AscendC::CrossCoreSetFlag<2,PIPE_MTE2>(2+slot);
            if(sequence+2<totalWindows) mm.template IterateAll<false>(ring);
        }
        if(s.earlySum && s.nSplit==1) {
            AscendC::Duplicate(val,0.0f,8);AscendC::PipeBarrier<PIPE_V>();
            if(rows) AscendC::ReduceSum<float,true>(val,maxima,tmp,rows);
            Fence<AscendC::HardEvent::V_MTE3>();
            AscendC::DataCopy(partials[task*16+sub*8],val,8);
            Fence<AscendC::HardEvent::MTE3_V>();
            mq.FreeTensor(maxima);
        } else {
            mq.EnQue(maxima);maxima=mq.DeQue<float>();
            AscendC::DataCopy(partials[(batch*s.nSplit+ns)*s.mTiles*s.baseM+m0+rowStart],maxima,s.baseM/2);
            mq.FreeTensor(maxima);
        }
    }
    AscendC::SyncAll<true>();
    if(s.earlySum && s.nSplit==1) {s.mTiles*=2;FinalizeEarly(partial,output,s,pipe);}
    else if(int64_t(AscendC::GetBlockIdx())*8<s.b) FinalizeRows(partial,output,s,pipe);
#endif
}

template<typename T,bool PAD_MN>
__schedmode__(1) __global__ __mix__(1,2) void bmmms_manual_case7_direct(
    GM_ADDR x1,GM_ADDR x2,GM_ADDR partial,GM_ADDR output,Schedule s)
{
    constexpr bool TX1=true,TX2=false,RESIDENT_PAD=false,FULL_A=false,RESIDENT_B=false;
    AscendC::TPipe pipe;
    // FULL_A appends adjacent C tiles in the existing two-tile L0C/ring budget.
    // A pair uses one FP32 handoff; odd partition tails still carry every column.
    const uint32_t span=FULL_A?2:1;
    const uint32_t slots=FULL_A?1:((s.dual==4 || s.dual==7)?4:2);
    const uint32_t slotSize=span*s.baseM*s.baseN;
    const int64_t partialCount=s.b*s.nSplit*s.mTiles*s.baseM;
    const int64_t alignedCount=(partialCount+127)/128*128;
#ifdef __DAV_CUBE__
    const uint32_t worker=AscendC::GetBlockIdx();
#else
    const uint32_t worker=AscendC::GetBlockIdx()/2,sub=AscendC::GetBlockIdx()%2;
    const uint32_t rowStart=0;
#endif
    AscendC::GlobalTensor<T> a,b;
    AscendC::GlobalTensor<float> ring,partials;
    a.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x1));
    b.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x2));
    partials.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(partial));
    ring.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(partial)+alignedCount+
        int64_t(worker)*slots*slotSize);
    const int64_t tasks=s.b*s.mTiles*s.nSplit;
    uint32_t sequence=0;
#ifdef __DAV_CUBE__
    AscendC::SetAtomicNone();AscendC::SetLoadDataBoundary(uint64_t(0));
    AscendC::SetLoadDataPaddingValue(uint64_t(0));
    uint32_t bk=256;
    if constexpr(FULL_A) bk=s.k;
    else if constexpr(RESIDENT_PAD) bk=s.kChunk;
    else while(bk>64 && (s.baseM*bk*4>65536 || s.baseN*bk*4>65536))bk/=2;
    // RESIDENT_PAD is launched only after the host has checked all local capacities.
    const bool residentA=FULL_A || RESIDENT_PAD || (!PAD_MN && s.dual>=6 &&
        uint64_t(s.baseM)*s.k*2+uint64_t(s.baseN)*bk*4+1024<=512*1024);
    const uint32_t cBuffers=FULL_A?1:RESIDENT_PAD?((s.tree&8)?1:2):(slotSize*8<=131072?2:1);
    AscendC::TQue<AscendC::TPosition::A1,2> aq;
    AscendC::TQue<AscendC::TPosition::B1,2> bq;
    AscendC::TBuf<AscendC::TPosition::A2> ab;
    AscendC::TBuf<AscendC::TPosition::B2> bb;
    AscendC::TBuf<AscendC::TPosition::CO1> cb;
    AscendC::TBuf<AscendC::TPosition::A1> residentBuf;
    AscendC::TBuf<AscendC::TPosition::B1> residentBbuf;
    if constexpr(RESIDENT_B)pipe.InitBuffer(residentBbuf,s.baseN*s.k*2);
    pipe.InitBuffer(residentBuf,residentA?s.baseM*s.k*2:512);
    pipe.InitBuffer(aq,2,residentA?512:s.baseM*bk*2);pipe.InitBuffer(bq,2,RESIDENT_B?512:s.baseN*bk*2);
    pipe.InitBuffer(ab,(FULL_A?1:2)*s.baseM*bk*2);
    pipe.InitBuffer(bb,RESIDENT_B?s.baseN*s.k*2:(FULL_A?1:2)*s.baseN*bk*2);
    pipe.InitBuffer(cb,cBuffers*slotSize*4);
    auto a2all=ab.Get<T>(),b2all=bb.Get<T>();auto cAll=cb.Get<float>();
    // TPipe owns M_MTE1 events 0, 1 and 2 on DAV-2201. Never signal them here.
    event_t loadFree[2],loadReady[2],cFree[2];
    for(uint32_t i=0;i<2;++i) {
        loadFree[i]=static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::M_MTE1>());
        loadReady[i]=static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::MTE1_M>());
        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(loadFree[i]);
    }
    for(uint32_t i=0;i<cBuffers;++i) {
        cFree[i]=static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::FIX_M>());
        AscendC::SetFlag<AscendC::HardEvent::FIX_M>(cFree[i]);
    }
    uint32_t kSequence=0;
    int64_t cachedBatch=-1;
    for(int64_t task=worker;task<tasks;task+=s.workers) {
        const uint32_t ns=task%s.nSplit;
        const int64_t mt=(task/s.nSplit)%s.mTiles,batch=task/(s.nSplit*s.mTiles);
        const int64_t m0=mt*s.baseM;
        const uint32_t validRows=s.m-m0<s.baseM?s.m-m0:s.baseM;
        // ND2NZ pads D automatically; align the L1 slab stride in N as well.
        // Missing N rows are explicitly zeroed and D padding is supplied by DMA.
        // Only valid rows/columns are reduced on AIV.
        const uint32_t rows=PAD_MN?(validRows+15)/16*16:validRows;
        const uint32_t begin=ns*s.nTiles/s.nSplit,end=(ns+1)*s.nTiles/s.nSplit;
        const bool refreshB=RESIDENT_B && cachedBatch!=batch;
        if constexpr(RESIDENT_B) {
            if(refreshB) {
                // The previous task has completed M before Fixpipe, so cached L0B is free.
                auto fullB=residentBbuf.Get<T>();
                AscendC::Nd2NzParams bp;
                bp.ndNum=1;bp.nValue=s.k;bp.dValue=s.n;
                bp.srcDValue=s.n;bp.dstNzC0Stride=s.k;bp.dstNzNStride=1;
                AscendC::DataCopy(fullB,b[batch*s.n*s.k],bp);
                Fence<AscendC::HardEvent::MTE2_MTE1>();
            }
        }
        AscendC::LocalTensor<T> resident;
        if(residentA) {
            resident=residentBuf.Get<T>();
            AscendC::Nd2NzParams ap;
            ap.ndNum=1;
            ap.nValue=TX1?s.k:(RESIDENT_PAD?validRows:rows);
            ap.dValue=TX1?(RESIDENT_PAD?validRows:rows):s.k;
            ap.srcDValue=TX1?s.m:s.k;
            ap.dstNzC0Stride=RESIDENT_PAD?(ap.nValue+15)/16*16:ap.nValue;
            ap.dstNzNStride=1;
            if constexpr(RESIDENT_PAD) ManualZeroNZTail(resident,ap.nValue,ap.dValue);
            AscendC::DataCopy(resident,a[batch*s.m*s.k+(TX1?m0:m0*s.k)],ap);
            Fence<AscendC::HardEvent::MTE2_MTE1>();
        }
        for(uint32_t nt=begin;nt<end;++nt) {
            const uint32_t slot=sequence%slots,cs=sequence%cBuffers;
            if constexpr(!FULL_A && !RESIDENT_PAD)AscendC::CrossCoreWaitFlag<2>(4+slot);
            const uint32_t pairIndex=(nt-begin)%span;
            if(pairIndex==0)AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree[cs]);
            const int64_t n0=int64_t(nt)*s.baseN;
            const uint32_t validCols=s.n-n0<s.baseN?s.n-n0:s.baseN;
            const uint32_t cols=PAD_MN?(validCols+15)/16*16:validCols;
            auto c=cAll[cs*slotSize+pairIndex*s.baseN*rows];

            ManualCopyK<T,TX1,TX2,PAD_MN,RESIDENT_B>(aq,bq,a,b,s,bk,validRows,validCols,batch,m0,n0,0,residentA);if(s.k>bk)ManualCopyK<T,TX1,TX2,PAD_MN,RESIDENT_B>(aq,bq,a,b,s,bk,validRows,validCols,batch,m0,n0,bk,residentA);
            for(uint32_t k0=0;k0<s.k;k0+=bk,++kSequence) {
                const uint32_t validCount=s.k-k0<bk?s.k-k0:bk;
                const uint32_t count=PAD_MN?(validCount+15)/16*16:validCount;
                const uint32_t ks=FULL_A?0:(kSequence&1);
                auto a1=residentA?resident:aq.DeQue<T>();
                // Resident A can enter MTE1 before the independent B DMA completes.
                AscendC::LocalTensor<T> b1;
                if constexpr(!RESIDENT_PAD)b1=RESIDENT_B?residentBbuf.Get<T>():bq.DeQue<T>();
                auto a2=a2all[ks*s.baseM*bk],b2=b2all[RESIDENT_B?k0*s.baseN:ks*s.baseN*bk];
                AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(loadFree[ks]);
                AscendC::LoadData2DParams lp;
                lp.ifTranspose=TX1;
                // FULL_A retains the complete A operand in L0A for every N tile of this task.
                if(!FULL_A || nt==begin) {
                if(((s.tree&4) || RESIDENT_PAD) && residentA) {
                    // Treat the resident NZ panel as NC1HWC0 with H=1 and a 1x1 filter.
                    // LoadData3D selects the complete K slab and converts it to L0A ZZ.
                    AscendC::LoadData3DParamsV2<T> panel;
                    panel.l1H=1;panel.l1W=TX1?s.k:rows;
                    panel.channelSize=TX1?rows:s.k;
                    panel.mStartPt=TX1?k0:0;panel.kStartPt=TX1?0:k0;
                    panel.mExtension=TX1?count:rows;panel.kExtension=TX1?rows:count;
                    panel.enTranspose=TX1;
                    AscendC::LoadData(a2,a1,panel);
                } else if constexpr(TX1) {
                    lp.srcStride=1;
                    if(residentA) {
                        if((s.tree&2) && rows>count) {
                            lp.repeatTimes=rows/16;lp.srcStride=s.k/16;lp.dstGap=count/16-1;
                            for(uint32_t ki=0;ki<count/16;++ki)
                                AscendC::LoadData(a2[ki*256],a1[k0*16+ki*256],lp);
                        } else {
                            lp.repeatTimes=count/16;
                            for(uint32_t mi=0;mi<rows/16;++mi)
                                AscendC::LoadData(a2[mi*count*16],a1[mi*s.k*16+k0*16],lp);
                        }
                    } else {
                        lp.repeatTimes=rows*count/256;AscendC::LoadData(a2,a1,lp);
                    }
                } else {
                    if((s.tree&2) && rows>count) {
                        lp.repeatTimes=rows/16;lp.srcStride=1;lp.dstGap=count/16-1;
                        for(uint32_t ki=0;ki<count/16;++ki)
                            AscendC::LoadData(a2[ki*256],a1[ki*rows*16+(residentA?k0*rows:0)],lp);
                    } else {
                        lp.repeatTimes=count/16;lp.srcStride=rows/16;
                        for(uint32_t mi=0;mi<rows/16;++mi)AscendC::LoadData(a2[mi*count*16],a1[mi*256+(residentA?k0*rows:0)],lp);
                    }
                }
                }
                if constexpr(RESIDENT_PAD)b1=bq.DeQue<T>();
                if constexpr(RESIDENT_B) {
                    if(refreshB) {
                        lp.dstGap=0;lp.ifTranspose=true;
                        lp.repeatTimes=cols/16;lp.srcStride=s.k/16;
                        for(uint32_t ki=0;ki<count/16;++ki)
                            AscendC::LoadData(b2[ki*cols*16],b1[k0*16+ki*256],lp);
                    }
                } else {
                lp.dstGap=0;lp.ifTranspose=!TX2;
                if constexpr(TX2) {
                    lp.repeatTimes=count*cols/256;lp.srcStride=1;AscendC::LoadData(b2,b1,lp);
                } else {
                    if((s.tree&2) && count>cols) {
                        lp.repeatTimes=count/16;lp.srcStride=1;lp.dstGap=cols/16-1;
                        for(uint32_t ni=0;ni<cols/16;++ni)AscendC::LoadData(b2[ni*256],b1[ni*count*16],lp);
                    } else {
                        lp.repeatTimes=cols/16;lp.srcStride=count/16;
                        for(uint32_t ki=0;ki<count/16;++ki)AscendC::LoadData(b2[ki*cols*16],b1[ki*256],lp);
                    }
                }
                }
                if(!residentA)aq.FreeTensor(a1);
                if constexpr(!RESIDENT_B)bq.FreeTensor(b1);
                if(k0+2*bk<s.k)ManualCopyK<T,TX1,TX2,PAD_MN,RESIDENT_B>(aq,bq,a,b,s,bk,validRows,validCols,batch,m0,n0,k0+2*bk,residentA);
                AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(loadReady[ks]);
                AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(loadReady[ks]);
                AscendC::MmadParams mp;
                mp.m=rows;mp.n=cols;mp.k=count;mp.cmatrixInitVal=k0==0;
                AscendC::Mmad(c,a2,b2,mp);
                // Small L0C tiles need explicit ordering between K accumulations.
                if((rows/16)*(cols/16)<10)AscendC::PipeBarrier<PIPE_M>();
                AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(loadFree[ks]);
            }
            if(pairIndex+1==span || nt+1==end) {
                // Acquire the GM ring when the private L0C result is ready to write.
                if constexpr(FULL_A || RESIDENT_PAD)AscendC::CrossCoreWaitFlag<2>(4+slot);
                Fence<AscendC::HardEvent::M_FIX>();
                AscendC::FixpipeParamsV220 fp;
                fp.nSize=pairIndex*s.baseN+cols;fp.mSize=rows;
                fp.srcStride=rows;fp.dstStride=span*s.baseN;
                AscendC::Fixpipe(ring[slot*slotSize],cAll[cs*slotSize],fp);
                AscendC::SetFlag<AscendC::HardEvent::FIX_M>(cFree[cs]);
                AscendC::CrossCoreSetFlag<2,PIPE_FIX>(slot);
                ++sequence;
            }
        }
        if(residentA)Fence<AscendC::HardEvent::MTE1_MTE2>();
        if constexpr(RESIDENT_B)cachedBatch=batch;
    }
    for(uint32_t i=0;i<2;++i) {
        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(loadFree[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::M_MTE1>(loadFree[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::MTE1_M>(loadReady[i]);
    }
    for(uint32_t i=0;i<cBuffers;++i) {
        AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::FIX_M>(cFree[i]);
    }
    for(uint32_t i=0;i<slots;++i)AscendC::CrossCoreWaitFlag<2>(4+i);
#else
    // The companion participates in the ring protocol for every batch/task.
    // One AIV owns all actual rows; no global partial or final merge is needed.
    if(sub) {
        for(uint32_t i=0;i<slots;++i)AscendC::CrossCoreSetFlag<2,PIPE_MTE2>(4+i);
        for(int64_t task=worker;task<tasks;task+=s.workers,++sequence) {
            const uint32_t slot=sequence%slots;
            AscendC::CrossCoreWaitFlag<2>(slot);
            AscendC::CrossCoreSetFlag<2,PIPE_MTE2>(4+slot);
        }
        return;
    }
    AscendC::TQue<AscendC::TPosition::VECIN,2> cq;
    AscendC::TQue<AscendC::TPosition::VECOUT,1> oq;
    AscendC::TBuf<AscendC::TPosition::VECCALC> rb;
    // One full-row queue equals the old two half-row queues in bytes.
    pipe.InitBuffer(cq,1,s.baseM*s.baseN*4);
    pipe.InitBuffer(oq,1,32);pipe.InitBuffer(rb,4*s.baseM*4);
    auto row=rb.Get<float>();
    AscendC::GlobalTensor<float> out;
    out.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(output));
    for(uint32_t i=0;i<slots;++i)AscendC::CrossCoreSetFlag<2,PIPE_MTE2>(4+i);
    for(int64_t task=worker;task<tasks;task+=s.workers,++sequence) {
        // Entry requires one M tile, one N tile and one N partition per batch.
        ManualCopyC(cq,ring,s,slots,slotSize,0,s.m,0,sequence,1,1);
        auto c=cq.DeQue<float>();
        SmallRowMaxLaneFold(c,row,s.m,s.n,s.baseN);
        auto y=oq.AllocTensor<float>();
        AscendC::WholeReduceSum(y,row,uint64_t(s.m),1,1,1,1);
        oq.EnQue(y);y=oq.DeQue<float>();
        AscendC::DataCopyExtParams cp{1,sizeof(float),0,0,0};
        AscendC::DataCopyPad(out[task],y,cp);
        oq.FreeTensor(y);cq.FreeTensor(c);
    }
#endif
}

// Packages use actual storage strides for all four physical layouts.
template<typename T,bool TX1,bool PAD_MN>
__aicore__ inline void WindowCopyAPackage(AscendC::TQue<AscendC::TPosition::A1,2>& aq,
    const AscendC::GlobalTensor<T>& a,const Schedule& s,uint32_t packageK,
    uint32_t validRows,int64_t batch,int64_t m0,uint32_t k0)
{
    const uint32_t count=s.k-k0<packageK?s.k-k0:packageK;
    auto a1=aq.AllocTensor<T>();AscendC::Nd2NzParams ap;
    ap.ndNum=1;ap.nValue=TX1?count:validRows;ap.dValue=TX1?validRows:count;
    ap.srcDValue=TX1?s.m:s.k;
    ap.dstNzC0Stride=PAD_MN?(ap.nValue+15)/16*16:ap.nValue;ap.dstNzNStride=1;
    if constexpr(PAD_MN)ManualZeroNZTail(a1,ap.nValue,ap.dValue);
    AscendC::DataCopy(a1,a[batch*s.m*s.k+(TX1?k0*s.m+m0:m0*s.k+k0)],ap);aq.EnQue(a1);
}
template<typename T,bool TX2,bool PAD_MN>
__aicore__ inline void WindowCopyBPackage(AscendC::TQue<AscendC::TPosition::B1,2>& bq,
    const AscendC::GlobalTensor<T>& b,const Schedule& s,uint32_t packageK,
    uint32_t validCols,int64_t batch,int64_t n0,uint32_t k0)
{
    const uint32_t count=s.k-k0<packageK?s.k-k0:packageK;
    auto b1=bq.AllocTensor<T>();AscendC::Nd2NzParams bp;
    bp.ndNum=1;bp.nValue=TX2?validCols:count;bp.dValue=TX2?count:validCols;
    bp.srcDValue=TX2?s.k:s.n;
    bp.dstNzC0Stride=PAD_MN?(bp.nValue+15)/16*16:bp.nValue;bp.dstNzNStride=1;
    if constexpr(PAD_MN)ManualZeroNZTail(b1,bp.nValue,bp.dValue);
    AscendC::DataCopy(b1,b[batch*s.n*s.k+(TX2?n0*s.k+k0:k0*s.n+n0)],bp);bq.EnQue(b1);
}
template <typename T, bool TX1, bool TX2, bool PAD_MN, bool RESIDENT_A>
__schedmode__(1) __global__ __mix__(1, 2) void bmmms_generic_packages(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR partial, GM_ADDR output, Schedule s,uint32_t aPackK,uint32_t bPackK)
{
    AscendC::TPipe pipe;
    AscendC::GlobalTensor<T> a,b;
    AscendC::GlobalTensor<float> ring,partials;
    a.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x1));
    b.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x2));
    partials.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(partial));
    const uint32_t width=s.baseN*s.window;
    const uint32_t slotSize=s.baseM*width;
    const int64_t partialCount=s.b*s.nSplit*s.mTiles*s.baseM;
    const int64_t alignedCount=(partialCount+127)/128*128;
#ifdef __DAV_CUBE__
    const uint32_t worker=AscendC::GetBlockIdx();
#else
    const uint32_t worker=AscendC::GetBlockIdx()/2;
    const uint32_t sub=AscendC::GetBlockIdx()%2;
    const uint32_t rowStart=sub*(s.baseM/2);
#endif
    ring.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(partial)+alignedCount+
                         int64_t(worker)*2*slotSize);
    const int64_t tasks=s.b*s.mTiles*s.nSplit;
    uint32_t sequence=0;
#ifdef __DAV_CUBE__
    AscendC::SetAtomicNone();AscendC::SetLoadDataBoundary(uint64_t(0));
    AscendC::SetLoadDataPaddingValue(uint64_t(0));
    uint32_t bk=256;
    while(bk>64 && (s.baseM*bk*4>65536 || s.baseN*bk*4>65536))bk/=2;
    const uint32_t kp=(s.k+15)/16*16;
    const uint32_t oneTile=s.baseM*s.baseN;
    const uint32_t cBuffers=oneTile*8<=131072?2:1;
    AscendC::TQue<AscendC::TPosition::A1,2> aq;
    AscendC::TQue<AscendC::TPosition::B1,2> bq;
    AscendC::TBuf<AscendC::TPosition::A1> fullAb;
    AscendC::TBuf<AscendC::TPosition::A2> ab;
    AscendC::TBuf<AscendC::TPosition::B2> bb;
    AscendC::TBuf<AscendC::TPosition::CO1> cb;
    if constexpr(!RESIDENT_A)pipe.InitBuffer(aq,2,s.baseM*aPackK*2);
    pipe.InitBuffer(bq,2,s.baseN*bPackK*2);
    pipe.InitBuffer(fullAb,RESIDENT_A?s.baseM*kp*2:512);
    pipe.InitBuffer(ab,2*s.baseM*bk*2);pipe.InitBuffer(bb,2*s.baseN*bk*2);
    pipe.InitBuffer(cb,cBuffers*oneTile*4);
    auto fullA=fullAb.Get<T>(),a2all=ab.Get<T>(),b2all=bb.Get<T>();
    auto cAll=cb.Get<float>();
    event_t loadFree[2],loadReady[2],cFree[2];
    for(uint32_t i=0;i<2;++i) {
        loadFree[i]=static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::M_MTE1>());
        loadReady[i]=static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::MTE1_M>());
        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(loadFree[i]);
    }
    for(uint32_t i=0;i<cBuffers;++i) {
        cFree[i]=static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::FIX_M>());
        AscendC::SetFlag<AscendC::HardEvent::FIX_M>(cFree[i]);
    }
    uint32_t kSequence=0,tileSequence=0;
    for(int64_t task=worker;task<tasks;task+=s.workers) {
        const uint32_t ns=task%s.nSplit;
        const int64_t mt=(task/s.nSplit)%s.mTiles,batch=task/(s.nSplit*s.mTiles);
        const int64_t m0=mt*s.baseM;
        const uint32_t validRows=s.m-m0<s.baseM?s.m-m0:s.baseM;
        const uint32_t rows=PAD_MN?(validRows+15)/16*16:validRows;
        const uint32_t begin=ns*s.nTiles/s.nSplit,end=(ns+1)*s.nTiles/s.nSplit;
        if constexpr(RESIDENT_A) {
            AscendC::Nd2NzParams ap;
            ap.ndNum=1;ap.nValue=TX1?s.k:validRows;ap.dValue=TX1?validRows:s.k;ap.srcDValue=TX1?s.m:s.k;
            ap.dstNzC0Stride=TX1?kp:rows;ap.dstNzNStride=1;
            ManualZeroNZTail(fullA,ap.nValue,ap.dValue);
            AscendC::DataCopy(fullA,a[batch*s.m*s.k+(TX1?m0:m0*s.k)],ap);
            Fence<AscendC::HardEvent::MTE2_MTE1>();
        }
        for(uint32_t nt=begin;nt<end;nt+=s.window,++sequence) {
            const uint32_t slot=sequence&1;
            const uint32_t tiles=end-nt<s.window?end-nt:s.window;
            // One GM credit covers the complete original N window.
            AscendC::CrossCoreWaitFlag<2>(2+slot);
            for(uint32_t p=0;p<tiles;++p,++tileSequence) {
                const uint32_t cs=tileSequence%cBuffers;
                AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree[cs]);
                const int64_t n0=int64_t(nt+p)*s.baseN;
                const uint32_t validCols=s.n-n0<s.baseN?s.n-n0:s.baseN;
                const uint32_t cols=PAD_MN?(validCols+15)/16*16:validCols;
                auto c=cAll[cs*oneTile];
                if constexpr(!RESIDENT_A)WindowCopyAPackage<T,TX1,PAD_MN>(aq,a,s,aPackK,validRows,batch,m0,0);
                WindowCopyBPackage<T,TX2,PAD_MN>(bq,b,s,bPackK,validCols,batch,n0,0);
                if constexpr(!RESIDENT_A) {
                    if(s.k>aPackK)WindowCopyAPackage<T,TX1,PAD_MN>(aq,a,s,aPackK,validRows,batch,m0,aPackK);
                }
                if(s.k>bPackK)WindowCopyBPackage<T,TX2,PAD_MN>(bq,b,s,bPackK,validCols,batch,n0,bPackK);
                AscendC::LocalTensor<T> a1,b1;
                uint32_t aStart=0,aCount=0,bStart=0,bCount=0;
                for(uint32_t k0=0;k0<s.k;k0+=bk,++kSequence) {
                    const uint32_t validCount=s.k-k0<bk?s.k-k0:bk;
                    const uint32_t count=PAD_MN?(validCount+15)/16*16:validCount;
                    const uint32_t ks=kSequence&1;
                    auto a2=a2all[ks*s.baseM*bk],b2=b2all[ks*s.baseN*bk];
                    AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(loadFree[ks]);
                    if constexpr(RESIDENT_A) {
                        AscendC::LoadData3DParamsV2<T> panel;
                        panel.l1H=1;panel.l1W=TX1?kp:rows;panel.channelSize=TX1?rows:kp;
                        panel.mStartPt=TX1?k0:0;panel.kStartPt=TX1?0:k0;
                        panel.mExtension=TX1?count:rows;panel.kExtension=TX1?rows:count;panel.enTranspose=TX1;
                        AscendC::LoadData(a2,fullA,panel);
                    } else {
                        if(k0%aPackK==0) {
                            a1=aq.DeQue<T>();aStart=k0;
                            aCount=s.k-k0<aPackK?s.k-k0:aPackK;
                        }
                        // The larger NZ package has its own actual padded K pitch.
                        AscendC::LoadData3DParamsV2<T> panel;
                        const uint32_t apad=(aCount+15)/16*16;
                        panel.l1H=1;panel.l1W=TX1?apad:rows;panel.channelSize=TX1?rows:apad;
                        panel.mStartPt=TX1?k0-aStart:0;panel.kStartPt=TX1?0:k0-aStart;
                        panel.mExtension=TX1?count:rows;panel.kExtension=TX1?rows:count;panel.enTranspose=TX1;
                        AscendC::LoadData(a2,a1,panel);
                    }
                    if(k0%bPackK==0) {
                        b1=bq.DeQue<T>();bStart=k0;
                        bCount=s.k-k0<bPackK?s.k-k0:bPackK;
                    }
                    AscendC::LoadData2DParams lp;
                    if constexpr(TX2) {
                        lp.ifTranspose=false;lp.repeatTimes=count*cols/256;lp.srcStride=1;
                        AscendC::LoadData(b2,b1[(k0-bStart)*cols],lp);
                    } else {
                        lp.ifTranspose=true;lp.dstGap=0;lp.repeatTimes=cols/16;
                        lp.srcStride=((bCount+15)/16*16)/16;
                        for(uint32_t ki=0;ki<count/16;++ki)
                            AscendC::LoadData(b2[ki*cols*16],b1[(k0-bStart)*16+ki*256],lp);
                    }
                    if constexpr(!RESIDENT_A) {
                        if(k0+bk>=aStart+aCount) {
                            aq.FreeTensor(a1);
                            if(aStart+2*aPackK<s.k)
                                WindowCopyAPackage<T,TX1,PAD_MN>(aq,a,s,aPackK,validRows,batch,m0,aStart+2*aPackK);
                        }
                    }
                    if(k0+bk>=bStart+bCount) {
                        bq.FreeTensor(b1);
                        if(bStart+2*bPackK<s.k)
                            WindowCopyBPackage<T,TX2,PAD_MN>(bq,b,s,bPackK,validCols,batch,n0,bStart+2*bPackK);
                    }
                    AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(loadReady[ks]);
                    AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(loadReady[ks]);
                    AscendC::MmadParams mp;
                    mp.m=rows;mp.n=cols;mp.k=count;mp.cmatrixInitVal=k0==0;
                    AscendC::Mmad(c,a2,b2,mp);
                    if((rows/16)*(cols/16)<10)AscendC::PipeBarrier<PIPE_M>();
                    AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(loadFree[ks]);
                }
                Fence<AscendC::HardEvent::M_FIX>();
                AscendC::FixpipeParamsV220 fp;
                fp.nSize=cols;fp.mSize=rows;fp.srcStride=rows;fp.dstStride=width;
                // Keep the original complete-window ND row stride in GM.
                AscendC::Fixpipe(ring[slot*slotSize+p*s.baseN],c,fp);
                AscendC::SetFlag<AscendC::HardEvent::FIX_M>(cFree[cs]);
            }
            AscendC::CrossCoreSetFlag<2,PIPE_FIX>(slot);
        }
        if constexpr(RESIDENT_A)Fence<AscendC::HardEvent::MTE1_MTE2>();
    }
    for(uint32_t i=0;i<2;++i) {
        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(loadFree[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::M_MTE1>(loadFree[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::MTE1_M>(loadReady[i]);
    }
    for(uint32_t i=0;i<cBuffers;++i) {
        AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::FIX_M>(cFree[i]);
    }
    AscendC::CrossCoreWaitFlag<2>(2);AscendC::CrossCoreWaitFlag<2>(3);
#else
    AscendC::TQue<AscendC::TPosition::VECIN,2> cq;
    AscendC::TQue<AscendC::TPosition::VECOUT,1> mq;
    AscendC::TBuf<AscendC::TPosition::VECCALC> rowBuf,tmpBuf,valBuf;
    pipe.InitBuffer(cq,2,(s.baseM/2)*s.baseN*4);
    pipe.InitBuffer(mq,1,s.baseM*4);
    pipe.InitBuffer(rowBuf,s.baseM*4);pipe.InitBuffer(tmpBuf,s.baseM*4);
    pipe.InitBuffer(valBuf,32);
    auto row=rowBuf.Get<float>(),tmp=tmpBuf.Get<float>(),val=valBuf.Get<float>();
    AscendC::CrossCoreSetFlag<2,PIPE_MTE2>(2);
    AscendC::CrossCoreSetFlag<2,PIPE_MTE2>(3);
    for(int64_t task=worker;task<tasks;task+=s.workers) {
        const uint32_t ns=task%s.nSplit;
        const int64_t mt=(task/s.nSplit)%s.mTiles;
        const int64_t batch=task/(s.nSplit*s.mTiles);
        const int64_t m0=mt*s.baseM;
        const int64_t remaining=s.m-m0-rowStart;
        const uint32_t rows=remaining<=0?0:(remaining<s.baseM/2?remaining:s.baseM/2);
        const uint32_t begin=ns*s.nTiles/s.nSplit,end=(ns+1)*s.nTiles/s.nSplit;
        auto maxima=mq.AllocTensor<float>();
        AscendC::Duplicate(maxima,-__builtin_inff(),s.baseM);
        AscendC::PipeBarrier<PIPE_V>();
        for(uint32_t nt=begin;nt<end;nt+=s.window,++sequence) {
            const uint32_t slot=sequence&1;
            AscendC::CrossCoreWaitFlag<2>(slot);
            const uint32_t tiles=end-nt<s.window?end-nt:s.window;
            for(uint32_t p=0;rows && p<tiles;++p) {
                const int64_t n0=int64_t(nt+p)*s.baseN;
                const uint32_t cols=s.n-n0<s.baseN?s.n-n0:s.baseN;
                auto c=cq.AllocTensor<float>();
                const uint32_t padded=(cols+7)/8*8;
                AscendC::DataCopyExtParams cp{static_cast<uint16_t>(rows),cols*4,
                    (width-cols)*4,(s.baseN-padded)/8,0};
                AscendC::DataCopyPadExtParams<float> pad{true,0,static_cast<uint8_t>(padded-cols),-__builtin_inff()};
                AscendC::DataCopyPad(c,ring[slot*slotSize+rowStart*width+p*s.baseN],cp,pad);
                cq.EnQue(c);c=cq.DeQue<float>();
                for(uint32_t col=0;col<cols;col+=64) {
                    const uint32_t n=cols-col<64?cols-col:64;
                    AscendC::WholeReduceMax(row,c[col],uint64_t(n),rows,1,1,s.baseN/8,
                                            AscendC::ReduceOrder::ORDER_ONLY_VALUE);
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::BinaryRepeatParams rp{1,1,1,8,8,8};
                    if(rows/64) AscendC::Max(maxima,maxima,row,uint64_t(64),rows/64,rp);
                    if(rows%64) AscendC::Max(maxima[(rows/64)*64],maxima[(rows/64)*64],row[(rows/64)*64],
                                              uint64_t(rows%64),1,rp);
                    AscendC::PipeBarrier<PIPE_V>();
                }
                cq.FreeTensor(c);
            }
            AscendC::CrossCoreSetFlag<2,PIPE_MTE2>(2+slot);
        }
        if(s.earlySum && s.nSplit==1) {
            AscendC::Duplicate(val,0.0f,8);AscendC::PipeBarrier<PIPE_V>();
            if(rows) AscendC::ReduceSum<float,true>(val,maxima,tmp,rows);
            Fence<AscendC::HardEvent::V_MTE3>();
            AscendC::DataCopy(partials[task*16+sub*8],val,8);
            Fence<AscendC::HardEvent::MTE3_V>();
            mq.FreeTensor(maxima);
        } else {
            mq.EnQue(maxima);maxima=mq.DeQue<float>();
            AscendC::DataCopy(partials[(batch*s.nSplit+ns)*s.mTiles*s.baseM+m0+rowStart],maxima,s.baseM/2);
            mq.FreeTensor(maxima);
        }
    }
    AscendC::SyncAll<true>();
    if(s.earlySum && s.nSplit==1) {s.mTiles*=2;FinalizeEarly(partial,output,s,pipe);}
    else if(int64_t(AscendC::GetBlockIdx())*8<s.b) FinalizeRows(partial,output,s,pipe);
#endif
}

template<typename T,bool TX2,bool PAD_MN>
__aicore__ inline void Case9CopyBPackage(AscendC::TQue<AscendC::TPosition::B1,2>& bq,
    const AscendC::GlobalTensor<T>& b,const Schedule& s,uint32_t packageK,
    uint32_t validCols,int64_t batch,int64_t n0,uint32_t k0)
{
    const uint32_t count=s.k-k0<packageK?s.k-k0:packageK;
    auto b1=bq.AllocTensor<T>();AscendC::Nd2NzParams bp;
    bp.ndNum=1;bp.nValue=TX2?validCols:count;bp.dValue=TX2?count:validCols;
    bp.srcDValue=TX2?s.k:s.n;
    bp.dstNzC0Stride=PAD_MN?(bp.nValue+15)/16*16:bp.nValue;bp.dstNzNStride=1;
    if constexpr(PAD_MN)ManualZeroNZTail(b1,bp.nValue,bp.dValue);
    AscendC::DataCopy(b1,b[batch*s.n*s.k+(TX2?n0*s.k+k0:k0*s.n+n0)],bp);bq.EnQue(b1);
}
template <typename T, bool PAD_MN>
__schedmode__(1) __global__ __mix__(1, 2) void bmmms_case9_packages(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR partial, GM_ADDR output, Schedule s,uint32_t aPackK,uint32_t bPackK)
{
    constexpr bool TX1=false,TX2=true,RESIDENT_A=true;
    AscendC::TPipe pipe;
    AscendC::GlobalTensor<T> a,b;
    AscendC::GlobalTensor<float> ring,partials;
    a.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x1));
    b.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x2));
    partials.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(partial));
    const uint32_t width=s.baseN*s.window;
    const uint32_t slotSize=s.baseM*width;
    const int64_t partialCount=s.b*s.nSplit*s.mTiles*s.baseM;
    const int64_t alignedCount=(partialCount+127)/128*128;
#ifdef __DAV_CUBE__
    const uint32_t worker=AscendC::GetBlockIdx();
#else
    const uint32_t worker=AscendC::GetBlockIdx()/2;
    const uint32_t sub=AscendC::GetBlockIdx()%2;
    const uint32_t rowStart=sub*(s.baseM/2);
#endif
    ring.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(partial)+alignedCount+
                         int64_t(worker)*2*slotSize);
    const int64_t tasks=s.b*s.mTiles*s.nSplit;
    uint32_t sequence=0;
#ifdef __DAV_CUBE__
    AscendC::SetAtomicNone();AscendC::SetLoadDataBoundary(uint64_t(0));
    AscendC::SetLoadDataPaddingValue(uint64_t(0));
    const uint32_t bk=s.kChunk;
    const uint32_t kp=(s.k+15)/16*16;
    const uint32_t oneTile=s.baseM*s.baseN;
    const uint32_t cBuffers=oneTile*8<=131072?2:1;
    AscendC::TQue<AscendC::TPosition::A1,2> aq;
    AscendC::TQue<AscendC::TPosition::B1,2> bq;
    AscendC::TBuf<AscendC::TPosition::A1> fullAb;
    AscendC::TBuf<AscendC::TPosition::A2> ab;
    AscendC::TBuf<AscendC::TPosition::B2> bb;
    AscendC::TBuf<AscendC::TPosition::CO1> cb;
    pipe.InitBuffer(bq,2,s.baseN*bPackK*2);
    pipe.InitBuffer(fullAb,RESIDENT_A?s.baseM*kp*2:512);
    pipe.InitBuffer(ab,2*s.baseM*bk*2);pipe.InitBuffer(bb,2*s.baseN*bk*2);
    pipe.InitBuffer(cb,cBuffers*oneTile*4);
    auto fullA=fullAb.Get<T>(),a2all=ab.Get<T>(),b2all=bb.Get<T>();
    auto cAll=cb.Get<float>();
    event_t loadFree[2],loadReady[2],cFree[2];
    for(uint32_t i=0;i<2;++i) {
        loadFree[i]=static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::M_MTE1>());
        loadReady[i]=static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::MTE1_M>());
        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(loadFree[i]);
    }
    for(uint32_t i=0;i<cBuffers;++i) {
        cFree[i]=static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::FIX_M>());
        AscendC::SetFlag<AscendC::HardEvent::FIX_M>(cFree[i]);
    }
    uint32_t kSequence=0,tileSequence=0;
    for(int64_t task=worker;task<tasks;task+=s.workers) {
        const uint32_t ns=task%s.nSplit;
        const int64_t mt=(task/s.nSplit)%s.mTiles,batch=task/(s.nSplit*s.mTiles);
        const int64_t m0=mt*s.baseM;
        const uint32_t validRows=s.m-m0<s.baseM?s.m-m0:s.baseM;
        const uint32_t rows=PAD_MN?(validRows+15)/16*16:validRows;
        const uint32_t begin=ns*s.nTiles/s.nSplit,end=(ns+1)*s.nTiles/s.nSplit;
        if constexpr(RESIDENT_A) {
            AscendC::Nd2NzParams ap;
            ap.ndNum=1;ap.nValue=TX1?s.k:validRows;ap.dValue=TX1?validRows:s.k;ap.srcDValue=TX1?s.m:s.k;
            ap.dstNzC0Stride=TX1?kp:rows;ap.dstNzNStride=1;
            ManualZeroNZTail(fullA,ap.nValue,ap.dValue);
            AscendC::DataCopy(fullA,a[batch*s.m*s.k+(TX1?m0:m0*s.k)],ap);
            Fence<AscendC::HardEvent::MTE2_MTE1>();
        }
        for(uint32_t nt=begin;nt<end;nt+=s.window,++sequence) {
            const uint32_t slot=sequence&1;
            const uint32_t tiles=end-nt<s.window?end-nt:s.window;
            // One GM credit covers the complete original N window.

            for(uint32_t p=0;p<tiles;++p,++tileSequence) {
                const uint32_t cs=tileSequence%cBuffers;
                AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree[cs]);
                const int64_t n0=int64_t(nt+p)*s.baseN;
                const uint32_t validCols=s.n-n0<s.baseN?s.n-n0:s.baseN;
                const uint32_t cols=PAD_MN?(validCols+15)/16*16:validCols;
                auto c=cAll[cs*oneTile];
                Case9CopyBPackage<T,TX2,PAD_MN>(bq,b,s,bPackK,validCols,batch,n0,0);
                if(s.k>bPackK)Case9CopyBPackage<T,TX2,PAD_MN>(bq,b,s,bPackK,validCols,batch,n0,bPackK);
                AscendC::LocalTensor<T> a1,b1;
                uint32_t aStart=0,aCount=0,bStart=0,bCount=0;
                for(uint32_t k0=0;k0<s.k;k0+=bk,++kSequence) {
                    const uint32_t validCount=s.k-k0<bk?s.k-k0:bk;
                    const uint32_t count=PAD_MN?(validCount+15)/16*16:validCount;
                    const uint32_t ks=kSequence&1;
                    auto a2=a2all[ks*s.baseM*bk],b2=b2all[ks*s.baseN*bk];
                    AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(loadFree[ks]);
                    if constexpr(RESIDENT_A) {
                        AscendC::LoadData3DParamsV2<T> panel;
                        panel.l1H=1;panel.l1W=TX1?kp:rows;panel.channelSize=TX1?rows:kp;
                        panel.mStartPt=TX1?k0:0;panel.kStartPt=TX1?0:k0;
                        panel.mExtension=TX1?count:rows;panel.kExtension=TX1?rows:count;panel.enTranspose=TX1;
                        AscendC::LoadData(a2,fullA,panel);
                    }
                    if(k0%bPackK==0) {
                        b1=bq.DeQue<T>();bStart=k0;
                        bCount=s.k-k0<bPackK?s.k-k0:bPackK;
                    }
                    AscendC::LoadData2DParams lp;
                    if constexpr(TX2) {
                        lp.ifTranspose=false;lp.repeatTimes=count*cols/256;lp.srcStride=1;
                        AscendC::LoadData(b2,b1[(k0-bStart)*cols],lp);
                    } else {
                        lp.ifTranspose=true;lp.dstGap=0;lp.repeatTimes=cols/16;
                        lp.srcStride=((bCount+15)/16*16)/16;
                        for(uint32_t ki=0;ki<count/16;++ki)
                            AscendC::LoadData(b2[ki*cols*16],b1[(k0-bStart)*16+ki*256],lp);
                    }
                    if(k0+bk>=bStart+bCount) {
                        bq.FreeTensor(b1);
                        if(bStart+2*bPackK<s.k)
                            Case9CopyBPackage<T,TX2,PAD_MN>(bq,b,s,bPackK,validCols,batch,n0,bStart+2*bPackK);
                    }
                    AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(loadReady[ks]);
                    AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(loadReady[ks]);
                    AscendC::MmadParams mp;
                    mp.m=rows;mp.n=cols;mp.k=count;mp.cmatrixInitVal=k0==0;
                    AscendC::Mmad(c,a2,b2,mp);
                    if((rows/16)*(cols/16)<10)AscendC::PipeBarrier<PIPE_M>();
                    AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(loadFree[ks]);
                }
                if(p==0)AscendC::CrossCoreWaitFlag<2>(2+slot);
                Fence<AscendC::HardEvent::M_FIX>();
                AscendC::FixpipeParamsV220 fp;
                fp.nSize=cols;fp.mSize=rows;fp.srcStride=rows;fp.dstStride=width;
                // Keep the original complete-window ND row stride in GM.
                AscendC::Fixpipe(ring[slot*slotSize+p*s.baseN],c,fp);
                AscendC::SetFlag<AscendC::HardEvent::FIX_M>(cFree[cs]);
            }
            AscendC::CrossCoreSetFlag<2,PIPE_FIX>(slot);
        }
        if constexpr(RESIDENT_A)Fence<AscendC::HardEvent::MTE1_MTE2>();
    }
    for(uint32_t i=0;i<2;++i) {
        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(loadFree[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::M_MTE1>(loadFree[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::MTE1_M>(loadReady[i]);
    }
    for(uint32_t i=0;i<cBuffers;++i) {
        AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::FIX_M>(cFree[i]);
    }
    AscendC::CrossCoreWaitFlag<2>(2);AscendC::CrossCoreWaitFlag<2>(3);
#else
    AscendC::TQue<AscendC::TPosition::VECIN,2> cq;
    AscendC::TQue<AscendC::TPosition::VECOUT,1> mq;
    AscendC::TBuf<AscendC::TPosition::VECCALC> rowBuf,tmpBuf,valBuf;
    pipe.InitBuffer(cq,2,(s.baseM/2)*s.baseN*4);
    pipe.InitBuffer(mq,1,s.baseM*4);
    pipe.InitBuffer(rowBuf,s.baseM*4);pipe.InitBuffer(tmpBuf,s.baseM*4);
    pipe.InitBuffer(valBuf,32);
    auto row=rowBuf.Get<float>(),tmp=tmpBuf.Get<float>(),val=valBuf.Get<float>();
    AscendC::CrossCoreSetFlag<2,PIPE_MTE2>(2);
    AscendC::CrossCoreSetFlag<2,PIPE_MTE2>(3);
    for(int64_t task=worker;task<tasks;task+=s.workers) {
        const uint32_t ns=task%s.nSplit;
        const int64_t mt=(task/s.nSplit)%s.mTiles;
        const int64_t batch=task/(s.nSplit*s.mTiles);
        const int64_t m0=mt*s.baseM;
        const int64_t remaining=s.m-m0-rowStart;
        const uint32_t rows=remaining<=0?0:(remaining<s.baseM/2?remaining:s.baseM/2);
        const uint32_t begin=ns*s.nTiles/s.nSplit,end=(ns+1)*s.nTiles/s.nSplit;
        auto maxima=mq.AllocTensor<float>();
        AscendC::Duplicate(maxima,-__builtin_inff(),s.baseM);
        AscendC::PipeBarrier<PIPE_V>();
        for(uint32_t nt=begin;nt<end;nt+=s.window,++sequence) {
            const uint32_t slot=sequence&1;
            AscendC::CrossCoreWaitFlag<2>(slot);
            const uint32_t tiles=end-nt<s.window?end-nt:s.window;
            for(uint32_t p=0;rows && p<tiles;++p) {
                const int64_t n0=int64_t(nt+p)*s.baseN;
                const uint32_t cols=s.n-n0<s.baseN?s.n-n0:s.baseN;
                auto c=cq.AllocTensor<float>();
                const uint32_t padded=(cols+7)/8*8;
                AscendC::DataCopyExtParams cp{static_cast<uint16_t>(rows),cols*4,
                    (width-cols)*4,(s.baseN-padded)/8,0};
                AscendC::DataCopyPadExtParams<float> pad{true,0,static_cast<uint8_t>(padded-cols),-__builtin_inff()};
                AscendC::DataCopyPad(c,ring[slot*slotSize+rowStart*width+p*s.baseN],cp,pad);
                cq.EnQue(c);c=cq.DeQue<float>();
                for(uint32_t col=0;col<cols;col+=64) {
                    const uint32_t n=cols-col<64?cols-col:64;
                    AscendC::WholeReduceMax(row,c[col],uint64_t(n),rows,1,1,s.baseN/8,
                                            AscendC::ReduceOrder::ORDER_ONLY_VALUE);
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::BinaryRepeatParams rp{1,1,1,8,8,8};
                    if(rows/64) AscendC::Max(maxima,maxima,row,uint64_t(64),rows/64,rp);
                    if(rows%64) AscendC::Max(maxima[(rows/64)*64],maxima[(rows/64)*64],row[(rows/64)*64],
                                              uint64_t(rows%64),1,rp);
                    AscendC::PipeBarrier<PIPE_V>();
                }
                cq.FreeTensor(c);
            }
            AscendC::CrossCoreSetFlag<2,PIPE_MTE2>(2+slot);
        }
        if(s.earlySum && s.nSplit==1) {
            AscendC::Duplicate(val,0.0f,8);AscendC::PipeBarrier<PIPE_V>();
            if(rows) AscendC::ReduceSum<float,true>(val,maxima,tmp,rows);
            Fence<AscendC::HardEvent::V_MTE3>();
            AscendC::DataCopy(partials[task*16+sub*8],val,8);
            Fence<AscendC::HardEvent::MTE3_V>();
            mq.FreeTensor(maxima);
        } else {
            mq.EnQue(maxima);maxima=mq.DeQue<float>();
            AscendC::DataCopy(partials[(batch*s.nSplit+ns)*s.mTiles*s.baseM+m0+rowStart],maxima,s.baseM/2);
            mq.FreeTensor(maxima);
        }
    }
    AscendC::SyncAll<true>();
    if(s.earlySum && s.nSplit==1) {s.mTiles*=2;FinalizeEarly(partial,output,s,pipe);}
    else if(int64_t(AscendC::GetBlockIdx())*8<s.b) FinalizeRows(partial,output,s,pipe);
#endif
}

// Independently tunable generic entries retain their full capture ranges.
template<bool MDL>
constexpr auto GENERIC_PAIR_CONFIG=MDL?DUAL_MDL_CONFIG:DUAL_CONFIG;
template <typename T, bool MDL>
__schedmode__(1) __global__ __mix__(1, 2) void bmmms_generic_c8(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR partial, GM_ADDR output, GM_ADDR workspace,
    AscendC::tiling::TCubeTiling tiling, Schedule s)
{
    constexpr bool TX1=true,TX2=true;
    AscendC::TPipe pipe;
    using A=matmul::MatmulType<AscendC::TPosition::GM,CubeFormat::ND,T,TX1,LayoutMode::NONE,true>;
    using B=matmul::MatmulType<AscendC::TPosition::GM,CubeFormat::ND,T,TX2,LayoutMode::NONE,true>;
    using C=matmul::MatmulType<AscendC::TPosition::GM,CubeFormat::ND,float>;
    using Bias=matmul::MatmulType<AscendC::TPosition::GM,CubeFormat::ND,float>;
    matmul::Matmul<A,B,C,Bias,GENERIC_PAIR_CONFIG<MDL>> mm;
    REGIST_MATMUL_OBJ(&pipe, workspace, mm, &tiling);
    AscendC::GlobalTensor<T> a,b;
    AscendC::GlobalTensor<float> ring,partials;
    a.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x1));
    b.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x2));
    partials.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(partial));
    const uint32_t width=s.baseN*s.window;
    const uint32_t slotSize=s.baseM*width;
    const int64_t partialCount=s.b*s.nSplit*s.mTiles*s.baseM;
    const int64_t alignedCount=(partialCount+127)/128*128;
#ifdef __DAV_CUBE__
    const uint32_t worker=AscendC::GetBlockIdx();
#else
    const uint32_t worker=AscendC::GetBlockIdx()/2;
    const uint32_t sub=AscendC::GetBlockIdx()%2;
    const uint32_t rowStart=sub*(s.baseM/2);
#endif
    ring.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(partial)+alignedCount+
                         int64_t(worker)*2*slotSize);
    const int64_t tasks=s.b*s.mTiles*s.nSplit;
    uint32_t sequence=0;
#ifdef __DAV_CUBE__
    AscendC::SetAtomicNone();
    AscendC::SetLoadDataBoundary(uint64_t(0));
    AscendC::SetLoadDataPaddingValue(uint64_t(0));
    for(int64_t task=worker;task<tasks;task+=s.workers) {
        const uint32_t ns=task%s.nSplit;
        const int64_t mt=(task/s.nSplit)%s.mTiles;
        const int64_t batch=task/(s.nSplit*s.mTiles);
        const int64_t m0=mt*s.baseM;
        const uint32_t rows=s.m-m0<s.baseM?s.m-m0:s.baseM;
        const uint32_t begin=ns*s.nTiles/s.nSplit,end=(ns+1)*s.nTiles/s.nSplit;
        for(uint32_t nt=begin;nt<end;nt+=s.window,++sequence) {
            const uint32_t slot=sequence&1;
            AscendC::CrossCoreWaitFlag<2>(2+slot);
            const int64_t n0=int64_t(nt)*s.baseN;
            const uint32_t tiles=end-nt<s.window?end-nt:s.window;
            const uint32_t cols=s.n-n0<tiles*s.baseN?s.n-n0:tiles*s.baseN;
            mm.SetOrgShape(s.m,s.n,s.k,s.k,width);
            mm.SetTensorA(a[batch*s.m*s.k+(TX1?m0:m0*s.k)],TX1);
            mm.SetTensorB(b[batch*s.n*s.k+(TX2?n0*s.k:n0)],TX2);
            mm.SetTail(rows,cols,s.k);
            mm.template IterateAll<false>(ring[slot*slotSize]);
            if constexpr(!MDL)mm.End();
            AscendC::CrossCoreSetFlag<2,PIPE_FIX>(slot);
        }
    }
    if constexpr(MDL)mm.End();
    // Consume each slot's last release, including an unused initial credit.
    AscendC::CrossCoreWaitFlag<2>(2);
    AscendC::CrossCoreWaitFlag<2>(3);
#else
    AscendC::TQue<AscendC::TPosition::VECIN,2> cq;
    AscendC::TQue<AscendC::TPosition::VECOUT,1> mq;
    AscendC::TBuf<AscendC::TPosition::VECCALC> rowBuf,tmpBuf,valBuf;
    pipe.InitBuffer(cq,2,(s.baseM/2)*s.baseN*4);
    pipe.InitBuffer(mq,1,s.baseM*4);
    pipe.InitBuffer(rowBuf,s.baseM*4);pipe.InitBuffer(tmpBuf,s.baseM*4);
    pipe.InitBuffer(valBuf,32);
    auto row=rowBuf.Get<float>(),tmp=tmpBuf.Get<float>(),val=valBuf.Get<float>();
    AscendC::CrossCoreSetFlag<2,PIPE_MTE2>(2);
    AscendC::CrossCoreSetFlag<2,PIPE_MTE2>(3);
    // The CANN 9 dual-master wrapper still has a lightweight iteration-start
    // handshake (flag 9). Post two iterations ahead; completion uses our slots.
    uint32_t totalWindows=0;
    for(int64_t task=worker;task<tasks;task+=s.workers) {
        const uint32_t ns=task%s.nSplit;
        const uint32_t begin=ns*s.nTiles/s.nSplit,end=(ns+1)*s.nTiles/s.nSplit;
        totalWindows+=(end-begin+s.window-1)/s.window;
    }
    for(uint32_t i=0;i<2 && i<totalWindows;++i) mm.template IterateAll<false>(ring);
    for(int64_t task=worker;task<tasks;task+=s.workers) {
        const uint32_t ns=task%s.nSplit;
        const int64_t mt=(task/s.nSplit)%s.mTiles;
        const int64_t batch=task/(s.nSplit*s.mTiles);
        const int64_t m0=mt*s.baseM;
        const int64_t remaining=s.m-m0-rowStart;
        const uint32_t rows=remaining<=0?0:(remaining<s.baseM/2?remaining:s.baseM/2);
        const uint32_t begin=ns*s.nTiles/s.nSplit,end=(ns+1)*s.nTiles/s.nSplit;
        auto maxima=mq.AllocTensor<float>();
        AscendC::Duplicate(maxima,-__builtin_inff(),s.baseM);
        AscendC::PipeBarrier<PIPE_V>();
        for(uint32_t nt=begin;nt<end;nt+=s.window,++sequence) {
            const uint32_t slot=sequence&1;
            AscendC::CrossCoreWaitFlag<2>(slot);
            const uint32_t tiles=end-nt<s.window?end-nt:s.window;
            for(uint32_t p=0;rows && p<tiles;++p) {
                const int64_t n0=int64_t(nt+p)*s.baseN;
                const uint32_t cols=s.n-n0<s.baseN?s.n-n0:s.baseN;
                auto c=cq.AllocTensor<float>();
                const uint32_t padded=(cols+7)/8*8;
                AscendC::DataCopyExtParams cp{static_cast<uint16_t>(rows),cols*4,
                    (width-cols)*4,(s.baseN-padded)/8,0};
                AscendC::DataCopyPadExtParams<float> pad{true,0,static_cast<uint8_t>(padded-cols),-__builtin_inff()};
                AscendC::DataCopyPad(c,ring[slot*slotSize+rowStart*width+p*s.baseN],cp,pad);
                cq.EnQue(c);c=cq.DeQue<float>();
                for(uint32_t col=0;col<cols;col+=64) {
                    const uint32_t n=cols-col<64?cols-col:64;
                    AscendC::WholeReduceMax(row,c[col],uint64_t(n),rows,1,1,s.baseN/8,
                                            AscendC::ReduceOrder::ORDER_ONLY_VALUE);
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::BinaryRepeatParams rp{1,1,1,8,8,8};
                    if(rows/64) AscendC::Max(maxima,maxima,row,uint64_t(64),rows/64,rp);
                    if(rows%64) AscendC::Max(maxima[(rows/64)*64],maxima[(rows/64)*64],row[(rows/64)*64],
                                              uint64_t(rows%64),1,rp);
                    AscendC::PipeBarrier<PIPE_V>();
                }
                cq.FreeTensor(c);
            }
            AscendC::CrossCoreSetFlag<2,PIPE_MTE2>(2+slot);
            if(sequence+2<totalWindows) mm.template IterateAll<false>(ring);
        }
        if(s.earlySum && s.nSplit==1) {
            AscendC::Duplicate(val,0.0f,8);AscendC::PipeBarrier<PIPE_V>();
            if(rows) AscendC::ReduceSum<float,true>(val,maxima,tmp,rows);
            Fence<AscendC::HardEvent::V_MTE3>();
            AscendC::DataCopy(partials[task*16+sub*8],val,8);
            Fence<AscendC::HardEvent::MTE3_V>();
            mq.FreeTensor(maxima);
        } else {
            mq.EnQue(maxima);maxima=mq.DeQue<float>();
            AscendC::DataCopy(partials[(batch*s.nSplit+ns)*s.mTiles*s.baseM+m0+rowStart],maxima,s.baseM/2);
            mq.FreeTensor(maxima);
        }
    }
    AscendC::SyncAll<true>();
    if(s.earlySum && s.nSplit==1) {s.mTiles*=2;FinalizeEarly(partial,output,s,pipe);}
    else if(int64_t(AscendC::GetBlockIdx())*8<s.b) FinalizeRows(partial,output,s,pipe);
#endif
}

// K-axis staggering is already enabled in the original MDL family.
// Compatible Norm plans can use explicit packages with the same local budgets.
constexpr auto C11PackageConfig()
{
    auto cfg=CFG_MDL;
    cfg.enableMixDualMaster=true;
    cfg.enUnitFlag=true;
    cfg.enableKdimReorderLoad=true;
    cfg.enableL1BankConflictOptimise=false;
    return cfg;
}
constexpr auto C11_PACKAGE_CONFIG=C11PackageConfig();
template<bool MDL,bool PACKAGE>
constexpr auto GENERIC_C11_CONFIG=PACKAGE?C11_PACKAGE_CONFIG:GENERIC_PAIR_CONFIG<MDL>;
template <typename T, bool MDL, bool PACKAGE=false>
__schedmode__(1) __global__ __mix__(1, 2) void bmmms_generic_c11(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR partial, GM_ADDR output, GM_ADDR workspace,
    AscendC::tiling::TCubeTiling tiling, Schedule s)
{
    constexpr bool TX1=true,TX2=true;
    AscendC::TPipe pipe;
    using A=matmul::MatmulType<AscendC::TPosition::GM,CubeFormat::ND,T,TX1,LayoutMode::NONE,true>;
    using B=matmul::MatmulType<AscendC::TPosition::GM,CubeFormat::ND,T,TX2,LayoutMode::NONE,true>;
    using C=matmul::MatmulType<AscendC::TPosition::GM,CubeFormat::ND,float>;
    using Bias=matmul::MatmulType<AscendC::TPosition::GM,CubeFormat::ND,float>;
    matmul::Matmul<A,B,C,Bias,GENERIC_C11_CONFIG<MDL,PACKAGE>> mm;
    REGIST_MATMUL_OBJ(&pipe, workspace, mm, &tiling);
    AscendC::GlobalTensor<T> a,b;
    AscendC::GlobalTensor<float> ring,partials;
    a.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x1));
    b.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x2));
    partials.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(partial));
    const uint32_t width=s.baseN*s.window;
    const uint32_t slotSize=s.baseM*width;
    const int64_t partialCount=s.b*s.nSplit*s.mTiles*s.baseM;
    const int64_t alignedCount=(partialCount+127)/128*128;
#ifdef __DAV_CUBE__
    const uint32_t worker=AscendC::GetBlockIdx();
#else
    const uint32_t worker=AscendC::GetBlockIdx()/2;
    const uint32_t sub=AscendC::GetBlockIdx()%2;
    const uint32_t rowStart=sub*(s.baseM/2);
#endif
    ring.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(partial)+alignedCount+
                         int64_t(worker)*2*slotSize);
    const int64_t tasks=s.b*s.mTiles*s.nSplit;
    uint32_t sequence=0;
#ifdef __DAV_CUBE__
    AscendC::SetAtomicNone();
    AscendC::SetLoadDataBoundary(uint64_t(0));
    AscendC::SetLoadDataPaddingValue(uint64_t(0));
    for(int64_t task=worker;task<tasks;task+=s.workers) {
        const uint32_t ns=task%s.nSplit;
        const int64_t mt=(task/s.nSplit)%s.mTiles;
        const int64_t batch=task/(s.nSplit*s.mTiles);
        const int64_t m0=mt*s.baseM;
        const uint32_t rows=s.m-m0<s.baseM?s.m-m0:s.baseM;
        const uint32_t begin=ns*s.nTiles/s.nSplit,end=(ns+1)*s.nTiles/s.nSplit;
        for(uint32_t nt=begin;nt<end;nt+=s.window,++sequence) {
            const uint32_t slot=sequence&1;
            AscendC::CrossCoreWaitFlag<2>(2+slot);
            const int64_t n0=int64_t(nt)*s.baseN;
            const uint32_t tiles=end-nt<s.window?end-nt:s.window;
            const uint32_t cols=s.n-n0<tiles*s.baseN?s.n-n0:tiles*s.baseN;
            mm.SetOrgShape(s.m,s.n,s.k,s.k,width);
            mm.SetTensorA(a[batch*s.m*s.k+(TX1?m0:m0*s.k)],TX1);
            mm.SetTensorB(b[batch*s.n*s.k+(TX2?n0*s.k:n0)],TX2);
            mm.SetTail(rows,cols,s.k);
            mm.template IterateAll<false>(ring[slot*slotSize]);
            if constexpr(!MDL)mm.End();
            AscendC::CrossCoreSetFlag<2,PIPE_FIX>(slot);
        }
    }
    if constexpr(MDL)mm.End();
    // Consume each slot's last release, including an unused initial credit.
    AscendC::CrossCoreWaitFlag<2>(2);
    AscendC::CrossCoreWaitFlag<2>(3);
#else
    AscendC::TQue<AscendC::TPosition::VECIN,2> cq;
    AscendC::TQue<AscendC::TPosition::VECOUT,1> mq;
    AscendC::TBuf<AscendC::TPosition::VECCALC> rowBuf,tmpBuf,valBuf;
    pipe.InitBuffer(cq,2,(s.baseM/2)*s.baseN*4);
    pipe.InitBuffer(mq,1,s.baseM*4);
    pipe.InitBuffer(rowBuf,s.baseM*4);pipe.InitBuffer(tmpBuf,s.baseM*4);
    pipe.InitBuffer(valBuf,32);
    auto row=rowBuf.Get<float>(),tmp=tmpBuf.Get<float>(),val=valBuf.Get<float>();
    AscendC::CrossCoreSetFlag<2,PIPE_MTE2>(2);
    AscendC::CrossCoreSetFlag<2,PIPE_MTE2>(3);
    // The CANN 9 dual-master wrapper still has a lightweight iteration-start
    // handshake (flag 9). Post two iterations ahead; completion uses our slots.
    uint32_t totalWindows=0;
    for(int64_t task=worker;task<tasks;task+=s.workers) {
        const uint32_t ns=task%s.nSplit;
        const uint32_t begin=ns*s.nTiles/s.nSplit,end=(ns+1)*s.nTiles/s.nSplit;
        totalWindows+=(end-begin+s.window-1)/s.window;
    }
    for(uint32_t i=0;i<2 && i<totalWindows;++i) mm.template IterateAll<false>(ring);
    for(int64_t task=worker;task<tasks;task+=s.workers) {
        const uint32_t ns=task%s.nSplit;
        const int64_t mt=(task/s.nSplit)%s.mTiles;
        const int64_t batch=task/(s.nSplit*s.mTiles);
        const int64_t m0=mt*s.baseM;
        const int64_t remaining=s.m-m0-rowStart;
        const uint32_t rows=remaining<=0?0:(remaining<s.baseM/2?remaining:s.baseM/2);
        const uint32_t begin=ns*s.nTiles/s.nSplit,end=(ns+1)*s.nTiles/s.nSplit;
        auto maxima=mq.AllocTensor<float>();
        AscendC::Duplicate(maxima,-__builtin_inff(),s.baseM);
        AscendC::PipeBarrier<PIPE_V>();
        for(uint32_t nt=begin;nt<end;nt+=s.window,++sequence) {
            const uint32_t slot=sequence&1;
            AscendC::CrossCoreWaitFlag<2>(slot);
            const uint32_t tiles=end-nt<s.window?end-nt:s.window;
            for(uint32_t p=0;rows && p<tiles;++p) {
                const int64_t n0=int64_t(nt+p)*s.baseN;
                const uint32_t cols=s.n-n0<s.baseN?s.n-n0:s.baseN;
                auto c=cq.AllocTensor<float>();
                const uint32_t padded=(cols+7)/8*8;
                AscendC::DataCopyExtParams cp{static_cast<uint16_t>(rows),cols*4,
                    (width-cols)*4,(s.baseN-padded)/8,0};
                AscendC::DataCopyPadExtParams<float> pad{true,0,static_cast<uint8_t>(padded-cols),-__builtin_inff()};
                AscendC::DataCopyPad(c,ring[slot*slotSize+rowStart*width+p*s.baseN],cp,pad);
                cq.EnQue(c);c=cq.DeQue<float>();
                for(uint32_t col=0;col<cols;col+=64) {
                    const uint32_t n=cols-col<64?cols-col:64;
                    AscendC::WholeReduceMax(row,c[col],uint64_t(n),rows,1,1,s.baseN/8,
                                            AscendC::ReduceOrder::ORDER_ONLY_VALUE);
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::BinaryRepeatParams rp{1,1,1,8,8,8};
                    if(rows/64) AscendC::Max(maxima,maxima,row,uint64_t(64),rows/64,rp);
                    if(rows%64) AscendC::Max(maxima[(rows/64)*64],maxima[(rows/64)*64],row[(rows/64)*64],
                                              uint64_t(rows%64),1,rp);
                    AscendC::PipeBarrier<PIPE_V>();
                }
                cq.FreeTensor(c);
            }
            AscendC::CrossCoreSetFlag<2,PIPE_MTE2>(2+slot);
            if(sequence+2<totalWindows) mm.template IterateAll<false>(ring);
        }
        if(s.earlySum && s.nSplit==1) {
            AscendC::Duplicate(val,0.0f,8);AscendC::PipeBarrier<PIPE_V>();
            if(rows) AscendC::ReduceSum<float,true>(val,maxima,tmp,rows);
            Fence<AscendC::HardEvent::V_MTE3>();
            AscendC::DataCopy(partials[task*16+sub*8],val,8);
            Fence<AscendC::HardEvent::MTE3_V>();
            mq.FreeTensor(maxima);
        } else {
            mq.EnQue(maxima);maxima=mq.DeQue<float>();
            AscendC::DataCopy(partials[(batch*s.nSplit+ns)*s.mTiles*s.baseM+m0+rowStart],maxima,s.baseM/2);
            mq.FreeTensor(maxima);
        }
    }
    AscendC::SyncAll<true>();
    if(s.earlySum && s.nSplit==1) {s.mTiles*=2;FinalizeEarly(partial,output,s,pipe);}
    else if(int64_t(AscendC::GetBlockIdx())*8<s.b) FinalizeRows(partial,output,s,pipe);
#endif
}

// Split-K retains every C partial until the complete dot product is available.
// Its matrices are at most 32x32, so the temporary storage stays bounded.
template<bool PACKED=false>
__aicore__ inline void FinalizeSplitKND(GM_ADDR partial,GM_ADDR output,Schedule s,AscendC::TPipe &pipe)
{
    const int64_t b0=int64_t(AscendC::GetBlockIdx())*8;
    if(b0>=s.b)return;
    const uint32_t batches=s.b-b0<8?s.b-b0:8;
    const uint32_t elements=s.baseM*s.baseN;
    AscendC::GlobalTensor<float> in,out;
    in.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(partial));
    out.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(output));
    AscendC::TQue<AscendC::TPosition::VECIN,1> iq;
    AscendC::TQue<AscendC::TPosition::VECOUT,1> oq;
    AscendC::TBuf<AscendC::TPosition::VECCALC> accumBuf,tmpBuf,groupBuf,lanesBuf;
    pipe.InitBuffer(iq,1,(PACKED?s.kSplit:1)*elements*4);pipe.InitBuffer(oq,1,32);
    pipe.InitBuffer(accumBuf,PACKED?32:elements*4);
    pipe.InitBuffer(tmpBuf,s.baseM*4);pipe.InitBuffer(groupBuf,256);
    // One baseM-wide plane of partial maxima per 64-column group of N.
    const uint32_t groups=(static_cast<uint32_t>(s.n)+63)/64;
    pipe.InitBuffer(lanesBuf,groups*s.baseM*4);
    auto acc=accumBuf.Get<float>();
    auto tmp=tmpBuf.Get<float>(),grouped=groupBuf.Get<float>();
    auto lanes=lanesBuf.Get<float>();
    for(uint32_t bi=0;bi<batches;++bi) {
        AscendC::LocalTensor<float> packed;
        if constexpr(PACKED) {
            packed=iq.AllocTensor<float>();
            AscendC::DataCopy(packed,in[(b0+bi)*s.kSplit*elements],s.kSplit*elements);
            iq.EnQue(packed);packed=iq.DeQue<float>();
            acc=packed; // The first complete K partial is the initial FP32 accumulator.
        } else {
            AscendC::Duplicate(acc,0.0f,elements);AscendC::PipeBarrier<PIPE_V>();
        }
        for(uint32_t ks=PACKED?1:0;ks<s.kSplit;++ks) {
            AscendC::LocalTensor<float> x;
            if constexpr(PACKED) x=packed[ks*elements];
            else {
                x=iq.AllocTensor<float>();
                AscendC::DataCopy(x,in[((b0+bi)*s.kSplit+ks)*elements],elements);
                iq.EnQue(x);x=iq.DeQue<float>();
            }
            // Accumulate this K-split's partial. repeatTimes is a uint8_t, so a
            // single Add over the whole baseM*baseN tile is undefined once the
            // tile exceeds 255*64 elements -- at baseM=64, baseN=256 that is
            // exactly 256 repeats and the whole accumulation silently vanished,
            // which is why (1,64,256,*) returned 0.0. Chunk it.
            for(uint64_t off=0;off<elements;off+=16320) {
                const uint64_t cnt=elements-off<16320?elements-off:16320;
                AscendC::Add(acc[off],acc[off],x[off],uint64_t(64),cnt/64,
                             AscendC::BinaryRepeatParams{1,1,1,8,8,8});
            }
            AscendC::PipeBarrier<PIPE_V>();if constexpr(!PACKED)iq.FreeTensor(x);
        }
        // Reduce N in 64-wide groups and combine the group maxima afterwards.
        // The fp32 WholeReduceMax mask is capped at 64 elements per repeat, so
        // the previous single call with maskCount = s.n was undefined for every
        // N > 64 -- it returned near-correct values only while N was small enough
        // that the whole row fitted one repeat. Rows are likewise blocked to keep
        // the repeat count inside its 255 limit.
        for(uint32_t r0=0;r0<static_cast<uint32_t>(s.m);r0+=64) {
            const uint32_t rr=static_cast<uint32_t>(s.m)-r0<64?static_cast<uint32_t>(s.m)-r0:64;
            for(uint32_t g=0;g<groups;++g) {
                const uint32_t n=static_cast<uint32_t>(s.n)-g*64<64?static_cast<uint32_t>(s.n)-g*64:64;
                AscendC::WholeReduceMax(lanes[g*s.baseM+r0],acc[g*64+int64_t(r0)*s.baseN],
                                        uint64_t(n),rr,1,1,s.baseN/8,
                                        AscendC::ReduceOrder::ORDER_ONLY_VALUE);
            }
            AscendC::PipeBarrier<PIPE_V>();
            for(uint32_t step=1;step<groups;step*=2) {
                for(uint32_t g=0;g+step<groups;g+=2*step)
                    AscendC::Max(lanes[g*s.baseM+r0],lanes[g*s.baseM+r0],
                                 lanes[(g+step)*s.baseM+r0],rr);
                AscendC::PipeBarrier<PIPE_V>();
            }
        }
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::ReduceSum<float,true>(grouped[bi*8],lanes,tmp,s.m);
        AscendC::PipeBarrier<PIPE_V>();
        if constexpr(PACKED)iq.FreeTensor(packed);
    }
    auto y=oq.AllocTensor<float>();
    AscendC::WholeReduceSum(y,grouped,uint64_t(1),batches,1,1,1);
    oq.EnQue(y);y=oq.DeQue<float>();
    AscendC::DataCopyExtParams cp{1,batches*4,0,0,0};
    AscendC::DataCopyPad(out[b0],y,cp);oq.FreeTensor(y);
}

// Clip every input panel to this split, while retaining the true GM row stride.
template<typename T,bool TX1,bool TX2>
__aicore__ inline void ManualCopySplitK(
    AscendC::TQue<AscendC::TPosition::A1,2>& aq,
    AscendC::TQue<AscendC::TPosition::B1,2>& bq,
    const AscendC::GlobalTensor<T>& a,const AscendC::GlobalTensor<T>& b,
    const Schedule& s,uint32_t bk,int64_t batch,uint32_t kStart,uint32_t nk,uint32_t k0)
{
    const uint32_t count=nk-k0<bk?nk-k0:bk;
    const uint32_t globalK=kStart+k0;
    auto a1=aq.AllocTensor<T>();AscendC::Nd2NzParams ap;
    ap.ndNum=1;ap.nValue=TX1?count:s.m;ap.dValue=TX1?s.m:count;
    ap.srcDValue=TX1?s.m:s.k;ap.dstNzC0Stride=(ap.nValue+15)/16*16;ap.dstNzNStride=1;
    ManualZeroNZTail(a1,ap.nValue,ap.dValue);
    AscendC::DataCopy(a1,a[batch*s.m*s.k+(TX1?int64_t(globalK)*s.m:globalK)],ap);
    aq.EnQue(a1);
    auto b1=bq.AllocTensor<T>();AscendC::Nd2NzParams bp;
    bp.ndNum=1;bp.nValue=TX2?s.n:count;bp.dValue=TX2?count:s.n;
    bp.srcDValue=TX2?s.k:s.n;bp.dstNzC0Stride=(bp.nValue+15)/16*16;bp.dstNzNStride=1;
    ManualZeroNZTail(b1,bp.nValue,bp.dValue);
    AscendC::DataCopy(b1,b[batch*s.n*s.k+(TX2?globalK:int64_t(globalK)*s.n)],bp);
    bq.EnQue(b1);
}

template<typename T,bool TX1,bool TX2,bool PACKED=false>
__schedmode__(1) __global__ __mix__(1,2) void bmmms_manual_splitk(
    GM_ADDR x1,GM_ADDR x2,GM_ADDR partial,GM_ADDR output,Schedule s,uint32_t bk)
{
    AscendC::TPipe pipe;
#ifdef __DAV_CUBE__
    AscendC::SetAtomicNone();AscendC::SetLoadDataBoundary(uint64_t(0));
    AscendC::SetLoadDataPaddingValue(uint64_t(0));
    AscendC::GlobalTensor<T> a,b;AscendC::GlobalTensor<float> parts;
    a.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x1));
    b.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x2));
    parts.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(partial));
    const uint32_t rows=s.baseM,cols=s.baseN,elements=rows*cols;
    AscendC::TQue<AscendC::TPosition::A1,2> aq;
    AscendC::TQue<AscendC::TPosition::B1,2> bq;
    AscendC::TBuf<AscendC::TPosition::A2> ab;
    AscendC::TBuf<AscendC::TPosition::B2> bb;
    AscendC::TBuf<AscendC::TPosition::CO1> cb;
    pipe.InitBuffer(aq,2,rows*bk*2);pipe.InitBuffer(bq,2,cols*bk*2);
    pipe.InitBuffer(ab,rows*bk*4);pipe.InitBuffer(bb,cols*bk*4);
    pipe.InitBuffer(cb,elements*4);
    auto a2all=ab.Get<T>(),b2all=bb.Get<T>();auto c=cb.Get<float>();
    event_t loadFree[2],loadReady[2];
    for(uint32_t i=0;i<2;++i) {
        loadFree[i]=static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::M_MTE1>());
        loadReady[i]=static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::MTE1_M>());
        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(loadFree[i]);
    }
    const auto cFree=static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::FIX_M>());
    AscendC::SetFlag<AscendC::HardEvent::FIX_M>(cFree);
    uint32_t kSequence=0;
    const int64_t tasks=s.b*s.kSplit;
    for(int64_t task=AscendC::GetBlockIdx();task<tasks;task+=s.workers) {
        const int64_t batch=task/s.kSplit;
        const uint32_t kStart=(task%s.kSplit)*s.kChunk;
        const uint32_t nk=s.k-kStart<s.kChunk?s.k-kStart:s.kChunk;
        // A previous task's asynchronous Fixpipe must release this CO1 tile.
        AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree);
        ManualCopySplitK<T,TX1,TX2>(aq,bq,a,b,s,bk,batch,kStart,nk,0);
        if(nk>bk)ManualCopySplitK<T,TX1,TX2>(aq,bq,a,b,s,bk,batch,kStart,nk,bk);
        for(uint32_t k0=0;k0<nk;k0+=bk,++kSequence) {
            const uint32_t validCount=nk-k0<bk?nk-k0:bk;
            const uint32_t count=(validCount+15)/16*16,ks=kSequence&1;
            auto a1=aq.DeQue<T>(),b1=bq.DeQue<T>();
            auto a2=a2all[ks*rows*bk],b2=b2all[ks*cols*bk];
            AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(loadFree[ks]);
            AscendC::LoadData3DParamsV2<T> panel;
            panel.l1H=1;panel.l1W=TX1?count:rows;panel.channelSize=TX1?rows:count;
            panel.mStartPt=0;panel.kStartPt=0;
            panel.mExtension=TX1?count:rows;panel.kExtension=TX1?rows:count;panel.enTranspose=TX1;
            AscendC::LoadData(a2,a1,panel);
            AscendC::LoadData2DParams lp;
            lp.dstGap=0;lp.ifTranspose=!TX2;
            if constexpr(TX2) {
                lp.repeatTimes=count*cols/256;lp.srcStride=1;AscendC::LoadData(b2,b1,lp);
            } else {
                lp.repeatTimes=cols/16;lp.srcStride=count/16;
                for(uint32_t ki=0;ki<count/16;++ki)
                    AscendC::LoadData(b2[ki*cols*16],b1[ki*256],lp);
            }
            aq.FreeTensor(a1);bq.FreeTensor(b1);
            if(k0+2*bk<nk)ManualCopySplitK<T,TX1,TX2>(aq,bq,a,b,s,bk,batch,kStart,nk,k0+2*bk);
            AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(loadReady[ks]);
            AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(loadReady[ks]);
            AscendC::MmadParams mp;
            mp.m=rows;mp.n=cols;mp.k=count;mp.cmatrixInitVal=k0==0;
            AscendC::Mmad(c,a2,b2,mp);
            if((rows/16)*(cols/16)<10)AscendC::PipeBarrier<PIPE_M>();
            AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(loadFree[ks]);
        }
        Fence<AscendC::HardEvent::M_FIX>();
        AscendC::FixpipeParamsV220 fp;
        fp.nSize=cols;fp.mSize=rows;fp.srcStride=rows;fp.dstStride=cols;
        AscendC::Fixpipe(parts[task*elements],c,fp);
        AscendC::SetFlag<AscendC::HardEvent::FIX_M>(cFree);
    }
    for(uint32_t i=0;i<2;++i) {
        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(loadFree[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::M_MTE1>(loadFree[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::MTE1_M>(loadReady[i]);
    }
    AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree);
    pipe.ReleaseEventID<AscendC::HardEvent::FIX_M>(cFree);
    // One completion per Cube, including a worker assigned no tasks.
    AscendC::CrossCoreSetFlag<2,PIPE_FIX>(0);
#else
    AscendC::CrossCoreWaitFlag<2>(0);
    AscendC::SyncAll<true>();
    FinalizeSplitKND<PACKED>(partial,output,s,pipe);
#endif
}

template <typename T,bool TX1,bool TX2,bool PACKED=false>
__schedmode__(1) __global__ __mix__(1,2) void bmmms_dual_split(
    GM_ADDR x1,GM_ADDR x2,GM_ADDR partial,GM_ADDR output,GM_ADDR workspace,
    AscendC::tiling::TCubeTiling tiling,Schedule s)
{
    AscendC::TPipe pipe;
    using A=matmul::MatmulType<AscendC::TPosition::GM,CubeFormat::ND,T,TX1,LayoutMode::NONE,true>;
    using B=matmul::MatmulType<AscendC::TPosition::GM,CubeFormat::ND,T,TX2,LayoutMode::NONE,true>;
    using C=matmul::MatmulType<AscendC::TPosition::GM,CubeFormat::ND,float>;
    using Bias=matmul::MatmulType<AscendC::TPosition::GM,CubeFormat::ND,float>;
    matmul::Matmul<A,B,C,Bias,DUAL_CONFIG> mm;
    REGIST_MATMUL_OBJ(&pipe,workspace,mm,&tiling);
    AscendC::GlobalTensor<T> a,b;
    AscendC::GlobalTensor<float> parts;
    a.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x1));
    b.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x2));
    parts.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(partial));
    const uint32_t elements=s.baseM*s.baseN;
    const int64_t tasks=s.b*s.kSplit;
#ifdef __DAV_CUBE__
    AscendC::SetAtomicNone();
    AscendC::SetLoadDataBoundary(uint64_t(0));
    AscendC::SetLoadDataPaddingValue(uint64_t(0));
    for(int64_t task=AscendC::GetBlockIdx();task<tasks;task+=s.workers) {
        const int64_t batch=task/s.kSplit;
        const uint32_t k0=(task%s.kSplit)*s.kChunk;
        const uint32_t nk=s.k-k0<s.kChunk?s.k-k0:s.kChunk;
        mm.SetOrgShape(s.m,s.n,s.k,s.k,s.baseN);
        mm.SetTensorA(a[batch*s.m*s.k+(TX1?k0*s.m:k0)],TX1);
        mm.SetTensorB(b[batch*s.n*s.k+(TX2?k0:k0*s.n)],TX2);
        mm.SetTail(s.m,s.n,nk);
        mm.template IterateAll<true>(parts[task*elements]);
        mm.End();
    }
#else
    const uint32_t worker=AscendC::GetBlockIdx()/2,sub=AscendC::GetBlockIdx()%2;
    AscendC::TBuf<AscendC::TPosition::VECCALC> zerosBuf;
    pipe.InitBuffer(zerosBuf,PACKED?32:elements*2);
    auto zeros=zerosBuf.Get<float>();
    if constexpr(!PACKED) {
        AscendC::Duplicate(zeros,0.0f,elements/2);
        Fence<AscendC::HardEvent::V_MTE3>();
    }
    for(int64_t task=worker;task<tasks;task+=s.workers) {
        // Initialize only this AIV's row half. The API's start signal is on
        // MTE3, so both zero stores complete before the AIC writes valid C.
        if constexpr(!PACKED)
            AscendC::DataCopy(parts[task*elements+sub*elements/2],zeros,elements/2);
        mm.template IterateAll<true>(parts[task*elements]);
    }
    AscendC::SyncAll<true>();
    FinalizeSplitKND<PACKED>(partial,output,s,pipe);
#endif
}

inline void CheckAcl(aclError error, const char *operation)
{
    if (error != ACL_SUCCESS)
        throw std::runtime_error(std::string(operation) + " failed, ACL error=" + std::to_string(error));
}
inline int64_t Ceil(int64_t v, int64_t d) { return (v + d - 1) / d; }
inline const TensorInfo &OnlyTensor(const TensorGroupInfo &group)
{
    if (group.numTensors != 1 || !group.tensors || !group.tensors[0].shape)
        throw std::invalid_argument("expected exactly one tensor with shape metadata");
    return group.tensors[0];
}
inline Shape Validate(const TensorGroupInfo &a, const TensorGroupInfo &b, const TensorGroupInfo &y,
                      bool tx1, bool tx2)
{
    const auto &ai = OnlyTensor(a);
    const auto &bi = OnlyTensor(b);
    const auto &yi = OnlyTensor(y);
    if (ai.numDims != 3 || bi.numDims != 3 || yi.numDims != 1)
        throw std::invalid_argument("expected rank-3 inputs and rank-1 output");
    Shape s{ai.shape[0], ai.shape[tx1 ? 2 : 1], bi.shape[tx2 ? 1 : 2],
            ai.shape[tx1 ? 1 : 2], ai.dtype, tx1 ? 1 : 0, tx2 ? 1 : 0};
    if (s.b < 1 || s.b > 64 || s.m < 1 || s.m > 8192 || s.n < 1 || s.n > 8192 ||
        s.k < 32 || s.k > 8192 || s.k % 8 != 0)
        throw std::invalid_argument("B/M/N/K outside competition limits");
    if (bi.shape[0] != s.b || bi.shape[tx2 ? 2 : 1] != s.k || yi.shape[0] != s.b)
        throw std::invalid_argument("batch/K/output mismatch; broadcast unsupported");
    if ((s.dtype != 1 && s.dtype != 2) || bi.dtype != s.dtype || yi.dtype != 0)
        throw std::invalid_argument("expected matching FP16/BF16 inputs and FP32 output");
    if (s.b * s.m * s.k > (int64_t(1) << 26) || s.b * s.n * s.k > (int64_t(1) << 26))
        throw std::invalid_argument("input exceeds 2^26 elements");
    return s;
}
struct Plan {
    Schedule schedule{};
    AscendC::tiling::TCubeTiling cube{};
    uint32_t cubeBlocks = 0, finalBlocks = 0;
    uint64_t systemBytes = 0, totalBytes = 0;
    bool small = false, micro = false;
};

// K<=64 bounds the fixed UB frame and FP32 masks; padded K tails use the exact mask.
// Notes: docs/kernel_function_notes.md#forced-dispatch-l5297
enum ForcedKind { FORCED_NONE = 0, FORCED_DOT = 15, FORCED_TINY = 16 };

// A case hit names BOTH the entry kernel (`dual`) and the tiling that was measured
// fastest for that class. bm/bn/window/ns/ks are 0 when the class did not pin them.
struct CaseProfile {
    int dual = FORCED_NONE;
    int bm = 0, bn = 0, window = 0, ns = 0, ks = 0;
    int cores = 0;
    bool locked = false;
};

// The short vector algorithm has real mask, repeat, output and UB limits.
// Full B/M/N/K input layout handling is retained for both input dtypes.
inline bool TinyVectorFits(const Shape& s, uint64_t ub)
{
    if(s.b<1 || s.b>8 || s.m<1 || s.m>8 || s.n<1 || s.n>64 || s.k>64)
        return false;
    const uint64_t kp=Ceil(s.k,16)*16,np=Ceil(s.n,8)*8;
    const uint64_t ar=s.b*s.m,br=s.b*s.n;
    uint64_t bytes=6*(ar+br)*kp+4*ar*np*kp+4*ar*np+32*ar+32;
    if(s.tx1 || !s.tx2) {
        bytes+=768+(s.tx1?4*Ceil(ar*s.k,16)*16:32)+
            (!s.tx2?4*Ceil(br*s.k,16)*16:32);
    } else bytes+=64;
    return bytes+1024<=ub;
}


// The original vector shape remains unchanged. A larger B is partitioned into
// independent groups only when each group satisfies the same real UB/mask limits.
inline uint32_t TinyVectorBatchGroup(const Shape& s,uint64_t ub)
{
    if(s.m==1 && s.n==1)return 0;
    for(int64_t batches=std::min<int64_t>(s.b,8);batches>=1;--batches) {
        Shape group=s;group.b=batches;
        if(TinyVectorFits(group,ub))return static_cast<uint32_t>(batches);
    }
    return 0;
}

inline bool SmallFullTileFits(const Shape& s,uint64_t ub,uint64_t l1,
    uint64_t l0c,uint64_t l0a,uint64_t l0b)
{
    if(s.m<2 || s.m>64 || s.n<2 || s.n>256 || s.k<32 || s.k>1024)
        return false;
    const uint64_t mp=Ceil(s.m,16)*16,np=Ceil(s.n,16)*16,kp=Ceil(s.k,16)*16;
    const uint64_t aBytes=mp*kp*2,bBytes=np*kp*2;
    // The L0 bounds also cap the contiguous LoadData repeat counts at 128.
    return mp*np*4+2*mp*4+32+1536<ub && aBytes+bBytes+4096<=l1 &&
        mp*np*4<=l0c && aBytes<=std::min<uint64_t>(l0a,65536) &&
        bBytes<=std::min<uint64_t>(l0b,65536);
}

inline CaseProfile ClassifyCase(const Shape &s, uint64_t ub)
{
    CaseProfile c;
    const bool kAligned = ((s.k % 8) == 0);

    // ---- vector families: the kernel owns the whole plan, so these return early.
    if (kAligned && s.k >= 32 && s.k <= 64) {
        if (s.m == 1 && s.n == 1) { c.dual = FORCED_DOT; return c; }
        if (TinyVectorFits(s,ub)) { c.dual = FORCED_TINY; return c; }
    }

    // Notes: docs/kernel_function_notes.md#classifycase-case15-l5387
    if (s.k >= 4096 && s.m >= 16 && s.m <= 128 && s.n <= 256) {
        const uint64_t m16 = Ceil(s.m, 16) * 16, n16 = Ceil(s.n, 16) * 16;
        const uint64_t vectorTile = std::min<uint64_t>(1024, (ub - 64) / 28 / 16 * 16);
        const uint64_t finalBytes = 3ULL * vectorTile * sizeof(float) + 64;
        const uint64_t vectorBytes = 2ULL * m16 * n16 * sizeof(float) + 18ULL * m16 * sizeof(float)
                                     + 32 + finalBytes;
        if (vectorBytes < ub) { c.dual = 1; c.ks = 4; return c; }
    }

    // Notes: docs/kernel_function_notes.md#classifycase-case14-l5409
    if (s.m <= 128 && s.n >= 4096 && s.k <= 512) {
        c.dual = 1; c.bn = 128; c.window = 2; c.ns = 10; return c;
    }

    // Notes: docs/kernel_function_notes.md#classifycase-case13-l5417
    if (s.m >= 2048 && s.n <= 256 && s.k <= 512) {
        c.bm = 128;
        c.bn = static_cast<int>(Ceil(s.n, 16) * 16);
        c.window = 1; c.ns = 1;
        if (s.m % 16 == 0 && s.n % 16 == 0 && s.k % 16 == 0) c.dual = 3;
        else c.dual = 14;
        return c;
    }

    // Notes: docs/kernel_function_notes.md#classifycase-case12-l5435
    if (s.m >= 1024 && s.n >= 2048 && s.k >= 1024 && s.n >= 4 * s.k) {
        c.dual = 1; c.bm = 128; c.bn = 256; c.window = 2; c.ns = 5; return c;
    }

    return c;
}

// Measured subregions only; a ten-percent margin stays in its power-of-two bucket.
inline bool NearMeasured(int64_t value,int64_t center)
{
    int64_t lowerPower=1;
    while(lowerPower*2<=center)lowerPower*=2;
    return value>=std::max(lowerPower,center-center/10) &&
           value<=std::min(lowerPower*2-1,center+center/10);
}
inline CaseProfile ClassifyMeasured(const Shape& s,int64_t aic,uint64_t ub,uint64_t l1,uint64_t l0c,uint64_t l0a,uint64_t l0b)
{
    CaseProfile c;
    if(s.b>=16 && s.b<32 && s.m>=32 && s.m<64 &&
        s.n>=128 && s.n<256 && s.k>=256 && s.k<512 && s.k%8==0 &&
        s.dtype==1 && s.tx1 && !s.tx2) {
        c.dual=(s.m%16==0 && s.n%16==0 && s.k%16==0)?3:14;
        c.bm=Ceil(s.m,16)*16;c.bn=Ceil(s.n,16)*16;c.window=1;c.ns=1;c.ks=1;
        c.cores=aic;c.locked=true;
        return c;
    }
    // Keep a full tiny frame on its original entry. Otherwise split B into
    // resource-validated groups, with at most one group per physical AIV.
    const bool tiny=s.k<=64 && TinyVectorFits(s,ub);
    const uint32_t tinyGroup=tiny?0:TinyVectorBatchGroup(s,ub);
    if(tinyGroup && Ceil(s.b,tinyGroup)<=2*aic) {
        c.dual=24;c.locked=true;return c;
    }
    // Preserve the existing TN complete-batch/manual dispatch, including case7.
    // The expanded single-tile path owns all M/N/K and one complete batch/core.
    const bool previousSmall=s.b>=1 && s.m>=2 && s.m<=32 && s.n>=2 &&
        s.n<=128 && s.k>=72 && s.k<=256;
    const bool expandedSmall=s.b>=1 && s.m>=2 && s.m<=64 && s.n>=2 &&
        s.n<=128 && s.k>=32 && s.k<=512 && !(s.tx1 && !s.tx2);
    if((previousSmall || expandedSmall) && !tiny && s.b<=aic) {
        const int64_t mp=Ceil(s.m,16)*16,np=Ceil(s.n,16)*16,kp=Ceil(s.k,16)*16;
        const uint64_t ubBytes=uint64_t(mp)*np*4+2*mp*4+32+512;
        const uint64_t aBytes=uint64_t(mp)*kp*2,bBytes=uint64_t(np)*kp*2;
        if(ubBytes+1024<ub && aBytes+bBytes+4096<=l1 &&
           uint64_t(mp)*np*4<=l0c &&
           aBytes<=std::min<uint64_t>(l0a,65536) &&
           bBytes<=std::min<uint64_t>(l0b,65536)) {
            c.dual=19;c.bm=mp;c.bn=np;c.window=1;c.ns=1;c.ks=1;c.cores=aic;c.locked=true;
            return c;
        }
    }
    // The single-batch entry uses worker==batch and must retain B<=AIC.
    // Its generic sibling owns round-robin batches and uses only complete,
    // resource-validated M/N/K tiles, including all four storage layouts.
    const bool microVector=s.k<=64 && s.m<=16 && s.n<=32 &&
        (s.tx1 || (s.n<=8 && !s.tx2));
    if(!tiny && !microVector && SmallFullTileFits(s,ub,l1,l0c,l0a,l0b)) {
        c.dual=23;c.bm=Ceil(s.m,16)*16;c.bn=Ceil(s.n,16)*16;
        c.window=1;c.ns=1;c.ks=1;c.cores=aic;c.locked=true;return c;
    }
    if(s.b==1 && aic==20) {
        // Notes: docs/kernel_function_notes.md#classifymeasured-package-selection-l5499
        const bool middle8=s.dtype==2 && s.tx1 && s.tx2 && s.m<=1536 && s.n<=1536 && s.k<=1536 && NearMeasured(s.m,1536) && NearMeasured(s.n,1536) && NearMeasured(s.k,1536);
        const bool middle9=s.dtype==1 && !s.tx1 && s.tx2 && s.m>=2048 && s.m<4096 && s.n>=1024 && s.n<2048 && s.k>=1024 && s.k<2048;
        const bool middle11=s.dtype==1 && s.tx1 && s.tx2 && NearMeasured(s.m,1536) && NearMeasured(s.n,3072) && NearMeasured(s.k,3072);
        if(middle8 || middle9 || middle11) {
            c.dual=1;c.bm=128;c.bn=128;c.window=2;c.ns=middle11?5:3;c.ks=1;c.cores=20;c.locked=true;
            return c;
        }
    }
    return c;
}

inline Plan MakePlanImpl(const Shape &s, int64_t availableCoreNum, bool allowMeasured)
{
    auto *platform = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (!platform) throw std::runtime_error("CANN platform information unavailable");
    const int64_t aic = std::min<int64_t>(availableCoreNum, platform->GetCoreNumAic());
    const int64_t aiv = platform->GetCoreNumAiv();
    uint64_t ub = 0, l1 = 0, l0c = 0, l0a = 0, l0b = 0;
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ub);
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::L1, l1);
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_C, l0c);
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_A, l0a);
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_B, l0b);
    if (aic <= 0 || aiv < 2 || ub < 4096 || !l1 || !l0c)
        throw std::runtime_error("invalid platform capacity for dav-2201 MIX(1,2)");
    Plan p;
    // Notes: docs/kernel_function_notes.md#makeplanimpl-forced-selection-l5527
    const bool forcedPinned = false;
    const CaseProfile measured=(!forcedPinned && allowMeasured)?ClassifyMeasured(s,std::min<int64_t>(aic,aiv/2),ub,l1,l0c,l0a,l0b):CaseProfile{};
    const CaseProfile caseProfile=measured.dual!=FORCED_NONE?measured:(forcedPinned?CaseProfile{}:ClassifyCase(s,ub));
    if (caseProfile.dual == FORCED_DOT || caseProfile.dual == FORCED_TINY) {
        // The two vector families own their entire plan, so they return here.
        p.schedule.balance = 1;
        p.schedule.microRows = s.m;
        p.schedule.batchGroup = s.b == 1 ? 8 : 0;
        p.schedule.earlySum = 0;
        p.schedule.tree = 0;
        p.schedule.dual = static_cast<uint32_t>(caseProfile.dual);
        p.schedule.kSplit = 1;
        p.schedule.kChunk = s.k;
        p.schedule.b = s.b; p.schedule.m = s.m; p.schedule.n = s.n; p.schedule.k = s.k;
        if (caseProfile.dual == FORCED_DOT) {
            // bmmms_dot_short grids ceil(B/8) blocks, each owning 8 batches.
            p.finalBlocks = static_cast<uint32_t>(Ceil(s.b, 8));
            if (p.finalBlocks > aiv)
                throw std::runtime_error("insufficient AIV cores for output groups");
        } else {
            // The default single-core tiny plan needs no GM scratch.
            p.schedule.workers = 1;
            p.finalBlocks = 1;
            p.totalBytes = 0;
            if (s.b > 1 && s.b <= aiv) {
                p.schedule.dual = 24;
                p.schedule.batchGroup = 1;
                p.schedule.workers = static_cast<uint32_t>(s.b);
                p.finalBlocks = p.schedule.workers;
            }
        }
        return p;
    }
    if(caseProfile.dual==24) {
        auto& d=p.schedule;
        d.b=s.b;d.m=s.m;d.n=s.n;d.k=s.k;d.dual=24;d.kSplit=1;d.kChunk=s.k;
        d.batchGroup=TinyVectorBatchGroup(s,ub);d.balance=1;
        if(!d.batchGroup)throw std::runtime_error("invalid grouped tiny UB plan");
        d.workers=Ceil(s.b,d.batchGroup);p.finalBlocks=d.workers;
        if(p.finalBlocks>aiv)throw std::runtime_error("insufficient AIV cores for tiny groups");
        return p;
    }
    // This family owns a complete batch and does not use a Matmul session.
    // Construct its validated plan before any micro/GEMV early return.
    if(caseProfile.dual==19 || caseProfile.dual==23) {
        auto& d=p.schedule;
        d.balance=1;d.microRows=s.m;d.batchGroup=s.b==1?8:0;
        d.earlySum=0;d.tree=0;d.dual=caseProfile.dual;d.kSplit=1;d.kChunk=s.k;
        d.b=s.b;d.m=s.m;d.n=s.n;d.k=s.k;
        d.baseM=caseProfile.bm;d.baseN=caseProfile.bn;
        d.mTiles=1;d.nTiles=1;d.nSplit=1;d.window=1;
        d.workers=caseProfile.dual==23?std::min<int64_t>(s.b,std::min<int64_t>(aic,aiv/2)):s.b;
        p.cubeBlocks=d.workers;p.finalBlocks=Ceil(s.b,8);
        p.cube.usedCoreNum=d.workers;
        p.systemBytes=Ceil(platform->GetLibApiWorkSpaceSize(),512)*512;
        if(!p.systemBytes)throw std::runtime_error("Matmul system workspace size is zero");
        const uint64_t parts=uint64_t(s.b)*d.baseM*4;
        p.totalBytes=p.systemBytes+Ceil(parts,512)*512+
            uint64_t(d.workers)*2*d.baseM*d.baseN*4;
        return p;
    }
    const int64_t capacity = 2 * std::min<int64_t>(aic, aiv / 2);
    p.schedule.balance = 1;
    p.schedule.microRows = s.m;
    p.schedule.batchGroup = s.b == 1 ? 8 : 0;
    p.schedule.earlySum = 0;
    p.schedule.tree = 0;
    p.schedule.kSplit = 1;
    p.schedule.kChunk = s.k;
    p.schedule.b = s.b; p.schedule.m = s.m; p.schedule.n = s.n; p.schedule.k = s.k;
    p.schedule.vectorTile = static_cast<uint32_t>(std::min<uint64_t>(1024, (ub - 64) / 28 / 16 * 16));
    p.finalBlocks = static_cast<uint32_t>(Ceil(s.b, 8));
    if (p.finalBlocks > aiv) throw std::runtime_error("insufficient AIV cores for output groups");
    // Notes: docs/kernel_function_notes.md#makeplanimpl-unit-families-l5617
    const bool familyPinned = false;
    // Notes: docs/kernel_function_notes.md#makeplanimpl-gemv-measurements-l5635
    const int64_t unitRow = (s.m == 1) ? s.n : s.m;
    if (!familyPinned && p.schedule.dual == 0 && (s.m == 1 || s.n == 1) &&
        !(s.m == 1 && s.n == 1) && unitRow * s.k >= 4096) {
        // dual==9 walks contiguous rows; dual==11 carries the transposing variant.
        p.schedule.dual = ((s.m == 1 && s.tx2) || (s.n == 1 && !s.tx1)) ? 9 : 11;
    }
    // Notes: docs/kernel_function_notes.md#makeplanimpl-unit-path-history-l5648
    if (s.m == 1 && s.n == 1 && !familyPinned) {
        // dot_short requires its fixed UB/mask limits; tiny direct uses TinyVectorFits.
        // Notes: docs/kernel_function_notes.md#makeplanimpl-unit-validation-l5651
        if(p.schedule.dual==15 && (s.k>64 || s.k%8!=0))
            throw std::invalid_argument("dot_short requires K<=64 and K%8==0");
        if(p.schedule.dual==16 && !TinyVectorFits(s,ub))
            throw std::invalid_argument("tiny direct exceeds fixed UB budget");
        return p;
    }
    if(p.schedule.dual==16) {
        if(!TinyVectorFits(s,ub))
            throw std::invalid_argument("tiny direct exceeds mask/output/UB budget");
        p.schedule.workers=1;p.finalBlocks=1;p.totalBytes=0;return p;
    }
    if(p.schedule.dual==9 || p.schedule.dual==11) {
        if(!((s.m==1 || s.n==1) && (p.schedule.dual==11 || (s.m==1 && s.tx2) || (s.n==1 && !s.tx1))))
            throw std::invalid_argument("vector GEMV requires contiguous matrix rows");
        const uint64_t rp=Ceil(std::max(s.m,s.n),8)*8;
        p.schedule.workers=std::min<int64_t>(capacity,s.b*rp/8);
        p.finalBlocks=p.schedule.workers;p.totalBytes=s.b*rp*4;
        return p;
    }
    const uint64_t smallRows = std::max(s.m, s.n);
    const uint64_t smallStride = Ceil(s.k, 16) * 16;
    if (!familyPinned && (s.m == 1 || s.n == 1) && smallRows <= 64 && s.k <= 256 &&
        10 * smallRows * smallStride + 14 * smallStride + Ceil(smallRows, 8) * 8 * 12 + 64 <= ub) {
        p.small = true;
        return p;
    }
    // Notes: docs/kernel_function_notes.md#makeplanimpl-micro-measurements-l5703
    if (!familyPinned && (s.tx1 || (s.n <= 8 && !s.tx2)) &&
        s.m <= 16 && s.n <= 32 && s.k <= 64) {
        const uint64_t stride = s.k <= 32 ? 32 : 64;
        const uint64_t np = Ceil(s.n, 8) * 8;
        const uint64_t ac = Ceil(s.m * s.k, 16) * 16, bc = Ceil(s.n * s.k, 16) * 16;
        const uint64_t ae = s.m * stride, be = np * stride;
        const uint64_t bytes = 2 * (ac + bc) + 4 * (2 * (ae + be) + std::max(ac, bc) +
            p.schedule.microRows * np * stride + 2 * std::max(ae, be) +
            p.schedule.microRows * np + 2 * Ceil(s.m, 8) * 8) + 320 +
            std::max(1u, p.schedule.batchGroup) * 32;
        if (bytes + 1024 <= ub) {
            p.micro = true;
            p.schedule.workers = std::min<int64_t>(capacity,
                Ceil(s.b, std::max(1u, p.schedule.batchGroup)));
            p.finalBlocks = p.schedule.workers;
            p.totalBytes = p.schedule.batchGroup ? 0 : s.b * 32;
            return p;
        }
    }
    // Notes: docs/kernel_function_notes.md#makeplanimpl-odd-shapes-l5731
    int tuneM = 128, tuneN = 128, tuneWindow = 4, tuneSplit = 0;
    // Notes: docs/kernel_function_notes.md#makeplanimpl-wave-balancing-l5737
    bool splitPinned = false;
    // Notes: docs/kernel_function_notes.md#makeplanimpl-offline-tiling-l5744
    if (s.m >= 64 && s.n >= 128 && (s.m <= 128 || (s.tx2 && s.n > 2048))) {
        tuneM = 64; tuneN = 128;
    }
    // Notes: docs/kernel_function_notes.md#makeplanimpl-short-m-l5760
    if (s.m <= 64 && s.n <= 256 && s.k <= 512) {
        tuneM = Ceil(s.m, 16) * 16;
    }
    if (s.m >= 128 && s.n <= 32 && s.k <= 512) {
        tuneM = 128; tuneN = Ceil(s.n, 16) * 16;
    }
    if (s.m >= 128 && s.n <= 2048 && (!s.tx2 || s.k <= 64)) tuneSplit = 1;
    if (s.m <= 32 && s.n <= 128) tuneSplit = 1;
    tuneWindow = std::max(1, std::min(8, tuneWindow));
    if (s.m <= 32 && s.n <= 32 && s.k >= 2048 && s.b < capacity / 4 &&
        (s.tx1 || !s.tx2)) {
        const int64_t splits = std::min<int64_t>(capacity / s.b, Ceil(s.k, 256));
        p.schedule.kChunk = Ceil(Ceil(s.k, splits), 32) * 32;
        p.schedule.kSplit = Ceil(s.k, p.schedule.kChunk);
        tuneM = Ceil(s.m, 16) * 16; tuneN = Ceil(s.n, 16) * 16;
        tuneWindow = 1;
    }
    // Notes: docs/kernel_function_notes.md#makeplanimpl-deep-k-l5788
    if (p.schedule.kSplit == 1 && s.k >= 4096 && s.m <= 64 && s.n <= 128 && s.n > 16 &&
        s.b * Ceil(s.m, 64) <= 2) {
        tuneM = Ceil(s.m, 16) * 16; tuneN = 32;
        tuneWindow = 1; tuneSplit = 0;
    }
    if (p.schedule.kSplit == 1 && s.k >= 4096 && s.m > 64 && s.m <= 128 && s.n <= 128) {
        tuneM = Ceil(s.m, 16) * 16; tuneN = Ceil(s.n, 16) * 16;
        tuneWindow = 1; tuneSplit = 1;
    }
    int tuneCores = capacity / 2;
    if (p.schedule.kSplit > 16) {
        const int64_t splits=std::min<int64_t>(16,capacity/s.b);
        p.schedule.kChunk=Ceil(Ceil(s.k,splits),32)*32;
        p.schedule.kSplit=Ceil(s.k,p.schedule.kChunk);
    }
    // Offline-selected families. Four layouts share rules unless physical
    // memory strides change the winning window or tile shape.
    if (p.schedule.kSplit == 1) {
        if (s.m >= 64 && s.m < 128 && s.n > 128 && s.n <= 256 && s.k <= 256) {
            tuneM=64;tuneN=128;tuneWindow=1;tuneSplit=1;
        }
        if (s.m >= 128 && s.n >= 128 && s.n <= 256 && s.k >= 128) {
            tuneM=128;tuneN=128;
            if (s.m >= 256 && !s.tx1 && !s.tx2 && s.k >= 256) {
                tuneM=64;tuneN=256;
                if (s.b*Ceil(s.m,64)<=32) tuneCores=8;
            }
        }
        if (s.m >= 128 && s.n <= 32 && s.k <= 512) {
            tuneM=128;tuneN=Ceil(s.n,16)*16;tuneWindow=1;tuneSplit=1;
            if (s.b*Ceil(s.m,128)<=64) tuneCores=8;
        }
        // Notes: docs/kernel_function_notes.md#makeplanimpl-old-tile-l5843
        if (s.m >= 128 && s.n >= 512 && s.n <= 2048) {
            // Tile candidates remain subject to L0C and UB capacity validation.
            // Notes: docs/kernel_function_notes.md#makeplanimpl-l0c-tiling-l5854
            tuneM=128;tuneN=(s.tx2 && s.n % 256 == 0) ? 128 : 256;tuneSplit=1;
            tuneWindow=s.k<=64?(s.tx2?2:1):(s.tx2&&!s.tx1?4:2);
            if (s.k>64) tuneCores=16;
        }
        if (s.m <= 32 && s.n >= 1024 && s.k <= 512) {
            tuneM=Ceil(s.m,16)*16;tuneN=256;
            tuneWindow=s.tx2?1:2;tuneSplit=s.tx2?8:4;
        }
        if (s.m <= 32 && s.n <= 32 && s.k >= 2048 && !s.tx1 && s.tx2) {
            tuneM=16;tuneN=Ceil(s.n,16)*16;tuneWindow=1;tuneSplit=1;
        }
    }
    p.schedule.dual = 1;
    // The full-K manual family requires M, N and K to be multiples of 16.
    // Notes: docs/kernel_function_notes.md#makeplanimpl-manual-measurements-l5878
    const bool manualPinned = false;
    if (p.schedule.kSplit == 1 && !manualPinned &&
        s.m % 16 == 0 && s.n % 16 == 0 && s.k % 16 == 0 &&
        s.m <= 256 && s.n <= 256 && s.k <= 512) {
        p.schedule.dual = 3;
    }
    // Notes: docs/kernel_function_notes.md#makeplanimpl-large-tile-measurements-l5909
    if (p.schedule.kSplit == 1 && s.m >= 128 && s.n >= 512 && s.n <= 2048 &&
        (s.m >= 1024 || s.k >= 2048 || (s.k >= 512 && s.b*Ceil(s.m,128) >= 16))) {
        tuneM=128;tuneN=s.tx2?128:256;
        tuneWindow=s.k<=64?(s.tx2?4:2):(s.tx2?8:4);
        tuneSplit=std::min<int64_t>(Ceil(s.n,tuneN),Ceil(16,s.b*Ceil(s.m,128)));
        tuneCores=capacity/2;
        if (s.k >= 2048) {
            p.schedule.dual=2;
            if (s.b*Ceil(s.m,128)<16) {
                // Notes: docs/kernel_function_notes.md#makeplanimpl-n-tiling-l5920
                const int64_t wideN=Ceil(s.n,256);
                if (wideN>=2 && s.b*Ceil(s.m,128)*wideN>=16) {
                    tuneN=256;tuneWindow=2;tuneSplit=0;
                } else {
                    tuneN=128;tuneWindow=2;
                    tuneSplit=std::min<int64_t>(Ceil(s.n,128),Ceil(16,s.b*Ceil(s.m,128)));
                }
                if (s.tx1 && !s.tx2) p.schedule.dual=1;
            } else {
                tuneN=256;tuneWindow=2;tuneSplit=1;
            }
        } else if (s.k>=1024 && s.tx2 && s.b*s.m*s.k*2>=32LL*1024*1024) {
            p.schedule.dual=2;
        }
    }
    // Notes: docs/kernel_function_notes.md#makeplanimpl-uneven-m-l5944
    if (p.schedule.kSplit == 1 && s.tx1 && !s.tx2 && s.m>=128 && s.m%128 &&
        s.n>=512 && s.n<=2048 && s.k>=2048 && s.b*Ceil(s.m,128)<16) {
        tuneM=64;tuneN=256;tuneWindow=2;tuneSplit=1;tuneCores=16;
        p.schedule.dual=1;
    }
    // Uneven N tails: use the row tile to keep all M tasks in one work wave.
    if (p.schedule.kSplit == 1 && s.m>=1024 && s.n>256 && s.n<512 && s.k>=512) {
        tuneM=128;tuneN=s.tx2?128:256;tuneSplit=1;tuneCores=capacity/2;
        tuneWindow=s.tx1&&s.tx2?4:2;
        p.schedule.dual=s.tx1&&s.tx2?1:2;
    }
    // Apply profile tiling before the validator so scratch sizing follows the same plan.
    // Notes: docs/kernel_function_notes.md#makeplanimpl-case-profile-ordering-l5971
    if (caseProfile.dual != FORCED_NONE) {
        p.schedule.dual = static_cast<uint32_t>(caseProfile.dual);
        if (caseProfile.ks > 0) {
            p.schedule.kChunk = Ceil(Ceil(s.k, caseProfile.ks), 32) * 32;
            p.schedule.kSplit = Ceil(s.k, p.schedule.kChunk);
            if (p.schedule.kSplit > 1) {
                tuneM = Ceil(s.m, 16) * 16;
                tuneN = Ceil(s.n, 16) * 16;
                tuneWindow = 1;
            }
        }
        if (caseProfile.bm > 0) tuneM = caseProfile.bm;
        if (caseProfile.bn > 0) tuneN = caseProfile.bn;
        if (caseProfile.window > 0) tuneWindow = caseProfile.window;
        if (caseProfile.ns > 0) { tuneSplit = caseProfile.ns; splitPinned = true; }
        if (caseProfile.cores > 0) tuneCores=caseProfile.cores;
    }
    if(p.schedule.dual==14) {
        if(p.schedule.kSplit!=1)
            throw std::invalid_argument("manual padded candidate requires complete K");
        tuneWindow=1;
    }
    if(p.schedule.dual==3 || p.schedule.dual==4 || p.schedule.dual==6 || p.schedule.dual==7) {
        if(s.m%16 || s.n%16 || s.k%16 || p.schedule.kSplit!=1)
            throw std::invalid_argument("manual candidate requires aligned full-K tiles");
        tuneWindow=1;
    }
    // Candidate: bound the C window for the FP16 NT logical bucket.
    if (s.b == 1 && s.dtype == 1 && s.tx1 == 0 && s.tx2 == 1 &&
        s.m >= 2048 && s.m < 4096 &&
        s.n >= 1024 && s.n < 2048 &&
        s.k >= 1024 && s.k < 2048 && s.k % 8 == 0 &&
        p.schedule.dual == 1 && p.schedule.kSplit == 1) {
        tuneWindow = 4;
    }
    if(s.b>=16 && s.b<32 && s.m>=32 && s.m<64 &&
        s.n>=128 && s.n<256 && s.k>=256 && s.k<512 && s.k%8==0 &&
        s.dtype==1 && s.tx1 && !s.tx2 && (p.schedule.dual==3 || p.schedule.dual==14))
        p.schedule.earlySum=1;
    // Large TT tiles outside the measured middle use full 128-row blocks.
    // Keep the existing family and N/window policy and reuse capacity checks.
    if (s.b == 1 && s.dtype == 1 && s.tx1 && s.tx2 &&
        s.m >= 1024 && s.m < 2048 && s.n > 2048 && s.n < 4096 &&
        s.k >= 2048 && s.k < 4096 &&
        s.m % 16 == 0 && s.n % 16 == 0 && s.k % 16 == 0 &&
        measured.dual == FORCED_NONE && p.schedule.dual == 1 &&
        p.schedule.kSplit == 1 && tuneM == 64) {
        tuneM = 128;
    }
    p.schedule.window = tuneWindow;
    // Notes: docs/kernel_function_notes.md#makeplanimpl-128-row-measurements-l6028
    const int candidates[][2] = {{tuneM, tuneN}, {128, 256}, {128, 128}, {64, 256}, {64, 128}, {64, 64},
        {64, 32}, {32, 256}, {32, 128}, {32, 64}, {32, 32}, {16, 64}, {16, 32}, {16, 16}};
    bool found = false;
    for (const auto &candidate : candidates) {
        const int bm = candidate[0], bn = candidate[1];
        if(caseProfile.locked && (bm!=tuneM || bn!=tuneN))continue;
        if (p.schedule.kSplit > 1 && (bm != tuneM || bn != tuneN)) continue;
        if (bm <= 0 || bn <= 0 || bm > ((p.schedule.dual==3 || p.schedule.dual==4 || p.schedule.dual==6 || p.schedule.dual==7)?256:128) || bn > 256 || bm % 16 || bn % 16) continue;
        // Final reduction shares this launch and TPipe with Matmul. Reserve
        // its live UB buffers as well; their maximum also covers split-K merge.
        const uint64_t finalBytes = 3ULL * p.schedule.vectorTile * sizeof(float) + 64;
        const uint64_t cBuffers = (p.schedule.dual && p.schedule.kSplit == 1) ? 1ULL : 2ULL;
        const uint64_t vectorBytes = cBuffers * bm * bn * 4 + 18ULL * bm * 4 + 32 + finalBytes;
        if (bm > Ceil(s.m, 16) * 16 || bn > Ceil(s.n, 16) * 16 ||
            vectorBytes >= ub || uint64_t(bm) * bn * 4 > l0c) continue;
        matmul_tiling::MatmulApiTiling api(*platform);
        using Pos = matmul_tiling::TPosition;
        using Fmt = matmul_tiling::CubeFormat;
        using Dt = matmul_tiling::DataType;
        const auto dt = s.dtype == 1 ? Dt::DT_FLOAT16 : Dt::DT_BF16;
        api.SetAType(Pos::GM, Fmt::ND, dt, s.tx1 != 0);
        api.SetBType(Pos::GM, Fmt::ND, dt, s.tx2 != 0);
        if (p.schedule.dual) api.SetCType(Pos::GM, Fmt::ND, Dt::DT_FLOAT);
        else api.SetCType(Pos::VECIN, Fmt::NZ, Dt::DT_FLOAT);
        api.SetBias(false);
        api.SetOrgShape(s.m, s.n, s.k);
        api.SetShape(std::min<int64_t>(bm, s.m), std::min<int64_t>(bn * tuneWindow, s.n), p.schedule.kChunk);
        api.SetBufferSpace(l1, l0c, ub - vectorBytes);
        if (api.SetFixSplit(bm, bn, -1) == -1 || api.GetTiling(p.cube) == -1) continue;
        if (p.cube.baseM != bm || p.cube.baseN != bn || p.cube.baseK == 0) continue;
        p.cube.stepM = 1; p.cube.stepN = 1;
        p.schedule.baseM = bm; p.schedule.baseN = bn;
        found = true;
        break;
    }
    if(!found) {
        if(measured.dual!=FORCED_NONE)return MakePlanImpl(s,availableCoreNum,false);
        throw std::runtime_error("no valid Matmul tiling fits platform buffers/layout");
    }
    auto &d = p.schedule;
    d.mTiles = Ceil(s.m, d.baseM); d.nTiles = Ceil(s.n, d.baseN);
    const int64_t taskCapacity=d.dual?capacity/2:capacity;
    d.nSplit = std::min<int64_t>(d.nTiles, Ceil(taskCapacity, s.b * d.mTiles));
    if (tuneSplit > 0) d.nSplit = std::min<uint32_t>(d.nTiles, tuneSplit);
    // Max distributes over N partitions, never K partial sums; preserve that split axis.
    // Notes: docs/kernel_function_notes.md#makeplanimpl-n-resplit-l6077
    if (p.schedule.balance && d.kSplit == 1 && d.nTiles > 1 && !splitPinned) {
        const int64_t aicNum = static_cast<int64_t>(capacity) / 2;
        const int64_t base = s.b * d.mTiles;
        const int64_t cap = std::min<int64_t>(capacity / 2, tuneCores);
        const int64_t tasks0 = s.b * d.mTiles * d.nSplit;
        const int64_t tasks1 = s.b * d.mTiles * d.nTiles;
        const int64_t workers0 = std::min<int64_t>(cap, d.dual ? tasks0 : Ceil(tasks0, 2));
        const int64_t workers1 = std::min<int64_t>(cap, d.dual ? tasks1 : Ceil(tasks1, 2));
        const bool legacy = d.dual == 2 && base < 16 * aicNum;
        const bool spread = d.dual != 2 && workers1 >= 2 * workers0;
        if (legacy || spread) {
            const int64_t want = std::max<int64_t>(2, 16 * aicNum / base);
            int64_t chosen = std::min<int64_t>(d.nTiles, want);
            // Notes: docs/kernel_function_notes.md#makeplanimpl-split-measurements-l6122
            if (spread && chosen > 2 && base * d.nTiles > cap) {
                for (int64_t ns = chosen; ns >= 2; --ns) {
                    if ((base * ns) % cap == 0) { chosen = ns; break; }
                }
            }
            d.nSplit = static_cast<uint32_t>(chosen);
        }
    }
    d.window = std::min<uint32_t>(d.window, Ceil(d.nTiles, d.nSplit));
    const int64_t tasks = d.kSplit > 1 ? s.b*d.kSplit : s.b*d.mTiles*d.nSplit;
    p.cubeBlocks = std::min<int64_t>(std::min<int64_t>(capacity/2,tuneCores), d.dual?tasks:Ceil(tasks,2));
    d.workers = p.cubeBlocks * (d.dual?1:2);
    p.cube.usedCoreNum = d.workers;
    p.systemBytes = Ceil(platform->GetLibApiWorkSpaceSize(), 512) * 512;
    if (!p.systemBytes) throw std::runtime_error("Matmul system workspace size is zero");
    const uint64_t partialBytes = d.kSplit > 1 ? s.b*d.kSplit*d.baseM*d.baseN*sizeof(float) :
        s.b*d.nSplit*d.mTiles*d.baseM*sizeof(float);
    p.totalBytes = p.systemBytes + Ceil(partialBytes, 512) * 512;
    if ((d.dual && d.kSplit == 1) || d.window > 1) p.totalBytes += static_cast<uint64_t>(d.workers) *
        d.baseM * d.baseN * d.window * sizeof(float) * (d.dual?2:1);
    if(d.dual==3 || d.dual==4 || d.dual==6 || d.dual==7) {
        const uint64_t slots=(d.dual==4 || d.dual==7)?4:2;
        p.totalBytes=p.systemBytes+Ceil(partialBytes,512)*512+uint64_t(d.workers)*d.baseM*d.baseN*4*slots;
    }
    // Full B fits L0B and each worker has at least two M tiles to reuse it.
    if(d.dual==3 && d.kSplit==1 && d.nSplit==1 && d.nTiles==1 &&
       d.baseM==128 && d.mTiles>=2*d.workers && s.dtype==1 && !s.tx1 && !s.tx2 &&
       s.b==1 && s.m>=2048 && s.n<=128 && s.k<=256 && s.m%16==0 && s.n%16==0 && s.k%16==0) {
        uint64_t l0a=0,l0b=0;
        platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_A,l0a);
        platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_B,l0b);
        uint32_t bk=256;
        while(bk>64 && (d.baseM*bk*4>65536 || d.baseN*bk*4>65536))bk/=2;
        const uint64_t bBytes=uint64_t(d.baseN)*s.k*2;
        if(uint64_t(d.baseM)*bk*4<=l0a && bBytes<=l0b &&
           uint64_t(d.baseM)*bk*4+bBytes+1536+4096<=l1) {
            d.tree|=16;d.earlySum=1;
        }
    }
    return p;
}

inline Plan MakePlan(const Shape& s,int64_t availableCoreNum)
{
    Plan p=MakePlanImpl(s,availableCoreNum,true);
    const bool dispatchPinned=false;
    // Case 13: reuse the padded manual kernel's existing complete-N local sum.
    // Keep the validated tile/workspace; each M tile writes two 8-float slots.
    if(!dispatchPinned && p.schedule.dual==14 && p.schedule.kSplit==1 &&
       p.schedule.nSplit==1 && p.schedule.baseM==128) {
        p.schedule.earlySum=1;
    }
    // Every logical C element is overwritten by Cube; no padding needs initialization.
    if(p.schedule.dual==1 && p.schedule.kSplit>1 && s.dtype==1 && s.tx1 && s.tx2 &&
       s.k>=4096 && s.m<=128 && s.n<=128 && s.m%16==0 && s.n%16==0 && s.k%16==0 &&
       p.schedule.baseM==s.m && p.schedule.baseN==s.n && p.schedule.kChunk%16==0) {
        auto* plat=platform_ascendc::PlatformAscendCManager::GetInstance();
        uint64_t ub=0;plat->GetCoreMemSize(platform_ascendc::CoreMemType::UB,ub);
        const auto& d=p.schedule;
        const uint64_t packed=uint64_t(d.kSplit)*d.baseM*d.baseN*4;
        const uint64_t remaining=uint64_t(d.baseM)*(1+Ceil(s.n,64))*4+1024;
        if(packed+remaining<=ub)p.schedule.dual=22;
    }
    // Short-M / wide-N: both dtypes and all layouts share full-K L0A residence.
    if(s.m>=16 && s.m<=128 && s.n>=4096 &&
       s.k<=256 && s.m%16==0 && s.n%16==0 && s.k%16==0 &&
       p.schedule.dual==1 && p.schedule.kSplit==1) {
        auto* plat=platform_ascendc::PlatformAscendCManager::GetInstance();
        uint64_t l1=0,l0a=0,l0b=0,l0c=0,ub=0;
        plat->GetCoreMemSize(platform_ascendc::CoreMemType::L1,l1);
        plat->GetCoreMemSize(platform_ascendc::CoreMemType::L0_A,l0a);
        plat->GetCoreMemSize(platform_ascendc::CoreMemType::L0_B,l0b);
        plat->GetCoreMemSize(platform_ascendc::CoreMemType::L0_C,l0c);
        plat->GetCoreMemSize(platform_ascendc::CoreMemType::UB,ub);
        const uint32_t bm=Ceil(s.m,32)*32,bn=128;
        const uint64_t ab=uint64_t(bm)*s.k*2,bb=uint64_t(bn)*s.k*2,cb=uint64_t(bm)*bn*4;
        // Includes two B L1 queues, placeholder A queues, and the existing finalizer reserve.
        const uint64_t vb=uint64_t(bm)*bn*4+20ULL*bm+32768;
        const int64_t cores=std::min<int64_t>(availableCoreNum,plat->GetCoreNumAic());
        if(ab<=l0a && bb<=l0b && 2*cb<=l0c && ab+2*bb+4096<=l1 && vb+uint64_t(cores)*bm*4<=ub && cores>0) {
            auto& d=p.schedule;
            d.dual=21;d.baseM=bm;d.baseN=bn;d.mTiles=1;d.nTiles=Ceil(s.n,bn);
            d.nSplit=std::min<int64_t>(d.nTiles,cores);d.window=1;d.earlySum=0;d.tree=0;
            // Case 14: use the fewest splits with the same maximum N-tile count.
            // For 64 N tiles on 20 cores this is 16 splits, still at most 4 tiles.
            if(!dispatchPinned && s.b==1 && s.m==64 && s.n==8192 &&
               s.k>=128 && s.k<256) {
                d.nSplit=Ceil(d.nTiles,Ceil(d.nTiles,d.nSplit));
            }
            d.workers=std::min<int64_t>(cores,s.b*d.nSplit);p.cubeBlocks=d.workers;
            const uint64_t parts=s.b*d.nSplit*bm*sizeof(float);
            p.totalBytes=p.systemBytes+Ceil(parts,512)*512+uint64_t(d.workers)*2*bm*bn*sizeof(float);
            return p;
        }
    }
    // Case 12: expose the existing aligned, two-slot L1-resident-A family.
    // Reuse the selected tile, N partition and worker count; retain the old plan
    // if either the actual platform or the kernel's fixed capacity checks fail.
    if(!dispatchPinned && p.schedule.dual==1 && p.schedule.kSplit==1 &&
       s.b==1 && s.dtype==2 && s.tx1 && !s.tx2 &&
       s.m>=1024 && s.m<2048 && s.n>=4096 && s.n<8192 &&
       s.k>=1024 && s.k<2048 && s.m%16==0 && s.n%16==0 && s.k%16==0 &&
       p.schedule.nTiles>=2*p.schedule.nSplit) {
        auto* plat=platform_ascendc::PlatformAscendCManager::GetInstance();
        uint64_t l1=0,l0a=0,l0b=0,l0c=0,ub=0;
        plat->GetCoreMemSize(platform_ascendc::CoreMemType::L1,l1);
        plat->GetCoreMemSize(platform_ascendc::CoreMemType::L0_A,l0a);
        plat->GetCoreMemSize(platform_ascendc::CoreMemType::L0_B,l0b);
        plat->GetCoreMemSize(platform_ascendc::CoreMemType::L0_C,l0c);
        plat->GetCoreMemSize(platform_ascendc::CoreMemType::UB,ub);
        auto& d=p.schedule;
        // Match bmmms_manual's non-RESIDENT_PAD bk and C-buffer selection.
        uint32_t bk=256;
        while(bk>64 && (uint64_t(d.baseM)*bk*4>65536 ||
                       uint64_t(d.baseN)*bk*4>65536))bk/=2;
        const uint64_t aL0=uint64_t(d.baseM)*bk*4,bL0=uint64_t(d.baseN)*bk*4;
        const uint64_t residentBytes=uint64_t(d.baseM)*s.k*2;
        const uint64_t oneC=uint64_t(d.baseM)*d.baseN*4;
        const uint64_t cBytes=oneC*(2*oneC<=131072?2:1);
        const uint64_t vectorBytes=oneC+20ULL*d.baseM+3ULL*d.vectorTile*4+64;
        if(residentBytes+bL0+1024+4096<=std::min<uint64_t>(l1,512ULL*1024) &&
           aL0<=l0a && bL0<=l0b && cBytes<=l0c && vectorBytes+1024<=ub) {
            d.dual=6;d.window=1;
            const uint64_t parts=s.b*d.nSplit*d.mTiles*d.baseM*sizeof(float);
            p.totalBytes=p.systemBytes+Ceil(parts,512)*512+
                uint64_t(d.workers)*2*d.baseM*d.baseN*sizeof(float);
        }
    }
    // Resident-A math supports both input dtypes and both B layouts.
    // Non-transposed A and aligned K are actual storage requirements.
    if (p.schedule.dual == 1 && p.schedule.kSplit == 1 && !s.tx1 &&
        s.b>=1 && s.m>=512 && s.n>=256 && s.k>=512 && s.k%16==0 &&
        p.schedule.baseM<=128 && p.schedule.baseN<=256) {
        auto* platform=platform_ascendc::PlatformAscendCManager::GetInstance();
        uint64_t l1=0,l0a=0,l0b=0,l0c=0,ub=0;
        platform->GetCoreMemSize(platform_ascendc::CoreMemType::L1,l1);
        platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_A,l0a);
        platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_B,l0b);
        platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_C,l0c);
        platform->GetCoreMemSize(platform_ascendc::CoreMemType::UB,ub);
        auto& d=p.schedule;
        uint32_t bk=128;
        while (bk>64 && (uint64_t(d.baseM)*bk*4>l0a || uint64_t(d.baseN)*bk*4>l0b)) bk/=2;
        const uint64_t residentBytes=uint64_t(d.baseM)*s.k*2;
        const uint64_t bBytes=uint64_t(d.baseN)*bk*4;
        const uint64_t oneCBytes=uint64_t(d.baseM)*d.baseN*4;
        const uint64_t cBytes=oneCBytes*(2*oneCBytes<=l0c?2:1);
        const uint64_t vectorBytes=oneCBytes+20ULL*d.baseM+3ULL*d.vectorTile*4+1024;
        if (vectorBytes<=ub && residentBytes+bBytes+1024+4096<=l1 &&
            uint64_t(d.baseM)*bk*4<=l0a && uint64_t(d.baseN)*bk*4<=l0b &&
            cBytes<=l0c) {
            d.dual=20;d.window=1;d.kChunk=bk;
            if(cBytes==oneCBytes)d.tree|=8;
            const uint64_t partialBytes=s.b*d.nSplit*d.mTiles*d.baseM*sizeof(float);
            p.totalBytes=p.systemBytes+Ceil(partialBytes,512)*512+
                uint64_t(d.workers)*d.baseM*d.baseN*2*sizeof(float);
        }
    }
    // Case12 packed-B workspace. Schedule itself is unchanged from c10; the device
    // derives the packed offset from the existing partial/ring geometry.
    if(p.schedule.dual==6 && !s.tx2) {
        auto& d=p.schedule;
        const uint64_t packedOffset=Ceil(p.totalBytes-p.systemBytes,512)*512;
        p.totalBytes=p.systemBytes+packedOffset+uint64_t(s.b)*d.nTiles*s.k*d.baseN*2;
    }
    return p;
}

// Choose package lengths from the selected plan; never mutate its tiling.
struct WindowKPackagePlan {bool safe=false,resident=false;uint32_t aK=0,bK=0;};
inline WindowKPackagePlan MakeWindowKPackagePlan(const Shape& s,const Plan& p)
{
    WindowKPackagePlan q;
    auto* plat=platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t l1=0,l0a=0,l0b=0,l0c=0,ub=0;
    plat->GetCoreMemSize(platform_ascendc::CoreMemType::L1,l1);
    plat->GetCoreMemSize(platform_ascendc::CoreMemType::L0_A,l0a);
    plat->GetCoreMemSize(platform_ascendc::CoreMemType::L0_B,l0b);
    plat->GetCoreMemSize(platform_ascendc::CoreMemType::L0_C,l0c);
    plat->GetCoreMemSize(platform_ascendc::CoreMemType::UB,ub);
    const auto& d=p.schedule;const auto& t=p.cube;
    if(!d.baseM || !d.baseN || d.baseM>128 || d.baseN>256 || d.window<1 || d.workers!=p.cubeBlocks ||
       !d.nSplit || d.nSplit>d.nTiles || d.kSplit!=1 ||
       d.mTiles!=Ceil(s.m,d.baseM) || d.nTiles!=Ceil(s.n,d.baseN))return q;
    uint32_t bk=256;
    while(bk>64 && (uint64_t(d.baseM)*bk*4>65536 || uint64_t(d.baseN)*bk*4>65536))bk/=2;
    const uint64_t aL0=uint64_t(d.baseM)*bk*4,bL0=uint64_t(d.baseN)*bk*4;
    const uint64_t oneC=uint64_t(d.baseM)*d.baseN*4;
    const uint64_t cBytes=oneC*(2*oneC<=131072?2:1);
    const uint64_t vectorBytes=oneC+20ULL*d.baseM+3ULL*d.vectorTile*4+64;
    const uint64_t partBytes=Ceil(s.b*d.nSplit*d.mTiles*d.baseM*4,512)*512;
    const uint64_t ringBytes=uint64_t(d.workers)*2*d.baseM*d.baseN*d.window*4;
    if(aL0>l0a || bL0>l0b || cBytes>l0c || vectorBytes+1024>ub ||
       p.totalBytes<p.systemBytes+partBytes+ringBytes)return q;
    const uint32_t maxPackage=Ceil(s.k,bk)*bk;
    const int64_t nativeA=int64_t(t.baseK)*std::max<int64_t>(1,t.stepKa);
    const int64_t nativeB=int64_t(t.baseK)*std::max<int64_t>(1,t.stepKb);
    const uint32_t desiredA=std::min<uint32_t>(maxPackage,std::max<int64_t>(2*bk,Ceil(nativeA,bk)*bk));
    const uint32_t desiredB=std::min<uint32_t>(maxPackage,std::max<int64_t>(2*bk,Ceil(nativeB,bk)*bk));
    const uint64_t limit=std::min<uint64_t>(l1,512ULL*1024);
    const uint64_t fullA=uint64_t(d.baseM)*Ceil(s.k,16)*16*2;
    uint32_t bp=desiredB;
    while(bp>bk && fullA+uint64_t(d.baseN)*bp*4>limit)bp-=bk;
    if(fullA+uint64_t(d.baseN)*bp*4<=limit) {
        q.safe=true;q.resident=true;q.aK=desiredA;q.bK=bp;
        const uint32_t capacityB=std::min<uint64_t>(maxPackage,
            (limit-fullA)/(uint64_t(d.baseN)*bk*4)*bk);
        if(Ceil(s.k,capacityB)<Ceil(s.k,q.bK))q.bK=capacityB;
        return q;
    }
    uint32_t ap=desiredA;bp=desiredB;
    while(uint64_t(d.baseM)*ap*4+uint64_t(d.baseN)*bp*4+512+4096>limit) {
        if(ap>bk && (bp==bk || uint64_t(d.baseM)*ap>=uint64_t(d.baseN)*bp))ap-=bk;
        else if(bp>bk)bp-=bk;
        else return q;
    }
    q.safe=true;q.aK=ap;q.bK=bp;
    const int64_t oldCopies=Ceil(s.k,ap)+Ceil(s.k,bp);
    int64_t bestCopies=oldCopies;
    uint32_t bestA=ap,bestB=bp;
    uint64_t bestBytes=uint64_t(d.baseM)*ap*4+uint64_t(d.baseN)*bp*4+512+4096;
    const uint32_t maxA=std::min<uint64_t>(maxPackage,
        (limit-512-4096)/(uint64_t(d.baseM)*bk*4)*bk);
    // Keep the original legal plan unless fewer double-buffered DMA packages fit.
    for(uint32_t a=bk;a<=maxA;a+=bk) {
        const uint64_t aBytes=uint64_t(d.baseM)*a*4;
        const uint32_t maxB=std::min<uint64_t>(maxPackage,
            (limit-512-4096-aBytes)/(uint64_t(d.baseN)*bk*4)*bk);
        if(maxB<bk)continue;
        const int64_t bCopies=Ceil(s.k,maxB);
        const uint32_t b=Ceil(Ceil(s.k,bCopies),bk)*bk;
        const int64_t copies=Ceil(s.k,a)+bCopies;
        const uint64_t bytes=aBytes+uint64_t(d.baseN)*b*4+512+4096;
        if(copies<bestCopies || (copies==bestCopies && copies<oldCopies && bytes<bestBytes)) {
            bestCopies=copies;bestBytes=bytes;bestA=a;bestB=b;
        }
    }
    if(bestCopies<oldCopies) {q.aK=bestA;q.bK=bestB;}
    return q;
}

template<typename T,bool TX1,bool TX2,bool C8>
inline void LaunchWindowKPackages(GM_ADDR x1,GM_ADDR x2,GM_ADDR partial,GM_ADDR y,
    const Shape& s,const Plan& p,const WindowKPackagePlan& q,aclrtStream stream)
{
    const bool pad=s.m%16 || s.n%16 || s.k%16;
        if(q.resident) {
            if(pad)bmmms_generic_packages<T,TX1,TX2,true,true><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule,q.aK,q.bK);
            else bmmms_generic_packages<T,TX1,TX2,false,true><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule,q.aK,q.bK);
        } else {
            if(pad)bmmms_generic_packages<T,TX1,TX2,true,false><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule,q.aK,q.bK);
            else bmmms_generic_packages<T,TX1,TX2,false,false><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule,q.aK,q.bK);
        }
}

struct Case9PackagePlan {bool safe=false,resident=false;uint32_t aK=0,bK=0;};
inline Case9PackagePlan MakeCase9PackagePlan(const Shape& s,const Plan& p)
{
    Case9PackagePlan q;
    auto* plat=platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t l1=0,l0a=0,l0b=0,l0c=0,ub=0;
    plat->GetCoreMemSize(platform_ascendc::CoreMemType::L1,l1);
    plat->GetCoreMemSize(platform_ascendc::CoreMemType::L0_A,l0a);
    plat->GetCoreMemSize(platform_ascendc::CoreMemType::L0_B,l0b);
    plat->GetCoreMemSize(platform_ascendc::CoreMemType::L0_C,l0c);
    plat->GetCoreMemSize(platform_ascendc::CoreMemType::UB,ub);
    const auto& d=p.schedule;const auto& t=p.cube;
    if(!d.baseM || !d.baseN || d.baseM>128 || d.baseN>256 || d.window<1 || d.workers!=p.cubeBlocks ||
       !d.nSplit || d.nSplit>d.nTiles || d.kSplit!=1 ||
       d.mTiles!=Ceil(s.m,d.baseM) || d.nTiles!=Ceil(s.n,d.baseN))return q;
    const uint32_t bk=d.kChunk;
    if(!bk || bk%16)return q;
    const uint64_t aL0=uint64_t(d.baseM)*bk*4,bL0=uint64_t(d.baseN)*bk*4;
    const uint64_t oneC=uint64_t(d.baseM)*d.baseN*4;
    const uint64_t cBytes=oneC*(2*oneC<=131072?2:1);
    const uint64_t vectorBytes=oneC+20ULL*d.baseM+3ULL*d.vectorTile*4+64;
    const uint64_t partBytes=Ceil(s.b*d.nSplit*d.mTiles*d.baseM*4,512)*512;
    const uint64_t ringBytes=uint64_t(d.workers)*2*d.baseM*d.baseN*d.window*4;
    if(aL0>l0a || bL0>l0b || cBytes>l0c || vectorBytes+1024>ub ||
       p.totalBytes<p.systemBytes+partBytes+ringBytes)return q;
    const uint32_t maxPackage=Ceil(s.k,bk)*bk;
    const int64_t nativeA=int64_t(t.baseK)*std::max<int64_t>(1,t.stepKa);
    const int64_t nativeB=int64_t(t.baseK)*std::max<int64_t>(1,t.stepKb);
    const uint32_t desiredA=std::min<uint32_t>(maxPackage,std::max<int64_t>(2*bk,Ceil(nativeA,bk)*bk));
    const uint32_t desiredB=std::min<uint32_t>(maxPackage,std::max<int64_t>(2*bk,Ceil(nativeB,bk)*bk));
    const uint64_t limit=std::min<uint64_t>(l1,512ULL*1024);
    const uint64_t fullA=uint64_t(d.baseM)*Ceil(s.k,16)*16*2;
    uint32_t bp=desiredB;
    while(bp>bk && fullA+uint64_t(d.baseN)*bp*4>limit)bp-=bk;
    if(fullA+uint64_t(d.baseN)*bp*4<=limit) {
        q.safe=true;q.resident=true;q.aK=desiredA;q.bK=bp;return q;
    }
    uint32_t ap=desiredA;bp=desiredB;
    while(uint64_t(d.baseM)*ap*4+uint64_t(d.baseN)*bp*4+512+4096>limit) {
        if(ap>bk && (bp==bk || uint64_t(d.baseM)*ap>=uint64_t(d.baseN)*bp))ap-=bk;
        else if(bp>bk)bp-=bk;
        else return q;
    }
    q.safe=true;q.aK=ap;q.bK=bp;return q;
}

using CacheKey = std::pair<uintptr_t, uintptr_t>;
using ShapeKey = std::tuple<int64_t, int64_t, int64_t, int64_t, int32_t, int32_t, int32_t, int64_t>;
struct CacheEntry {
    void *memory = nullptr;
    uint64_t capacity = 0;
    bool hasPlan = false;
    ShapeKey shape;
    Plan plan;
};
// No ACL calls from static destructors: the runtime may have finalized already.
inline std::map<CacheKey, CacheEntry> &Cache() { static std::map<CacheKey, CacheEntry> c; return c; }
inline std::mutex &CacheMutex() { static std::mutex m; return m; }
inline CacheKey CurrentKey(aclrtStream stream)
{
    aclrtContext context = nullptr;
    CheckAcl(aclrtGetCurrentContext(&context), "aclrtGetCurrentContext");
    if (!context) throw std::runtime_error("no active ACL context");
    return {reinterpret_cast<uintptr_t>(context), reinterpret_cast<uintptr_t>(stream)};
}
// Use only the already selected long-K split plan and its complete padded tile.
inline uint32_t ManualSplitKBlockSize(const Shape& s,const Plan& p)
{
    const auto& d=p.schedule;
    if(s.k<4096 || !d.dual || d.kSplit<=1 || !d.workers || d.workers!=p.cubeBlocks ||
       d.mTiles!=1 || d.nTiles!=1 || d.nSplit!=1 ||
       d.baseM!=Ceil(s.m,16)*16 || d.baseN!=Ceil(s.n,16)*16 ||
       d.baseM>128 || d.baseN>256 || !d.kChunk || d.kChunk%16 ||
       d.kSplit!=Ceil(s.k,d.kChunk))return 0;
    const uint64_t partBytes=uint64_t(s.b)*d.kSplit*d.baseM*d.baseN*4;
    if(p.totalBytes<p.systemBytes+partBytes)return 0;
    auto* plat=platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t l1=0,l0a=0,l0b=0,l0c=0;
    plat->GetCoreMemSize(platform_ascendc::CoreMemType::L1,l1);
    plat->GetCoreMemSize(platform_ascendc::CoreMemType::L0_A,l0a);
    plat->GetCoreMemSize(platform_ascendc::CoreMemType::L0_B,l0b);
    plat->GetCoreMemSize(platform_ascendc::CoreMemType::L0_C,l0c);
    if(uint64_t(d.baseM)*d.baseN*4>l0c)return 0;
    for(uint32_t bk=256;bk>=16;bk/=2) {
        if(uint64_t(d.baseM+d.baseN)*bk*4+4096<=l1 &&
           uint64_t(d.baseM)*bk*4<=l0a && uint64_t(d.baseN)*bk*4<=l0b &&
           uint64_t(d.baseN)*bk/256<=255)return bk;
    }
    return 0;
}

inline uint32_t SmallVectorK256Rows(const Shape& s)
{
    if(s.b<1 || s.m<2 || s.m>16 || s.n<2 || s.n>32 || s.k<65 || s.k>256)return 0;
    // Prefer the existing Cube dispatch when M and N can fill a 16x16 tile.
    if(s.m>=16 && s.n>=16)return 0;
    auto* plat=platform_ascendc::PlatformAscendCManager::GetInstance();
    if(s.b>plat->GetCoreNumAiv())return 0;
    uint64_t ub=0;plat->GetCoreMemSize(platform_ascendc::CoreMemType::UB,ub);
    const uint64_t kp=Ceil(s.k,16)*16,np=Ceil(s.n,8)*8;
    const uint64_t ac=Ceil(s.m*s.k,16)*16,bc=Ceil(s.n*s.k,16)*16;
    const uint64_t fixed=6*(s.m+s.n)*kp+(s.tx1?ac*4:32)+(!s.tx2?bc*4:32)+3*256*4+64;
    const uint64_t perRow=np*kp*4+np*8;
    uint32_t rows=s.m;
    while(rows && fixed+rows*perRow+Ceil(rows,8)*32+1024>ub)--rows;
    return rows;
}

template<typename T,bool TX1,bool TX2,uint32_t KCONST,bool GROUPED>
inline void LaunchTinyK(GM_ADDR x1,GM_ADDR x2,GM_ADDR y,TinyKernelShape s,
    uint32_t group,uint32_t blocks,aclrtStream stream)
{
    if constexpr(GROUPED)bmmms_tiny_grouped<T,TX1,TX2,KCONST><<<blocks,nullptr,stream>>>(x1,x2,y,s,group);
    else bmmms_tiny_direct<T,TX1,TX2,KCONST><<<blocks,nullptr,stream>>>(x1,x2,y,s);
}

template<typename T,bool TX1,bool TX2,bool GROUPED>
inline void LaunchTinyGeometry(GM_ADDR x1,GM_ADDR x2,GM_ADDR y,TinyKernelShape s,
    uint32_t group,uint32_t blocks,aclrtStream stream)
{
    switch(s.k) {
    case 32:LaunchTinyK<T,TX1,TX2,32,GROUPED>(x1,x2,y,s,group,blocks,stream);return;
    case 40:LaunchTinyK<T,TX1,TX2,40,GROUPED>(x1,x2,y,s,group,blocks,stream);return;
    case 48:LaunchTinyK<T,TX1,TX2,48,GROUPED>(x1,x2,y,s,group,blocks,stream);return;
    case 56:LaunchTinyK<T,TX1,TX2,56,GROUPED>(x1,x2,y,s,group,blocks,stream);return;
    case 64:LaunchTinyK<T,TX1,TX2,64,GROUPED>(x1,x2,y,s,group,blocks,stream);return;
    default:LaunchTinyK<T,TX1,TX2,0,GROUPED>(x1,x2,y,s,group,blocks,stream);return;
    }
}

template <typename T>
inline void Launch(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, const Shape &s, const Plan &p,
                   void *memory, aclrtStream stream)
{
    const uint32_t vectorRows=SmallVectorK256Rows(s);
    if(vectorRows) {
        SmallVectorManualShape v{static_cast<uint32_t>(s.m),static_cast<uint32_t>(s.n),static_cast<uint32_t>(s.k),vectorRows};
        const uint32_t blocks=s.b;
        if(s.tx1 && s.tx2)bmmms_small_vector_k256<T,true,true><<<blocks,nullptr,stream>>>(x1,x2,y,v);
        else if(s.tx1)bmmms_small_vector_k256<T,true,false><<<blocks,nullptr,stream>>>(x1,x2,y,v);
        else if(s.tx2)bmmms_small_vector_k256<T,false,true><<<blocks,nullptr,stream>>>(x1,x2,y,v);
        else bmmms_small_vector_k256<T,false,false><<<blocks,nullptr,stream>>>(x1,x2,y,v);
        return;
    }
    if(p.schedule.dual==16) {
        if(s.tx1 && s.tx2)LaunchTinyGeometry<T,true,true,false>(x1,x2,y,TinyKernelShape{static_cast<uint32_t>(s.b),static_cast<uint32_t>(s.m),static_cast<uint32_t>(s.n),static_cast<uint32_t>(s.k)},0,1,stream);
        else if(s.tx1)LaunchTinyGeometry<T,true,false,false>(x1,x2,y,TinyKernelShape{static_cast<uint32_t>(s.b),static_cast<uint32_t>(s.m),static_cast<uint32_t>(s.n),static_cast<uint32_t>(s.k)},0,1,stream);
        else if(s.tx2)LaunchTinyGeometry<T,false,true,false>(x1,x2,y,TinyKernelShape{static_cast<uint32_t>(s.b),static_cast<uint32_t>(s.m),static_cast<uint32_t>(s.n),static_cast<uint32_t>(s.k)},0,1,stream);
        else LaunchTinyGeometry<T,false,false,false>(x1,x2,y,TinyKernelShape{static_cast<uint32_t>(s.b),static_cast<uint32_t>(s.m),static_cast<uint32_t>(s.n),static_cast<uint32_t>(s.k)},0,1,stream);
        return;
    }
    if(p.schedule.dual==24) {
        if(s.tx1 && s.tx2)LaunchTinyGeometry<T,true,true,true>(x1,x2,y,TinyKernelShape{static_cast<uint32_t>(s.b),static_cast<uint32_t>(s.m),static_cast<uint32_t>(s.n),static_cast<uint32_t>(s.k)},p.schedule.batchGroup,p.finalBlocks,stream);
        else if(s.tx1)LaunchTinyGeometry<T,true,false,true>(x1,x2,y,TinyKernelShape{static_cast<uint32_t>(s.b),static_cast<uint32_t>(s.m),static_cast<uint32_t>(s.n),static_cast<uint32_t>(s.k)},p.schedule.batchGroup,p.finalBlocks,stream);
        else if(s.tx2)LaunchTinyGeometry<T,false,true,true>(x1,x2,y,TinyKernelShape{static_cast<uint32_t>(s.b),static_cast<uint32_t>(s.m),static_cast<uint32_t>(s.n),static_cast<uint32_t>(s.k)},p.schedule.batchGroup,p.finalBlocks,stream);
        else LaunchTinyGeometry<T,false,false,true>(x1,x2,y,TinyKernelShape{static_cast<uint32_t>(s.b),static_cast<uint32_t>(s.m),static_cast<uint32_t>(s.n),static_cast<uint32_t>(s.k)},p.schedule.batchGroup,p.finalBlocks,stream);
        return;
    }
    if (s.m == 1 && s.n == 1) {
        if(p.schedule.dual==15) {
            const bool aligned=s.k%16==0 &&
                ((reinterpret_cast<uintptr_t>(x1)|reinterpret_cast<uintptr_t>(x2))&31)==0;
            if(aligned)bmmms_dot_short<T,true><<<p.finalBlocks,nullptr,stream>>>(x1,x2,y,static_cast<uint32_t>(s.b),static_cast<uint32_t>(s.k));
            else bmmms_dot_short<T><<<p.finalBlocks,nullptr,stream>>>(x1,x2,y,static_cast<uint32_t>(s.b),static_cast<uint32_t>(s.k));
            return;
        }
        bmmms_dot<T><<<p.finalBlocks, nullptr, stream>>>(x1, x2, y, p.schedule);
        return;
    }
    if(p.schedule.dual==9 || p.schedule.dual==11) {
        if(s.m==1) {
            if(s.tx2)bmmms_gemv_vector<T,true><<<p.finalBlocks,nullptr,stream>>>(x2,x1,(GM_ADDR)memory,y,p.schedule);
            else bmmms_gemv_vector<T,true,true><<<p.finalBlocks,nullptr,stream>>>(x2,x1,(GM_ADDR)memory,y,p.schedule);
        } else {
            if(s.tx1)bmmms_gemv_vector<T,false,true><<<p.finalBlocks,nullptr,stream>>>(x1,x2,(GM_ADDR)memory,y,p.schedule);
            else bmmms_gemv_vector<T,false><<<p.finalBlocks,nullptr,stream>>>(x1,x2,(GM_ADDR)memory,y,p.schedule);
        }
        return;
    }
    if (p.small) {
        if (s.m == 1) {
            if (s.tx2) bmmms_small<T, false, true><<<p.finalBlocks, nullptr, stream>>>(x2, x1, y, p.schedule);
            else bmmms_small<T, true, true><<<p.finalBlocks, nullptr, stream>>>(x2, x1, y, p.schedule);
        } else {
            if (s.tx1) bmmms_small<T, true, false><<<p.finalBlocks, nullptr, stream>>>(x1, x2, y, p.schedule);
            else bmmms_small<T, false, false><<<p.finalBlocks, nullptr, stream>>>(x1, x2, y, p.schedule);
        }
        return;
    }
    // ASC's GM_ADDR carries an address-space qualifier. At the host launch
    // boundary use the same explicit cast as main.asc; reinterpret_cast is rejected.
    GM_ADDR workspace = (GM_ADDR)memory;
    if (p.micro && p.schedule.batchGroup == 0 && p.schedule.microRows == s.m) {
        if(s.tx1 && s.tx2) bmmms_small_gemm<T,true,true><<<p.finalBlocks,nullptr,stream>>>(x1,x2,y,workspace,p.schedule);
        else if(s.tx1) bmmms_small_gemm<T,true,false><<<p.finalBlocks,nullptr,stream>>>(x1,x2,y,workspace,p.schedule);
        else if(s.tx2 && (s.k == 32 || s.k == 64))
            bmmms_small_gemm_contiguous<T,false,true><<<p.finalBlocks,nullptr,stream>>>(x1,x2,y,workspace,p.schedule);
        else if(s.tx2) bmmms_small_gemm<T,false,true><<<p.finalBlocks,nullptr,stream>>>(x1,x2,y,workspace,p.schedule);
        else if(s.k == 32 || s.k == 64)
            bmmms_small_gemm_contiguous<T,false,false><<<p.finalBlocks,nullptr,stream>>>(x1,x2,y,workspace,p.schedule);
        else bmmms_small_gemm<T,false,false><<<p.finalBlocks,nullptr,stream>>>(x1,x2,y,workspace,p.schedule);
        return;
    }
    if (p.micro) {
        if (s.tx1 && s.tx2)
            bmmms_small_gemm_grouped<T, true, true><<<p.finalBlocks, nullptr, stream>>>(x1, x2, y, workspace, p.schedule);
        else if (s.tx1)
            bmmms_small_gemm_grouped<T, true, false><<<p.finalBlocks, nullptr, stream>>>(x1, x2, y, workspace, p.schedule);
        else if (s.tx2)
            bmmms_small_gemm_grouped<T, false, true><<<p.finalBlocks, nullptr, stream>>>(x1, x2, y, workspace, p.schedule);
        else
            bmmms_small_gemm_grouped<T, false, false><<<p.finalBlocks, nullptr, stream>>>(x1, x2, y, workspace, p.schedule);
        return;
    }
    GM_ADDR partial = workspace + p.systemBytes;
    if(p.schedule.dual && p.schedule.kSplit>1) {
        const uint32_t bk=ManualSplitKBlockSize(s,p);
        if(bk) {
            if(p.schedule.dual==22)bmmms_manual_splitk<T,true,true,true><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule,bk);
            else if(s.tx1 && s.tx2)bmmms_manual_splitk<T,true,true><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule,bk);
            else if(s.tx1)bmmms_manual_splitk<T,true,false><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule,bk);
            else if(s.tx2)bmmms_manual_splitk<T,false,true><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule,bk);
            else bmmms_manual_splitk<T,false,false><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule,bk);
            return;
        }
    }
    if(p.schedule.dual==22) {
        bmmms_dual_split<T,true,true,true><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,workspace,p.cube,p.schedule);
        return;
    }
    if (p.schedule.dual && p.schedule.kSplit>1) {
        if(s.tx1 && s.tx2) bmmms_dual_split<T,true,true><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,workspace,p.cube,p.schedule);
        else if(s.tx1) bmmms_dual_split<T,true,false><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,workspace,p.cube,p.schedule);
        else if(s.tx2) bmmms_dual_split<T,false,true><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,workspace,p.cube,p.schedule);
        else bmmms_dual_split<T,false,false><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,workspace,p.cube,p.schedule);
        return;
    }
    if(p.schedule.dual==23) {
        if(s.tx1 && s.tx2)bmmms_single_tile_loop<T,true,true><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule);
        else if(s.tx1)bmmms_single_tile_loop<T,true,false><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule);
        else if(s.tx2)bmmms_single_tile_loop<T,false,true><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule);
        else bmmms_single_tile_loop<T,false,false><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule);
        return;
    }
    // Case 4: specialize only an exact match of the already validated M/N tile.
    // The same kernel still uses actual M/N/K for every tail load and reduction.
    if(p.schedule.dual==19 && s.tx1 && s.tx2 && p.schedule.baseM==16) {
        if(p.schedule.baseN==16) {
            bmmms_single_tile<T,true,true,16,16,0><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule);
            return;
        }
        if(p.schedule.baseN==32) {
            bmmms_single_tile<T,true,true,16,32,0><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule);
            return;
        }
    }
    // Constant M/N for the existing small5 resource-validated plan; K stays dynamic.
    if(p.schedule.dual==19 && !s.tx1 && !s.tx2) {
        if(p.schedule.baseM==16 && p.schedule.baseN==32) {
            bmmms_single_tile<T,false,false,16,32,0><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule);
            return;
        }
        if(p.schedule.baseM==16 && p.schedule.baseN==48) {
            bmmms_single_tile<T,false,false,16,48,0><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule);
            return;
        }
        if(p.schedule.baseM==16 && p.schedule.baseN==64) {
            bmmms_single_tile<T,false,false,16,64,0><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule);
            return;
        }
        if(p.schedule.baseM==32 && p.schedule.baseN==32) {
            bmmms_single_tile<T,false,false,32,32,0><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule);
            return;
        }
        if(p.schedule.baseM==32 && p.schedule.baseN==48) {
            bmmms_single_tile<T,false,false,32,48,0><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule);
            return;
        }
        if(p.schedule.baseM==32 && p.schedule.baseN==64) {
            bmmms_single_tile<T,false,false,32,64,0><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule);
            return;
        }
    }
    // Compile-time geometry for measured BF16 NT small-batch tiles.
    // All actual dimensions still control tail loads and reductions.
    if(p.schedule.dual==19 && !s.tx1 && s.tx2 && p.schedule.baseM==32) {
        const uint32_t paddedK=Ceil(s.k,16)*16;
        if(p.schedule.baseN==96 && paddedK==192) {
            bmmms_single_tile_direct_batch<T,false,true,32,96,192,true><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule);
            return;
        }
        if(p.schedule.baseN==128 && paddedK==256) {
            bmmms_single_tile_direct_batch<T,false,true,32,128,256,true><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule);
            return;
        }
        if(p.schedule.baseN==112 && paddedK==224) {
            bmmms_single_tile_direct_batch<T,false,true,32,112,224,true><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule);
            return;
        }
        if(p.schedule.baseN==128 && paddedK==240) {
            bmmms_single_tile_direct_batch<T,false,true,32,128,240,true><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule);
            return;
        }
        if(p.schedule.baseN==112 && paddedK==208) {
            bmmms_single_tile_direct_batch<T,false,true,32,112,208,true><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule);
            return;
        }
    }
    // Cover every resource-validated BF16 NT small-batch M/N tile.
    // The five fully constant geometries above retain priority. Elsewhere K
    // remains dynamic (KP=0); actual M/N/K still govern all tail operations.
    // Match the existing plan exactly: never enlarge a tile or its workspace.
    if(p.schedule.dual==19 && !s.tx1 && s.tx2) {
        if(p.schedule.baseM==16 && p.schedule.baseN==64) {
            bmmms_single_tile_direct_batch<T,false,true,16,64,0,true><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule);
            return;
        }
        if(p.schedule.baseM==16 && p.schedule.baseN==80) {
            bmmms_single_tile_direct_batch<T,false,true,16,80,0,true><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule);
            return;
        }
        if(p.schedule.baseM==16 && p.schedule.baseN==96) {
            bmmms_single_tile_direct_batch<T,false,true,16,96,0,true><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule);
            return;
        }
        if(p.schedule.baseM==16 && p.schedule.baseN==112) {
            bmmms_single_tile_direct_batch<T,false,true,16,112,0,true><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule);
            return;
        }
        if(p.schedule.baseM==16 && p.schedule.baseN==128) {
            bmmms_single_tile_direct_batch<T,false,true,16,128,0,true><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule);
            return;
        }
        if(p.schedule.baseM==32 && p.schedule.baseN==64) {
            bmmms_single_tile_direct_batch<T,false,true,32,64,0,true><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule);
            return;
        }
        if(p.schedule.baseM==32 && p.schedule.baseN==80) {
            bmmms_single_tile_direct_batch<T,false,true,32,80,0,true><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule);
            return;
        }
        if(p.schedule.baseM==32 && p.schedule.baseN==96) {
            bmmms_single_tile_direct_batch<T,false,true,32,96,0,true><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule);
            return;
        }
        if(p.schedule.baseM==32 && p.schedule.baseN==112) {
            bmmms_single_tile_direct_batch<T,false,true,32,112,0,true><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule);
            return;
        }
        if(p.schedule.baseM==32 && p.schedule.baseN==128) {
            bmmms_single_tile_direct_batch<T,false,true,32,128,0,true><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule);
            return;
        }
        // The same NT operand pipeline supports every validated full tile.
        bmmms_single_tile_direct_batch<T,false,true,0,0,0,true><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule);
        return;
    }
    if(p.schedule.dual==19) {
        if(s.tx1 && s.tx2)bmmms_single_tile<T,true,true><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule);
        else if(s.tx1)bmmms_single_tile<T,true,false><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule);
        else if(s.tx2)bmmms_single_tile<T,false,true><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule);
        else bmmms_single_tile<T,false,false><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule);
        return;
    }
    // Dedicated NT case9 computation precedes neighboring generic routes.
    if(p.schedule.dual==20 && s.dtype==1 && !s.tx1 && s.tx2) {
        // Keep the existing NT resident-A plan and exact original BK.
        const auto package=MakeCase9PackagePlan(s,p);
        if(package.safe && package.resident && package.bK>p.schedule.kChunk) {
            const bool pad=s.m%16 || s.n%16 || s.k%16;
            if(pad)bmmms_case9_packages<T,true><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule,package.aK,package.bK);
            else bmmms_case9_packages<T,false><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule,package.aK,package.bK);
            return;
        }
    }
    if(p.schedule.dual==21) {
        if(s.tx1 && s.tx2)bmmms_manual<T,true,true,false,false,true><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule);
        else if(s.tx1)bmmms_manual<T,true,false,false,false,true><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule);
        else if(s.tx2)bmmms_manual<T,false,true,false,false,true><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule);
        else bmmms_manual<T,false,false,false,false,true><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule);
        return;
    }
    if(p.schedule.dual==20) {
        if(s.tx2) bmmms_manual<T,false,true,true,true><<<p.cubeBlocks,nullptr,stream>>>(
            x1,x2,partial,y,p.schedule);
        else bmmms_manual<T,false,false,true,true><<<p.cubeBlocks,nullptr,stream>>>(
            x1,x2,partial,y,p.schedule);
        return;
    }
    // Notes: docs/kernel_function_notes.md#launch-tn-direct-l6781
    if(s.tx1 && !s.tx2 &&
       (p.schedule.dual==3 || p.schedule.dual==14) && p.schedule.kSplit==1 &&
       p.schedule.mTiles==1 && p.schedule.nTiles==1 && p.schedule.nSplit==1 &&
       p.schedule.baseM<=64 && p.schedule.baseN<=256) {
        if(p.schedule.dual==14)bmmms_manual_case7_direct<T,true><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule);
        else bmmms_manual_case7_direct<T,false><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule);
        return;
    }
    if(p.schedule.dual==14) {
        if(s.tx1 && s.tx2)bmmms_manual<T,true,true,true><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule);
        else if(s.tx1)bmmms_manual<T,true,false,true><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule);
        else if(s.tx2)bmmms_manual<T,false,true,true><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule);
        else bmmms_manual<T,false,false,true><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule);
        return;
    }
    if(p.schedule.dual==3 && (p.schedule.tree&16)) {
        bmmms_manual<T,false,false,false,false,false,true><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule);
        return;
    }
    // Notes: docs/kernel_function_notes.md#launch-case12-packed-l6802
    if(p.schedule.dual==6 && s.tx1 && !s.tx2) {
        bmmms_manual_case12_packed<T,true,false><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule);
        return;
    }
    if(p.schedule.dual==3 || p.schedule.dual==4 || p.schedule.dual==6 || p.schedule.dual==7) {
        if(s.tx1 && s.tx2)bmmms_manual<T,true,true><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule);
        else if(s.tx1)bmmms_manual<T,true,false><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule);
        else if(s.tx2)bmmms_manual<T,false,true><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule);
        else bmmms_manual<T,false,false><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,p.schedule);
        return;
    }
    // Complete generic plans own legal tails and all four input layouts.
    // Match by actual resource support instead of estimated B/shape/dtype buckets.
    if(p.schedule.kSplit==1 && (p.schedule.dual==1 || p.schedule.dual==2)) {
        const auto package=MakeWindowKPackagePlan(s,p);
        if(package.safe) {
            if(s.dtype==2) {
                if(s.tx1 && s.tx2)LaunchWindowKPackages<T,true,true,true>(x1,x2,partial,y,s,p,package,stream);
                else if(s.tx1)LaunchWindowKPackages<T,true,false,true>(x1,x2,partial,y,s,p,package,stream);
                else if(s.tx2)LaunchWindowKPackages<T,false,true,true>(x1,x2,partial,y,s,p,package,stream);
                else LaunchWindowKPackages<T,false,false,true>(x1,x2,partial,y,s,p,package,stream);
            } else {
                if(s.tx1 && s.tx2)LaunchWindowKPackages<T,true,true,false>(x1,x2,partial,y,s,p,package,stream);
                else if(s.tx1)LaunchWindowKPackages<T,true,false,false>(x1,x2,partial,y,s,p,package,stream);
                else if(s.tx2)LaunchWindowKPackages<T,false,true,false>(x1,x2,partial,y,s,p,package,stream);
                else LaunchWindowKPackages<T,false,false,false>(x1,x2,partial,y,s,p,package,stream);
            }
            return;
        }
    }
    // Notes: docs/kernel_function_notes.md#launch-generic-measured-intervals-l6833
    if(s.b==1 && s.tx1 && s.tx2 && p.schedule.kSplit==1 &&
       (p.schedule.dual==1 || p.schedule.dual==2)) {
        const bool genericC8=s.dtype==2 && s.m>=1024 && s.m<2048 &&
            s.n>=1024 && s.n<2048 && s.k>=1024 && s.k<2048;
        const bool genericC11=s.dtype==1 && s.m>=1024 && s.m<2048 &&
            s.n>=2048 && s.n<4096 && s.k>=2048 && s.k<4096;
        if(genericC8) {
            if(p.schedule.dual==2)bmmms_generic_c8<T,true><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,workspace,p.cube,p.schedule);
            else bmmms_generic_c8<T,false><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,workspace,p.cube,p.schedule);
            return;
        }
        if(genericC11) {
            const auto& t=p.cube;
            auto* plat=platform_ascendc::PlatformAscendCManager::GetInstance();
            uint64_t l1=0,l0a=0,l0b=0,l0c=0;
            plat->GetCoreMemSize(platform_ascendc::CoreMemType::L1,l1);
            plat->GetCoreMemSize(platform_ascendc::CoreMemType::L0_A,l0a);
            plat->GetCoreMemSize(platform_ascendc::CoreMemType::L0_B,l0b);
            plat->GetCoreMemSize(platform_ascendc::CoreMemType::L0_C,l0c);
            const uint64_t aTile=uint64_t(t.baseM)*t.baseK*2;
            const uint64_t bTile=uint64_t(t.baseN)*t.baseK*2;
            const uint64_t cTile=uint64_t(t.baseM)*t.baseN*4;
            const uint64_t packages=aTile*t.depthA1+bTile*t.depthB1;
            const bool depthOk=t.stepM==1 && t.stepN==1 && t.stepKa>0 && t.stepKb>0 &&
                (t.depthA1==t.stepKa || t.depthA1==2*t.stepKa) &&
                (t.depthB1==t.stepKb || t.depthB1==2*t.stepKb);
            const bool partialK=int64_t(t.baseK)*t.stepKa<s.k && int64_t(t.baseK)*t.stepKb<s.k;
            const bool mdlSafe=p.schedule.dual==1 && depthOk && partialK && t.shareL1Size>0 &&
                packages+4096<=l1 && packages<=uint64_t(t.shareL1Size) &&
                aTile*(t.dbL0A==2?2:1)<=l0a && bTile*(t.dbL0B==2?2:1)<=l0b &&
                cTile*(t.dbL0C==2?2:1)<=l0c;
            if(mdlSafe)bmmms_generic_c11<T,true,true><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,workspace,p.cube,p.schedule);
            else if(p.schedule.dual==2)bmmms_generic_c11<T,true><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,workspace,p.cube,p.schedule);
            else bmmms_generic_c11<T,false><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,workspace,p.cube,p.schedule);
            return;
        }
    }
    if (p.schedule.dual == 2) {
        if(s.tx1 && s.tx2) bmmms_dual_mdl<T,true,true><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,workspace,p.cube,p.schedule);
        else if(s.tx1) bmmms_dual_mdl<T,true,false><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,workspace,p.cube,p.schedule);
        else if(s.tx2) bmmms_dual_mdl<T,false,true><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,workspace,p.cube,p.schedule);
        else bmmms_dual_mdl<T,false,false><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,workspace,p.cube,p.schedule);
        return;
    }
    if (p.schedule.dual) {
        if(s.tx1 && s.tx2) bmmms_dual<T,true,true><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,workspace,p.cube,p.schedule);
        else if(s.tx1) bmmms_dual<T,true,false><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,workspace,p.cube,p.schedule);
        else if(s.tx2) bmmms_dual<T,false,true><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,workspace,p.cube,p.schedule);
        else bmmms_dual<T,false,false><<<p.cubeBlocks,nullptr,stream>>>(x1,x2,partial,y,workspace,p.cube,p.schedule);
        return;
    }
}
} // namespace bmmms

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo &info_x1,
                           GM_ADDR x2, const TensorGroupInfo &info_x2,
                           GM_ADDR y, const TensorGroupInfo &info_y,
                           int64_t availableCoreNum, aclrtStream stream,
                           bool transposeX1, bool transposeX2)
{
    if (!x1 || !x2 || !y || availableCoreNum <= 0)
        throw std::invalid_argument("null buffer or invalid core limit");
    const auto s = bmmms_opt4::Validate(info_x1, info_x2, info_y, transposeX1, transposeX2);
    const auto key = bmmms_opt4::CurrentKey(stream);
    const bmmms_opt4::ShapeKey shape{s.b, s.m, s.n, s.k, s.dtype, s.tx1, s.tx2, availableCoreNum};
    std::lock_guard<std::mutex> lock(bmmms_opt4::CacheMutex());
    auto &entry = bmmms_opt4::Cache()[key];
    if (!entry.hasPlan || entry.shape != shape) {
        auto plan = bmmms_opt4::MakePlan(s, availableCoreNum);
        if (plan.totalBytes > entry.capacity) {
            bmmms_opt4::CheckAcl(aclrtSynchronizeStream(stream), "workspace resize synchronization");
            void *next = nullptr;
            bmmms_opt4::CheckAcl(aclrtMalloc(&next, plan.totalBytes, ACL_MEM_MALLOC_HUGE_FIRST), "workspace allocation");
            // Initialize persistent padding once, including unused NZ tail lanes.
            const aclError initError = aclrtMemset(next, plan.totalBytes, 0, plan.totalBytes);
            if (initError != ACL_SUCCESS) { aclrtFree(next); bmmms_opt4::CheckAcl(initError, "workspace initialization"); }
            if (entry.memory) {
                const aclError error = aclrtFree(entry.memory);
                if (error != ACL_SUCCESS) { aclrtFree(next); bmmms_opt4::CheckAcl(error, "workspace free"); }
            }
            entry.memory = next; entry.capacity = plan.totalBytes;
        }
        entry.plan = plan; entry.shape = shape; entry.hasPlan = true;
    }
    if (s.dtype == 1) bmmms_opt4::Launch<half>(x1, x2, y, s, entry.plan, entry.memory, stream);
    else bmmms_opt4::Launch<bfloat16_t>(x1, x2, y, s, entry.plan, entry.memory, stream);
}

// Optional lifecycle helper: call in the owning context BEFORE destroying stream/context.
extern "C" void release_kernel_resources(aclrtStream stream)
{
    const auto key = bmmms_opt4::CurrentKey(stream);
    std::lock_guard<std::mutex> lock(bmmms_opt4::CacheMutex());
    auto it = bmmms_opt4::Cache().find(key);
    if (it == bmmms_opt4::Cache().end()) return;
    bmmms_opt4::CheckAcl(aclrtSynchronizeStream(stream), "workspace release synchronization");
    if (it->second.memory) bmmms_opt4::CheckAcl(aclrtFree(it->second.memory), "workspace release");
    bmmms_opt4::Cache().erase(it);
}