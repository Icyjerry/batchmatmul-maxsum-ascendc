#include <cstdint>
#include <cstdio>
#include <sstream>
#include <stdexcept>
#include "acl/acl.h"
struct TensorInfo {const int64_t* shape;int64_t numDims;int32_t dtype;};
struct TensorGroupInfo {const TensorInfo* tensors;int64_t numTensors;};
#include "kernel.asc"
extern "C" int native_plan(int64_t B,int64_t M,int64_t N,int64_t K,int dtype,
 int tx1,int tx2,int64_t cores,char* output,size_t capacity){
 try{
  using namespace bmmms_opt4;
  Shape s{B,M,N,K,dtype,tx1,tx2};auto p=MakePlan(s,cores);
  auto* hw=platform_ascendc::PlatformAscendCManager::GetInstance();
  if(cores<1||cores>hw->GetCoreNumAic())throw std::runtime_error("invalid requested core budget");
  std::ostringstream o;o<<"{";
#define F(name,value) o<<"\"" name "\":"<<(value)<<",";
  F("hardware_aic",hw->GetCoreNumAic()) F("hardware_aiv",hw->GetCoreNumAiv())
  F("core_limit",cores) F("cube_blocks",p.cubeBlocks) F("final_blocks",p.finalBlocks)
  F("system_bytes",p.systemBytes) F("total_bytes",p.totalBytes)
  F("small",p.small) F("micro",p.micro) F("case12_packed_a",p.case12PackedA)
  F("tall_single",UseTallSingleFrame(s,p)) F("tall_halves",UseTallHalfPipeline(s,p))
  F("case12_zn",Case12K16GroupZn(s,p)) F("case12_phased",Case12PhasedPrep(s,p))
  o<<"\"schedule\":{";
#define S(name) F(#name,p.schedule.name)
  S(b) S(m) S(n) S(k) S(baseM) S(baseN) S(mTiles) S(nTiles) S(nSplit) S(workers)
  S(vectorTile) S(window) S(kSplit) S(kChunk) S(microRows) S(batchGroup) S(dual)
  S(earlySum) S(tree)
  o<<"\"balance\":"<<p.schedule.balance<<"},\"cube\":{";
#define C(name) F(#name,p.cube.name)
  C(usedCoreNum) C(baseM) C(baseN) C(baseK) C(stepM) C(stepN) C(stepKa) C(stepKb)
  C(depthA1) C(depthB1) C(dbL0A) C(dbL0B) C(dbL0C)
  o<<"\"shareL1Size\":"<<p.cube.shareL1Size<<"}}";
#undef F
#undef S
#undef C
  auto str=o.str();if(str.size()+1>capacity)return -2;
  std::snprintf(output,capacity,"%s",str.c_str());return 0;
 }catch(const std::exception& e){std::snprintf(output,capacity,"%s",e.what());return -1;}
}
extern "C" int native_call(GM_ADDR a,GM_ADDR b,GM_ADDR y,void* stream,
 int64_t B,int64_t M,int64_t N,int64_t K,int dtype,int tx1,int tx2,int64_t cores){
 int64_t ashape[3]={B,tx1?K:M,tx1?M:K},bshape[3]={B,tx2?N:K,tx2?K:N},yshape[1]={B};
 TensorInfo ai{ashape,3,dtype},bi{bshape,3,dtype},yi{yshape,1,0};
 TensorGroupInfo ga{&ai,1},gb{&bi,1},gy{&yi,1};
 try{run_kernel(a,ga,b,gb,
  y,gy,cores,reinterpret_cast<aclrtStream>(stream),tx1,tx2);return 0;}
 catch(const std::exception& e){std::fprintf(stderr,"native_call: %s\n",e.what());return -1;}
}
