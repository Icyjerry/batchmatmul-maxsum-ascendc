#include "../library.asc"
// Read the actual host selector and freshly queried tiling. No kernel launch or data access.
extern "C" int native_c11_transpose_plan(int dtype,int64_t cores,char* output,size_t capacity){
 try{
  using namespace bmmms_opt4;
  Shape s{1,1536,2048,2048,dtype,1,1};auto p=MakePlan(s,cores);
  AscendC::tiling::TCubeTiling t{};const bool selected=MakeTTMdlTranspose(s,p,t);
  std::ostringstream o;o<<"{\"selected\":"<<selected<<",\"dtype\":"<<dtype<<",\"core_limit\":"<<cores;
  if(selected){
#define F(x) o<<",\"" #x "\":"<<t.x
   F(M);F(N);F(Ka);F(Kb);F(usedCoreNum);F(baseM);F(baseN);F(baseK);
   F(singleCoreM);F(singleCoreN);F(singleCoreK);F(stepM);F(stepN);
   F(stepKa);F(stepKb);F(depthA1);F(depthB1);F(dbL0A);F(dbL0B);F(dbL0C);
   F(shareL1Size);F(shareL0CSize);F(shareUbSize);F(shareMode);F(transLength);
#undef F
  }
  o<<"}";const auto text=o.str();if(text.size()+1>capacity)return -2;
  std::snprintf(output,capacity,"%s",text.c_str());return 0;
 }catch(const std::exception& e){std::snprintf(output,capacity,"%s",e.what());return -1;}
}
