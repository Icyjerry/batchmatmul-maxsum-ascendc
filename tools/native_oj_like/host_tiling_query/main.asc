#include <iostream>
#include <stdexcept>
#include "acl/acl.h"
#include "kernel_tiling/kernel_tiling.h"
#include "tiling/platform/platform_ascendc.h"
#include "tiling/tiling_api.h"
// Host resource/tiling queries only. This executable defines and launches no NPU kernel.
static void Query(bool transpose, int m, int n, int bm, int bn) {
    auto* hw=platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t l1=0,l0c=0,ub=0;
    hw->GetCoreMemSize(platform_ascendc::CoreMemType::L1,l1);
    hw->GetCoreMemSize(platform_ascendc::CoreMemType::L0_C,l0c);
    hw->GetCoreMemSize(platform_ascendc::CoreMemType::UB,ub);
    const uint64_t vectorBytes=4ULL*256*128+12ULL*256+32+3ULL*1024*4+64;
    matmul_tiling::MatmulApiTiling api(*hw);
    using P=matmul_tiling::TPosition;using F=matmul_tiling::CubeFormat;using D=matmul_tiling::DataType;
    api.SetAType(P::GM,F::ND,D::DT_BF16,transpose);
    api.SetBType(P::GM,F::ND,D::DT_BF16,transpose);
    api.SetCType(P::GM,F::ND,D::DT_FLOAT);api.SetBias(false);
    api.SetOrgShape(m,n,2048);api.SetShape(bm,bn,2048);
    api.SetBufferSpace(l1,l0c,ub-vectorBytes);
    AscendC::tiling::TCubeTiling t{};
    const int fixed=api.SetFixSplit(bm,bn,64);
    const int result=fixed==-1?-1:api.GetTiling(t);
    std::cout<<"{\"transpose\":"<<transpose<<",\"M\":"<<m<<",\"N\":"<<n
        <<",\"requestedBM\":"<<bm<<",\"requestedBN\":"<<bn<<",\"result\":"<<result;
    if(result!=-1) {
#define FIELD(x) std::cout<<",\"" #x "\":"<<t.x
        FIELD(M);FIELD(N);FIELD(Ka);FIELD(Kb);FIELD(baseM);FIELD(baseN);FIELD(baseK);
        FIELD(singleCoreM);FIELD(singleCoreN);FIELD(singleCoreK);FIELD(stepM);FIELD(stepN);
        FIELD(stepKa);FIELD(stepKb);FIELD(depthA1);FIELD(depthB1);FIELD(dbL0A);FIELD(dbL0B);FIELD(dbL0C);
        FIELD(shareL1Size);FIELD(shareL0CSize);FIELD(shareUbSize);FIELD(shareMode);FIELD(transLength);
#undef FIELD
    }
    std::cout<<"}\n";
}
int main() {
    if(aclInit(nullptr)!=ACL_SUCCESS)return 1;
    if(aclrtSetDevice(0)!=ACL_SUCCESS){aclFinalize();return 2;}
    std::cout<<"{\"soc\":\""<<aclrtGetSocName()<<"\"}\n";
    Query(true,1536,2048,256,128);
    Query(false,2048,1536,128,256);
    aclrtResetDevice(0);aclFinalize();
}
