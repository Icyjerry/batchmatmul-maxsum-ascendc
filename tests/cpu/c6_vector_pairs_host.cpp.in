int main(){
 auto* hw=platform_ascendc::PlatformAscendCManager::GetInstance();unsigned count=0,hits=0;
 for(int cores:{1,8,12,20,32,64})for(int b:{12,13,14})for(int m:{22,23,24})
 for(int n:{72,73,74})for(int k:{184,192,200})for(int dt:{1,2})for(int x:{0,1})for(int y:{0,1}){
  hw->aic=cores;hw->aiv=2*cores;Shape s{b,m,n,k,dt,x,y};auto p=MakePlan(s,cores),old=p;++count;
  bool got=C6VectorPairsFits(s,p),want=b==13&&m==23&&n==73&&k==192&&dt==2&&!x&&y&&cores>=13;
  assert(got==want);assert(!memcmp(&p.schedule,&old.schedule,sizeof(Schedule))&&p.totalBytes==old.totalBytes&&p.cubeBlocks==old.cubeBlocks);
  hits+=got;
 }
 assert(count==3888&&hits==3);hw->aic=20;hw->aiv=40;Shape s{13,23,73,192,2,0,1};auto p=MakePlan(s,20);
 assert(C6VectorPairsFits(s,p));auto ub=hw->ub;hw->ub=194336;assert(C6VectorPairsFits(s,p));
 hw->ub=194335;assert(!C6VectorPairsFits(s,p));hw->ub=ub;
 hw->aiv=26;assert(C6VectorPairsFits(s,p));hw->aiv=25;assert(!C6VectorPairsFits(s,p));hw->aiv=40;
 auto bytes=p.totalBytes;p.totalBytes=p.systemBytes+2048;assert(C6VectorPairsFits(s,p));
 p.totalBytes=p.systemBytes+2047;assert(!C6VectorPairsFits(s,p));p.totalBytes=bytes;
 for(auto field:{&p.schedule.b,&p.schedule.m,&p.schedule.n,&p.schedule.k}){
  auto old=*field;*field=999;assert(!C6VectorPairsFits(s,p));*field=old;}
 for(auto field:{&p.schedule.dual,&p.schedule.baseM,&p.schedule.baseN,&p.schedule.mTiles,&p.schedule.nTiles,
  &p.schedule.nSplit,&p.schedule.kSplit,&p.schedule.window,&p.schedule.workers}){
  auto old=*field;*field=999;assert(!C6VectorPairsFits(s,p));*field=old;}
 auto blocks=p.cubeBlocks;p.cubeBlocks=999;assert(!C6VectorPairsFits(s,p));p.cubeBlocks=blocks;
#ifdef BMMMS_TUNING
 for(auto field:{&Tune().group,&Tune().rows,&Tune().dual,&Tune().early,&Tune().tree,
  &Tune().bm,&Tune().bn,&Tune().window,&Tune().ns,&Tune().ks,&Tune().workers}){
  Tune()=TuneConfig{};*field=1;assert(!C6VectorPairsFits(s,p));
 }
 Tune()=TuneConfig{};
#endif
 std::cout<<count<<" actual C6 host plans / "<<hits<<" selections: exact original plan/workspace, capacity/core/one-byte bounds and all explicit pins fallback PASS\n";
}
