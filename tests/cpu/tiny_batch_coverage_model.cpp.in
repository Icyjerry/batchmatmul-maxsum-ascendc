struct Inputs {
 std::vector<int16_t> a,b;std::vector<float> y;int16_t* ap;int16_t* bp;
 Inputs(uint32_t B,uint32_t M,uint32_t N,uint32_t K,bool X,bool Y,bool neg):a(B*M*K+32,12345),b(B*N*K+32,12345),y(B+16,1e30f){
  ap=reinterpret_cast<int16_t*>((reinterpret_cast<uintptr_t>(a.data())+31)/32*32);
  bp=reinterpret_cast<int16_t*>((reinterpret_cast<uintptr_t>(b.data())+31)/32*32);
  for(uint32_t z=0;z<B;++z)for(uint32_t k=0;k<K;++k){
   for(uint32_t m=0;m<M;++m)ap[z*M*K+(X?k*M+m:m*K+k)]=int16_t(1+(z*5+m*3+k)%5);
   for(uint32_t n=0;n<N;++n)bp[z*N*K+(Y?n*K+k:k*N+n)]=int16_t(neg?-int(1+(z*7+n*3+k)%7):int((z*7+n*3+k)%11)-5);
  }
  AscendC::globals.clear();AscendC::globals[reinterpret_cast<uintptr_t>(ap)]=B*M*K*2;
  AscendC::globals[reinterpret_cast<uintptr_t>(bp)]=B*N*K*2;
  AscendC::globals[reinterpret_cast<uintptr_t>(y.data()+8)]=B*4;
 }
 void Prepare(){
  assert(AscendC::dma.empty()&&AscendC::outDma.empty());
  AscendC::ub=std::make_shared<std::vector<uint8_t>>(256*1024,0x7f);
  AscendC::manualBytes=0;AscendC::writes.clear();AscendC::lastBytes=0;AscendC::flags.clear();
  std::fill(y.begin(),y.end(),1e30f);
 }
 void Verify(uint32_t B,uint32_t M,uint32_t N,uint32_t K,bool X,bool Y,bool neg){
  assert(AscendC::dma.empty()&&AscendC::outDma.empty());for(auto f:AscendC::flags)assert(f.second==0);
  for(uint32_t z=0;z<B;++z){float sum=0;
   for(uint32_t m=0;m<M;++m){float mx=-INFINITY;
    for(uint32_t n=0;n<N;++n){float dot=0;for(uint32_t k=0;k<K;++k)
     dot+=float(ap[z*M*K+(X?k*M+m:m*K+k)])*float(bp[z*N*K+(Y?n*K+k:k*N+n)]);
     mx=std::max(mx,dot);}
    if(neg)assert(mx<0);sum+=mx;
   }
   assert(y[8+z]==sum&&AscendC::writes.at(reinterpret_cast<uintptr_t>(y.data()+8+z))==1);
  }
  for(int i=0;i<8;++i)assert(y[i]==1e30f&&y[8+B+i]==1e30f);
 }
};
unsigned grouped=0,direct=0,idle=0;
template<bool X,bool Y>void Run(uint32_t B,uint32_t M,uint32_t N,uint32_t K,uint32_t budget,bool neg){
 Shape s{B,M,N,K,1,X,Y};auto group=TinyVectorBatchGroup(s,budget);
 if(!group)return;
 Inputs in(B,M,N,K,X,Y,neg);auto a=in.a,b=in.b;
 auto run=[&](uint32_t g,bool specialized){
  in.Prepare();uint32_t maxBytes=0;
  for(uint32_t z=0;z<(B+g-1)/g+1;++z){
   AscendC::block=z;AscendC::manualBytes=0;
   AscendC::ub=std::make_shared<std::vector<uint8_t>>(budget,0x7f);
   if(!specialized)bmmms_tiny_grouped<int16_t,X,Y>(in.ap,in.bp,in.y.data()+8,{B,M,N,K},g);
   else if(K==32)bmmms_tiny_grouped<int16_t,X,Y,32>(in.ap,in.bp,in.y.data()+8,{B,M,N,K},g);
   else if(K==40)bmmms_tiny_grouped<int16_t,X,Y,40>(in.ap,in.bp,in.y.data()+8,{B,M,N,K},g);
   else bmmms_tiny_grouped<int16_t,X,Y,64>(in.ap,in.bp,in.y.data()+8,{B,M,N,K},g);
   maxBytes=std::max<uint32_t>(maxBytes,AscendC::manualBytes);
   if(z==(B+g-1)/g){assert(AscendC::manualBytes==0);++idle;}
  }
  in.Verify(B,M,N,K,X,Y,neg);assert(in.a==a&&in.b==b);
  assert(maxBytes+1024<=budget);++grouped;
 };
 run(group,false);auto result=in.y;run(group,true);assert(in.y==result);
 if(group!=1){run(1,true);assert(in.y==result);}
 if(TinyVectorFits(s,budget)){
  in.Prepare();AscendC::block=0;AscendC::ub=std::make_shared<std::vector<uint8_t>>(budget,0x7f);
  bmmms_tiny_direct<int16_t,X,Y>(in.ap,in.bp,in.y.data()+8,{B,M,N,K});
  in.Verify(B,M,N,K,X,Y,neg);assert(in.y==result&&in.a==a&&in.b==b);++direct;
  in.Prepare();ReferenceTiny<int16_t,X,Y>(in.ap,in.bp,in.y.data()+8,{B,M,N,K});
  in.Verify(B,M,N,K,X,Y,neg);assert(in.y==result);++direct;
 }
}
int main(){
 for(uint32_t B:{1u,3u,8u,9u,31u,64u})for(uint32_t M:{1u,5u,8u})
 for(uint32_t N:{1u,7u,17u,63u,64u})for(uint32_t K:{32u,40u,64u})
 for(uint32_t ub:{65536u,196608u})for(bool neg:{false,true}){
  Run<false,false>(B,M,N,K,ub,neg);Run<false,true>(B,M,N,K,ub,neg);
  Run<true,false>(B,M,N,K,ub,neg);Run<true,true>(B,M,N,K,ub,neg);
 }
 std::cout<<grouped<<" actual grouped dynamic/specialized cases / "<<direct<<" direct + passed parent / "<<idle<<" idle blocks PASS\n";
 std::cout<<"4 layouts, B tails, N64/M8/K8 boundaries, negative maxima, UB capacity/typed slice/mask bounds, unique valid y and delayed DMA completion PASS\n";
}
