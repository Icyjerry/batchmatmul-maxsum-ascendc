int main(){
 auto* hw=platform_ascendc::PlatformAscendCManager::GetInstance();unsigned total=0,hits=0,fp16=0;
 for(int cores:{1,3,8,20,32})for(int M:{1024,1025,1536,1537,2048})
 for(int N:{1024,1025,2048,3072,3073})for(int K:{1024,1032,1536,3072,3080})
 for(int dt:{1,2})for(int lay=0;lay<4;++lay){
  hw->aic=std::max(cores,8);hw->aiv=2*hw->aic;Shape s{1,M,N,K,dt,lay/2,lay%2};
  auto p=MakePlan(s,cores),old=p;auto q=MakeTTDocumentFrame(s,p);++total;
  assert(!memcmp(&p.schedule,&old.schedule,sizeof(Schedule))&&p.totalBytes==old.totalBytes);
  if(q.workers){++hits;fp16+=dt==1;const auto& d=p.schedule;uint32_t bk=q.bn==256?64:128;
   assert(lay==3&&(d.dual==1||d.dual==29||d.dual==33)&&q.nSplit==d.nSplit&&q.workers==d.workers);
   assert((q.bm==d.baseM||q.bm==64)&&q.bn==d.baseN&&q.k==K&&q.m==M&&q.n==N);
   assert(2ULL*q.bm*Ceil(K,16)*16+4ULL*q.bn*q.packageK<=hw->l1);
   assert(4ULL*q.bn*bk<=hw->l0a&&4ULL*q.bm*bk<=hw->l0b&&8ULL*q.bm*q.bn<=hw->l0);
   uint64_t parts=Ceil(4ULL*q.nSplit*Ceil(M,q.bm)*q.bm,512)*512,ring=8ULL*q.workers*q.bm*q.bn;
   assert(p.totalBytes>=p.systemBytes+parts+ring);
   assert(q.workers<=uint32_t(hw->aic)&&2*q.workers<=uint32_t(hw->aiv));
  }
 }
 assert(hits&&fp16);hw->aic=20;hw->aiv=40;Shape s{1,1537,3073,3080,1,1,1};auto p=MakePlan(s,20);
 auto q=MakeTTDocumentFrame(s,p);assert(q.workers&&q.bm==64);
 std::cout<<"FP16 TT proxy: old dual="<<p.schedule.dual<<" bm="<<p.schedule.baseM<<" ns="<<p.schedule.nSplit
  <<" -> internal bm="<<q.bm<<" bn="<<q.bn<<" PK="<<q.packageK<<" ns="<<q.nSplit<<" cores="<<q.workers<<"\n";
 for(auto cap:{&hw->ub,&hw->l1,&hw->l0a,&hw->l0b,&hw->l0}){
  auto old=*cap;*cap=4096;assert(!MakeTTDocumentFrame(s,p).workers);*cap=old;
 }
 auto bytes=p.totalBytes;p.totalBytes=p.systemBytes;assert(!MakeTTDocumentFrame(s,p).workers);p.totalBytes=bytes;
 hw->aiv=2*(p.cubeBlocks-1);assert(!MakeTTDocumentFrame(s,p).workers);hw->aiv=40;
 Shape nonTT=s;nonTT.tx1=0;assert(!MakeTTDocumentFrame(nonTT,p).workers);
 for(auto field:{&p.schedule.kSplit,&p.schedule.workers,&p.schedule.baseN}){
  auto old=*field;*field=999;assert(!MakeTTDocumentFrame(s,p).workers);*field=old;
 }
#ifdef BMMMS_TUNING
 for(auto field:{&Tune().group,&Tune().rows,&Tune().dual,&Tune().early,&Tune().tree,
  &Tune().bm,&Tune().bn,&Tune().window,&Tune().ns,&Tune().ks,&Tune().workers}){
  Tune()=TuneConfig{};*field=1;assert(!MakeTTDocumentFrame(s,p).workers);
 }
 Tune()=TuneConfig{};
#endif
 std::cout<<total<<" actual TT document host controls / "<<hits<<" selected / "<<fp16
  <<" FP16: old plan unmodified, BM fallback, actual cores/memories, same GM capacity, pin fallback PASS\n";
}
