int main(){
 auto* hw=platform_ascendc::PlatformAscendCManager::GetInstance();unsigned count=0,hits=0;
 for(int cores:{1,4,8,20,32,64})for(int b:{1,2})for(int m:{1520,1536,1552})
 for(int n:{2032,2048,2064})for(int k:{2040,2048,2056})for(int dt:{1,2})for(int x:{0,1})for(int y:{0,1}){
  hw->aic=cores;hw->aiv=2*cores;Shape s{b,m,n,k,dt,x,y};auto p=MakePlan(s,cores),old=p;++count;
  auto q=MakeC11TTFrame(s,p);bool expected=b==1&&m==1536&&n==2048&&k==2048&&dt==1&&x&&y&&cores>=8;
  assert(bool(q.workers)==expected);
  assert(!memcmp(&p.schedule,&old.schedule,sizeof(Schedule))&&p.cubeBlocks==old.cubeBlocks&&p.totalBytes==old.totalBytes);
  if(q.workers){++hits;assert(q.bm==64&&q.bn==256&&q.packageK==256&&q.nTiles==8&&q.workers==p.cubeBlocks);
   assert(4ULL*q.nTiles*Ceil(q.m,q.bm)*q.bm==4ULL*p.schedule.nSplit*p.schedule.mTiles*p.schedule.baseM);
   assert(8ULL*q.bm*q.bn*q.workers<=8ULL*p.schedule.baseM*p.schedule.baseN*p.schedule.workers);
  }
 }
 hw->aic=20;hw->aiv=40;Shape s{1,1536,2048,2048,1,1,1};auto p=MakePlan(s,20);
 assert(MakeC11TTFrame(s,p).workers==20);
 std::vector<std::pair<uint64_t*,uint64_t>> caps={{&hw->l1,524288},{&hw->l0a,16384},
  {&hw->l0b,65536},{&hw->l0,131072},{&hw->ub,65792+4096}};
 for(auto v:caps){auto old=*v.first;*v.first=v.second;assert(MakeC11TTFrame(s,p).workers);
  *v.first=v.second-1;assert(!MakeC11TTFrame(s,p).workers);*v.first=old;}
 auto bytes=p.totalBytes,need=p.systemBytes+49152+131072ULL*p.schedule.workers;
 p.totalBytes=need;assert(MakeC11TTFrame(s,p).workers);p.totalBytes=need-1;assert(!MakeC11TTFrame(s,p).workers);p.totalBytes=bytes;
 hw->aic=19;assert(!MakeC11TTFrame(s,p).workers);hw->aic=20;
 hw->aiv=39;assert(!MakeC11TTFrame(s,p).workers);hw->aiv=40;
 for(auto field:{&p.schedule.dual,&p.schedule.baseM,&p.schedule.baseN,&p.schedule.mTiles,&p.schedule.nTiles,
  &p.schedule.nSplit,&p.schedule.kSplit,&p.schedule.kChunk,&p.schedule.window,&p.schedule.workers}){
  auto old=*field;*field=999;assert(!MakeC11TTFrame(s,p).workers);*field=old;}
 for(auto field:{&p.schedule.tree,&p.schedule.earlySum}){auto old=*field;*field=1;assert(!MakeC11TTFrame(s,p).workers);*field=old;}
 for(auto field:{&p.schedule.b,&p.schedule.m,&p.schedule.n,&p.schedule.k}){
  auto old=*field;*field=999;assert(!MakeC11TTFrame(s,p).workers);*field=old;}
 auto blocks=p.cubeBlocks;p.cubeBlocks=999;assert(!MakeC11TTFrame(s,p).workers);p.cubeBlocks=blocks;
#ifdef BMMMS_TUNING
 for(auto field:{&Tune().group,&Tune().rows,&Tune().dual,&Tune().early,&Tune().tree,
  &Tune().bm,&Tune().bn,&Tune().window,&Tune().ns,&Tune().ks,&Tune().workers}){
  Tune()=TuneConfig{};*field=1;assert(!MakeC11TTFrame(s,p).workers);
 }
 Tune()=TuneConfig{};
#endif
 assert(count==2592&&hits==4);
 std::cout<<count<<" actual host plans / "<<hits<<" exact C11 selections: unchanged plan/GM prefix, real core/capacity/one-byte boundaries, one/four-core and tuning fallback PASS\n";
}
