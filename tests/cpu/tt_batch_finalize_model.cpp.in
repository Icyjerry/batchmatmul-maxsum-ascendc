// Actual finalizer, delayed live DMA/Vector reads and a real all-AIV barrier.
// Integer-valued floats; no native BF16 rounding or TPipe implementation.
#include <algorithm>
#include <atomic>
#include <cassert>
#include <condition_variable>
#include <cstdint>
#include <deque>
#include <functional>
#include <iostream>
#include <limits>
#include <mutex>
#include <thread>
#include <vector>
#define __aicore__
#define __gm__
using GM_ADDR=float*;
constexpr int PIPE_MTE2=0,PIPE_V=1,PIPE_MTE3=2,PIPE_ALL=3;
struct Schedule {int64_t m;uint32_t baseM,mTiles,nSplit,workers;};
struct Barrier {
 std::mutex mutex;std::condition_variable cv;unsigned arrived=0,generation=0,count;
 explicit Barrier(unsigned n):count(n){}
 void Wait(){std::unique_lock<std::mutex> lock(mutex);auto old=generation;
  if(++arrived==count){arrived=0;++generation;cv.notify_all();}
  else cv.wait(lock,[&]{return generation!=old;});}
};
struct Shared {
 Schedule s;std::vector<float> partial,output;std::vector<std::atomic<unsigned>> written;
 Barrier barrier;std::atomic<unsigned> yWrites{0};
 explicit Shared(Schedule x):s(x),partial(x.nSplit*x.mTiles*x.baseM+16,1e30f),
  output(17,1e30f),written(x.nSplit*x.mTiles*x.baseM),barrier(2*x.workers){
   for(auto& n:written)n.store(0);
  }
}*shared;
struct State {
 uint32_t block=0;bool synced=false;unsigned allocations=0;
 std::vector<float> ub=std::vector<float>(192*1024/4+8,1e30f);
 std::vector<unsigned> gen=std::vector<unsigned>(192*1024/4+8,0);
 std::vector<std::pair<size_t,size_t>> claims;
 std::deque<std::function<void()>> queues[3];
 void Flush(int pipe){while(!queues[pipe].empty()){auto f=queues[pipe].front();queues[pipe].pop_front();f();}}
} ;
thread_local State st;
namespace AscendC {
enum class TPosition{VECCALC,VECOUT};
enum class HardEvent{MTE2_V,V_MTE3};
struct TPipe{};
uint32_t GetBlockIdx(){return st.block;}
void SetMaskNorm(){}void ResetMask(){}
template<class T>struct LocalTensor {
 size_t offset=0,count=0;
 LocalTensor(TPosition,size_t bytes,size_t n):offset(bytes/4),count(n){
  assert(st.synced&&st.block==0&&bytes%32==0&&offset+n<=192*1024/4);
  for(auto r:st.claims)assert(offset+n<=r.first||offset>=r.second);
  st.claims.push_back({offset,offset+n});++st.allocations;
 }
 LocalTensor(size_t off,size_t n):offset(off),count(n){}
 LocalTensor operator[](size_t i)const{assert(i<count);return {offset+i,count-i};}
 float& At(size_t i)const{assert(i<count);return st.ub[offset+i];}
 unsigned& Gen(size_t i)const{assert(i<count);return st.gen[offset+i];}
};
template<class T>struct GlobalTensor {
 T* ptr=nullptr;size_t count=0;bool out=false;
 void SetGlobalBuffer(T* p){ptr=p;out=p==shared->output.data();assert(out||p==shared->partial.data());
  count=out?1:shared->written.size();}
};
template<int P>void PipeBarrier(){
 if(P==PIPE_V)st.Flush(PIPE_V);
 else {static_assert(P==PIPE_V||P==PIPE_ALL);st.Flush(PIPE_MTE3);st.Flush(PIPE_MTE2);st.Flush(PIPE_V);st.Flush(PIPE_MTE3);}
}
template<bool Mode>void SyncAll(){
 static_assert(Mode);st.Flush(PIPE_V);st.Flush(PIPE_MTE3);st.Flush(PIPE_MTE2);
 shared->barrier.Wait();st.synced=true;
}
struct BinaryRepeatParams{uint32_t db,ab,bb,dr,ar,br;};
struct DataCopyExtParams{uint16_t blocks;uint32_t bytes,src,dst,res;};
void DataCopy(LocalTensor<float> dst,GlobalTensor<float> src,uint32_t count){
 assert(st.synced&&st.block==0&&!src.out&&count==shared->written.size());
 st.queues[PIPE_MTE2].push_back([=]{for(uint32_t i=0;i<count;++i){
  assert(shared->written[i].load(std::memory_order_acquire)==1);
  dst.At(i)=src.ptr[i];dst.Gen(i)=1;
 }});
}
void DataCopyPad(GlobalTensor<float> dst,LocalTensor<float> src,DataCopyExtParams p){
 assert(dst.out&&st.synced&&st.block==0&&p.blocks==1&&p.bytes==4&&!p.src&&!p.dst);
 st.queues[PIPE_MTE3].push_back([=]{assert(src.Gen(0)==1&&"output before V completion");
  assert(shared->yWrites.fetch_add(1)==0);dst.ptr[0]=src.At(0);});
}
void Max(LocalTensor<float> dst,LocalTensor<float> a,LocalTensor<float> b,uint64_t mask,uint32_t reps,BinaryRepeatParams p){
 assert(mask>=1&&mask<=64&&reps>=1&&reps<=255&&p.db==1&&p.ab==1&&p.bb==1);
 st.queues[PIPE_V].push_back([=]{for(uint32_t r=0;r<reps;++r)for(uint32_t i=0;i<mask;++i){
  assert(a.Gen(r*p.ar*8+i)==1&&b.Gen(r*p.br*8+i)==1&&"merge before DMA completion");
  dst.At(r*p.dr*8+i)=std::max(a.At(r*p.ar*8+i),b.At(r*p.br*8+i));dst.Gen(r*p.dr*8+i)=1;
 }});
}
void Max(LocalTensor<float> dst,LocalTensor<float> a,LocalTensor<float> b,uint32_t count){
 st.queues[PIPE_V].push_back([=]{for(uint32_t i=0;i<count;++i){
  assert(a.Gen(i)==1&&b.Gen(i)==1);dst.At(i)=std::max(a.At(i),b.At(i));dst.Gen(i)=1;
 }});
}
void WholeReduceSum(LocalTensor<float> dst,LocalTensor<float> src,uint64_t mask,uint32_t reps,uint32_t ds,uint32_t bs,uint32_t rs){
 assert(mask>=1&&mask<=64&&reps>=1&&reps<=255&&ds==1&&bs==1);
 st.queues[PIPE_V].push_back([=]{for(uint32_t r=0;r<reps;++r){float total=0;
  for(uint32_t i=0;i<mask;++i){assert(src.Gen(r*rs*8+i)==1);total+=src.At(r*rs*8+i);}
  dst.At(r*ds)=total;dst.Gen(r*ds)=1;
 }});
}
}
template<AscendC::HardEvent E>void Fence(){
 if(E==AscendC::HardEvent::MTE2_V)st.Flush(PIPE_MTE2);else st.Flush(PIPE_V);
}
// INSERT_FINALIZER
void FinalizeFullMTiles(GM_ADDR,GM_ADDR,const Schedule&,AscendC::TPipe&){assert(false);}
void FinishOriginalConsumer(GM_ADDR partial,GM_ADDR output,const Schedule& s){
 constexpr bool TILE_STREAM=true,BATCH_FINAL=true;AscendC::TPipe pipe;
 // INSERT_BARRIER_CALL
}
float Value(uint32_t row,uint32_t ns,bool negative){return negative?-float(1+(row*17+ns*11)%61):float(int((row*17+ns*11)%61)-30);}
void Run(uint32_t m,uint32_t bm,uint32_t ns,uint32_t workers,bool negative){
 Schedule s{m,bm,(m+bm-1)/bm,ns,workers};uint32_t pm=s.mTiles*bm;
 Shared data(s);shared=&data;std::vector<float> expected(data.partial.size(),1e30f);
 for(uint32_t split=0;split<ns;++split)for(uint32_t row=0;row<pm;++row)
  expected[split*pm+row]=row<m?Value(row,split,negative):1e30f;
 float golden=0;for(uint32_t row=0;row<m;++row){float mx=-std::numeric_limits<float>::infinity();
  for(uint32_t split=0;split<ns;++split)mx=std::max(mx,Value(row,split,negative));golden+=mx;}
 std::vector<std::thread> threads;
 for(uint32_t id=0;id<2*workers;++id)threads.emplace_back([&,id]{
  st=State{};st.block=id;uint32_t tasks=s.mTiles*ns,worker=id/2,sub=id%2;
  const uint32_t begin=worker*tasks/workers,end=(worker+1)*tasks/workers;
  st.queues[PIPE_MTE3].push_back([=,&data,&expected]{
   for(uint32_t task=begin;task<end;++task){uint32_t split=task%ns,mt=task/ns;
    for(uint32_t r=0;r<bm/2;++r){uint32_t at=split*pm+mt*bm+sub*(bm/2)+r;
     data.partial[at]=expected[at];assert(data.written[at].fetch_add(1,std::memory_order_release)==0);}}
  });
  FinishOriginalConsumer(data.partial.data(),data.output.data(),s);
  for(auto& q:st.queues)assert(q.empty()&&"manual alias kernel left pending DMA");
  assert(st.allocations==(id==0?3u:0u));
  for(size_t i=192*1024/4;i<st.ub.size();++i)assert(st.ub[i]==1e30f);
 });
 for(auto& t:threads)t.join();
 assert(data.partial==expected&&"finalizer changed input partials");
 assert(data.output[0]==golden&&data.yWrites==1);
 for(size_t i=1;i<data.output.size();++i)assert(data.output[i]==1e30f);
 for(auto& n:data.written)assert(n.load()==1);
}
int main(){unsigned count=0;
 for(uint32_t bm:{64u,128u})for(uint32_t m:{1024u,1025u,1055u,1087u,1536u,1537u,2048u})
 for(uint32_t ns:{3u,8u,13u,16u})for(uint32_t workers:{1u,3u,20u})for(bool neg:{false,true}){
  uint32_t pm=(m+bm-1)/bm*bm;
  if((ns/2)*pm/64>255||ns*pm*4+256+4096>192*1024)continue;
  Run(m,bm,ns,workers,neg);++count;
 }
 std::cout<<count<<" actual TT batch finalizers: queued MTE2/V/MTE3, one real all-AIV barrier, dead-frame reuse, poisoned M tails, N Max then M Sum, immutable partials, unique four-byte y PASS\n";
}
