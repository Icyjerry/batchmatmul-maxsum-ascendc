int main(){
 auto* hw=platform_ascendc::PlatformAscendCManager::GetInstance();unsigned total=0,hits=0;
 for(int cores:{1,3,8,20,32})for(int M:{1024,1025,1536,1537,2048})
 for(int N:{1024,1025,1536,1537,2048})for(int K:{1024,1032,1536,1544,2048})
 for(int dt:{1,2})for(int lay=0;lay<4;++lay){
  hw->aic=std::max(cores,8);hw->aiv=2*hw->aic;Shape s{1,M,N,K,dt,lay/2,lay%2};
  auto p=MakePlan(s,cores),old=p;auto q=MakeTTManualFrame(s,p);++total;
  assert(!memcmp(&p.schedule,&old.schedule,sizeof(Schedule))&&p.totalBytes==old.totalBytes);
  if(q.workers){++hits;const auto& d=p.schedule;uint32_t bk=q.bn==256?64:128;
   assert(dt==2&&lay==3&&d.dual==33&&q.packageK==d.kChunk&&q.workers==d.workers);
   assert(q.bm==d.baseM&&q.bn==d.baseN&&q.nTiles==d.nTiles&&q.k==K&&q.m==M&&q.n==N);
   assert(2ULL*q.bm*Ceil(K,16)*16+4ULL*q.bn*q.packageK<=hw->l1);
   assert(4ULL*q.bm*bk<=hw->l0a&&4ULL*q.bn*bk<=hw->l0b&&8ULL*q.bm*q.bn<=hw->l0);
   assert(q.workers<=uint32_t(hw->aic)&&2*q.workers<=uint32_t(hw->aiv));
  }
 }
 assert(hits);hw->aic=20;hw->aiv=40;Shape s{1,1537,1537,1536,2,1,1};auto p=MakePlan(s,20);
 assert(MakeTTManualFrame(s,p).workers);
 for(auto cap:{&hw->ub,&hw->l1,&hw->l0a,&hw->l0b,&hw->l0}){
  auto old=*cap;*cap=4096;assert(!MakeTTManualFrame(s,p).workers);*cap=old;
 }
 auto bytes=p.totalBytes;p.totalBytes=p.systemBytes;assert(!MakeTTManualFrame(s,p).workers);p.totalBytes=bytes;
 hw->aiv=2*(p.cubeBlocks-1);assert(!MakeTTManualFrame(s,p).workers);hw->aiv=40;
 for(auto field:{&p.schedule.kChunk,&p.schedule.workers,&p.schedule.baseN}){
  auto old=*field;*field=999;assert(!MakeTTManualFrame(s,p).workers);*field=old;
 }
#ifdef BMMMS_TUNING
 for(auto field:{&Tune().group,&Tune().rows,&Tune().dual,&Tune().early,&Tune().tree,
  &Tune().bm,&Tune().bn,&Tune().window,&Tune().ns,&Tune().ks,&Tune().workers}){
  Tune()=TuneConfig{};*field=1;assert(!MakeTTManualFrame(s,p).workers);
 }
 Tune()=TuneConfig{};
#endif
 std::cout<<total<<" actual TT frame host controls / "<<hits<<" selected: same plan/task/packages/GM, actual cores/memories, resource/pin fallback PASS\n";
}
