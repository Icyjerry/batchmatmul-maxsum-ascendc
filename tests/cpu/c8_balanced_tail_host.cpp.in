int main(){auto* hw=platform_ascendc::PlatformAscendCManager::GetInstance();unsigned n=0,hits=0,tiles=0;
 for(int cores:{1,3,8,20,24,32,40})for(int B:{1,2})for(int M:{1024,1025,1026})for(int N:{1030,1031,1032})
 for(int K:{1024,1032,1040})for(int dt:{1,2})for(int lay=0;lay<4;++lay){
  hw->aic=cores;hw->aiv=2*cores;Shape s{B,M,N,K,dt,lay/2,lay%2};auto p=MakePlan(s,cores),old=p;
  int hit=Select(s,p);++n;
  assert(!memcmp(&p.schedule,&old.schedule,sizeof(Schedule))&&p.totalBytes==old.totalBytes);
  if(hit==2){++hits;assert(B==1&&M==1025&&N==1031&&K==1032&&dt==2&&lay==3&&cores>=8&&cores<=32);}
 }
 assert(hits==4);
 for(uint32_t w=8;w<=32;++w){TTFrameShape s{1025,1031,1032,128,128,384,9,w};auto owners=MakeTTWorkOwners(s);
  std::vector<unsigned> seen(9*1025,0);for(uint32_t id=0;id<w;++id){auto g=refs.at(w).at(id);
   assert(TTWorkCount(s,id,owners)==g.size());
   for(uint32_t t=0;t<g.size();++t){auto a=TTWorkAt(s,id,t,owners);auto b=g[t];++tiles;
    assert(a.mt==b.mt&&a.nt==b.nt&&a.row==b.row&&a.rows==b.rows);
    assert(a.row%16==0&&a.row+a.rows<=uint32_t(a.mt==8?1:128));
    for(uint32_t r=0;r<a.rows;++r)assert(seen[a.nt*1025+a.mt*128+a.row+r]++==0);
   }
  }for(auto x:seen)assert(x==1);
 }
 hw->aic=20;hw->aiv=40;Shape s{1,1025,1031,1032,2,1,1};auto p=MakePlan(s,20);assert(Select(s,p)==2);
 for(auto cap:{&hw->ub,&hw->l1,&hw->l0a,&hw->l0b,&hw->l0}){auto old=*cap;*cap=4096;assert(Select(s,p)==0);*cap=old;}
 auto old=p.totalBytes;p.totalBytes=p.systemBytes;assert(!Select(s,p));p.totalBytes=old;
 hw->aiv=2*(p.cubeBlocks-1);assert(!Select(s,p));hw->aiv=40;
#ifdef BMMMS_TUNING
 for(auto field:{&Tune().group,&Tune().rows,&Tune().dual,&Tune().early,&Tune().tree,&Tune().bm,&Tune().bn,&Tune().window,&Tune().ns,&Tune().ks,&Tune().workers}){
  Tune()=TuneConfig{};*field=1;assert(!Select(s,p));
 }Tune()=TuneConfig{};
#endif
 std::cout<<n<<" actual host plans/"<<hits<<" exact selections; "<<tiles<<" actual packed descriptors over all 8..32 cores match independent enumeration, unique valid coverage/resources/pins PASS\n";
}
