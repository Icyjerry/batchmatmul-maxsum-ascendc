void Run(uint32_t M,uint32_t N,uint32_t workers,bool neg,uint32_t mode){
 uint32_t BM=128,BN=(N+15)/16*16,tasks=M/BM;assert(M%BM==0);
 Shape q{M,N,136,M,BN,1,1,BM,workers};Shared data(q,neg);shared=&data;
 C13FrameShape s{M,N,136,BN,workers};std::vector<std::thread> threads;
 for(uint32_t id=0;id<2*workers;++id)threads.emplace_back([&,id]{
  st=State{};st.block=id;st.mode=mode;st.ring.resize(2*BM*BN,1e30f);
  bmmms_c13_manual_frame<int16_t>(nullptr,nullptr,data.scratch.data(),data.output.data(),s);
  for(auto& engine:st.queues)assert(engine.empty());for(auto e:st.events)for(int v:e)assert(v==0);
  unsigned owned=0;for(uint32_t t=id/2;t<tasks;t+=workers)++owned;
  assert(st.issued==owned&&st.copies==owned&&st.primes==2&&st.releases==owned);
  assert(st.credit[0]==1&&st.credit[1]==1&&st.allocs==(id==0?7u:3u));
 });
 for(auto& t:threads)t.join();assert(data.yWrites.load()==1);float total=0;
 for(uint32_t m=0;m<M;++m){float mx=-std::numeric_limits<float>::infinity();
  for(uint32_t n=0;n<N;++n)mx=std::max(mx,Value(m,n,neg));if(neg)assert(mx<0);total+=mx;
 }
 assert(data.output[0]==total);
 for(uint32_t t=0;t<tasks;++t)for(uint32_t sub=0;sub<2;++sub){float sum=0;
  for(uint32_t m=t*BM+sub*64;m<t*BM+(sub+1)*64;++m){float mx=-std::numeric_limits<float>::infinity();
   for(uint32_t n=0;n<N;++n)mx=std::max(mx,Value(m,n,neg));sum+=mx;}
  for(uint32_t i=0;i<8;++i){auto ix=t*16+sub*8+i;assert(data.scratch[ix]==(i?0:sum)&&data.written[ix]==1);}
 }
 for(size_t i=tasks*16;i<data.scratch.size();++i)assert(data.scratch[i]==1e30f);
 for(size_t i=1;i<data.output.size();++i)assert(data.output[i]==1e30f);
}
int main(){unsigned count=0;
 for(uint32_t m:{128u,256u,640u,8192u})for(uint32_t n:{64u,65u,79u,80u,96u,111u,112u,127u})
 for(uint32_t workers:{1u,3u,20u,32u})for(bool neg:{false,true})for(uint32_t mode=0;mode<3;++mode){
  Run(m,n,workers,neg,mode);++count;
 }
 std::cout<<count<<" queued actual C13 AIV entries: C/sum ping-pong, destructive ring release, three FIFO engine priorities, idle companions, unique complete-N local sums, all-AIV barrier, same early partials and one exact y PASS\n";
}
