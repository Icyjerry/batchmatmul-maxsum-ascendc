int main(){
 auto* hw=platform_ascendc::PlatformAscendCManager::GetInstance();unsigned count=0,hits=0;
 for(int cores:{1,3,8,20,32})for(int B:{1,2})for(int M:{1024,1025,1026})for(int N:{1030,1031,1032})
 for(int K:{1024,1032,1040})for(int dt:{1,2})for(int lay=0;lay<4;++lay){
  hw->aic=cores;hw->aiv=2*cores;Shape s{B,M,N,K,dt,lay/2,lay%2};auto p=MakePlan(s,cores),old=p;
  bool hit=SelectPhased(s,p);++count;
  assert(!memcmp(&p.schedule,&old.schedule,sizeof(Schedule))&&p.totalBytes==old.totalBytes&&p.cubeBlocks==old.cubeBlocks);
  if(hit){++hits;assert(B==1&&M==1025&&N==1031&&K==1032&&dt==2&&lay==3);
   auto q=MakeTTManualFrame(s,p);assert(q.bm==128&&q.bn==128&&q.packageK==384&&q.nTiles==9);
   assert(q.workers==p.cubeBlocks&&q.workers<=uint32_t(cores));
   assert(2ULL*q.bm*1040+4ULL*q.bn*q.packageK==462848);
   assert(q.packageK%128==0&&2*q.packageK<uint32_t(K)&&uint32_t(K)<=3*q.packageK);
  }
 }
 assert(hits==5);hw->aic=20;hw->aiv=40;Shape s{1,1025,1031,1032,2,1,1};auto p=MakePlan(s,20);
 assert(SelectPhased(s,p));
 for(auto cap:{&hw->ub,&hw->l1,&hw->l0a,&hw->l0b,&hw->l0}){
  auto old=*cap;*cap=4096;assert(!SelectPhased(s,p));*cap=old;
 }
 auto bytes=p.totalBytes;p.totalBytes=p.systemBytes;assert(!SelectPhased(s,p));p.totalBytes=bytes;
 hw->aiv=2*(p.cubeBlocks-1);assert(!SelectPhased(s,p));hw->aiv=40;
#ifdef BMMMS_TUNING
 for(auto field:{&Tune().group,&Tune().rows,&Tune().dual,&Tune().early,&Tune().tree,
  &Tune().bm,&Tune().bn,&Tune().window,&Tune().ns,&Tune().ks,&Tune().workers}){
  Tune()=TuneConfig{};*field=1;assert(!SelectPhased(s,p));
 }
 Tune()=TuneConfig{};
#endif
 std::cout<<count<<" actual host plans/"<<hits<<" phased-A selections: unchanged plan/GM/resources, actual cores, exact geometry and parent capacity/pin fallback PASS\n";
}
