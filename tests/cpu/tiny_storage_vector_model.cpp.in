uint64_t FrameBytes(TinyKernelShape s,bool X,bool Y){
 uint64_t pitch=(s.n+15)/16*16,ar=s.b*s.m,ac=ar*s.k,bc=s.b*s.k*pitch;
 uint64_t sizes[]={2*(ac+bc),4*(ac+bc),X?ar*s.k*4:32,X?s.k*4:32,ar*s.k*32,4*ar*s.k*pitch,32*ar,32};
 uint64_t total=0;for(auto n:sizes)total+=(n+31)/32*32;return total;
}
void Clean(){
 for(auto& q:AscendC::engines)assert(q.empty());for(auto f:AscendC::flags)assert(f.second==0);
}
unsigned cases=0,blocks=0,idle=0,controls=0;
template<bool X,bool Y,uint32_t KC=0,bool G=true>
void Entry(Inputs& in,TinyKernelShape s,uint32_t group){
 bmmms_tiny_storage_vector<int16_t,X,KC,G>(in.ap,in.bp,in.y.data()+8,s,group);
}
template<bool X,bool Y>void Run(uint32_t B,uint32_t M,uint32_t N,uint32_t K,uint32_t group,bool neg,unsigned mode){
 TinyKernelShape shape{B,M,N,K};if(!TinyStorageFrameFits(shape,X,Y,group))return;
 Inputs in(B,M,N,K,X,Y,neg);auto oldA=in.a,oldB=in.b;
 auto test=[&](bool specialized){
  in.Prepare();AscendC::localEnds.clear();AscendC::mode=mode;AscendC::brcbs=0;
  unsigned num=group?(B+group-1)/group:1,expectedBrcbs=0;
  for(unsigned z=0;z<num+(group?1:0);++z){
   Clean();AscendC::block=z;AscendC::manualBytes=0;AscendC::localEnds.clear();
   AscendC::ub=std::make_shared<std::vector<uint8_t>>(platform_ascendc::PlatformAscendCManager::GetInstance()->ub,0x7f);
   unsigned b0=group?z*group:0,pitch=(N+15)/16*16;
   unsigned batches=b0>=B?0:(group?std::min(group,B-b0):B),ac=batches*M*K;
   AscendC::canonicalExpected.assign(ac+batches*K*pitch,0);
   for(unsigned i=0;i<ac;++i)AscendC::canonicalExpected[i]=in.ap[b0*M*K+i];
   for(unsigned b=0;b<batches;++b)for(unsigned k=0;k<K;++k)for(unsigned n=0;n<N;++n)
    AscendC::canonicalExpected[ac+(b*K+k)*pitch+n]=in.bp[((b0+b)*K+k)*N+n];
   if(!group)Entry<X,Y,0,false>(in,shape,group);
   else if(!specialized)Entry<X,Y>(in,shape,group);
   else if(K==32)Entry<X,Y,32>(in,shape,group);
   else Entry<X,Y,64>(in,shape,group);
   Clean();
   if(b0>=B){assert(!AscendC::manualBytes);++idle;}
   else {TinyKernelShape frame{group?std::min(group,B-b0):B,M,N,K};
    expectedBrcbs+=(frame.b*M*K/8+254)/255;
    assert(AscendC::manualBytes==FrameBytes(frame,X,Y)&&AscendC::manualBytes+1024<=platform_ascendc::PlatformAscendCManager::GetInstance()->ub);++blocks;}
   for(size_t i=AscendC::manualBytes;i<AscendC::ub->size();++i)assert(AscendC::ub->at(i)==0x7f);
  }
  in.Verify(B,M,N,K,X,Y,neg);assert(in.a==oldA&&in.b==oldB);
  assert(AscendC::brcbs==expectedBrcbs);++cases;
 };
 test(false);auto expected=in.y;test(true);assert(in.y==expected);
 // Reference computes the same passed arithmetic per batch, independent layout code.
 in.Prepare();AscendC::mode=mode;AscendC::canonicalExpected.clear();
 for(uint32_t b=0;b<B;++b){
  AscendC::manualBytes=0;AscendC::localEnds.clear();AscendC::ub=std::make_shared<std::vector<uint8_t>>(platform_ascendc::PlatformAscendCManager::GetInstance()->ub,0x7f);
  TinyCompute<int16_t,X,Y>(in.ap+b*M*K,in.bp+b*N*K,in.y.data()+8+b,{1,M,N,K});Clean();
 }
 in.Verify(B,M,N,K,X,Y,neg);assert(in.y==expected&&in.a==oldA&&in.b==oldB);
}
void Host(){
 auto* hw=platform_ascendc::PlatformAscendCManager::GetInstance();
 for(uint32_t B:{1u,3u,8u,9u,31u,64u})for(uint32_t M:{1u,5u,8u})
 for(uint32_t N:{1u,7u,16u,17u,31u,63u,64u})for(uint32_t K:{32u,40u,48u,56u,64u})
 for(uint32_t group:{0u,1u,3u,8u})for(unsigned lay=0;lay<4;++lay){
  TinyKernelShape s{B,M,N,K},f=s;if(group)f.b=std::min(B,group);
  bool valid=f.b<=8&&!(lay%2)&&(K==32||K==64)&&f.b*M*((N+15)/16*16)/8<=255;uint64_t need=FrameBytes(f,lay/2,lay%2)+1024;
  hw->ub=need;assert(TinyStorageFrameFits(s,lay/2,lay%2,group)==valid);
  hw->ub=need-1;assert(!TinyStorageFrameFits(s,lay/2,lay%2,group));++controls;
 }
 hw->ub=192*1024;TinyKernelShape s{1,5,17,32};assert(TinyStorageFrameFits(s,true,false,0));
 for(auto field:{&s.b,&s.m,&s.n,&s.k}){auto old=*field;*field=0;assert(!TinyStorageFrameFits(s,true,false,0));*field=old;}
 assert(!TinyStorageFrameFits(s,true,false,9));s.k=41;assert(!TinyStorageFrameFits(s,true,false,0));s.k=32;
#ifdef BMMMS_TUNING
 for(auto p:{&Tune().group,&Tune().rows,&Tune().dual,&Tune().early,&Tune().tree,&Tune().bm,&Tune().bn,
  &Tune().window,&Tune().ns,&Tune().ks,&Tune().workers}){Tune()=TuneConfig{};*p=1;assert(!TinyStorageFrameFits(s,true,false,0));}
 Tune()=TuneConfig{};
#endif
 std::cout<<controls<<" exact UB one-byte boundary/shape/group/layout/pin host controls PASS\n";
}
template<bool X>bool Quant(unsigned encoding,unsigned M,unsigned N,unsigned K,bool neg,unsigned mode,unsigned group,double& absMax,double& relMax){
 const unsigned B=3;if(!TinyStorageFrameFits({B,M,N,K},X,false,group))return false;
 Inputs in(B,M,N,K,X,false,neg);std::mt19937 rng(encoding*41+M*13+N*7+K);
 auto value=[&](bool negative){
  unsigned sign=neg?unsigned(negative):rng()%2;
  unsigned e=(encoding==1?6:118)+rng()%9;
  unsigned bits=(sign<<15)|(e<<(encoding==1?10:7))|(rng()%(encoding==1?1024:128));return int16_t(bits);
 };
 for(unsigned b=0;b<B;++b)for(unsigned k=0;k<K;++k){
  for(unsigned m=0;m<M;++m)in.ap[b*M*K+(X?k*M+m:m*K+k)]=value(false);
  for(unsigned n=0;n<N;++n)in.bp[(b*K+k)*N+n]=value(true);
 }
 auto a=in.a,doc=in.b;std::vector<float> expected(B);AscendC::storageEncoding=encoding;
 for(unsigned b=0;b<B;++b){double total=0;
  for(unsigned m=0;m<M;++m){double best=-INFINITY;
   for(unsigned n=0;n<N;++n){double dot=0;for(unsigned k=0;k<K;++k)
    dot+=double(AscendC::Decode(in.ap[b*M*K+(X?k*M+m:m*K+k)]))*AscendC::Decode(in.bp[(b*K+k)*N+n]);
    best=std::max(best,dot);}
   if(neg)assert(best<0);total+=best;
  }expected[b]=float(total);
 }
 in.Prepare();AscendC::mode=mode;AscendC::canonicalExpected.clear();
 for(unsigned block=0;block<(B+group-1)/group;++block){
  AscendC::block=block;AscendC::ub=std::make_shared<std::vector<uint8_t>>(platform_ascendc::PlatformAscendCManager::GetInstance()->ub,0x7f);
  Entry<X,false>(in,{B,M,N,K},group);Clean();
 }
 auto candidate=in.y;
 for(unsigned b=0;b<B;++b){
  float actual=in.y[8+b],golden=expected[b];double err=std::abs(double(actual)-golden);
  absMax=std::max(absMax,err);if(golden!=0)relMax=std::max(relMax,err/std::abs(double(golden)));
  assert(std::isfinite(actual)&&err<=1e-4+1e-4*std::abs(double(golden)));
  assert(AscendC::writes.at(reinterpret_cast<uintptr_t>(in.y.data()+8+b))==1);
 }
 for(unsigned i=0;i<8;++i)assert(in.y[i]==1e30f&&in.y[8+B+i]==1e30f);assert(in.a==a&&in.b==doc);
 // Compare rounding to the passed order independently; exact equality is not required.
 in.Prepare();AscendC::canonicalExpected.clear();
 for(unsigned b=0;b<B;++b){
  AscendC::ub=std::make_shared<std::vector<uint8_t>>(platform_ascendc::PlatformAscendCManager::GetInstance()->ub,0x7f);
  TinyCompute<int16_t,X,false>(in.ap+b*M*K,in.bp+b*N*K,in.y.data()+8+b,{1,M,N,K});Clean();
 }
 for(unsigned b=0;b<B;++b){double e=std::abs(double(candidate[8+b])-in.y[8+b]);assert(e<=1e-4+1e-4*std::abs(double(in.y[8+b])));}
 AscendC::storageEncoding=0;return true;
}
void Quantized(){unsigned count=0;double ae=0,re=0;
 for(unsigned enc:{1u,2u})for(unsigned m:{1u,5u,8u})for(unsigned n:{1u,7u,16u,17u,63u,64u})
 for(unsigned k:{32u,64u})for(bool neg:{false,true})for(unsigned mode=0;mode<3;++mode)for(unsigned group:{1u,2u,3u}){
  count+=Quant<false>(enc,m,n,k,neg,mode,group,ae,re);count+=Quant<true>(enc,m,n,k,neg,mode,group,ae,re);
 }
 std::cout<<count<<" actual entries on FP16/BF16 bit values vs FP64 golden / passed FP32 order, maxAbs="<<ae<<", maxNonzeroRel="<<re<<" PASS (mixed 1e-4 CPU check, not native precision)\n";
}
int main(){Host();Quantized();
 for(uint32_t B:{1u,9u,31u})for(uint32_t M:{1u,5u,8u})for(uint32_t N:{1u,7u,16u,17u,63u,64u})
 for(uint32_t K:{32u,40u,48u,56u,64u})for(uint32_t group:{0u,1u,3u,8u})for(bool neg:{false,true})for(unsigned mode=0;mode<3;++mode){
  Run<false,false>(B,M,N,K,group,neg,mode);Run<true,false>(B,M,N,K,group,neg,mode);
 }
 // Synthetic larger UB checks the supported guard's repeat/chunk boundaries,
 // not an assertion about A2/A3 physical capacity.
 auto* hw=platform_ascendc::PlatformAscendCManager::GetInstance();hw->ub=512*1024;
 for(uint32_t N:{1u,7u,17u,64u})for(uint32_t K:{32u,64u})for(unsigned mode=0;mode<3;++mode){
  Run<false,false>(8,8,N,K,8,true,mode);Run<true,false>(8,8,N,K,8,true,mode);
 }
 hw->ub=192*1024;
 std::cout<<cases<<" queued actual dynamic/constant tiny entries, "<<blocks<<" active / "<<idle<<" idle blocks PASS\n";
 std::cout<<"three engine priorities, batch tails, FF/TF storage, query-only gather, batched Brcb and group-wide K tree, N masks, negative maxima, passed integer reference, immutable inputs/UB/y guards PASS\n";
}
