int main(){
 auto* hw=platform_ascendc::PlatformAscendCManager::GetInstance();unsigned count=0,hits=0;
 for(int cores:{1,4,20,32})for(int b=4;b<=7;++b)for(int m=8;m<16;++m)
 for(int n=16;n<32;++n)for(int k=128;k<256;k+=8){
  hw->aic=cores;hw->aiv=2*cores;Shape s{b,m,n,k,2,1,1};auto p=MakePlan(s,cores),old=p;++count;
  bool fit=C4DirectCubeFits(s,p);assert(fit==(b<=cores));
  assert(!memcmp(&p.schedule,&old.schedule,sizeof(Schedule))&&p.cubeBlocks==old.cubeBlocks&&
   p.finalBlocks==old.finalBlocks&&p.totalBytes==old.totalBytes&&p.systemBytes==old.systemBytes);
  if(fit){++hits;auto d=p.schedule;assert(d.dual==28&&d.workers==b&&p.cubeBlocks==0&&p.finalBlocks==b);
   assert(d.baseM==16&&d.baseN==(n==16?16:32)&&d.kSplit==1&&d.kChunk==Ceil(k,32)*32);
   auto end=p.systemBytes+Ceil(b*16*4,512)*512+8ULL*b*16*d.baseN;assert(end<=p.totalBytes);
  }
 }
 assert(count==32768&&hits==18432);hw->aic=20;hw->aiv=40;Shape s{7,15,31,248,2,1,1};auto p=MakePlan(s,20);
 assert(C4DirectCubeFits(s,p));uint64_t kp=256,c=512;
 std::vector<std::pair<uint64_t*,uint64_t>> caps={{&hw->l1,2*(16+32)*kp+4096},
  {&hw->l0a,32*kp},{&hw->l0b,64*kp},{&hw->l0,4*c},{&hw->ub,4*c+192+4096}};
 for(auto v:caps){auto old=*v.first;*v.first=v.second;assert(C4DirectCubeFits(s,p));
  *v.first=v.second-1;assert(!C4DirectCubeFits(s,p));*v.first=old;}
 auto bytes=p.totalBytes,need=p.systemBytes+Ceil(s.b*16*4,512)*512+8*s.b*c;
 p.totalBytes=need;assert(C4DirectCubeFits(s,p));p.totalBytes=need-1;assert(!C4DirectCubeFits(s,p));p.totalBytes=bytes;
 hw->aic=7;hw->aiv=14;assert(C4DirectCubeFits(s,p));hw->aic=6;assert(!C4DirectCubeFits(s,p));
 hw->aic=7;hw->aiv=13;assert(!C4DirectCubeFits(s,p));hw->aic=20;hw->aiv=40;
 // Original dual19 retained when the TT Vector frame exceeds UB. Neither plan is changed.
 p.schedule.dual=19;p.cubeBlocks=s.b;assert(C4DirectCubeFits(s,p));p.schedule.dual=28;p.cubeBlocks=0;
 for(auto field:{&p.schedule.dual,&p.schedule.baseM,&p.schedule.baseN,&p.schedule.mTiles,
  &p.schedule.nTiles,&p.schedule.nSplit,&p.schedule.kSplit,&p.schedule.kChunk,&p.schedule.window,&p.schedule.workers}){
  auto old=*field;*field=999;assert(!C4DirectCubeFits(s,p));*field=old;}
 for(auto field:{&p.schedule.b,&p.schedule.m,&p.schedule.n,&p.schedule.k}){
  auto old=*field;*field=999;assert(!C4DirectCubeFits(s,p));*field=old;}
 auto sys=p.systemBytes;p.systemBytes=0;assert(!C4DirectCubeFits(s,p));p.systemBytes=sys;
 ++p.cubeBlocks;assert(!C4DirectCubeFits(s,p));--p.cubeBlocks;
 ++p.finalBlocks;assert(!C4DirectCubeFits(s,p));--p.finalBlocks;
 for(Shape other:std::vector<Shape>{{3,15,31,248,2,1,1},{8,15,31,248,2,1,1},
  {7,7,31,248,2,1,1},{7,16,31,248,2,1,1},{7,15,15,248,2,1,1},{7,15,32,248,2,1,1},
  {7,15,31,120,2,1,1},{7,15,31,256,2,1,1},{7,15,31,249,2,1,1},
  {7,15,31,248,1,1,1},{7,15,31,248,2,0,1},{7,15,31,248,2,1,0}})
  assert(!C4DirectCubeFits(other,p));
#ifdef BMMMS_TUNING
 for(auto field:{&Tune().group,&Tune().rows,&Tune().dual,&Tune().early,&Tune().tree,
  &Tune().bm,&Tune().bn,&Tune().window,&Tune().ns,&Tune().ks,&Tune().workers}){
  Tune()=TuneConfig{};*field=1;assert(!C4DirectCubeFits(s,p));
 }
 Tune()=TuneConfig{};
#endif
 std::cout<<count<<" actual C4 host plans / "<<hits<<" selected: whole conditional range, actual capacity/core/workspace boundaries, full-K plan, explicit pins and adjacent fallback PASS\n";
}
