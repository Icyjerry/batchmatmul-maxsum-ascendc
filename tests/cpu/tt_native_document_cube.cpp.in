int main(){unsigned count=0;
 for(uint32_t bm:{64u,128u})for(uint32_t tail:{1u,bm/2,bm})for(uint32_t n:{65u,129u,257u})
 for(uint32_t k:{40u,136u})for(uint32_t workers:{1u,3u})for(bool neg:{false,true})for(bool eager:{false,true}){
  AscendC::eagerFix=eager;uint32_t nt=(n+127)/128;
  for(uint32_t ns:{1u,nt}){Run(bm+tail,n,k,bm,128,256,workers,ns,neg);++count;}
 }
 for(auto v:std::vector<std::vector<uint32_t>>{{129,257,1032,128,128,256,3,2},
  {193,257,1544,64,128,512,8,2},{129,513,1032,64,256,128,8,3},
  {257,129,2040,64,128,256,20,1},{129,513,3072,64,128,256,20,3}})
 for(bool neg:{false,true})for(bool eager:{false,true}){
  AscendC::eagerFix=eager;Run(v[0],v[1],v[2],v[3],v[4],v[5],v[6],v[7],neg);++count;
 }
 std::cout<<count<<" actual swapped TT Cube entries: nValue=1 multi-matrix copy, NC1HWC0/im2col ZZ/ZN, deferred live MTE1/MMAD/Fixpipe, full K/tails, FP32 dense C transpose, input/GM guards PASS\n";
}
