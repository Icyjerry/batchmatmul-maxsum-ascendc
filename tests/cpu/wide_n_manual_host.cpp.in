int main(){
 auto* hw=platform_ascendc::PlatformAscendCManager::GetInstance();unsigned count=0,hits=0;
 for(int cores:{1,3,8,20,32})for(int M:{16,32,48,64,80,96,112,128})
 for(int N:{4096,4112,8192})for(int K:{32,64,128,192,256})for(int dt:{1,2})for(int lay=0;lay<4;++lay){
  hw->aic=std::max(cores,8);hw->aiv=hw->aic*2;Shape s{1,M,N,K,dt,lay/2,lay%2};auto p=MakePlan(s,cores),old=p;
  auto q=MakeWideNManualFrame(s,p);++count;assert(!memcmp(&p.schedule,&old.schedule,sizeof(Schedule)));
  assert(p.totalBytes==old.totalBytes&&p.systemBytes==old.systemBytes&&p.cubeBlocks==old.cubeBlocks);
  if(q.workers){++hits;assert(dt==2&&lay==1&&q.workers==p.cubeBlocks&&q.workers==q.nSplit);
   assert(q.m==M&&q.n==N&&q.k==K&&q.mp==Ceil(M,32)*32&&q.np==128&&q.nTiles==Ceil(N,128));
   assert(q.workers<=uint32_t(cores)&&2ULL*q.mp*K<=hw->l0a&&2ULL*q.np*K<=hw->l0b);
   assert(2ULL*(q.mp+2*q.np)*K+4096<=hw->l1&&8ULL*q.mp*q.np<=hw->l0);
   assert(8ULL*q.mp*q.np+10ULL*q.mp+64+4096<=hw->ub);
  }
 }
 assert(hits);hw->aic=20;hw->aiv=40;Shape hit{1,64,8192,128,2,0,1};auto p=MakePlan(hit,20);
 assert(p.schedule.nSplit==16&&MakeWideNManualFrame(hit,p).workers==16);
 for(auto cap:{&hw->l1,&hw->l0a,&hw->l0b,&hw->l0,&hw->ub}){auto saved=*cap;*cap=4096;assert(!MakeWideNManualFrame(hit,p).workers);*cap=saved;}
 hw->aiv=30;assert(!MakeWideNManualFrame(hit,p).workers);hw->aiv=40;
 for(auto bad:{Shape{2,64,8192,128,2,0,1},Shape{1,64,8192,128,1,0,1},
  Shape{1,64,8192,128,2,1,1},Shape{1,64,8192,128,2,0,0},Shape{1,15,8192,128,2,0,1},
  Shape{1,129,8192,128,2,0,1},Shape{1,63,8192,128,2,0,1},Shape{1,64,8191,128,2,0,1},
  Shape{1,64,8192,136,2,0,1},Shape{1,64,8192,272,2,0,1},Shape{1,64,4080,128,2,0,1}})
  assert(!MakeWideNManualFrame(bad,p).workers);
 for(auto field:{&p.schedule.dual,&p.schedule.kSplit,&p.schedule.mTiles,&p.schedule.window,
  &p.schedule.workers,&p.schedule.nTiles,&p.schedule.nSplit,&p.schedule.baseM,&p.schedule.baseN}){
  auto saved=*field;*field=999;assert(!MakeWideNManualFrame(hit,p).workers);*field=saved;
 }
 auto bytes=p.totalBytes;p.totalBytes=p.systemBytes;assert(!MakeWideNManualFrame(hit,p).workers);p.totalBytes=bytes;
#ifdef BMMMS_TUNING
 for(auto field:{&Tune().group,&Tune().rows,&Tune().dual,&Tune().early,&Tune().tree,
  &Tune().bm,&Tune().bn,&Tune().window,&Tune().ns,&Tune().ks,&Tune().workers}){
  Tune()=TuneConfig{};*field=1;assert(!MakeWideNManualFrame(hit,p).workers);
 }
 Tune()=TuneConfig{};
#endif
 std::cout<<count<<" actual host controls / "<<hits<<" wide-N frames: plan untouched, resources, pins, shape/launch/GM fallback PASS\n";
}
