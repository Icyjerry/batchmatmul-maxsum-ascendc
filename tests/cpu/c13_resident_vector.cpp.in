void Run(uint32_t M,uint32_t workers,bool neg,uint32_t mode){
 uint32_t N=64,BM=128,BN=64,tasks=M/BM;assert(M%BM==0);
 Shape q{M,N,128,M,BN,1,1,BM,workers};Shared data(q,neg);shared=&data;
 C13ResidentFrame s{M,workers};std::vector<std::thread> threads;
 for(uint32_t id=0;id<2*workers;++id)threads.emplace_back([&,id]{
  st=State{};st.block=id;st.mode=mode;st.ring.resize(2*BM*BN,1e30f);
  bmmms_c13_resident_frame<int16_t>(nullptr,nullptr,data.scratch.data(),data.output.data(),s);
  for(auto& engine:st.queues)assert(engine.empty());for(auto e:st.events)for(int v:e)assert(v==0);
  unsigned owned=0;for(uint32_t t=id/2;t<tasks;t+=workers)++owned;
  assert(st.issued==owned&&st.copies==owned&&st.primes==2&&st.releases==owned);
  assert(st.credit[0]==1&&st.credit[1]==1&&st.allocs==(id==0?8u:4u));
 });
 for(auto& t:threads)t.join();assert(data.yWrites.load()==1);float total=0;
 for(uint32_t m=0;m<M;++m){float mx=-std::numeric_limits<float>::infinity();
  for(uint32_t n=0;n<N;++n)mx=std::max(mx,Value(m,n,neg));if(neg)assert(mx<0);total+=mx;
 }
 assert(data.output[0]==total);
 for(uint32_t w=0;w<workers;++w)for(uint32_t sub=0;sub<2;++sub){float sum=0;
  for(uint32_t r=0;r<64;++r)for(uint32_t t=w;t<tasks;t+=workers){float mx=-std::numeric_limits<float>::infinity();
   for(uint32_t n=0;n<N;++n)mx=std::max(mx,Value(t*BM+sub*64+r,n,neg));sum+=mx;}
  for(uint32_t i=0;i<8;++i){auto ix=w*16+sub*8+i;assert(data.scratch[ix]==(i?0:sum)&&data.written[ix]==1);}
 }
 for(size_t i=workers*16;i<data.scratch.size();++i)assert(data.scratch[i]==1e30f);
 for(size_t i=1;i<data.output.size();++i)assert(data.output[i]==1e30f);
}
int main(){unsigned count=0;
 for(uint32_t m:{128u,256u,640u,8192u})for(uint32_t workers:{1u,3u,8u,20u,32u,64u}){
  if(workers*16>m)continue;
  for(bool neg:{false,true})for(uint32_t mode=0;mode<3;++mode){Run(m,workers,neg,mode);++count;}
 }
 std::cout<<count<<" threaded resident AIV configurations: doubleC, destructive GM credit, three engine priorities, completeN before worker sum, single partial store, idle workers, unique y and guards PASS\n";
}
