int main(){
 auto* hw=platform_ascendc::PlatformAscendCManager::GetInstance();unsigned count=0,hits=0;
 for(int cores:{1,8,20,32})for(int n=64;n<128;++n)for(int k=128;k<256;k+=8){
  hw->aic=cores;hw->aiv=2*cores;Shape s{1,8192,n,k,1,0,0};auto p=MakePlan(s,cores),old=p;
  auto q=MakeC13ManualFrame(s,p);++count;
  assert(!memcmp(&p.schedule,&old.schedule,sizeof(Schedule))&&p.totalBytes==old.totalBytes);
  bool expected=n%16||k%16;assert(bool(q.workers)==expected);
  if(q.workers){++hits;const auto& d=p.schedule;
   assert(q.m==8192&&q.n==n&&q.k==k&&q.bn==d.baseN&&q.workers==d.workers);
   assert(d.dual==14&&d.earlySum&&d.mTiles==64&&d.nSplit==1&&d.nTiles==1&&d.kSplit==1&&d.window==1);
   assert(4ULL*(128+q.bn)*128+4096<=hw->l1&&4ULL*128*128<=hw->l0a&&4ULL*q.bn*128<=hw->l0b);
   assert(8ULL*128*q.bn<=hw->l0&&4ULL*128*q.bn+1088+4096<=hw->ub);
  }
 }
 assert(count==4096&&hits==3968);hw->aic=20;hw->aiv=40;Shape s{1,8192,65,136,1,0,0};auto p=MakePlan(s,20);
 assert(MakeC13ManualFrame(s,p).workers);
 std::vector<std::pair<uint64_t*,uint64_t>> caps={{&hw->l1,4ULL*(128+p.schedule.baseN)*128+4096},
  {&hw->l0a,4ULL*128*128},{&hw->l0b,4ULL*p.schedule.baseN*128},
  {&hw->l0,8ULL*128*p.schedule.baseN},{&hw->ub,4ULL*128*p.schedule.baseN+1088+4096}};
 for(auto v:caps){auto old=*v.first;*v.first=v.second;assert(MakeC13ManualFrame(s,p).workers);
  *v.first=v.second-1;assert(!MakeC13ManualFrame(s,p).workers);*v.first=old;}
 auto bytes=p.totalBytes;auto need=p.systemBytes+Ceil(s.m*4,512)*512+8ULL*p.schedule.workers*128*p.schedule.baseN;
 p.totalBytes=need;assert(MakeC13ManualFrame(s,p).workers);p.totalBytes=need-1;assert(!MakeC13ManualFrame(s,p).workers);p.totalBytes=bytes;
 auto workers=p.schedule.workers;hw->aic=workers;hw->aiv=2*workers;assert(MakeC13ManualFrame(s,p).workers);
 hw->aic=workers-1;assert(!MakeC13ManualFrame(s,p).workers);hw->aic=workers;hw->aiv=2*workers-1;
 assert(!MakeC13ManualFrame(s,p).workers);hw->aic=20;hw->aiv=40;
 for(auto field:{&p.schedule.dual,&p.schedule.baseM,&p.schedule.baseN,&p.schedule.mTiles,
  &p.schedule.nTiles,&p.schedule.nSplit,&p.schedule.kSplit,&p.schedule.window,&p.schedule.workers}){
  auto old=*field;*field=999;assert(!MakeC13ManualFrame(s,p).workers);*field=old;}
 auto early=p.schedule.earlySum;p.schedule.earlySum=0;assert(!MakeC13ManualFrame(s,p).workers);p.schedule.earlySum=early;
 for(Shape other:std::vector<Shape>{{2,8192,65,136,1,0,0},{1,8191,65,136,1,0,0},
  {1,8192,63,136,1,0,0},{1,8192,128,136,1,0,0},{1,8192,65,120,1,0,0},
  {1,8192,65,256,1,0,0},{1,8192,65,136,2,0,0},{1,8192,65,136,1,1,0},{1,8192,65,136,1,0,1}})
  assert(!MakeC13ManualFrame(other,p).workers);
#ifdef BMMMS_TUNING
 for(auto field:{&Tune().group,&Tune().rows,&Tune().dual,&Tune().early,&Tune().tree,
  &Tune().bm,&Tune().bn,&Tune().window,&Tune().ns,&Tune().ks,&Tune().workers}){
  Tune()=TuneConfig{};*field=1;assert(!MakeC13ManualFrame(s,p).workers);
 }
 Tune()=TuneConfig{};
#endif
 std::cout<<count<<" actual C13 host plans / "<<hits<<" selected: original plan/grid/GM, full conditional shapes, exact capacity/core/workspace boundaries, adjacent layout/dtype/shape and TUNING fallback PASS\n";
}
