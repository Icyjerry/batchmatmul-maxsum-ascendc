// Executes extracted producer with physical NZ/ZZ/ZN blocks. Not a CANN emulator.
#include <algorithm>
#include <cassert>
#include <cstdint>
#include <cstring>
#include <deque>
#include <iostream>
#include <map>
#include <memory>
#include <vector>
#include <tuple>
#include <limits>
#include <functional>
#define __aicore__
using event_t=int;
using half=int16_t;
constexpr int PIPE_MTE2=1,PIPE_M=2,PIPE_FIX=3;
struct Schedule {
    int64_t b,m,n,k;
    uint32_t baseM,baseN,mTiles,nTiles,nSplit,workers,panelK,panelGroup;
    uint32_t panelResident=0,panelL1K=0,window=1,dual=31,tree=0,kChunk=0;
};
struct Expected {int64_t b,m,n;uint32_t rows,cols,ns;size_t offset;};
struct State {
    Schedule s;bool tx1,tx2;bool packedReady=true;uint32_t worker=0;
    uint64_t aDeques=0,overlap=0;
    uint64_t aReads=0,bReads=0,aL0=0,bL0=0,mmads=0,aCopies=0,bCopies=0,aLoads=0,bLoads=0;
    int lastCWait=-1;
    std::map<std::tuple<int64_t,int64_t,uint32_t>,float> maxima;
    std::map<std::pair<int,int>,int> events;
    int cross[2]={1,1};
    std::vector<Expected> expected;size_t fixes=0;
} st;
bool negativeInput=false;
int16_t A(int64_t b,int64_t m,int64_t k){return negativeInput?1+(b*13+m*7+k*3)%3:int((b*13+m*5+k*3)%7)-3;}
int16_t B(int64_t b,int64_t k,int64_t n){return -int16_t(1+(b*11+k*3+n*2)%5);}
namespace AscendC {
enum class TPosition {A1,B1,A2,B2,CO1};
enum class HardEvent {M_MTE1,MTE1_M,FIX_M,M_FIX,MTE2_MTE1,MTE1_MTE2};
struct Storage {std::vector<uint8_t> bytes;TPosition pos;bool pending=false;Storage(size_t n,TPosition p):bytes(n,0x77),pos(p){}};
struct Pending {std::shared_ptr<Storage> mem;std::function<void()> op;};
std::deque<Pending> dma;
void Flush(std::shared_ptr<Storage> target){
 while(target->pending){assert(!dma.empty());auto x=dma.front();dma.pop_front();x.op();x.mem->pending=false;}
}
template<class T>struct LocalTensor {
    std::shared_ptr<Storage> mem;size_t offset=0;
    LocalTensor operator[](size_t i)const{assert(offset+i*sizeof(T)<mem->bytes.size());return {mem,offset+i*sizeof(T)};}
    T& at(size_t i)const{assert(offset+(i+1)*sizeof(T)<=mem->bytes.size());return *reinterpret_cast<T*>(&mem->bytes[offset+i*sizeof(T)]);}
    template<class U>LocalTensor<U> ReinterpretCast()const{return {mem,offset};}
};
template<class T>struct GlobalTensor {
    std::vector<T>* data;size_t offset=0;bool isA=false;
    GlobalTensor operator[](size_t i)const{assert(offset+i<data->size());return {data,offset+i,isA};}
    T& at(size_t i)const{assert(offset+i<data->size());return data->at(offset+i);}
};
template<TPosition P,int N>struct TQue {
    std::shared_ptr<Storage> mem[N];bool used[N]={};std::deque<int> fifo;
    template<class T>LocalTensor<T> AllocTensor(){for(int i=0;i<N;++i)if(!used[i]){used[i]=true;return {mem[i],0};}assert(false);return {};}
    template<class T>void EnQue(LocalTensor<T> t){for(int i=0;i<N;++i)if(mem[i]==t.mem){assert(used[i]);fifo.push_back(i);return;}assert(false);}
    template<class T>LocalTensor<T> DeQue(){assert(!fifo.empty());int i=fifo.front();fifo.pop_front();Flush(mem[i]);if(P==TPosition::A1)++st.aDeques;return {mem[i],0};}
    template<class T>void FreeTensor(LocalTensor<T> t){for(int i=0;i<N;++i)if(mem[i]==t.mem){assert(used[i] && !mem[i]->pending);used[i]=false;return;}assert(false);}
    ~TQue(){assert(fifo.empty());for(bool u:used)assert(!u);}
};
template<TPosition P>struct TBuf{std::shared_ptr<Storage> mem;template<class T>LocalTensor<T> Get(){return {mem,0};}};
struct TPipe {
    int next[6]={3,0,0,0,0};uint64_t l1=0,l0a=0,l0b=0,l0c=0;
    void Count(TPosition p,uint64_t n){
        if(p==TPosition::A1||p==TPosition::B1){l1+=n;assert(l1<=512*1024);}
        if(p==TPosition::A2){l0a+=n;assert(l0a<=65536);}
        if(p==TPosition::B2){l0b+=n;assert(l0b<=65536);}
        if(p==TPosition::CO1){l0c+=n;assert(l0c<=131072);}
    }
    template<TPosition P,int N>void InitBuffer(TQue<P,N>& q,int depth,uint32_t n){assert(depth==N);Count(P,depth*n);for(auto& m:q.mem)m=std::make_shared<Storage>(n,P);}
    template<TPosition P>void InitBuffer(TBuf<P>& b,uint32_t n){Count(P,n);b.mem=std::make_shared<Storage>(n,P);}
    template<HardEvent E>int AllocEventID(){int i=next[int(E)]++;assert(i<8);return i;}
    template<HardEvent E>void ReleaseEventID(int i){assert(st.events[std::make_pair(int(E),i)]==0);}
};
template<HardEvent E>void SetFlag(int i){assert(st.events[std::make_pair(int(E),i)]++==0);}
template<HardEvent E>void WaitFlag(int i){
    assert(st.events[std::make_pair(int(E),i)]--==1);
    if(E==HardEvent::FIX_M)st.lastCWait=i;
}
template<int P>void PipeBarrier(){}
template<int Mode>void CrossCoreWaitFlag(int id){
 assert(Mode==2);if(id==12){assert(st.packedReady);st.packedReady=false;return;}
 assert(id>=4&&id<6);assert(st.cross[id-4]--==1);
}
template<int Mode,int P>void CrossCoreSetFlag(int id){assert(Mode==2 && P==PIPE_FIX && id<2);assert(st.cross[id]++==0);}
struct Nd2NzParams {uint32_t ndNum,nValue,dValue,srcDValue,dstNzC0Stride,dstNzNStride;};
template<class T>struct InitConstValueParams {uint16_t repeats,blocks,gap;T value;};
template<class T>void InitConstValue(LocalTensor<T> dst,InitConstValueParams<T> p){
    for(uint32_t r=0;r<p.repeats;++r)for(uint32_t j=0;j<p.blocks*16;++j)
        dst.at(r*(p.blocks+p.gap)*16+j)=p.value;
}
template<class T>void DataCopy(LocalTensor<T> dst,GlobalTensor<T> src,Nd2NzParams p){
    assert(p.ndNum==1 && p.dstNzNStride==1 && p.dstNzC0Stride%16==0);
    assert(!dst.mem->pending);dst.mem->pending=true;
    dma.push_back({dst.mem,[=]{
    for(uint32_t r=0;r<p.nValue;++r)for(uint32_t c=0;c<(p.dValue+15)/16*16;++c){
        dst.at((c/16)*p.dstNzC0Stride*16+r*16+c%16)=c<p.dValue?src.at(r*p.srcDValue+c):0;
    }
    }});
    (src.isA?st.aReads:st.bReads)+=p.nValue*p.dValue;
    ++(src.isA?st.aCopies:st.bCopies);
}
template<class T>void DataCopy(LocalTensor<T> dst,GlobalTensor<T> src,uint32_t count){
 assert(!dst.mem->pending);dst.mem->pending=true;
 dma.push_back({dst.mem,[=]{for(uint32_t i=0;i<count;++i)dst.at(i)=src.at(i);}});
 st.bReads+=count;++st.bCopies;
}
void SetAtomicNone(){} void SetLoadDataBoundary(uint64_t){} void SetLoadDataPaddingValue(uint64_t){}
struct LoadData2DParams {uint32_t repeatTimes=1,srcStride=1,dstGap=0;bool ifTranspose=false;};
template<class T>void LoadData(LocalTensor<T> dst,LocalTensor<T> src,LoadData2DParams p){
    assert(!src.mem->pending);
    assert(p.repeatTimes>0 && p.repeatTimes<=255 && dst.offset%512==0 && src.offset%512==0);
    for(uint32_t r=0;r<p.repeatTimes;++r)for(uint32_t i=0;i<16;++i)for(uint32_t j=0;j<16;++j)
        dst.at(r*(p.dstGap+1)*256+i*16+j)=src.at(r*p.srcStride*256+(p.ifTranspose?j*16+i:i*16+j));
    (dst.mem->pos==TPosition::A2?st.aL0:st.bL0)+=p.repeatTimes*256;
    ++(dst.mem->pos==TPosition::A2?st.aLoads:st.bLoads);
}
template<class T>struct LoadData3DParamsV2 {
    uint32_t l1H=1,l1W=0,channelSize=0,strideH=1,strideW=1,filterH=1,filterW=1;
    uint32_t dilationFilterH=1,dilationFilterW=1,mStartPt=0,kStartPt=0,mExtension=0,kExtension=0;
    bool enTranspose=false;
};
void LoadData(LocalTensor<half> dst,LocalTensor<half> src,LoadData3DParamsV2<half> p){
    assert(p.enTranspose&&dst.mem->pos==TPosition::A2&&src.mem->pos==TPosition::A1&&!src.mem->pending);
    assert(p.l1H==1&&p.l1W%16==0&&p.channelSize%16==0&&p.strideH==1&&p.strideW==1&&p.filterH==1&&p.filterW==1);
    assert(p.dilationFilterH==1&&p.dilationFilterW==1&&p.kStartPt==0&&p.mStartPt%16==0);
    uint32_t rows=p.kExtension,count=p.mExtension;
    assert(rows==p.channelSize&&count%16==0&&p.mStartPt+count<=p.l1W);
    for(uint32_t m=0;m<rows;++m)for(uint32_t k=0;k<count;++k){
        const auto from=(m/16)*p.l1W*16+(p.mStartPt+k)*16+m%16;
        const auto to=((m/16)*(count/16)+k/16)*256+(m%16)*16+k%16;
        dst.at(to)=src.at(from);
    }
    st.aL0+=uint64_t(rows)*count;++st.aLoads;
}
struct MmadParams {uint32_t m,n,k;bool cmatrixInitVal;};
template<class T>void Mmad(LocalTensor<float> c,LocalTensor<T> a,LocalTensor<T> b,MmadParams p){
    assert(p.m%16==0 && p.n%16==0 && p.k%16==0);++st.mmads;
    const int slot=c.offset/(st.s.baseM*st.s.baseN*sizeof(float));
    assert(st.events[std::make_pair(int(HardEvent::FIX_M),slot)]==0);
    if(p.cmatrixInitVal) {
        assert(st.lastCWait==slot);st.lastCWait=-1;

    }
    for(auto x:dma)if(x.mem->pos==TPosition::A1)++st.overlap;
    for(uint32_t m=0;m<p.m;++m)for(uint32_t n=0;n<p.n;++n){
        const size_t ci=(n/16)*p.m*16+m*16+n%16;
        float v=p.cmatrixInitVal?0:c.at(ci);
        for(uint32_t k=0;k<p.k;++k){
            auto ai=((m/16)*(p.k/16)+k/16)*256+(m%16)*16+k%16;
            auto bi=((k/16)*(p.n/16)+n/16)*256+(n%16)*16+k%16;
            v+=float(a.at(ai))*float(b.at(bi));
        }
        c.at(ci)=v;
    }
}
struct FixpipeParamsV220 {uint32_t nSize,mSize,srcStride,dstStride;};
void Fixpipe(GlobalTensor<float> dst,LocalTensor<float> src,FixpipeParamsV220 p){
    assert(st.fixes<st.expected.size());const auto e=st.expected[st.fixes++];
    assert(p.srcStride==p.mSize && p.dstStride==st.s.baseN*st.s.window);
    assert(dst.offset==e.offset);
    for(uint32_t m=0;m<p.mSize;++m)for(uint32_t n=0;n<p.nSize;++n){
        float v=src.at((n/16)*p.srcStride*16+m*16+n%16),gold=0;
        if(m<e.rows && n<e.cols)for(uint32_t k=0;k<st.s.k;++k)gold+=float(A(e.b,e.m+m,k))*float(B(e.b,k,e.n+n));
        assert(v==gold); // checks every output C element, including padded rows/cols
        dst.at(m*p.dstStride+n)=v;
        if(m<e.rows && n<e.cols) {
            auto key=std::make_tuple(e.b,e.m+m,e.ns);
            auto it=st.maxima.find(key);
            if(it==st.maxima.end())st.maxima[key]=v;else it->second=std::max(it->second,v);
        }
    }
}
}
template<AscendC::HardEvent E>void Fence(){
 if(E==AscendC::HardEvent::MTE2_MTE1){
  while(!AscendC::dma.empty()){auto x=AscendC::dma.front();AscendC::dma.pop_front();x.op();x.mem->pending=false;}
 }
}
// INSERT_HELPERS

void Run(Schedule s,bool neg) {
    negativeInput=neg;
    s.mTiles=(s.m+s.baseM-1)/s.baseM;s.nTiles=(s.n+s.baseN-1)/s.baseN;
    const uint32_t bm=s.baseM;
    std::vector<int16_t> a(s.b*s.m*s.k),b(s.b*s.nTiles*s.baseN*s.k,0);
    for(int64_t z=0;z<s.b;++z)for(int64_t m=0;m<s.m;++m)for(int64_t k=0;k<s.k;++k)a[z*s.m*s.k+k*s.m+m]=A(z,m,k);
    for(int64_t z=0;z<s.b;++z)for(int64_t k=0;k<s.k;++k)for(int64_t n=0;n<s.n;++n)b[(z*s.nTiles+n/s.baseN)*s.k*s.baseN+(k/16)*s.baseN*16+(n%s.baseN)*16+k%16]=B(z,k,n);
    uint64_t aRead=0,bRead=0,mmads=0,bCopies=0,bLoads=0;
    std::vector<float> final(s.b*s.m,-std::numeric_limits<float>::infinity());
    std::map<int64_t,int> seen;
    for(uint32_t worker=0;worker<s.workers;++worker) {
        st=State{};st.s=s;st.worker=worker;st.tx1=st.tx2=true;uint32_t sequence=0;
        for(int64_t task=worker;task<s.b*s.mTiles*s.nSplit;task+=s.workers) {
            assert(++seen[task]==1);
            auto ns=task%s.nSplit,mt=(task/s.nSplit)%s.mTiles,z=task/(s.nSplit*s.mTiles);
            auto begin=ns*s.nTiles/s.nSplit,end=(ns+1)*s.nTiles/s.nSplit;
            for(int64_t nt=begin;nt<end;++nt){
                const auto part=(nt-begin)%s.window;
                st.expected.push_back({z,mt*s.baseM,nt*s.baseN,
                    uint32_t(std::min<int64_t>(bm,s.m-mt*s.baseM)),uint32_t(std::min<int64_t>(s.baseN,s.n-nt*s.baseN)),
                    uint32_t(ns),size_t((sequence&1)*s.baseM*s.baseN*s.window+part*s.baseN)});
                if(part+1==s.window || nt+1==end)++sequence;
            }
        }
        std::vector<float> ring(2*s.baseM*s.baseN*s.window,1e30f);
        AscendC::TPipe pipe;
        RunPackedCube<int16_t>(pipe,{&a,0,true},{&b,0,false},{&ring},s,worker);
        assert(AscendC::dma.empty());
        assert(st.aDeques==0);assert(!st.packedReady);
        assert(st.aLoads==st.mmads);

        assert(st.fixes==st.expected.size() && !st.cross[0] && !st.cross[1]);
        for(auto e:st.events)assert(e.second==0);
        for(auto x:st.maxima) {
            auto z=std::get<0>(x.first),m=std::get<1>(x.first);auto ns=std::get<2>(x.first);
            const int64_t nbegin=(ns*s.nTiles/s.nSplit)*s.baseN;
            const int64_t nend=std::min<int64_t>(s.n,((ns+1)*s.nTiles/s.nSplit)*s.baseN);
            float expected=-std::numeric_limits<float>::infinity();
            for(int64_t n=nbegin;n<nend;++n) {
                float v=0;for(int64_t k=0;k<s.k;++k)v+=float(A(z,m,k))*float(B(z,k,n));
                expected=std::max(expected,v);
            }
            assert(x.second==expected);final[z*s.m+m]=std::max(final[z*s.m+m],x.second);
        }
        aRead+=st.aReads;bRead+=st.bReads;mmads+=st.mmads;bCopies+=st.bCopies;bLoads+=st.bLoads;
    }
    assert(seen.size()==size_t(s.b*s.mTiles*s.nSplit));
    assert(aRead==uint64_t(s.b*s.m*s.k)*s.nSplit);
    assert(bRead==uint64_t(s.b*s.mTiles*s.nTiles*s.baseN*s.k));
    const uint64_t bk=s.baseN==256?64:128,kTiles=(s.k+bk-1)/bk;
    assert(bCopies==uint64_t(s.b*s.mTiles*s.nTiles)*kTiles);
    uint64_t expectedLoads=0;
    for(uint32_t nt=0;nt<s.nTiles;++nt)for(uint32_t k0=0;k0<s.k;k0+=bk){
        const uint32_t cols=std::min<int64_t>(s.baseN,s.n-int64_t(nt)*s.baseN);
        const uint32_t count=std::min<int64_t>(bk,s.k-k0);
        expectedLoads+=cols==s.baseN?1:count/16;
    }
    assert(bLoads==expectedLoads*s.b*s.mTiles);
    assert(mmads==uint64_t(s.b*((s.m+bm-1)/bm)*s.nTiles)*kTiles);
    assert(bCopies==mmads);
    for(int64_t z=0;z<s.b;++z) {
        float got=0,expected=0;
        for(int64_t m=0;m<s.m;++m) {
            float r=-std::numeric_limits<float>::infinity();
            for(int64_t n=0;n<s.n;++n) {
                float v=0;for(int64_t k=0;k<s.k;++k)v+=float(A(z,m,k))*float(B(z,k,n));
                r=std::max(r,v);
            }
            assert(final[z*s.m+m]==r);if(neg)assert(r<0);
            got+=final[z*s.m+m];expected+=r;
        }
        assert(got==expected);
    }
}
int main(){unsigned cases=0;
 for(uint32_t m:{16u,32u,64u,80u,128u,144u})for(uint32_t n:{16u,128u,144u,256u,272u})
 for(uint32_t k:{48u,144u,1040u})for(uint32_t ns:{1u,2u})for(uint32_t workers:{1u,3u})for(bool neg:{false,true}) {
   Run({2,m,n,k,128,256,0,0,ns,workers,64,0},neg);++cases;
 }
 for(auto s:std::vector<Schedule>{{1,144,528,1536,128,256,0,0,2,3,64,0},
                                {1,144,272,1040,128,128,0,0,2,3,128,0}})
   for(bool neg:{false,true}){Run(s,neg);++cases;}
 std::cout<<cases<<" actual packed Cube-body executions: resident full-K A, raw-bit rectangle, prepacked NZ B, delayed DMA, C1/C2/events/credits, padded B/N/M/K16 tails, full-K Max/Sum PASS\n";
}
