// Inserted into the existing bounded NZ model. No FP arithmetic is performed.
void StageLayout(uint32_t bn,uint32_t n,uint32_t k) {
 const uint32_t bk=bn==256?64:128,stageK=2*bk;
 Schedule s{2,16,n,k,16,bn,1,(n+bn-1)/bn,1,1,0,0};st=State{};st.s=s;
 std::vector<int16_t> input(2ULL*n*k);
 for(size_t i=0;i<input.size();++i)input[i]=static_cast<int16_t>(static_cast<uint16_t>(i));
 const auto old=input;AscendC::TPipe pipe;
 AscendC::TQue<AscendC::TPosition::B1,1> staged;
 AscendC::TQue<AscendC::TPosition::B1,2> legacy;
 AscendC::TBuf<AscendC::TPosition::B2> results;
 pipe.InitBuffer(staged,1,bn*stageK*2);pipe.InitBuffer(legacy,2,bn*bk*2);
 pipe.InitBuffer(results,2*bn*bk*2);auto got=results.Get<int16_t>();
 uint64_t stages=0,panels=0;
 for(int batch=0;batch<2;++batch)for(uint32_t n0=0;n0<n;n0+=bn) {
  const uint32_t validCols=std::min(bn,n-n0),cols=(validCols+15)/16*16;
  for(uint32_t k0=0;k0<k;k0+=stageK) {
   ManualFullMReadB<int16_t>(staged,{&input,0,false},s,stageK,validCols,batch,n0,k0);
   auto full=staged.DeQue<int16_t>();++stages;
   for(uint32_t inner=0;inner<stageK&&k0+inner<k;inner+=bk) {
    const uint32_t valid=std::min(bk,k-k0-inner),count=(valid+15)/16*16;
    AscendC::LoadData2DParams lp;lp.repeatTimes=count*cols/256;
    AscendC::LoadData(got,full[inner*cols],lp);
    ManualFullMReadB<int16_t>(legacy,{&input,0,false},s,bk,validCols,batch,n0,k0+inner);
    auto ref=legacy.DeQue<int16_t>();AscendC::LoadData(got[bn*bk],ref,lp);legacy.FreeTensor(ref);++panels;
    for(uint32_t r=0;r<count;++r)for(uint32_t c=0;c<cols;++c) {
     const uint32_t i=((r/16)*(cols/16)+c/16)*256+(c%16)*16+r%16;
     const int16_t expected=r<valid&&c<validCols?input[batch*n*k+(n0+c)*k+k0+inner+r]:0;
     assert(got.at(i)==expected&&got.at(bn*bk+i)==expected);
    }
   }
   staged.FreeTensor(full);
  }
 }
 assert(input==old&&AscendC::dma.empty());
 assert(st.bCopies==stages+panels&&st.bReads==4ULL*n*k);
 assert(stages==2ULL*s.nTiles*((k+stageK-1)/stageK));
 assert(panels==2ULL*s.nTiles*((k+bk-1)/bk));
}
int main(){unsigned cases=0;
 for(uint32_t bn:{32u,64u,128u,256u})for(uint32_t n:{1u,17u,129u,511u,513u})
 for(uint32_t k:{32u,40u,128u,136u,256u,264u,1032u,1776u,2040u}){
  StageLayout(bn,n,k);++cases;
 }
 std::cout<<cases<<" actual ND2NZ/read helper and physical B2 slices: raw bits, N/K8 tails, stage boundaries, paired batch offsets, independent ZN oracle, equal input bytes PASS\n";
}
